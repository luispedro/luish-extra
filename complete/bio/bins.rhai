        "convert_to_itol" => #{
            opts: `
                --input_tree INPUT_TREE    path to the unrooted tree in Newick format
                --output_tree OUTPUT_TREE  path to output the tree
                --debug                    create intermediate files for debugging purposes
                -h, --help                 show help message
            `,
            values: #{
                "--input_tree": "files", "--output_tree": "files",
            },
            args: ["none"],
        },
        "convert_to_species" => #{
            opts: `
                --input_tree INPUT_TREE                      path to the unrooted tree in Newick format
                --output_tree OUTPUT_TREE                    path to output the tree
                --custom_taxonomy_file CUSTOM_TAXONOMY_FILE  file of custom taxonomy strings for the user genomes
                --all_ranks                                  add all missing ranks to the leaf nodes if they are present in the reference tree
                --debug                                      create intermediate files for debugging purposes
                -h, --help                                   show help message
            `,
            values: #{
                "--input_tree": "files", "--output_tree": "files", "--custom_taxonomy_file": "files",
            },
            args: ["none"],
        },
        "export_msa" => #{
            opts: `
                --domain ARC|BAC  domain to export
                --output OUTPUT   output file
                --debug           create intermediate files for debugging purposes
                -h, --help        show help message
            `,
            values: #{
                "--domain": ["arc", "bac"], "--output": "files",
            },
            args: ["none"],
        },
        "check_install" => #{
            opts: `
                --db_version DB_VERSION  GTDB-Tk version package to test for compatibility
                --debug                  create intermediate files for debugging purposes
                -h, --help               show help message
            `,
            values: #{
                "--db_version": "none",
            },
            args: ["none"],
        },
        _ => (),
    }
}

fn drep() {
    #{
        opts: `
            -h, --help  show this help message and exit
        `,
        commands: `
            dereplicate         de-replicate a set of genomes
            compare             compare and cluster a set of genomes
            check_dependencies  check which dependencies are properly installed
        `,
        sub_spec: "@extra-complete/bio/bins:dRep",
    }
}

fn drep_sub(sub) {
    switch sub {
        "dereplicate" => #{
            opts: `
                -p, --processors PROCESSORS                   threads
                -d, --debug                                   make extra debugging output
                -h, --help                                    show this help message and exit
                -g, --genomes GENOMES                         genomes to filter in .fasta format
                -l, --length LENGTH                           minimum genome length
                -comp, --completeness COMPLETENESS            minimum genome completeness
                -con, --contamination CONTAMINATION           maximum genome contamination
                --ignoreGenomeQuality                         don't run checkM or do any quality filtering
                --genomeInfo GENOMEINFO                       location of .csv file containing quality information on the genomes
                --checkM_method LINEAGE_WF|TAXONOMY_WF        either lineage_wf (more accurate) or taxonomy_wf (faster)
                --set_recursion SET_RECURSION                 increases the python recursion limit
                --checkm_group_size CHECKM_GROUP_SIZE         the number of genomes passed to checkM at a time
                --S_algorithm S_ALGORITHM                     algorithm for the secondary clustering comparisons
                -ms, --MASH_sketch MASH_SKETCH                MASH sketch size
                --SkipMash                                    skip MASH clustering, just do secondary clustering on all genomes
                --SkipSecondary                               skip secondary clustering, just perform MASH clustering
                --skani_extra SKANI_EXTRA                     extra arguments to pass to skani triangle
                --n_PRESET NORMAL|TIGHT                       presets to pass to nucmer: tight (only highly conserved regions) or normal
                -pa, --P_ani P_ANI                            ANI threshold to form primary (MASH) clusters
                -sa, --S_ani S_ANI                            ANI threshold to form secondary clusters
                -nc, --cov_thresh COV_THRESH                  minimum level of overlap between genomes in the secondary comparisons
                -cm, --coverage_method TOTAL|LARGER           method to calculate coverage of an alignment
                --clusterAlg CLUSTERALG                       algorithm used to cluster genomes (scipy.cluster.hierarchy.linkage)
                --low_ram_primary_clustering                  use a memory-efficient algorithm for primary clustering
                --multiround_primary_clustering               cluster each primary chunk separately and merge them with single linkage
                --primary_chunksize PRIMARY_CHUNKSIZE         impacts multiround_primary_clustering
                --greedy_secondary_clustering                 use a heuristic to avoid pair-wise comparisons when doing secondary clustering
                --run_tertiary_clustering                     run an additional round of clustering on the final genome set
                -comW, --completeness_weight COMPLETENESS_WEIGHT  completeness weight
                -conW, --contamination_weight CONTAMINATION_WEIGHT  contamination weight
                -strW, --strain_heterogeneity_weight STRAIN_HETEROGENEITY_WEIGHT  strain heterogeneity weight
                -N50W, --N50_weight N50_WEIGHT                weight of log(genome N50)
                -sizeW, --size_weight SIZE_WEIGHT             weight of log(genome size)
                -centW, --centrality_weight CENTRALITY_WEIGHT  weight of (centrality - S_ani)
                -extraW, --extra_weight_table EXTRA_WEIGHT_TABLE  a TSV file of genomes and extra scores to add (two columns, no header)
                --gen_warnings                                generate warnings
                --warn_dist WARN_DIST                         how far from the threshold to throw cluster warnings
                --warn_sim WARN_SIM                           similarity threshold for warnings between dereplicated genomes
                --warn_aln WARN_ALN                           minimum aligned fraction for warnings between dereplicated genomes (ANIn)
                --skip_plots                                  don't make plots
            `,
            values: #{
                "-p": "none", "--processors": "none", "-g": k("fasta"), "--genomes": k("fasta"), "-l": "none",
                "--length": "none", "-comp": "none", "--completeness": "none", "-con": "none",
                "--contamination": "none", "--genomeInfo": "files",
                "--checkM_method": ["lineage_wf", "taxonomy_wf"], "--set_recursion": "none",
                "--checkm_group_size": "none",
                "--S_algorithm": ["ANImf", "ANIn", "fastANI", "gANI", "goANI", "skani"], "-ms": "none",
                "--MASH_sketch": "none", "--skani_extra": "none", "--n_PRESET": ["normal", "tight"], "-pa": "none",
                "--P_ani": "none", "-sa": "none", "--S_ani": "none", "-nc": "none", "--cov_thresh": "none",
                "-cm": ["total", "larger"], "--coverage_method": ["total", "larger"],
                "--clusterAlg": ["average", "centroid", "complete", "median", "single", "ward", "weighted"],
                "--primary_chunksize": "none", "-comW": "none", "--completeness_weight": "none", "-conW": "none",
                "--contamination_weight": "none", "-strW": "none", "--strain_heterogeneity_weight": "none",
                "-N50W": "none", "--N50_weight": "none", "-sizeW": "none", "--size_weight": "none",
                "-centW": "none", "--centrality_weight": "none", "-extraW": "files",
                "--extra_weight_table": "files", "--warn_dist": "none", "--warn_sim": "none", "--warn_aln": "none",
            },
            args: ["dirs"],
        },
        "compare" => #{
            opts: `
                -p, --processors PROCESSORS            threads
                -d, --debug                            make extra debugging output
                -h, --help                             show this help message and exit
                -g, --genomes GENOMES                  genomes to filter in .fasta format
                --S_algorithm S_ALGORITHM              algorithm for the secondary clustering comparisons
                -ms, --MASH_sketch MASH_SKETCH         MASH sketch size
                --SkipMash                             skip MASH clustering, just do secondary clustering on all genomes
                --SkipSecondary                        skip secondary clustering, just perform MASH clustering
                --skani_extra SKANI_EXTRA              extra arguments to pass to skani triangle
                --n_PRESET NORMAL|TIGHT                presets to pass to nucmer: tight (only highly conserved regions) or normal
                -pa, --P_ani P_ANI                     ANI threshold to form primary (MASH) clusters
                -sa, --S_ani S_ANI                     ANI threshold to form secondary clusters
                -nc, --cov_thresh COV_THRESH           minimum level of overlap between genomes in the secondary comparisons
                -cm, --coverage_method TOTAL|LARGER    method to calculate coverage of an alignment
                --clusterAlg CLUSTERALG                algorithm used to cluster genomes (scipy.cluster.hierarchy.linkage)
                --low_ram_primary_clustering           use a memory-efficient algorithm for primary clustering
                --multiround_primary_clustering        cluster each primary chunk separately and merge them with single linkage
                --primary_chunksize PRIMARY_CHUNKSIZE  impacts multiround_primary_clustering
                --greedy_secondary_clustering          use a heuristic to avoid pair-wise comparisons when doing secondary clustering
                --run_tertiary_clustering              run an additional round of clustering on the final genome set
                --gen_warnings                         generate warnings
                --warn_dist WARN_DIST                  how far from the threshold to throw cluster warnings
                --warn_sim WARN_SIM                    similarity threshold for warnings between dereplicated genomes
                --warn_aln WARN_ALN                    minimum aligned fraction for warnings between dereplicated genomes (ANIn)
            `,
            values: #{
                "-p": "none", "--processors": "none", "-g": k("fasta"), "--genomes": k("fasta"),
                "--S_algorithm": ["ANImf", "ANIn", "fastANI", "gANI", "goANI", "skani"], "-ms": "none",
                "--MASH_sketch": "none", "--skani_extra": "none", "--n_PRESET": ["normal", "tight"], "-pa": "none",
                "--P_ani": "none", "-sa": "none", "--S_ani": "none", "-nc": "none", "--cov_thresh": "none",
                "-cm": ["total", "larger"], "--coverage_method": ["total", "larger"],
                "--clusterAlg": ["average", "centroid", "complete", "median", "single", "ward", "weighted"],
                "--primary_chunksize": "none", "--warn_dist": "none", "--warn_sim": "none", "--warn_aln": "none",
            },
            args: ["dirs"],
        },
        "check_dependencies" => #{
            opts: `
                -h, --help  show this help message and exit
            `,
            args: ["none"],
        },
        _ => (),
    }
}

fn vamb() {
    #{
        opts: `
            -h, --help  print help and exit
            --version   show program's version number and exit
        `,
        commands: `
            bin        VAMB and TaxVAMB binners
            taxometer  refines taxonomic annotations of any metagenome classifier
            recluster  reclustering using single-copy genes for the binning results of VAMB or TaxVAMB
        `,
        sub_spec: "@extra-complete/bio/bins:vamb",
    }
}

fn vamb_sub(sub) {
    switch sub {
        "bin" => #{
            opts: `
                -h, --help  print help and exit
                --version   show program's version number and exit
            `,
            commands: `
                default  default binner based on a variational autoencoder
                taxvamb  taxonomy informed binner based on a bi-modal variational autoencoder
            `,
            subs: #{
                "default": #{
                    opts: `
                        -h, --help                        print help and exit
                        --version                         show program's version number and exit
                        --outdir OUTDIR                   output directory to create
                        -m MINLENGTH                      ignore contigs shorter than this
                        -p NTHREADS                       number of threads to use where customizable
                        --norefcheck                      skip reference name hashing check
                        --cuda                            use GPU to train & cluster
                        --seed SEED                       random seed (determinism not guaranteed)
                        --fasta FASTA                     path to fasta file
                        --composition COMPOSITION         path to .npz of composition
                        --bamdir BAMDIR                   dir with .bam files to use
                        --abundance_tsv ABUNDANCE_TSV     TSV file of precomputed abundances, with a header: contigname and the samples
                        --abundance ABUNDANCEPATH         path to .npz of abundances
                        --minfasta MIN_FASTA_OUTPUT_SIZE  minimum bin size to output as FASTA
                        -o[=BINSPLIT_SEPARATOR]           binsplit separator
                    `,
                    values: #{
                        "--outdir": "dirs", "-m": "none", "-p": "none", "--seed": "none", "--fasta": k("fasta"),
                        "--composition": "files", "--bamdir": "dirs", "--abundance_tsv": "files",
                        "--abundance": "files", "--minfasta": "none", "-o": "none",
                    },
                    args: ["none"],
                },
                "taxvamb": #{
                    opts: `
                        -h, --help                        print help and exit
                        --version                         show program's version number and exit
                        --outdir OUTDIR                   output directory to create
                        -m MINLENGTH                      ignore contigs shorter than this
                        -p NTHREADS                       number of threads to use where customizable
                        --norefcheck                      skip reference name hashing check
                        --cuda                            use GPU to train & cluster
                        --seed SEED                       random seed (determinism not guaranteed)
                        --fasta FASTA                     path to fasta file
                        --composition COMPOSITION         path to .npz of composition
                        --bamdir BAMDIR                   dir with .bam files to use
                        --abundance_tsv ABUNDANCE_TSV     TSV file of precomputed abundances, with a header: contigname and the samples
                        --abundance ABUNDANCEPATH         path to .npz of abundances
                        --taxonomy TAXONOMY               path to the taxonomy file
                        --no_predictor                    do not complete input taxonomy with Taxometer
                        --minfasta MIN_FASTA_OUTPUT_SIZE  minimum bin size to output as FASTA
                        -o[=BINSPLIT_SEPARATOR]           binsplit separator
                    `,
                    values: #{
                        "--outdir": "dirs", "-m": "none", "-p": "none", "--seed": "none", "--fasta": k("fasta"),
                        "--composition": "files", "--bamdir": "dirs", "--abundance_tsv": "files",
                        "--abundance": "files", "--taxonomy": "files", "--minfasta": "none", "-o": "none",
                    },
                    args: ["none"],
                },
            },
        },
        "taxometer" => #{
            opts: `
                -h, --help                     print help and exit
                --version                      show program's version number and exit
                --outdir OUTDIR                output directory to create
                -m MINLENGTH                   ignore contigs shorter than this
                -p NTHREADS                    number of threads to use where customizable
                --norefcheck                   skip reference name hashing check
                --cuda                         use GPU to train & cluster
                --seed SEED                    random seed (determinism not guaranteed)
                --fasta FASTA                  path to fasta file
                --composition COMPOSITION      path to .npz of composition
                --bamdir BAMDIR                dir with .bam files to use
                --abundance_tsv ABUNDANCE_TSV  TSV file of precomputed abundances, with a header: contigname and the samples
                --abundance ABUNDANCEPATH      path to .npz of abundances
                --taxonomy TAXONOMY            path to the taxonomy file
            `,
            values: #{
                "--outdir": "dirs", "-m": "none", "-p": "none", "--seed": "none", "--fasta": k("fasta"),
                "--composition": "files", "--bamdir": "dirs", "--abundance_tsv": "files", "--abundance": "files",
                "--taxonomy": "files",
            },
            args: ["none"],
        },
        "recluster" => #{
            opts: `
                -h, --help                        print help and exit
                --version                         show program's version number and exit
                --outdir OUTDIR                   output directory to create
                -m MINLENGTH                      ignore contigs shorter than this
                -p NTHREADS                       number of threads to use where customizable
                --norefcheck                      skip reference name hashing check
                --cuda                            use GPU to train & cluster
                --seed SEED                       random seed (determinism not guaranteed)
                --fasta FASTA                     path to fasta file
                --composition COMPOSITION         path to .npz of composition
                --bamdir BAMDIR                   dir with .bam files to use
                --abundance_tsv ABUNDANCE_TSV     TSV file of precomputed abundances, with a header: contigname and the samples
                --abundance ABUNDANCEPATH         path to .npz of abundances
                --markers MARKERS                 path to the marker .npz file
                --hmm_path HMM_PATH               path to the .hmm file of marker gene profiles
                --minfasta MIN_FASTA_OUTPUT_SIZE  minimum bin size to output as FASTA
                -o[=BINSPLIT_SEPARATOR]           binsplit separator
                --latent_path LATENT_PATH         path to latent space .npz file
                --clusters_path CLUSTERS_PATH     path to TSV file with clusters
                --algorithm KMEANS|DBSCAN         which reclustering algorithm to use ('kmeans', 'dbscan')
                --taxonomy TAXONOMY               path to the taxonomy file
                --no_predictor                    do not complete input taxonomy with Taxometer
            `,
            values: #{
                "--outdir": "dirs", "-m": "none", "-p": "none", "--seed": "none", "--fasta": k("fasta"),
                "--composition": "files", "--bamdir": "dirs", "--abundance_tsv": "files", "--abundance": "files",
                "--markers": "files", "--hmm_path": k("hmm"), "--minfasta": "none", "-o": "none",
                "--latent_path": "files", "--clusters_path": "files", "--algorithm": ["kmeans", "dbscan"],
                "--taxonomy": "files",
            },
            args: ["none"],
        },
        _ => (),
    }
}

