// Binning of metagenomes, and the quality, taxonomy and dereplication of the
// genomes that come out of it: checkm, checkm2, gunc, gtdbtk, metabat2 (with
// jgi_summarize_bam_contig_depths), concoct (with its scripts), MaxBin
// (run_MaxBin.pl), DAS Tool, dRep, coverm and vamb. Generated by
// scripts/gen/mk_bins.py from the tools' own `--help` or argparse parser
// (versions in completion-todo.md).

fn k(name) { "@extra-complete/bio/kinds:" + name }

fn checkm() {
    #{
        opts: `
            -h, --help  show the commands
        `,
        commands: `
            data          set the CheckM data directory: checkm data setRoot DIR
            tree          place bins in the reference genome tree
            tree_qa       assess phylogenetic markers found in each bin
            lineage_set   infer lineage-specific marker sets for each bin
            taxon_list    list available taxonomic-specific marker sets
            taxon_set     generate taxonomic-specific marker set
            analyze       identify marker genes in bins
            qa            assess bins for contamination and completeness
            lineage_wf    runs tree, lineage_set, analyze, qa
            taxonomy_wf   runs taxon_set, analyze, qa
            gc_plot       create GC histogram and delta-GC plot
            coding_plot   create coding density (CD) histogram and delta-CD plot
            tetra_plot    create tetranucleotide distance (TD) histogram and delta-TD plot
            dist_plot     create image with GC, CD, and TD distribution plots together
            gc_bias_plot  plot bin coverage as a function of GC
            nx_plot       create Nx-plots
            len_hist      sequence length histogram
            marker_plot   plot position of marker genes on sequences
            unbinned      identify unbinned sequences
            coverage      calculate coverage of sequences
            tetra         calculate tetranucleotide signature of sequences
            profile       calculate percentage of reads mapped to each bin
            ssu_finder    identify SSU (16S/18S) rRNAs in sequences
            merge         identify bins with complementary sets of marker genes
            outliers      identify outlier in bins relative to reference distributions (experimental)
            modify        modify sequences in a bin (experimental)
            unique        ensure no sequences are assigned to multiple bins
            test          run CheckM on a test genome
        `,
        sub_spec: "@extra-complete/bio/bins:checkm",
    }
}

fn checkm_sub(sub) {
    switch sub {
        "data" => #{
            opts: `
                -h, --help  show this help message and exit
            `,
            args: [["setRoot"], "dirs"],
        },
        "tree" => #{
            opts: `
                -h, --help                         show this help message and exit
                -r, --reduced_tree                 use reduced tree (requires <16GB of memory) for determining lineage of each bin
                --ali                              generate HMMER alignment file for each bin
                --nt                               generate nucleotide gene sequences for each bin
                -g, --genes                        bins contain genes as amino acids instead of nucleotide contigs
                -x, --extension EXTENSION          extension of bins (other files in directory are ignored)
                -t, --threads THREADS              number of threads
                --pplacer_threads PPLACER_THREADS  number of threads used by pplacer
                -q, --quiet                        suppress console output
                --tmpdir TMPDIR                    specify an alternative directory for temporary files
            `,
            values: #{
                "-x": "none", "--extension": "none", "-t": "none", "--threads": "none",
                "--pplacer_threads": "none", "--tmpdir": "dirs",
            },
            args: ["files", "dirs"],
        },
        "tree_qa" => #{
            opts: `
                -h, --help                  show this help message and exit
                -o, --out_format 1|2|3|4|5  output format: 1, 2, 3, 4, 5 (see checkm tree_qa -h)
                -f, --file FILE             print results to file
                --tab_table                 print tab-separated values table
                -q, --quiet                 suppress console output
                --tmpdir TMPDIR             specify an alternative directory for temporary files
            `,
            values: #{
                "-o": ["1", "2", "3", "4", "5"], "--out_format": ["1", "2", "3", "4", "5"], "-f": "files",
                "--file": "files", "--tmpdir": "dirs",
            },
            args: ["dirs"],
        },
        "lineage_set" => #{
            opts: `
                -h, --help           show this help message and exit
                -u, --unique UNIQUE  minimum number of unique phylogenetic markers required to use lineage-specific marker set
                -m, --multi MULTI    maximum number of multi-copy phylogenetic markers before defaulting to domain-level
                --force_domain       use domain-level sets for all bins
                --no_refinement      do not perform lineage-specific marker set refinement
                -q, --quiet          suppress console output
                --tmpdir TMPDIR      specify an alternative directory for temporary files
            `,
            values: #{
                "-u": "none", "--unique": "none", "-m": "none", "--multi": "none", "--tmpdir": "dirs",
            },
            args: ["dirs", "files"],
        },
        "taxon_list" => #{
            opts: `
                -h, --help       show this help message and exit
                --rank RANK      restrict list to specified taxonomic rank
                --tmpdir TMPDIR  specify an alternative directory for temporary files
            `,
            values: #{
                "--rank": ["ALL", "life", "domain", "phylum", "class", "order", "family", "genus", "species"],
                "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "taxon_set" => #{
            opts: `
                -h, --help       show this help message and exit
                -q, --quiet      suppress console output
                --tmpdir TMPDIR  specify an alternative directory for temporary files
            `,
            values: #{
                "--tmpdir": "dirs",
            },
            args: [["life", "domain", "phylum", "class", "order", "family", "genus", "species"], "none", "files"],
        },
        "analyze" => #{
            opts: `
                -h, --help                 show this help message and exit
                --ali                      generate HMMER alignment file for each bin
                --nt                       generate nucleotide gene sequences for each bin
                -g, --genes                bins contain genes as amino acids instead of nucleotide contigs
                -x, --extension EXTENSION  extension of bins (other files in directory are ignored)
                -t, --threads THREADS      number of threads
                -q, --quiet                suppress console output
                --tmpdir TMPDIR            specify an alternative directory for temporary files
            `,
            values: #{
                "-x": "none", "--extension": "none", "-t": "none", "--threads": "none", "--tmpdir": "dirs",
            },
            args: ["files", "files", "dirs"],
        },
        "qa" => #{
            opts: `
                -h, --help                           show this help message and exit
                -o, --out_format 1|2|3|4|5|6|7|8|9   output format: 1, 2, 3, 4, 5, 6, 7, 8, 9 (see checkm qa -h)
                --exclude_markers EXCLUDE_MARKERS    file specifying markers to exclude from marker sets
                --individual_markers                 treat marker as independent (i.e, ignore co-located set structure)
                --skip_adj_correction                do not exclude adjacent marker genes when estimating contamination
                --skip_pseudogene_correction         skip identification and filtering of pseudogenes
                --aai_strain AAI_STRAIN              AAI threshold used to identify strain heterogeneity
                -a, --alignment_file ALIGNMENT_FILE  produce file showing alignment of multi-copy genes and their AAI identity
                --ignore_thresholds                  ignore model-specific score thresholds
                -e, --e_value E_VALUE                e-value cut off
                -l, --length LENGTH                  percent overlap between target and query
                -c, --coverage_file COVERAGE_FILE    file containing coverage of each sequence; coverage information added to table type 2
                -f, --file FILE                      print results to file
                --tab_table                          print tab-separated values table
                -t, --threads THREADS                number of threads
                -q, --quiet                          suppress console output
                --tmpdir TMPDIR                      specify an alternative directory for temporary files
            `,
            values: #{
                "-o": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
                "--out_format": ["1", "2", "3", "4", "5", "6", "7", "8", "9"], "--exclude_markers": "files",
                "--aai_strain": "none", "-a": "files", "--alignment_file": "files", "-e": "none",
                "--e_value": "none", "-l": "none", "--length": "none", "-c": "files", "--coverage_file": "files",
                "-f": "files", "--file": "files", "-t": "none", "--threads": "none", "--tmpdir": "dirs",
            },
            args: ["files", "dirs"],
        },
        "lineage_wf" => #{
            opts: `
                -h, --help                           show this help message and exit
                -r, --reduced_tree                   use reduced tree (requires <16GB of memory) for determining lineage of each bin
                --ali                                generate HMMER alignment file for each bin
                --nt                                 generate nucleotide gene sequences for each bin
                -g, --genes                          bins contain genes as amino acids instead of nucleotide contigs
                -u, --unique UNIQUE                  minimum number of unique phylogenetic markers required to use lineage-specific marker set
                -m, --multi MULTI                    maximum number of multi-copy phylogenetic markers before defaulting to domain-level
                --force_domain                       use domain-level sets for all bins
                --no_refinement                      do not perform lineage-specific marker set refinement
                --individual_markers                 treat marker as independent (i.e, ignore co-located set structure)
                --skip_adj_correction                do not exclude adjacent marker genes when estimating contamination
                --skip_pseudogene_correction         skip identification and filtering of pseudogenes
                --aai_strain AAI_STRAIN              AAI threshold used to identify strain heterogeneity
                -a, --alignment_file ALIGNMENT_FILE  produce file showing alignment of multi-copy genes and their AAI identity
                --ignore_thresholds                  ignore model-specific score thresholds
                -e, --e_value E_VALUE                e-value cut off
                -l, --length LENGTH                  percent overlap between target and query
                -f, --file FILE                      print results to file
                --tab_table                          print tab-separated values table
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                -t, --threads THREADS                number of threads
                --pplacer_threads PPLACER_THREADS    number of threads used by pplacer
                -q, --quiet                          suppress console output
                --tmpdir TMPDIR                      specify an alternative directory for temporary files
            `,
            values: #{
                "-u": "none", "--unique": "none", "-m": "none", "--multi": "none", "--aai_strain": "none",
                "-a": "files", "--alignment_file": "files", "-e": "none", "--e_value": "none", "-l": "none",
                "--length": "none", "-f": "files", "--file": "files", "-x": "none", "--extension": "none",
                "-t": "none", "--threads": "none", "--pplacer_threads": "none", "--tmpdir": "dirs",
            },
            args: ["files", "dirs"],
        },
        "taxonomy_wf" => #{
            opts: `
                -h, --help                           show this help message and exit
                --ali                                generate HMMER alignment file for each bin
                --nt                                 generate nucleotide gene sequences for each bin
                -g, --genes                          bins contain genes as amino acids instead of nucleotide contigs
                --individual_markers                 treat marker as independent (i.e, ignore co-located set structure)
                --skip_adj_correction                do not exclude adjacent marker genes when estimating contamination
                --skip_pseudogene_correction         skip identification and filtering of pseudogenes
                --aai_strain AAI_STRAIN              AAI threshold used to identify strain heterogeneity
                -a, --alignment_file ALIGNMENT_FILE  produce file showing alignment of multi-copy genes and their AAI identity
                --ignore_thresholds                  ignore model-specific score thresholds
                -e, --e_value E_VALUE                e-value cut off
                -l, --length LENGTH                  percent overlap between target and query
                -c, --coverage_file COVERAGE_FILE    file containing coverage of each sequence; coverage information added to table type 2
                -f, --file FILE                      print results to file
                --tab_table                          print tab-separated values table
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                -t, --threads THREADS                number of threads
                -q, --quiet                          suppress console output
                --tmpdir TMPDIR                      specify an alternative directory for temporary files
            `,
            values: #{
                "--aai_strain": "none", "-a": "files", "--alignment_file": "files", "-e": "none",
                "--e_value": "none", "-l": "none", "--length": "none", "-c": "files", "--coverage_file": "files",
                "-f": "files", "--file": "files", "-x": "none", "--extension": "none", "-t": "none",
                "--threads": "none", "--tmpdir": "dirs",
            },
            args: [["life", "domain", "phylum", "class", "order", "family", "genus", "species"], "none", "files", "dirs"],
        },
        "gc_plot" => #{
            opts: `
                -h, --help                           show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG      desired image type
                --dpi DPI                            desired DPI of output image
                --font_size FONT_SIZE                desired font size
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                --width WIDTH                        width of output image
                --height HEIGHT                      height of output image
                -w, --gc_window_size GC_WINDOW_SIZE  window size used to calculate GC histogram
                -b, --gc_bin_width GC_BIN_WIDTH      width of GC bars in histogram
                -q, --quiet                          suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-w": "none",
                "--gc_window_size": "none", "-b": "none", "--gc_bin_width": "none",
            },
            args: ["files", "dirs", "none"],
        },
        "coding_plot" => #{
            opts: `
                -h, --help                           show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG      desired image type
                --dpi DPI                            desired DPI of output image
                --font_size FONT_SIZE                desired font size
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                --width WIDTH                        width of output image
                --height HEIGHT                      height of output image
                -w, --cd_window_size CD_WINDOW_SIZE  window size used to calculate CD histogram
                -b, --cd_bin_width CD_BIN_WIDTH      width of CD bars in histogram
                -q, --quiet                          suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-w": "none",
                "--cd_window_size": "none", "-b": "none", "--cd_bin_width": "none",
            },
            args: ["dirs", "files", "dirs", "none"],
        },
        "tetra_plot" => #{
            opts: `
                -h, --help                           show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG      desired image type
                --dpi DPI                            desired DPI of output image
                --font_size FONT_SIZE                desired font size
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                --width WIDTH                        width of output image
                --height HEIGHT                      height of output image
                -w, --td_window_size TD_WINDOW_SIZE  window size used to calculate TD histogram
                -b, --td_bin_width TD_BIN_WIDTH      width of TD bars in histogram
                -q, --quiet                          suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-w": "none",
                "--td_window_size": "none", "-b": "none", "--td_bin_width": "none",
            },
            args: ["dirs", "files", "dirs", "files", "none"],
        },
        "dist_plot" => #{
            opts: `
                -h, --help                           show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG      desired image type
                --dpi DPI                            desired DPI of output image
                --font_size FONT_SIZE                desired font size
                -x, --extension EXTENSION            extension of bins (other files in directory are ignored)
                --width WIDTH                        width of output image
                --height HEIGHT                      height of output image
                -a, --gc_window_size GC_WINDOW_SIZE  window size used to calculate GC histogram
                -b, --td_window_size TD_WINDOW_SIZE  window size used to calculate TD histogram
                -c, --cd_window_size CD_WINDOW_SIZE  window size used to calculate CD histogram
                -1, --gc_bin_width GC_BIN_WIDTH      width of GC bars in histogram
                -2, --td_bin_width TD_BIN_WIDTH      width of TD bars in histogram
                -3, --cd_bin_width CD_BIN_WIDTH      width of CD bars in histogram
                -q, --quiet                          suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-a": "none",
                "--gc_window_size": "none", "-b": "none", "--td_window_size": "none", "-c": "none",
                "--cd_window_size": "none", "-1": "none", "--gc_bin_width": "none", "-2": "none",
                "--td_bin_width": "none", "-3": "none", "--cd_bin_width": "none",
            },
            args: ["dirs", "files", "dirs", "files", "none"],
        },
        "gc_bias_plot" => #{
            opts: `
                -h, --help                         show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG    desired image type
                --dpi DPI                          desired DPI of output image
                --font_size FONT_SIZE              desired font size
                -x, --extension EXTENSION          extension of bins (other files in directory are ignored)
                --width WIDTH                      width of output image
                --height HEIGHT                    height of output image
                -w, --window_size WINDOW_SIZE      window size used to calculate plot statistics
                -r, --all_reads                    use all reads to estimate coverage instead of just those in proper pairs
                -a, --min_align MIN_ALIGN          minimum alignment length as percentage of read length
                -e, --max_edit_dist MAX_EDIT_DIST  maximum edit distance as percentage of read length
                -t, --threads THREADS              number of threads
                -q, --quiet                        suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-w": "none",
                "--window_size": "none", "-a": "none", "--min_align": "none", "-e": "none",
                "--max_edit_dist": "none", "-t": "none", "--threads": "none",
            },
            args: ["files", "dirs", k("bam")],
        },
        "nx_plot" => #{
            opts: `
                -h, --help                       show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG  desired image type
                --dpi DPI                        desired DPI of output image
                --font_size FONT_SIZE            desired font size
                -x, --extension EXTENSION        extension of bins (other files in directory are ignored)
                --width WIDTH                    width of output image
                --height HEIGHT                  height of output image
                -s, --step_size STEP_SIZE        x step size for calculating Nx
                -q, --quiet                      suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none", "-s": "none",
                "--step_size": "none",
            },
            args: ["files", "dirs"],
        },
        "len_hist" => #{
            opts: `
                -h, --help                       show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG  desired image type
                --dpi DPI                        desired DPI of output image
                --font_size FONT_SIZE            desired font size
                -x, --extension EXTENSION        extension of bins (other files in directory are ignored)
                --width WIDTH                    width of output image
                --height HEIGHT                  height of output image
                -q, --quiet                      suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none",
            },
            args: ["files", "dirs"],
        },
        "marker_plot" => #{
            opts: `
                -h, --help                       show this help message and exit
                --image_type EPS|PDF|PNG|PS|SVG  desired image type
                --dpi DPI                        desired DPI of output image
                --font_size FONT_SIZE            desired font size
                -x, --extension EXTENSION        extension of bins (other files in directory are ignored)
                --width WIDTH                    width of output image
                --height HEIGHT                  height of output image
                --fig_padding FIG_PADDING        white space to place around figure (in inches)
                -q, --quiet                      suppress console output
            `,
            values: #{
                "--image_type": ["eps", "pdf", "png", "ps", "svg"], "--dpi": "none", "--font_size": "none",
                "-x": "none", "--extension": "none", "--width": "none", "--height": "none",
                "--fig_padding": "none",
            },
            args: ["dirs", "files", "dirs"],
        },
        "unbinned" => #{
            opts: `
                -h, --help                     show this help message and exit
                -x, --extension EXTENSION      extension of bins (other files in directory are ignored)
                -s, --min_seq_len MIN_SEQ_LEN  required length of sequence
                -q, --quiet                    suppress console output
            `,
            values: #{
                "-x": "none", "--extension": "none", "-s": "none", "--min_seq_len": "none",
            },
            args: ["files", k("fasta"), "files", "files"],
        },
        "coverage" => #{
            opts: `
                -h, --help                         show this help message and exit
                -x, --extension EXTENSION          extension of bins (other files in directory are ignored)
                -r, --all_reads                    use all reads to estimate coverage instead of just those in proper pairs
                -a, --min_align MIN_ALIGN          minimum alignment length as percentage of read length
                -e, --max_edit_dist MAX_EDIT_DIST  maximum edit distance as percentage of read length
                -m, --min_qc MIN_QC                minimum quality score (in phred)
                -t, --threads THREADS              number of threads
                -q, --quiet                        suppress console output
            `,
            values: #{
                "-x": "none", "--extension": "none", "-a": "none", "--min_align": "none", "-e": "none",
                "--max_edit_dist": "none", "-m": "none", "--min_qc": "none", "-t": "none", "--threads": "none",
            },
            args: ["files", "files", k("bam")],
        },
        "tetra" => #{
            opts: `
                -h, --help             show this help message and exit
                -t, --threads THREADS  number of threads
                -q, --quiet            suppress console output
            `,
            values: #{
                "-t": "none", "--threads": "none",
            },
            args: [k("fasta"), "files"],
        },
        "profile" => #{
            opts: `
                -h, --help       show this help message and exit
                -f, --file FILE  print results to file
                --tab_table      print tab-separated values table
                -q, --quiet      suppress console output
            `,
            values: #{
                "-f": "files", "--file": "files",
            },
            args: ["files"],
        },
        "ssu_finder" => #{
            opts: `
                -h, --help                     show this help message and exit
                -x, --extension EXTENSION      extension of bins (other files in directory are ignored)
                -e, --evalue EVALUE            e-value threshold for identifying hits
                -c, --concatenate CONCATENATE  concatenate hits that are within the specified number of base pairs
                -t, --threads THREADS          number of threads
                -q, --quiet                    suppress console output
            `,
            values: #{
                "-x": "none", "--extension": "none", "-e": "none", "--evalue": "none", "-c": "none",
                "--concatenate": "none", "-t": "none", "--threads": "none",
            },
            args: [k("fasta"), "files", "dirs"],
        },
        "merge" => #{
            opts: `
                -h, --help                 show this help message and exit
                -g, --genes                bins contain genes as amino acids instead of nucleotide contigs
                --delta_comp DELTA_COMP    minimum increase in completeness to report pair
                --delta_cont DELTA_CONT    maximum increase in contamination to report pair
                --merged_comp MERGED_COMP  minimum merged completeness to report pair
                --merged_cont MERGED_CONT  maximum merged contamination to report pair
                -x, --extension EXTENSION  extension of bins (other files in directory are ignored)
                -t, --threads THREADS      number of threads
                -q, --quiet                suppress console output
            `,
            values: #{
                "--delta_comp": "none", "--delta_cont": "none", "--merged_comp": "none", "--merged_cont": "none",
                "-x": "none", "--extension": "none", "-t": "none", "--threads": "none",
            },
            args: ["files", "files", "dirs"],
        },
        "outliers" => #{
            opts: `
                -h, --help                      show this help message and exit
                -d, --distributions DIST_VALUE  reference distribution used to identify outliers; integer between 0 and 100
                -r, --report_type ANY|ALL       report sequences that are outliers in 'all' or 'any' reference distribution
                -x, --extension EXTENSION       extension of bins (other files in directory are ignored)
                -q, --quiet                     suppress console output
            `,
            values: #{
                "-d": "none", "--distributions": "none", "-r": ["any", "all"], "--report_type": ["any", "all"],
                "-x": "none", "--extension": "none",
            },
            args: ["dirs", "files", "files", "files"],
        },
        "modify" => #{
            opts: `
                -h, --help                       show this help message and exit
                -a, --add ADD                    ID of sequence to add to bin (may specify multiple times)
                -r, --remove REMOVE              ID of sequence to remove from bin (may specify multiple times)
                -o, --outlier_file OUTLIER_FILE  remove all sequences marked as outliers in the bin (see outlier command)
                -q, --quiet                      suppress console output
            `,
            values: #{
                "-a": "none", "--add": "none", "-r": "none", "--remove": "none", "-o": "files",
                "--outlier_file": "files",
            },
            args: [k("fasta"), k("fasta"), "files"],
        },
        "unique" => #{
            opts: `
                -h, --help                 show this help message and exit
                -x, --extension EXTENSION  extension of bins (all other files in bin directory are ignored)
            `,
            values: #{
                "-x": "none", "--extension": "none",
            },
            args: ["files"],
        },
        "test" => #{
            opts: `
                -h, --help       show this help message and exit
                --tmpdir TMPDIR  specify an alternative directory for temporary files
            `,
            values: #{
                "--tmpdir": "dirs",
            },
            args: ["dirs"],
        },
        _ => (),
    }
}

fn checkm2() {
    #{
        opts: `
            -h, --help  show this help message and exit
            --debug     output debug information
            --version   output version information and quit
            --quiet     only output errors
            --lowmem    low memory mode
        `,
        commands: `
            predict   predict the completeness and contamination of genome bins in a folder
            testrun   runs Checkm2 on internal test genomes to ensure it runs without errors
            database  download/set up required diamond database for CheckM2
        `,
        sub_spec: "@extra-complete/bio/bins:checkm2",
    }
}

fn checkm2_sub(sub) {
    switch sub {
        "predict" => #{
            opts: `
                -h, --help                                    show this help message and exit
                --debug                                       output debug information
                --version                                     output version information and quit
                --quiet                                       only output errors
                --lowmem                                      low memory mode
                -i, --input INPUT                             folder of MAGs, or list of MAGs, to analyze
                -o, --output-directory, --output_directory OUTPUT_DIRECTORY  output folder
                --general                                     force the use of the general quality prediction model (gradient boost)
                --specific                                    force the use of the specific quality prediction model (neural network)
                --allmodels                                   output quality prediction for both models for each genome
                --genes                                       treat input files as protein files
                -x, --extension EXTENSION                     extension of input files
                --tmpdir TMPDIR                               specify an alternative directory for temporary files
                --force                                       overwrite output directory
                --resume                                      reuse Prodigal and DIAMOND results found in output directory
                -t, --threads NUM_THREADS                     number of CPUS to use
                --stdout                                      print results to stdout
                --remove_intermediates                        remove all intermediate files (protein files, diamond output)
                --ttable TTABLE                               provide a specific progidal translation table for bins
                --database_path DATABASE_PATH                 provide a location for the CheckM2 database for a given predict run
                --dbg_cos                                     DEBUG: write cosine similarity values to file
                --dbg_vectors                                 DEBUG: dump pickled feature vectors to file
            `,
            values: #{
                "-i": "files", "--input": "files", "-o": "dirs", "--output-directory": "dirs",
                "--output_directory": "dirs", "-x": "none", "--extension": "none", "--tmpdir": "dirs",
                "-t": "none", "--threads": "none", "--ttable": "none", "--database_path": k("diamond_db"),
            },
            args: ["none"],
        },
        "testrun" => #{
            opts: `
                -h, --help                     show this help message and exit
                --debug                        output debug information
                --version                      output version information and quit
                --quiet                        only output errors
                --lowmem                       low memory mode
                -t, --threads NUM_THREADS      number of CPUS to use
                --database_path DATABASE_PATH  provide a location for the CheckM2 database for a given predict run
            `,
            values: #{
                "-t": "none", "--threads": "none", "--database_path": k("diamond_db"),
            },
            args: ["none"],
        },
        "database" => #{
            opts: `
                -h, --help                     show this help message and exit
                --debug                        output debug information
                --version                      output version information and quit
                --quiet                        only output errors
                --lowmem                       low memory mode
                --download                     download the DIAMOND database
                --setdblocation SETDBLOCATION  point CheckM2 to the DIAMOND database location if already downloaded
                --current                      print where current database is installed
                --path PATH                    custom path for downloading and installing database file
                --no_write_json_db             don't write the database path to the internal JSON file
            `,
            values: #{
                "--setdblocation": k("diamond_db"), "--path": "dirs",
            },
            args: ["none"],
        },
        _ => (),
    }
}

fn gunc() {
    #{
        opts: `
            -h, --help     show this help message and exit
            -v, --version  print version number and exit
        `,
        commands: `
            run                 run chimerism detection
            download_db         download GUNC db
            merge_checkm        merge GUNC and CheckM outputs
            plot                create interactive visualisation
            summarise, rescore  re-score genomes using a different contamination cutoff
            check               validate environment and input files before running
        `,
        sub_spec: "@extra-complete/bio/bins:gunc",
    }
}

fn gunc_sub(sub) {
    switch sub {
        "run" => #{
            opts: `
                -h, --help                                    show this help message and exit
                -r, --db_file DB_FILE                         DIAMOND database
                --custom_genome2taxonomy CUSTOM_GENOME2TAXONOMY  if using a custom DB, use this to provide taxonomy of genomes in the custom DB
                -i, --input_fasta INPUT_FASTA                 input file in FASTA format
                -f, --input_file INPUT_FILE                   file with paths to FASTA format files
                -d, --input_dir INPUT_DIR                     input dir with files in FASTA format
                -e, --file_suffix FILE_SUFFIX                 suffix of files in input_dir
                -g, --gene_calls                              input files are FASTA faa format
                -t, --threads THREADS                         number of CPU threads
                -o, --out_dir OUT_DIR                         output dir
                --temp_dir TEMP_DIR                           directory to store temp files
                --sensitive                                   run with high sensitivity
                --detailed_output                             output scores for every taxlevel
                --contig_taxonomy_output                      output assignments for each contig
                --use_species_level                           allow species level to be picked as maxCSS
                --min_mapped_genes MIN_MAPPED_GENES           don't calculate GUNC score if number of mapped genes is below this value
                -v, --verbose                                 verbose output for debugging
            `,
            values: #{
                "-r": k("diamond_db"), "--db_file": k("diamond_db"), "--custom_genome2taxonomy": "files",
                "-i": k("fasta"), "--input_fasta": k("fasta"), "-f": "files", "--input_file": "files",
                "-d": "dirs", "--input_dir": "dirs", "-e": "none", "--file_suffix": "none", "-t": "none",
                "--threads": "none", "-o": "dirs", "--out_dir": "dirs", "--temp_dir": "dirs",
                "--min_mapped_genes": "none",
            },
            args: ["none"],
        },
        "download_db" => #{
            opts: `
                -h, --help                show this help message and exit
                -db, --database DATABASE  database to download: progenomes_2.1, gtdb_95, gtdb_214
                -v, --verbose             verbose output for debugging
            `,
            values: #{
                "-db": ["progenomes_2.1", "gtdb_95", "gtdb_214"],
                "--database": ["progenomes_2.1", "gtdb_95", "gtdb_214"],
            },
            args: ["dirs"],
        },
        "merge_checkm" => #{
            opts: `
                -h, --help                     show this help message and exit
                -g, --gunc_file GUNC_FILE      path of GUNC.maxCSS_level.tsv file
                -c, --checkm_file CHECKM_FILE  checkM qa output file
                -o, --out_dir OUT_DIR          output directory for merged file
                -v, --verbose                  verbose output for debugging
            `,
            values: #{
                "-g": "files", "--gunc_file": "files", "-c": "files", "--checkm_file": "files", "-o": "dirs",
                "--out_dir": "dirs",
            },
            args: ["none"],
        },
        "plot" => #{
            opts: `
                -h, --help                                    show this help message and exit
                -d, --diamond_file DIAMOND_FILE               GUNC diamond outputfile
                -g, --gunc_gene_count_file GUNC_GENE_COUNT_FILE  GUNC gene_counts.json file
                -o, --out_dir OUT_DIR                         output directory
                -t, --tax_levels TAX_LEVELS                   tax levels to display (comma-separated)
                -r, --remove_minor_clade_level REMOVE_MINOR_CLADE_LEVEL  tax level at which to remove minor clades
                -c, --contig_display_num CONTIG_DISPLAY_NUM   number of contigs to visualise
                -l, --contig_display_list CONTIG_DISPLAY_LIST  comma-separated list of contig names to plot
                -v, --verbose                                 verbose output for debugging
            `,
            values: #{
                "-d": "files", "--diamond_file": "files", "-g": "files", "--gunc_gene_count_file": "files",
                "-o": "dirs", "--out_dir": "dirs", "-t": "none", "--tax_levels": "none", "-r": "none",
                "--remove_minor_clade_level": "none", "-c": "none", "--contig_display_num": "none", "-l": "none",
                "--contig_display_list": "none",
            },
            args: ["none"],
        },
        "summarise" | "rescore" => #{
            opts: `
                -h, --help                          show this help message and exit
                -m, --max_csslevel_file FILE        maxCSS output file from GUNC (e.g GUNC.progenomes_2.1.maxCSS_level.tsv)
                -d, --gunc_detailed_output_dir DIR  GUNC detailed output dir (e.g gunc_output)
                -c, --contamination_cutoff FLOAT    alternative cutoff to use
                -o, --output_file FILE              file in which to write output with rescored pass.GUNC column
                -v, --verbose                       verbose output for debugging
            `,
            values: #{
                "-m": "files", "--max_csslevel_file": "files", "-d": "dirs", "--gunc_detailed_output_dir": "dirs",
                "-c": "none", "--contamination_cutoff": "none", "-o": "files", "--output_file": "files",
            },
            args: ["none"],
        },
        "check" => #{
            opts: `
                -h, --help                     show this help message and exit
                -r, --db_file FILE             DIAMOND database
                --custom_genome2taxonomy FILE  custom genome-to-taxonomy TSV file to validate
                -o, --out_dir DIR              output directory to check for write access
                -v, --verbose                  verbose output for debugging
            `,
            values: #{
                "-r": k("diamond_db"), "--db_file": k("diamond_db"), "--custom_genome2taxonomy": "files",
                "-o": "dirs", "--out_dir": "dirs",
            },
            args: ["none"],
        },
        _ => (),
    }
}

fn gtdbtk() {
    #{
        opts: `
            -h, --help     show the commands
            -v, --version  show the version
        `,
        commands: `
            de_novo_wf          infer de novo tree and decorate with GTDB taxonomy
            classify_wf         classify genomes by placement in GTDB reference tree
            identify            identify marker genes in genome
            align               create multiple sequence alignment
            infer               infer tree from multiple sequence alignment
            classify            determine taxonomic classification of genomes
            root                root tree using an outgroup
            decorate            decorate tree with GTDB taxonomy
            infer_ranks         establish taxonomic ranks of internal nodes using RED
            ani_rep             calculates ANI to GTDB representative genomes
            test                validate the classify_wf pipeline with 3 archaeal genomes
            trim_msa            trim an untrimmed MSA file based on a mask
            remove_labels       remove labels (bootstrap values, node labels) from an Newick tree
            convert_to_itol     convert a GTDB-Tk Newick tree to an iTOL tree
            convert_to_species  convert GTDB genome IDs to GTDB species names
            export_msa          export the untrimmed archaeal or bacterial MSA file
            check_install       verify third party programs and GTDB reference package
        `,
        sub_spec: "@extra-complete/bio/bins:gtdbtk",
    }
}

fn gtdbtk_sub(sub) {
    switch sub {
        "de_novo_wf" => #{
            opts: `
                --genome_dir GENOME_DIR                       directory containing genome files in FASTA format
                --batchfile BATCHFILE                         file describing genomes: tab separated, the FASTA file, the genome ID and its translation
                --bacteria                                    process bacterial genomes
                --archaea                                     process archaeal genomes
                --outgroup_taxon OUTGROUP_TAXON               taxon to use as outgroup (e.g p__Patescibacteriota)
                --out_dir OUT_DIR                             directory to output files
                -x, --extension EXTENSION                     extension of the files to process (gz: gzipped)
                --skip_gtdb_refs                              do not include GTDB reference genomes in multiple sequence alignment
                --taxa_filter TAXA_FILTER                     filter GTDB genomes to taxa (comma separated) within specific taxonomic groups
                --min_perc_aa MIN_PERC_AA                     exclude genomes that do not have at least this percentage of AA in the MSA
                --custom_msa_filters                          custom filtering of the MSA with --cols_per_gene, --min_consensus,
                --cols_per_gene COLS_PER_GENE                 maximum number of columns to retain per gene when generating the MSA
                --min_consensus MIN_CONSENSUS                 minimum percentage of the same amino acid required to retain column (inclusive bound)
                --max_consensus MAX_CONSENSUS                 maximum percentage of the same amino acid required to retain column (exclusive bound)
                --min_perc_taxa MIN_PERC_TAXA                 minimum percentage of taxa required to retain column (inclusive bound)
                --rnd_seed RND_SEED                           random seed to use for selecting columns
                --prot_model JTT|WAG|LG                       protein substitution model for tree inference
                --no_support                                  do not compute local support values using the Shimodaira-Hasegawa test
                --gamma                                       rescale branch lengths to optimize the Gamma20 likelihood
                --gtdbtk_classification_file GTDBTK_CLASSIFICATION_FILE  file with GTDB-Tk classifications produced by the 'classify' command
                --custom_taxonomy_file CUSTOM_TAXONOMY_FILE   file of custom taxonomy strings for the user genomes
                --write_single_copy_genes                     output unaligned single-copy marker genes
                --prefix PREFIX                               prefix for all output files
                --genes                                       indicates input files contain predicted proteins as amino acids
                --cpus CPUS                                   number of CPUs to use
                --force                                       continue processing if an error occurs on a single genome
                --tmpdir TMPDIR                               specify alternative directory for temporary files
                --keep_intermediates                          keep intermediate files in the final directory
                --debug                                       create intermediate files for debugging purposes
                -h, --help                                    show help message
            `,
            values: #{
                "--genome_dir": "dirs", "--batchfile": "files", "--outgroup_taxon": "none", "--out_dir": "dirs",
                "-x": "none", "--extension": "none", "--taxa_filter": "none", "--min_perc_aa": "none",
                "--cols_per_gene": "none", "--min_consensus": "none", "--max_consensus": "none",
                "--min_perc_taxa": "none", "--rnd_seed": "none", "--prot_model": ["JTT", "WAG", "LG"],
                "--gtdbtk_classification_file": "files", "--custom_taxonomy_file": "files", "--prefix": "none",
                "--cpus": "none", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "classify_wf" => #{
            opts: `
                --genome_dir GENOME_DIR      directory containing genome files in FASTA format
                --batchfile BATCHFILE        file describing genomes: tab separated, the FASTA file, the genome ID and its translation
                --out_dir OUT_DIR            directory to output files
                --place_species              place species in pplacer trees even if they are classified with skani
                -f, --full_tree              use the unsplit bacterial tree for the classify step (the original GTDB-Tk approach)
                -x, --extension EXTENSION    extension of the files to process (gz: gzipped)
                --min_perc_aa MIN_PERC_AA    exclude genomes that do not have at least this percentage of AA in the MSA
                --prefix PREFIX              prefix for all output files
                --genes                      indicates input files contain predicted proteins as amino acids
                --cpus CPUS                  number of CPUs to use
                --pplacer_cpus PPLACER_CPUS  number of CPUs to use during pplacer placement
                --force                      continue processing if an error occurs on a single genome
                --scratch_dir SCRATCH_DIR    reduce pplacer memory usage by writing to disk (slower)
                --write_single_copy_genes    output unaligned single-copy marker genes
                --keep_intermediates         keep intermediate files in the final directory
                --min_af MIN_AF              minimum alignment fraction to assign genome to a species cluster
                --tmpdir TMPDIR              specify alternative directory for temporary files
                --debug                      create intermediate files for debugging purposes
                -h, --help                   show help message
            `,
            values: #{
                "--genome_dir": "dirs", "--batchfile": "files", "--out_dir": "dirs", "-x": "none",
                "--extension": "none", "--min_perc_aa": "none", "--prefix": "none", "--cpus": "none",
                "--pplacer_cpus": "none", "--scratch_dir": "dirs", "--min_af": "none", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "identify" => #{
            opts: `
                --genome_dir GENOME_DIR    directory containing genome files in FASTA format
                --batchfile BATCHFILE      file describing genomes: tab separated, the FASTA file, the genome ID and its translation
                --out_dir OUT_DIR          directory to output files
                -x, --extension EXTENSION  extension of the files to process (gz: gzipped)
                --prefix PREFIX            prefix for all output files
                --genes                    indicates input files contain predicted proteins as amino acids
                --cpus CPUS                number of CPUs to use
                --force                    continue processing if an error occurs on a single genome
                --write_single_copy_genes  output unaligned single-copy marker genes
                --tmpdir TMPDIR            specify alternative directory for temporary files
                --debug                    create intermediate files for debugging purposes
                -h, --help                 show help message
            `,
            values: #{
                "--genome_dir": "dirs", "--batchfile": "files", "--out_dir": "dirs", "-x": "none",
                "--extension": "none", "--prefix": "none", "--cpus": "none", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "align" => #{
            opts: `
                --identify_dir IDENTIFY_DIR    output directory of 'identify' command
                --out_dir OUT_DIR              directory to output files
                --skip_gtdb_refs               do not include GTDB reference genomes in multiple sequence alignment
                --taxa_filter TAXA_FILTER      filter GTDB genomes to taxa (comma separated) within specific taxonomic groups
                --min_perc_aa MIN_PERC_AA      exclude genomes that do not have at least this percentage of AA in the MSA
                --cols_per_gene COLS_PER_GENE  maximum number of columns to retain per gene when generating the MSA
                --min_consensus MIN_CONSENSUS  minimum percentage of the same amino acid required to retain column (inclusive bound)
                --max_consensus MAX_CONSENSUS  maximum percentage of the same amino acid required to retain column (exclusive bound)
                --min_perc_taxa MIN_PERC_TAXA  minimum percentage of taxa required to retain column (inclusive bound)
                --rnd_seed RND_SEED            random seed to use for selecting columns
                --prefix PREFIX                prefix for all output files
                --cpus CPUS                    number of CPUs to use
                --tmpdir TMPDIR                specify alternative directory for temporary files
                --debug                        create intermediate files for debugging purposes
                -h, --help                     show help message
                --custom_msa_filters           custom filtering of the MSA with --cols_per_gene, --min_consensus,
                --skip_trimming                skip the trimming step and return the full MSAs
            `,
            values: #{
                "--identify_dir": "dirs", "--out_dir": "dirs", "--taxa_filter": "none", "--min_perc_aa": "none",
                "--cols_per_gene": "none", "--min_consensus": "none", "--max_consensus": "none",
                "--min_perc_taxa": "none", "--rnd_seed": "none", "--prefix": "none", "--cpus": "none",
                "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "infer" => #{
            opts: `
                --msa_file MSA_FILE      multiple sequence alignment in FASTA format
                --out_dir OUT_DIR        directory to output files
                --prot_model JTT|WAG|LG  protein substitution model for tree inference
                --no_support             do not compute local support values using the Shimodaira-Hasegawa test
                --gamma                  rescale branch lengths to optimize the Gamma20 likelihood
                --prefix PREFIX          prefix for all output files
                --cpus CPUS              number of CPUs to use
                --tmpdir TMPDIR          specify alternative directory for temporary files
                --debug                  create intermediate files for debugging purposes
                -h, --help               show help message
            `,
            values: #{
                "--msa_file": "files", "--out_dir": "dirs", "--prot_model": ["JTT", "WAG", "LG"],
                "--prefix": "none", "--cpus": "none", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "classify" => #{
            opts: `
                --genome_dir GENOME_DIR      directory containing genome files in FASTA format
                --batchfile BATCHFILE        file describing genomes: tab separated, the FASTA file, the genome ID and its translation
                --align_dir ALIGN_DIR        output directory of 'align' command
                --out_dir OUT_DIR            directory to output files
                --place_species              place species in pplacer trees even if they are classified with skani
                -x, --extension EXTENSION    extension of the files to process (gz: gzipped)
                --prefix PREFIX              prefix for all output files
                --cpus CPUS                  number of CPUs to use
                --pplacer_cpus PPLACER_CPUS  number of CPUs to use during pplacer placement
                --scratch_dir SCRATCH_DIR    reduce pplacer memory usage by writing to disk (slower)
                --genes                      indicates input files contain predicted proteins as amino acids
                -f, --full_tree              use the unsplit bacterial tree for the classify step (the original GTDB-Tk approach)
                --min_af MIN_AF              minimum alignment fraction to assign genome to a species cluster
                --tmpdir TMPDIR              specify alternative directory for temporary files
                --debug                      create intermediate files for debugging purposes
                -h, --help                   show help message
            `,
            values: #{
                "--genome_dir": "dirs", "--batchfile": "files", "--align_dir": "dirs", "--out_dir": "dirs",
                "-x": "none", "--extension": "none", "--prefix": "none", "--cpus": "none",
                "--pplacer_cpus": "none", "--scratch_dir": "dirs", "--min_af": "none", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "root" => #{
            opts: `
                --input_tree INPUT_TREE                       path to the unrooted tree in Newick format
                --outgroup_taxon OUTGROUP_TAXON               taxon to use as outgroup (e.g p__Patescibacteriota)
                --output_tree OUTPUT_TREE                     path to output the tree
                --gtdbtk_classification_file GTDBTK_CLASSIFICATION_FILE  file with GTDB-Tk classifications produced by the 'classify' command
                --custom_taxonomy_file CUSTOM_TAXONOMY_FILE   file of custom taxonomy strings for the user genomes
                --tmpdir TMPDIR                               specify alternative directory for temporary files
                --debug                                       create intermediate files for debugging purposes
                -h, --help                                    show help message
            `,
            values: #{
                "--input_tree": "files", "--outgroup_taxon": "none", "--output_tree": "files",
                "--gtdbtk_classification_file": "files", "--custom_taxonomy_file": "files", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "decorate" => #{
            opts: `
                --input_tree INPUT_TREE                       path to the unrooted tree in Newick format
                --output_tree OUTPUT_TREE                     path to output the tree
                --gtdbtk_classification_file GTDBTK_CLASSIFICATION_FILE  file with GTDB-Tk classifications produced by the 'classify' command
                --custom_taxonomy_file CUSTOM_TAXONOMY_FILE   file of custom taxonomy strings for the user genomes
                --tmpdir TMPDIR                               specify alternative directory for temporary files
                --debug                                       create intermediate files for debugging purposes
                -h, --help                                    show help message
            `,
            values: #{
                "--input_tree": "files", "--output_tree": "files", "--gtdbtk_classification_file": "files",
                "--custom_taxonomy_file": "files", "--tmpdir": "dirs",
            },
            args: ["none"],
