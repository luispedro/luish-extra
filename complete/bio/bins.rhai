                --output_tree OUTPUT_TREE      path to output the tree
                --tmpdir TMPDIR                specify alternative directory for temporary files
                --debug                        create intermediate files for debugging purposes
                -h, --help                     show help message
            `,
            values: #{
                "--input_tree": "files", "--ingroup_taxon": "none", "--output_tree": "files", "--tmpdir": "dirs",
            },
            args: ["none"],
        },
        "ani_rep" => #{
            opts: `
                --genome_dir GENOME_DIR    directory containing genome files in FASTA format
                --batchfile BATCHFILE      file describing genomes: tab separated, the FASTA file, the genome ID and its translation
                --out_dir OUT_DIR          directory to output files
                --min_af MIN_AF            minimum alignment fraction to assign genome to a species cluster
                -x, --extension EXTENSION  extension of the files to process (gz: gzipped)
                --prefix PREFIX            prefix for all output files
                --cpus CPUS                number of CPUs to use
                --tmpdir TMPDIR            specify alternative directory for temporary files
                --debug                    create intermediate files for debugging purposes
                -h, --help                 show help message
            `,
            values: #{
                "--genome_dir": "dirs", "--batchfile": "files", "--out_dir": "dirs", "--min_af": "none",
                "-x": "none", "--extension": "none", "--prefix": "none", "--cpus": "none", "--tmpdir": "dirs",
