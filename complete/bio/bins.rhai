            opts: `
                --out_dir OUT_DIR  directory to output files
                --cpus CPUS        number of CPUs to use
                --debug            create intermediate files for debugging purposes
                -h, --help         show help message
            `,
            values: #{
                "--out_dir": "dirs", "--cpus": "none",
            },
            args: ["none"],
        },
        "trim_msa" => #{
            opts: `
                --untrimmed_msa UNTRIMMED_MSA  path to the untrimmed MSA file
                --output OUTPUT                output file
                --mask_file MASK_FILE          path to a custom mask file for trimming the MSA
                --reference_mask ARC|BAC       reference mask already present in GTDB-Tk
                --debug                        create intermediate files for debugging purposes
                -h, --help                     show help message
            `,
            values: #{
                "--untrimmed_msa": "files", "--output": "files", "--mask_file": "files",
                "--reference_mask": ["arc", "bac"],
            },
            args: ["none"],
        },
        "remove_labels" => #{
