                --input_tree INPUT_TREE    path to the unrooted tree in Newick format
                --output_tree OUTPUT_TREE  path to output the tree
                --debug                    create intermediate files for debugging purposes
                -h, --help                 show help message
            `,
            values: #{
                "--input_tree": "files", "--output_tree": "files",
            },
            args: ["none"],
