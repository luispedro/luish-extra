fn metabat2() {
    #{
        opts: `
            -h, --help               produce help message
            -i, --inFile FILE        contigs in (gzipped) fasta file format
            -o, --outFile FILE       base file name and path of the bins (FASTA, or contig names with -l)
            -a, --abdFile FILE       file of the mean and variance of the depth of each contig (jgi_summarize_bam_contig_depths)
            -m, --minContig NUM      minimum size of a contig for binning (at least 1500)
            --minSmallContig NUM     minimum size of a small contig to recruit into the bins (at least 500)
            --maxP NUM               percentage of 'good' contigs considered for binning decided by connection among contigs
            --minS NUM               minimum score of an edge for binning, 1 to 99
            --maxEdges NUM           maximum number of edges per node
            --pTNF NUM               TNF probability cutoff for the TNF graph, 1 to 100 (0: automatic)
            --noAdd                  turning off additional binning for lost or small contigs
            --minRecruitingSize NUM  minimum cluster size for recruiting small and leftover contigs
            --recruitToAbdCentroid   recruit small and lost contigs to the abundance-weighted centroid (experimental)
            --recruitWithTNF NUM     factor of the TNF threshold for small and lost contigs (experimental)
            --cvExt                  the coverage file has no variance (from third party tools), instead of an abdFile
            --fullHeader             preserve full FASTA headers from input assembly
            -x, --minCV NUM          minimum mean coverage of a contig in each library for binning
            --minCVSum NUM           minimum total effective mean coverage of a contig (sum of depth over minCV) for binning
            -s, --minClsSize NUM     minimum size of a bin as the output
            -t, --numThreads NUM     number of threads to use (0: use all cores)
            -l, --onlyLabel          output only sequence labels as a list in a column without sequences
            --saveCls                save cluster memberships as a matrix format
            --unbinned               generate [outFile].unbinned.fa file for unbinned contigs
            --noBinOut               no bin output
            --noSampleDepths         do not include per-sample depths in bin fasta headers
            --seed NUM               for exact reproducibility
            -d, --debug              debug output
            -q, --quiet              be less verbose
            -v, --verbose            be more verbose in output (on by default)
        `,
        values: #{
            "-i": k("fasta"), "--inFile": k("fasta"), "-o": "files", "--outFile": "files", "-a": "files",
            "--abdFile": "files", "-m": "none", "--minContig": "none", "--minSmallContig": "none",
            "--maxP": "none", "--minS": "none", "--maxEdges": "none", "--pTNF": "none",
            "--minRecruitingSize": "none", "--recruitWithTNF": "none", "-x": "none", "--minCV": "none",
            "--minCVSum": "none", "-s": "none", "--minClsSize": "none", "-t": "none", "--numThreads": "none",
            "--seed": "none",
        },
        args: ["none"],
    }
}

fn jgi_summarize_bam_contig_depths() {
    #{
        opts: `
            --outputDepth FILE      the file to put the contig by bam depth matrix
            --checkpoint            the write checkpoints for every bam processed
            --percentIdentity NUM   the minimum end-to-end % identity of qualifying reads
            --pairedContigs FILE    the file to output the sparse matrix of contigs which paired reads span
            --unmappedFastq FILE    prefix of the FASTQ files of the unmapped reads of each BAM file
            --noIntraDepthVariance  do not include variance from mean depth along the contig
            --showDepth             output a .depth file per bam for each contig base
            --minMapQual NUM        the minimum mapping quality necessary to count the read as mapped
            --weightMapQual NUM     weight the per-base depth by the mapping quality of the read (default: 0, off)
            --includeEdgeBases      when calculating depth & variance, include the 1-readlength edges (off by default)
            --maxEdgeBases NUM      the maximum length of the edges left out (without --includeEdgeBases)
            --referenceFasta FILE   the reference: the FASTA that the BAM files were mapped to
            --outputGC FILE         the file to print the gc coverage histogram
            --gcWindow NUM          the sliding window size for GC calculations
            --outputReadStats FILE  the file to print the per read statistics
            --outputKmers FILE      the file to print the perfect kmer counts
            --shredLength NUM       the maximum length of the shreds
            --shredDepth NUM        the depth to generate overlapping shreds
            --minContigLength NUM   the mimimum length of contig to include for mapping and shredding
            --minContigDepth NUM    the minimum depth along contig at which to break the contig
        `,
        values: #{
            "--outputDepth": "files", "--percentIdentity": "none", "--pairedContigs": "files",
            "--unmappedFastq": "files", "--minMapQual": "none", "--weightMapQual": "none",
            "--maxEdgeBases": "none", "--referenceFasta": k("fasta"), "--outputGC": "files", "--gcWindow": "none",
            "--outputReadStats": "files", "--outputKmers": "files", "--shredLength": "none",
            "--shredDepth": "none", "--minContigLength": "none", "--minContigDepth": "none",
        },
        args: [k("bam")],
    }
}

fn run_maxbin() {
    #{
        opts: `
            -contig FILE            contigs (FASTA)
            -out PREFIX             output prefix
            -reads FILE             reads file (FASTA or FASTQ)
            -reads2 FILE            reads file of a second sample
            -reads3 FILE            reads file of a third sample
            -reads4 FILE            reads file of a fourth sample
            -abund FILE             abundance file (contig name, abundance)
            -abund2 FILE            abundance file of a second sample
            -abund3 FILE            abundance file of a third sample
            -abund4 FILE            abundance file of a fourth sample
            -reads_list FILE        file listing reads files, one per line
            -abund_list FILE        file listing abundance files, one per line
            -min_contig_length NUM  minimum contig length (default: 1000)
            -max_iteration NUM      maximum number of EM iterations (default: 50)
            -thread NUM             number of threads (default: 1)
            -prob_threshold NUM     probability threshold for the final EM classification (default: 0.9)
            -plotmarker             plot the marker gene presence of the bins
            -markerset SET          marker gene set: 107 (bacteria, the default) or 40 (bacteria and archaea)
            -version, -v            print the version
            -verbose                verbose output
            -preserve_intermediate  keep the intermediate files
        `,
        values: #{
            "-contig": k("fasta"), "-out": "files", "-reads": k("reads"), "-reads2": k("reads"),
            "-reads3": k("reads"), "-reads4": k("reads"), "-abund": "files", "-abund2": "files",
            "-abund3": "files", "-abund4": "files", "-reads_list": "files", "-abund_list": "files",
            "-min_contig_length": "none", "-max_iteration": "none", "-thread": "none", "-prob_threshold": "none",
            "-markerset": ["107", "40"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn das_tool() {
    #{
        opts: `
            -i, --bins=CONTIG2BIN                  contig-to-bin tables (tab separated), comma separated
            -c, --contigs=CONTIGS                  contigs in fasta format
            -o, --outputbasename=OUTPUTBASENAME    basename of output files
            -l, --labels=LABELS                    names of the binning predictions, comma separated
            --search_engine=SEARCH_ENGINE          engine for single copy gene identification: diamond, blastp, usearch
            -p, --proteins=PROTEINS                predicted proteins in prodigal FASTA format (>contigID_geneNo), to skip gene prediction
            --write_bin_evals                      write evaluation of input bin sets
            --write_bins                           export bins as fasta files
            --write_unbinned                       write unbinned contigs
            -t, --threads=THREADS                  number of threads to use
            --score_threshold=SCORE_THRESHOLD      score threshold until which the selection keeps selecting bins (0..1)
            --duplicate_penalty=DUPLICATE_PENALTY  penalty for duplicate single copy genes per bin (weight b, 0..3)
            --megabin_penalty=MEGABIN_PENALTY      penalty for megabins (weight c, 0..3)
            --max_iter_post_threshold=MAX_ITER     maximum number of iterations after reaching score threshold
            --dbDirectory=DBDIRECTORY              directory of single copy gene database
            --resume                               use existing predicted single copy gene files from a previous run
            --debug                                write debug information to log file
            -v, --version                          print version number and exit
            -h, --help                             show this
        `,
        values: #{
            "-i": "files", "-c": k("fasta"), "-o": "files", "-l": "none",
            "--search_engine": ["diamond", "blastp", "usearch"], "-p": k("fasta"), "-t": "none",
            "--score_threshold": "none", "--duplicate_penalty": "none", "--megabin_penalty": "none",
            "--max_iter_post_threshold": "none", "--dbDirectory": "dirs",
        },
        args: ["none"],
    }
}

fn fasta_to_contig2bin() {
    #{
        opts: `
            -e, --extension EXT     extension of fasta files
            -i, --input_folder DIR  folder with bins in fasta format
            -h, --help              show this message
        `,
        values: #{
            "-e": "none", "--extension": "none", "-i": "dirs", "--input_folder": "dirs",
        },
        args: ["none"],
    }
}

fn coverm() {
    #{
        opts: `
            -h, --help     show the commands
            -V, --version  print version information
        `,
        commands: `
            genome            calculate coverage of genomes
            contig            calculate coverage of contigs
            filter            remove alignments with insufficient identity
            make              generate BAM files through mapping
            makedb            generate mapping database(s) from reference FASTA files
            shell-completion  generate a shell completion script for coverm
            cluster           cluster FASTA files by average nucleotide identity
        `,
        sub_spec: "@extra-complete/bio/bins:coverm",
    }
}

fn coverm_sub(sub) {
    switch sub {
        "genome" => #{
            opts: `
                -1 PATH                                                          forward FASTA/Q file(s) for mapping
                -2 PATH                                                          reverse FASTA/Q file(s) for mapping
                -c, --coupled PATH                                               pairs of forward and reverse FASTA/Q files: sample1_R1 sample1_R2 sample2_R1 sample2_R2 ...
                --interleaved PATH                                               interleaved FASTA/Q files(s) for mapping
                --single PATH                                                    unpaired FASTA/Q files(s) for mapping
                -b, --bam-files PATH                                             BAM files, sorted by reference (by read name with --sharded): no mapping is done
                -f, --genome-fasta-files PATH                                    path(s) to FASTA files of each genome e.g pathA/genome1.fna pathB/genome2.fa
                -d, --genome-fasta-directory PATH                                directory containing FASTA files of each genome
                -x, --genome-fasta-extension EXT                                 file extension of genomes in the directory specified with -d/--genome-fasta-directory
                --genome-fasta-list PATH                                         file containing FASTA file paths, one per line
                -r, --reference PATH                                             FASTA file of contigs (concatenated genomes or an assembly), or a minimap2, strobealign or BWA index
                -s, --separator CHARACTER                                        the character that separates genome names from contig names in the reference file
                --single-genome                                                  all contigs are from the same genome
                --genome-definition FILE                                         file containing list of genome_name<tab>contig lines to define the genome of each contig
                --use-full-contig-names                                          the BAM files were made with contig names that have spaces
                --dereplicate                                                    dereplicate genomes by ANI, choosing a representative of each cluster
                --checkm2-quality-report PATH                                    CheckM2's quality_report.tsv, for the quality of the genomes
                --checkm-tab-table PATH                                          CheckM's tab table (checkm ... --tab_table -f PATH), for the quality of the genomes
                --genome-info PATH                                               dRep's genome info table, for the quality of the genomes
                --min-completeness FLOAT                                         ignore genomes with less completeness than this percentage
                --max-contamination FLOAT                                        ignore genomes with more contamination than this percentage
                --run-checkm2                                                    run CheckM2 to generate quality scoring used for clustering
                --checkm2-db-path DB_PATH                                        path to CheckM2 database (required for running CheckM2)
                --dereplication-ani FLOAT                                        overall ANI level to dereplicate at with the primary clusterer
                --dereplication-aligned-fraction FLOAT                           min aligned fraction of two genomes for clustering
                --dereplication-small-genomes                                    use small-genomes settings in skani (recommended for sequences < 20kbp)
                --dereplication-fragment-length FLOAT                            length of fragment used in FastANI calculation (i.e --fragLen)
                --dereplication-quality-formula FORMULA                          scoring function for genome quality
                --dereplication-prethreshold-ani FLOAT                           minimum precluster ANI for preclustering and primary clustering
                --dereplication-precluster-method NAME                           method of calculating rough ANI: finch (MinHash) or skani
                --dereplication-cluster-method NAME                              method of calculating ANI: fastani (FastANI) or skani (Skani)
                --dereplication-cluster-contigs                                  cluster contigs within a FASTA file instead of genomes
                --dereplication-small-contigs                                    use small-genomes settings in skani when clustering contigs
                --dereplication-large-contigs                                    do not use small-genomes settings in skani when clustering contigs
                --dereplication-low-memory                                       reduce memory use by sketching to file and searching it instead
                --dereplication-reference-genomes PATH                           reference genomes to cluster against
                --dereplication-reference-genomes-list PATH                      file containing paths to reference genomes (one per line)
                --dereplication-output-cluster-definition PATH                   output a file of representative<TAB>member lines
                --dereplication-output-representative-fasta-directory PATH       symlink representative genomes into this directory
                --dereplication-output-representative-fasta-directory-copy PATH  copy representative genomes into this directory
                --dereplication-output-representative-list PATH                  print newline separated list of paths to representatives into this file
                --sharded                                                        the BAM files (or the mappings to each reference) are sharded: choose the best hit for each pair
                --exclude-genomes-from-deshard PATH                              ignore the genomes named in this file (one per line) when combining shards
                -p, --mapper NAME                                                underlying mapping software used
                --minimap2-params PARAMS                                         extra parameters to provide to minimap2, both indexing command (if used) and for mapping
                --minimap2-reference-is-index                                    treat reference as a minimap2 database, not as a FASTA file
                --bwa-params PARAMS                                              extra parameters to provide to BWA or BWA-MEM2
                --strobealign-params PARAMS                                      extra parameters to provide to strobealign
                --minibwa-params PARAMS                                          extra parameters to provide to the 'minibwa map' command
                --rammap-params PARAMS                                           extra parameters to provide to rammap
                --strobealign-use-index                                          use a pregenerated index (strobealign --create-index) of the reference
                --min-read-aligned-length INT                                    exclude reads with smaller numbers of aligned bases
                --min-read-percent-identity FLOAT                                exclude reads by overall percent identity e.g 95 for 95%
                --min-read-aligned-percent FLOAT                                 exclude reads by percent aligned bases (95: 95% of the read's bases)
                --min-read-aligned-length-pair INT                               exclude pairs with smaller numbers of aligned bases
                --min-read-percent-identity-pair FLOAT                           exclude pairs by overall percent identity (implies --proper-pairs-only)
                --min-read-aligned-percent-pair FLOAT                            exclude pairs by percent aligned bases (implies --proper-pairs-only)
                --min-mapq INT                                                   exclude reads with a mapping quality below this value (0 to 254)
                --proper-pairs-only                                              require reads to be mapped as proper pairs
                --exclude-supplementary                                          exclude supplementary alignments
                --include-secondary                                              include secondary alignments
                -m, --methods METHOD                                             method(s) for calculating coverage
                --min-covered-fraction FRACTION                                  genomes with less covered bases than this are reported as having zero coverage
                --contig-end-exclusion INT                                       exclude bases at the ends of reference sequences from calculation
                --trim-min FRACTION                                              remove this smallest fraction of positions when calculating trimmed_mean
                --trim-max FRACTION                                              maximum fraction for trimmed_mean calculations
                --gff PATH                                                       GFF (or GTF) file of the genes or features, to report the coverage of each
                --gff-feature-type TYPE                                          only use features of this type (i.e the third column of the GFF) when --gff is specified
                -o, --output-file FILE                                           output coverage values to this file, or '-' for stdout
                --output-format FORMAT                                           shape of output: 'sparse' for long format, 'dense' for species-by-site
                --no-zeros                                                       omit printing of genomes that have zero coverage
                --cache-unfiltered-bam-directory DIRECTORY                       output BAM files generated during alignment to this directory
                --cache-unfiltered-bam-files FILE                                output BAM files generated during alignment to these files
                --discard-unmapped                                               exclude unmapped reads from cached BAM files
                -t, --threads INT                                                number of threads for mapping, sorting and reading
                -h, --help                                                       output a short usage message
                --full-help                                                      output a full help message and display in 'man'
                --full-help-roff                                                 output a full help message in raw ROFF format for conversion to other formats
                -v, --verbose                                                    print extra debugging information
                --quiet                                                          unless there is an error, do not print log messages
            `,
            values: #{
                "-1": k("reads"), "-2": k("reads"), "-c": k("reads"), "--coupled": k("reads"),
                "--interleaved": k("reads"), "--single": k("reads"), "-b": k("bam"), "--bam-files": k("bam"),
                "-f": k("fasta"), "--genome-fasta-files": k("fasta"), "-d": "dirs",
                "--genome-fasta-directory": "dirs", "-x": "none", "--genome-fasta-extension": "none",
                "--genome-fasta-list": "files", "-r": "files", "--reference": "files", "-s": "none",
                "--separator": "none", "--genome-definition": "files", "--checkm2-quality-report": "files",
                "--checkm-tab-table": "files", "--genome-info": "files", "--min-completeness": "none",
                "--max-contamination": "none", "--checkm2-db-path": k("diamond_db"), "--dereplication-ani": "none",
                "--dereplication-aligned-fraction": "none", "--dereplication-fragment-length": "none",
                "--dereplication-quality-formula": ["completeness-4contamination", "completeness-5contamination", "Parks2020_reduced", "dRep"],
                "--dereplication-prethreshold-ani": "none",
                "--dereplication-precluster-method": ["skani", "finch"],
                "--dereplication-cluster-method": ["skani", "fastani"],
                "--dereplication-reference-genomes": k("fasta"), "--dereplication-reference-genomes-list": "files",
                "--dereplication-output-cluster-definition": "files",
                "--dereplication-output-representative-fasta-directory": "dirs",
                "--dereplication-output-representative-fasta-directory-copy": "dirs",
                "--dereplication-output-representative-list": "files", "--exclude-genomes-from-deshard": "files",
                "-p": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--mapper": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--minimap2-params": "none", "--bwa-params": "none", "--strobealign-params": "none",
                "--minibwa-params": "none", "--rammap-params": "none", "--min-read-aligned-length": "none",
                "--min-read-percent-identity": "none", "--min-read-aligned-percent": "none",
                "--min-read-aligned-length-pair": "none", "--min-read-percent-identity-pair": "none",
                "--min-read-aligned-percent-pair": "none", "--min-mapq": "none",
                "-m": [
                    "relative_abundance", "mean", "trimmed_mean", "coverage_histogram", "covered_fraction",
                    "covered_bases", "variance", "length", "count", "reads_per_base", "anir", "rpkm", "tpm",
                ],
                "--methods": [
                    "relative_abundance", "mean", "trimmed_mean", "coverage_histogram", "covered_fraction",
                    "covered_bases", "variance", "length", "count", "reads_per_base", "anir", "rpkm", "tpm",
                ],
                "--min-covered-fraction": "none", "--contig-end-exclusion": "none", "--trim-min": "none",
                "--trim-max": "none", "--gff": k("gff"), "--gff-feature-type": "none", "-o": "files",
                "--output-file": "files", "--output-format": ["sparse", "dense"],
                "--cache-unfiltered-bam-directory": "dirs", "--cache-unfiltered-bam-files": "files", "-t": "none",
                "--threads": "none",
            },
            args: ["none"],
        },
        "contig" => #{
            opts: `
                -1 PATH                                     forward FASTA/Q file(s) for mapping
                -2 PATH                                     reverse FASTA/Q file(s) for mapping
                -c, --coupled PATH                          pairs of forward and reverse FASTA/Q files: sample1_R1 sample1_R2 sample2_R1 sample2_R2 ...
                --interleaved PATH                          interleaved FASTA/Q files(s) for mapping
                --single PATH                               unpaired FASTA/Q files(s) for mapping
                -b, --bam-files PATH                        BAM files, sorted by reference (by read name with --sharded): no mapping is done
                -r, --reference PATH                        FASTA file of contigs (concatenated genomes or an assembly), or a minimap2, strobealign or BWA index
                --sharded                                   the BAM files (or the mappings to each reference) are sharded: choose the best hit for each pair
                -p, --mapper NAME                           underlying mapping software used
                --minimap2-params PARAMS                    extra parameters to provide to minimap2, both indexing command (if used) and for mapping
                --minimap2-reference-is-index               treat reference as a minimap2 database, not as a FASTA file
                --bwa-params PARAMS                         extra parameters to provide to BWA or BWA-MEM2
                --strobealign-params PARAMS                 extra parameters to provide to strobealign
                --minibwa-params PARAMS                     extra parameters to provide to the 'minibwa map' command
                --rammap-params PARAMS                      extra parameters to provide to rammap
                --strobealign-use-index                     use a pregenerated index (strobealign --create-index) of the reference
                --min-read-aligned-length INT               exclude reads with smaller numbers of aligned bases
                --min-read-percent-identity FLOAT           exclude reads by overall percent identity e.g 95 for 95%
                --min-read-aligned-percent FLOAT            exclude reads by percent aligned bases (95: 95% of the read's bases)
                --min-read-aligned-length-pair INT          exclude pairs with smaller numbers of aligned bases
                --min-read-percent-identity-pair FLOAT      exclude pairs by overall percent identity (implies --proper-pairs-only)
                --min-read-aligned-percent-pair FLOAT       exclude pairs by percent aligned bases (implies --proper-pairs-only)
                --min-mapq INT                              exclude reads with a mapping quality below this value (0 to 254)
                --proper-pairs-only                         require reads to be mapped as proper pairs
                --exclude-supplementary                     exclude supplementary alignments
                --include-secondary                         include secondary alignments
                -m, --methods METHOD                        method(s) for calculating coverage
                --min-covered-fraction FRACTION             contigs with less covered bases than this are reported as having zero coverage
                --contig-end-exclusion INT                  exclude bases at the ends of reference sequences from calculation
                --trim-min FRACTION                         remove this smallest fraction of positions when calculating trimmed_mean
                --trim-max FRACTION                         maximum fraction for trimmed_mean calculations
                --gff PATH                                  GFF (or GTF) file of the genes or features, to report the coverage of each
                --gff-feature-type TYPE                     only use features of this type (i.e the third column of the GFF) when --gff is specified
                -o, --output-file FILE                      output coverage values to this file, or '-' for stdout
                --output-format FORMAT                      shape of output: 'sparse' for long format, 'dense' for species-by-site
                --no-zeros                                  omit printing of genomes that have zero coverage
                --cache-unfiltered-bam-directory DIRECTORY  output BAM files generated during alignment to this directory
                --cache-unfiltered-bam-files FILE           output BAM files generated during alignment to these files
                --discard-unmapped                          exclude unmapped reads from cached BAM files
                -t, --threads INT                           number of threads for mapping, sorting and reading
                -h, --help                                  output a short usage message
                --full-help                                 output a full help message and display in 'man'
                --full-help-roff                            output a full help message in raw ROFF format for conversion to other formats
                -v, --verbose                               print extra debugging information
                --quiet                                     unless there is an error, do not print log messages
            `,
            values: #{
                "-1": k("reads"), "-2": k("reads"), "-c": k("reads"), "--coupled": k("reads"),
                "--interleaved": k("reads"), "--single": k("reads"), "-b": k("bam"), "--bam-files": k("bam"),
                "-r": "files", "--reference": "files",
                "-p": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--mapper": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--minimap2-params": "none", "--bwa-params": "none", "--strobealign-params": "none",
                "--minibwa-params": "none", "--rammap-params": "none", "--min-read-aligned-length": "none",
                "--min-read-percent-identity": "none", "--min-read-aligned-percent": "none",
                "--min-read-aligned-length-pair": "none", "--min-read-percent-identity-pair": "none",
                "--min-read-aligned-percent-pair": "none", "--min-mapq": "none",
                "-m": [
                    "mean", "trimmed_mean", "coverage_histogram", "covered_fraction", "covered_bases", "variance",
                    "length", "count", "metabat", "reads_per_base", "anir", "rpkm", "tpm", "strobealign-aemb",
                ],
                "--methods": [
                    "mean", "trimmed_mean", "coverage_histogram", "covered_fraction", "covered_bases", "variance",
                    "length", "count", "metabat", "reads_per_base", "anir", "rpkm", "tpm", "strobealign-aemb",
                ],
                "--min-covered-fraction": "none", "--contig-end-exclusion": "none", "--trim-min": "none",
                "--trim-max": "none", "--gff": k("gff"), "--gff-feature-type": "none", "-o": "files",
                "--output-file": "files", "--output-format": ["sparse", "dense"],
                "--cache-unfiltered-bam-directory": "dirs", "--cache-unfiltered-bam-files": "files", "-t": "none",
                "--threads": "none",
            },
            args: ["none"],
        },
        "filter" => #{
            opts: `
                --inverse                               only keep reads which are unmapped or align below thresholds
                -v, --verbose                           print extra debugging information
                -q, --quiet                             unless there is an error, do not print log messages
                -h, --help                              output a short usage message
                --full-help                             output a full help message and display in 'man'
                --full-help-roff                        output a full help message in raw ROFF format for conversion to other formats
                -b, --bam-files PATH                    BAM files to filter, sorted by reference
                -o, --output-bam-files PATH             output BAM files, one per input BAM file
                -t, --threads INT                       number of threads for output compression
                --min-read-aligned-length INT           exclude reads with smaller numbers of aligned bases
                --min-read-percent-identity FLOAT       exclude reads by overall percent identity e.g 95 for 95%
                --min-read-aligned-percent FLOAT        exclude reads by percent aligned bases (95: 95% of the read's bases)
                --min-read-aligned-length-pair INT      exclude pairs with smaller numbers of aligned bases
                --min-read-percent-identity-pair FLOAT  exclude pairs by overall percent identity (implies --proper-pairs-only)
                --min-read-aligned-percent-pair FLOAT   exclude pairs by percent aligned bases (implies --proper-pairs-only)
                --min-mapq INT                          exclude reads with a mapping quality below this value (0 to 254)
                --proper-pairs-only                     require reads to be mapped as proper pairs
                --exclude-supplementary                 exclude supplementary alignments
                --include-secondary                     include secondary alignments
            `,
            values: #{
                "-b": k("bam"), "--bam-files": k("bam"), "-o": k("bam"), "--output-bam-files": k("bam"),
                "-t": "none", "--threads": "none", "--min-read-aligned-length": "none",
                "--min-read-percent-identity": "none", "--min-read-aligned-percent": "none",
                "--min-read-aligned-length-pair": "none", "--min-read-percent-identity-pair": "none",
                "--min-read-aligned-percent-pair": "none", "--min-mapq": "none",
            },
            args: ["none"],
        },
        "make" => #{
            opts: `
                -1 PATH                        forward FASTA/Q file(s) for mapping
                -2 PATH                        reverse FASTA/Q file(s) for mapping
                -c, --coupled PATH             pairs of forward and reverse FASTA/Q files: sample1_R1 sample1_R2 sample2_R1 sample2_R2 ...
                --interleaved PATH             interleaved FASTA/Q files(s) for mapping
                --single PATH                  unpaired FASTA/Q files(s) for mapping
                -r, --reference PATH           FASTA file of contigs (concatenated genomes or an assembly), or a minimap2, strobealign or BWA index
                -p, --mapper NAME              underlying mapping software used
                --minimap2-params PARAMS       extra parameters to provide to minimap2, both indexing command (if used) and for mapping
                --minimap2-reference-is-index  treat reference as a minimap2 database, not as a FASTA file
                --bwa-params PARAMS            extra parameters to provide to BWA or BWA-MEM2
                --strobealign-params PARAMS    extra parameters to provide to strobealign
                --minibwa-params PARAMS        extra parameters to provide to the 'minibwa map' command
                --rammap-params PARAMS         extra parameters to provide to rammap
                --strobealign-use-index        use a pregenerated index (strobealign --create-index) of the reference
                -o, --output-directory DIR     directory of the output (created if it does not exist)
                --discard-unmapped             exclude unmapped reads from cached BAM files
                -t, --threads INT              number of threads for mapping and sorting
                -h, --help                     output a short usage message
                --full-help                    output a full help message and display in 'man'
                --full-help-roff               output a full help message in raw ROFF format for conversion to other formats
                -v, --verbose                  print extra debugging information
                --quiet                        unless there is an error, do not print log messages
            `,
            values: #{
                "-1": k("reads"), "-2": k("reads"), "-c": k("reads"), "--coupled": k("reads"),
                "--interleaved": k("reads"), "--single": k("reads"), "-r": "files", "--reference": "files",
                "-p": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--mapper": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--minimap2-params": "none", "--bwa-params": "none", "--strobealign-params": "none",
                "--minibwa-params": "none", "--rammap-params": "none", "-o": "dirs", "--output-directory": "dirs",
                "-t": "none", "--threads": "none",
            },
            args: ["none"],
        },
        "makedb" => #{
            opts: `
                -r, --reference PATH                                             FASTA file of contigs (concatenated genomes or an assembly), or a minimap2, strobealign or BWA index
                -f, --genome-fasta-files PATH                                    path(s) to FASTA files of each genome e.g 'pathA/genome1.fna pathB/genome2.fa'. These are
                -d, --genome-fasta-directory PATH                                directory containing FASTA files of each genome, which are concatenated into a single
                --genome-fasta-list PATH                                         file containing FASTA file paths, one per line, of each genome to concatenate into a
                -x, --genome-fasta-extension EXT                                 file extension of genomes in the directory specified with -d/--genome-fasta-directory
                -p, --mapper NAME                                                kind(s) of database to generate, one per mapping software
                --minimap2-params PARAMS                                         extra parameters to provide to the minimap2 indexing command
                --bwa-params PARAMS                                              extra parameters to provide to the BWA or BWA-MEM2 indexing command
                --strobealign-params PARAMS                                      extra parameters to provide to the 'strobealign --create-index' command
                -o, --output-directory DIR                                       directory of the output (created if it does not exist)
                --dereplicate                                                    dereplicate genomes by ANI, choosing a representative of each cluster
                --checkm2-quality-report PATH                                    CheckM2's quality_report.tsv, for the quality of the genomes
                --checkm-tab-table PATH                                          CheckM's tab table (checkm ... --tab_table -f PATH), for the quality of the genomes
                --genome-info PATH                                               dRep's genome info table, for the quality of the genomes
                --min-completeness FLOAT                                         ignore genomes with less completeness than this percentage
                --max-contamination FLOAT                                        ignore genomes with more contamination than this percentage
                --run-checkm2                                                    run CheckM2 to generate quality scoring used for clustering
                --checkm2-db-path DB_PATH                                        path to CheckM2 database (required for running CheckM2)
                --dereplication-ani FLOAT                                        overall ANI level to dereplicate at with the primary clusterer
                --dereplication-aligned-fraction FLOAT                           min aligned fraction of two genomes for clustering
                --dereplication-small-genomes                                    use small-genomes settings in skani (recommended for sequences < 20kbp)
                --dereplication-fragment-length FLOAT                            length of fragment used in FastANI calculation (i.e --fragLen)
                --dereplication-quality-formula FORMULA                          scoring function for genome quality
                --dereplication-prethreshold-ani FLOAT                           minimum precluster ANI for preclustering and primary clustering
                --dereplication-precluster-method NAME                           method of calculating rough ANI: finch (MinHash) or skani
                --dereplication-cluster-method NAME                              method of calculating ANI: fastani (FastANI) or skani (Skani)
                --dereplication-cluster-contigs                                  cluster contigs within a FASTA file instead of genomes
                --dereplication-small-contigs                                    use small-genomes settings in skani when clustering contigs
                --dereplication-large-contigs                                    do not use small-genomes settings in skani when clustering contigs
                --dereplication-low-memory                                       reduce memory use by sketching to file and searching it instead
                --dereplication-reference-genomes PATH                           reference genomes to cluster against
                --dereplication-reference-genomes-list PATH                      file containing paths to reference genomes (one per line)
                --dereplication-output-cluster-definition PATH                   output a file of representative<TAB>member lines
                --dereplication-output-representative-fasta-directory PATH       symlink representative genomes into this directory
                --dereplication-output-representative-fasta-directory-copy PATH  copy representative genomes into this directory
                --dereplication-output-representative-list PATH                  print newline separated list of paths to representatives into this file
                -t, --threads INT                                                number of threads used to generate the database(s)
                -h, --help                                                       output a short usage message
                --full-help                                                      output a full help message and display in 'man'
                --full-help-roff                                                 output a full help message in raw ROFF format for conversion to other formats
                -v, --verbose                                                    print extra debugging information
                --quiet                                                          unless there is an error, do not print log messages
            `,
            values: #{
                "-r": k("fasta"), "--reference": k("fasta"), "-f": k("fasta"), "--genome-fasta-files": k("fasta"),
                "-d": "dirs", "--genome-fasta-directory": "dirs", "--genome-fasta-list": "files", "-x": "none",
                "--genome-fasta-extension": "none",
                "-p": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--mapper": [
                    "bwa-mem", "bwa-mem2", "minimap2-sr", "minimap2-ont", "minimap2-pb", "minimap2-hifi",
                    "minimap2-lr-hq", "minimap2-no-preset", "strobealign", "minibwa", "rammap-sr", "rammap-ont",
                    "rammap-pb", "rammap-hifi", "rammap-lr-hq", "rammap-no-preset",
                ],
                "--minimap2-params": "none", "--bwa-params": "none", "--strobealign-params": "none", "-o": "dirs",
                "--output-directory": "dirs", "--checkm2-quality-report": "files", "--checkm-tab-table": "files",
                "--genome-info": "files", "--min-completeness": "none", "--max-contamination": "none",
                "--checkm2-db-path": k("diamond_db"), "--dereplication-ani": "none",
                "--dereplication-aligned-fraction": "none", "--dereplication-fragment-length": "none",
                "--dereplication-quality-formula": ["completeness-4contamination", "completeness-5contamination", "Parks2020_reduced", "dRep"],
                "--dereplication-prethreshold-ani": "none",
                "--dereplication-precluster-method": ["skani", "finch"],
                "--dereplication-cluster-method": ["skani", "fastani"],
                "--dereplication-reference-genomes": k("fasta"), "--dereplication-reference-genomes-list": "files",
                "--dereplication-output-cluster-definition": "files",
                "--dereplication-output-representative-fasta-directory": "dirs",
                "--dereplication-output-representative-fasta-directory-copy": "dirs",
                "--dereplication-output-representative-list": "files", "-t": "none", "--threads": "none",
            },
            args: ["none"],
        },
        "shell-completion" => #{
            opts: `
                -v, --verbose                  print extra debug logging information
                --quiet                        unless there is an error, do not print logging information
                -o, --output-file OUTPUT_FILE  output coverage values to this file, or '-' for stdout
                --shell SHELL                  the shell
                -h, --help                     print help
            `,
            values: #{
                "-o": "files", "--output-file": "files",
                "--shell": ["bash", "elvish", "fish", "powershell", "zsh"],
            },
            args: ["none"],
        },
        "cluster" => #{
            opts: `
                -f, --genome-fasta-files PATH                      path(s) to FASTA files of each genome e.g pathA/genome1.fna pathB/genome2.fa
                -d, --genome-fasta-directory PATH                  directory containing FASTA files of each genome
                -x, --genome-fasta-extension EXT                   file extension of genomes in the directory specified with -d/--genome-fasta-directory
                --genome-fasta-list PATH                           file containing FASTA file paths, one per line
                --checkm2-quality-report PATH                      CheckM2's quality_report.tsv, for the quality of the genomes
                --checkm-tab-table PATH                            CheckM's tab table (checkm ... --tab_table -f PATH), for the quality of the genomes
                --genome-info PATH                                 dRep's genome info table, for the quality of the genomes
                --min-completeness FLOAT                           ignore genomes with less completeness than this percentage
                --max-contamination FLOAT                          ignore genomes with more contamination than this percentage
                --run-checkm2                                      run CheckM2 to generate quality scoring used for clustering
                --checkm2-db-path DB_PATH                          path to CheckM2 database (required for running CheckM2)
                --ani FLOAT                                        overall ANI level to dereplicate at with the primary clusterer
                --min-aligned-fraction FLOAT                       min aligned fraction of two genomes for clustering
                --small-genomes                                    use small-genomes settings in skani (recommended for sequences < 20kbp)
                --fragment-length FLOAT                            length of fragment used in FastANI calculation (i.e --fragLen)
                --quality-formula FORMULA                          scoring function for genome quality
                --precluster-ani FLOAT                             minimum precluster ANI for preclustering and primary clustering
                --precluster-method NAME                           method of calculating rough ANI: finch (MinHash) or skani
                --cluster-method NAME                              method of calculating ANI: fastani (FastANI) or skani (Skani)
                --cluster-contigs                                  cluster contigs within a FASTA file instead of genomes
                --small-contigs                                    use small-genomes settings in skani when clustering contigs
                --large-contigs                                    do not use small-genomes settings in skani when clustering contigs
                --low-memory                                       reduce memory use by sketching to file and searching it instead
                --reference-genomes PATH                           reference genomes to cluster against
                --reference-genomes-list PATH                      file containing paths to reference genomes (one per line)
                --output-cluster-definition PATH                   output a file of representative<TAB>member lines
                --output-representative-fasta-directory PATH       symlink representative genomes into this directory
                --output-representative-fasta-directory-copy PATH  copy representative genomes into this directory
                --output-representative-list PATH                  print newline separated list of paths to representatives into this file
                -t, --threads INT                                  number of threads
                -v, --verbose                                      print extra debugging information
                -q, --quiet                                        unless there is an error, do not print log messages
                -h, --help                                         output a short usage message
                --full-help                                        output a full help message and display in 'man'
                --full-help-roff                                   output a full help message in raw ROFF format for conversion to other formats
            `,
            values: #{
                "-f": k("fasta"), "--genome-fasta-files": k("fasta"), "-d": "dirs",
                "--genome-fasta-directory": "dirs", "-x": "none", "--genome-fasta-extension": "none",
                "--genome-fasta-list": "files", "--checkm2-quality-report": "files", "--checkm-tab-table": "files",
                "--genome-info": "files", "--min-completeness": "none", "--max-contamination": "none",
                "--checkm2-db-path": k("diamond_db"), "--ani": "none", "--min-aligned-fraction": "none",
                "--fragment-length": "none",
                "--quality-formula": ["completeness-4contamination", "completeness-5contamination", "Parks2020_reduced", "dRep"],
                "--precluster-ani": "none", "--precluster-method": ["skani", "finch"],
                "--cluster-method": ["skani", "fastani"], "--reference-genomes": k("fasta"),
                "--reference-genomes-list": "files", "--output-cluster-definition": "files",
                "--output-representative-fasta-directory": "dirs",
                "--output-representative-fasta-directory-copy": "dirs", "--output-representative-list": "files",
                "-t": "none", "--threads": "none",
            },
            args: ["none"],
        },
        _ => (),
    }
}

fn spec(cmd) {
    switch cmd {
        "checkm" => checkm(),
        "checkm2" => checkm2(),
        "gunc" => gunc(),
        "gtdbtk" => gtdbtk(),
        "dRep" => drep(),
        "vamb" => vamb(),
        "concoct" => concoct(),
        "concoct_coverage_table.py" => concoct_coverage_table(),
        "cut_up_fasta.py" => cut_up_fasta(),
        "merge_cutup_clustering.py" => merge_cutup_clustering(),
        "extract_fasta_bins.py" => extract_fasta_bins(),
        "metabat2" => metabat2(),
        "jgi_summarize_bam_contig_depths" => jgi_summarize_bam_contig_depths(),
        "run_MaxBin.pl" => run_maxbin(),
        "DAS_Tool" => das_tool(),
        "Fasta_to_Contig2Bin.sh" => fasta_to_contig2bin(),
        "coverm" => coverm(),
        _ => #{},
    }
}

fn sub_spec(name, sub) {
    switch name {
        "checkm" => checkm_sub(sub),
        "checkm2" => checkm2_sub(sub),
        "gunc" => gunc_sub(sub),
        "gtdbtk" => gtdbtk_sub(sub),
        "dRep" => drep_sub(sub),
        "vamb" => vamb_sub(sub),
        "coverm" => coverm_sub(sub),
        _ => (),
    }
}
