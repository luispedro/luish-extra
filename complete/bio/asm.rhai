// Assembly and annotation: spades.py, metaspades.py, megahit, flye, quast,
// metaquast, busco, prodigal, prokka, bakta and barrnap. Generated by
// scripts/gen/mk_asm.py from the tools' own `--help` or argparse parser
// (versions in completion-todo.md).

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn k(name) { own("kinds:") + name }

fn spades() {
    #{
        opts: `
            -o OUTPUT_DIR                 directory to store all the resulting files (required)
            --isolate                     this flag is highly recommended for high-coverage isolate and multi-cell data
            --sc                          this flag is required for MDA (single-cell) data
            --meta                        this flag is required for metagenomic data
            --bio                         this flag is required for biosyntheticSPAdes mode
            --sewage                      this flag is required for sewage mode
            --corona                      this flag is required for coronaSPAdes mode
            --rna                         this flag is required for RNA-Seq data
            --plasmid                     runs plasmidSPAdes pipeline for plasmid detection
            --metaviral                   runs metaviralSPAdes pipeline for virus detection
            --metaplasmid                 runs metaplasmidSPAdes pipeline for plasmid detection in metagenomic datasets
            --rnaviral                    this flag enables virus assembly module from RNA-Seq data
            --iontorrent                  this flag is required for IonTorrent data
            --test                        runs SPAdes on toy dataset
            -h, --help                    prints this usage message
            -v, --version                 prints version
            --12 FILENAME                 file with interlaced forward and reverse paired-end reads
            -1 FILENAME                   file with forward paired-end reads
            -2 FILENAME                   file with reverse paired-end reads
            -s FILENAME                   file with unpaired reads
            --merged FILENAME             file with merged forward and reverse paired-end reads
            --pe-12 N                     file with interlaced reads for paired-end library number N
            --pe-1 N                      file with forward reads for paired-end library number N
            --pe-2 N                      file with reverse reads for paired-end library number N
            --pe-s N                      file with unpaired reads for paired-end library number N
            --pe-m N                      file with merged reads for paired-end library number N
            --pe-or N                     orientation of reads for paired-end library number N
            --s N                         file with unpaired reads for single reads library number N
            --mp-12 N                     file with interlaced reads for mate-pair library number N
            --mp-1 N                      file with forward reads for mate-pair library number N
            --mp-2 N                      file with reverse reads for mate-pair library number N
            --mp-s N                      file with unpaired reads for mate-pair library number N
            --mp-or N                     orientation of reads for mate-pair library number N
            --hqmp-12 N                   file with interlaced reads for high-quality mate-pair library number N
            --hqmp-1 N                    file with forward reads for high-quality mate-pair library number N
            --hqmp-2 N                    file with reverse reads for high-quality mate-pair library number N
            --hqmp-s N                    file with unpaired reads for high-quality mate-pair library number N
            --hqmp-or N                   orientation of reads for high-quality mate-pair library number N
            --sanger FILENAME             file with Sanger reads
            --pacbio FILENAME             file with PacBio reads
            --nanopore FILENAME           file with Nanopore reads
            --trusted-contigs FILENAME    file with trusted contigs
            --untrusted-contigs FILENAME  file with untrusted contigs
            --only-error-correction       runs only read error correction (without assembling)
            --only-assembler              runs only assembling (without read error correction)
            --careful                     tries to reduce number of mismatches and short indels
            --checkpoints WHEN            save intermediate check-points ('last', 'all')
            --continue                    continue run from the last available check-point (only -o should be specified)
            --restart-from CP             restart run with updated options and from the specified check-point
            --disable-gzip-output         forces error correction not to compress the corrected reads
            --disable-rr                  disables repeat resolution stage of assembling
            --dataset FILENAME            file with dataset description in YAML format
            -t, --threads INT             number of threads
            -m, --memory INT              RAM limit for SPAdes in Gb (terminates if exceeded)
            --tmp-dir DIRNAME             directory for temporary files
            -k INT                        list of k-mer sizes (must be odd and less than 128)
            --cov-cutoff FLOAT            coverage cutoff value (a positive float number, or 'auto', or 'off')
            --phred-offset OFFSET         PHRED quality offset in the input reads (33 or 64)
            --custom-hmms DIRNAME         directory with custom hmms that replace default ones
            --gfa11                       use GFA v1.1 format for assembly graph
            --frugal                      be memory frugal (at the expense of the possible assembly quality)
            --grid-engine GE              run under grid control ('slurm', 'local', 'mpi', save_yaml')
            --grid-queue STRING           submits the jobs to one of the specified queues
            --grid-nnodes INT             specifies the number of processors
            --grid-wait                   wait for job finish
            --grid-extra STRING           any extra commands
            --grid-time STRING            time limit
        `,
        values: #{
            "-o": "dirs", "--12": k("reads"), "-1": k("reads"), "-2": k("reads"), "-s": k("reads"),
            "--merged": k("reads"), "--pe-12": "none", "--pe-1": "none", "--pe-2": "none", "--pe-s": "none",
            "--pe-m": "none", "--pe-or": "none", "--s": "none", "--mp-12": "none", "--mp-1": "none",
            "--mp-2": "none", "--mp-s": "none", "--mp-or": "none", "--hqmp-12": "none", "--hqmp-1": "none",
            "--hqmp-2": "none", "--hqmp-s": "none", "--hqmp-or": "none", "--sanger": k("reads"),
            "--pacbio": k("reads"), "--nanopore": k("reads"), "--trusted-contigs": k("fasta"),
            "--untrusted-contigs": k("fasta"), "--checkpoints": ["last", "all"],
            "--restart-from": ["ec", "as", "mc", "last"], "--dataset": "files", "-t": "none", "--threads": "none",
            "-m": "none", "--memory": "none", "--tmp-dir": "dirs", "-k": "none", "--cov-cutoff": ["auto", "off"],
            "--phred-offset": ["33", "64"], "--custom-hmms": "dirs",
            "--grid-engine": ["slurm", "local", "mpi", "save_yaml"], "--grid-queue": "none",
            "--grid-nnodes": "none", "--grid-extra": "none", "--grid-time": "none",
        },
        args: [k("reads")],
    }
}

fn metaspades() {
    #{
        opts: `
            -o OUTPUT_DIR            directory to store all the resulting files (required)
            --iontorrent             this flag is required for IonTorrent data
            --test                   runs SPAdes on toy dataset
            -h, --help               prints this usage message
            -v, --version            prints version
            --12 FILENAME            file with interlaced forward and reverse paired-end reads
            -1 FILENAME              file with forward paired-end reads
            -2 FILENAME              file with reverse paired-end reads
            -s FILENAME              file with unpaired reads
            --merged FILENAME        file with merged forward and reverse paired-end reads
            --pe-12 N                file with interlaced reads for paired-end library number N
            --pe-1 N                 file with forward reads for paired-end library number N
            --pe-2 N                 file with reverse reads for paired-end library number N
            --pe-s N                 file with unpaired reads for paired-end library number N
            --pe-m N                 file with merged reads for paired-end library number N
            --pe-or N                orientation of reads for paired-end library number N
            --s N                    file with unpaired reads for single reads library number N
            --pacbio FILENAME        file with PacBio reads
            --nanopore FILENAME      file with Nanopore reads
            --only-error-correction  runs only read error correction (without assembling)
            --only-assembler         runs only assembling (without read error correction)
            --checkpoints WHEN       save intermediate check-points ('last', 'all')
            --continue               continue run from the last available check-point (only -o should be specified)
            --restart-from CP        restart run with updated options and from the specified check-point
            --disable-gzip-output    forces error correction not to compress the corrected reads
            --disable-rr             disables repeat resolution stage of assembling
            --dataset FILENAME       file with dataset description in YAML format
            -t, --threads INT        number of threads
            -m, --memory INT         RAM limit for SPAdes in Gb (terminates if exceeded)
            --tmp-dir DIRNAME        directory for temporary files
            -k INT                   list of k-mer sizes (must be odd and less than 128)
            --phred-offset OFFSET    PHRED quality offset in the input reads (33 or 64)
            --custom-hmms DIRNAME    directory with custom hmms that replace default ones
            --gfa11                  use GFA v1.1 format for assembly graph
            --frugal                 be memory frugal (at the expense of the possible assembly quality)
            --grid-engine GE         run under grid control ('slurm', 'local', 'mpi', save_yaml')
            --grid-queue STRING      submits the jobs to one of the specified queues
            --grid-nnodes INT        specifies the number of processors
            --grid-wait              wait for job finish
            --grid-extra STRING      any extra commands
            --grid-time STRING       time limit
        `,
        values: #{
            "-o": "dirs", "--12": k("reads"), "-1": k("reads"), "-2": k("reads"), "-s": k("reads"),
            "--merged": k("reads"), "--pe-12": "none", "--pe-1": "none", "--pe-2": "none", "--pe-s": "none",
            "--pe-m": "none", "--pe-or": "none", "--s": "none", "--pacbio": k("reads"), "--nanopore": k("reads"),
            "--checkpoints": ["last", "all"], "--restart-from": ["ec", "as", "mc", "last"], "--dataset": "files",
            "-t": "none", "--threads": "none", "-m": "none", "--memory": "none", "--tmp-dir": "dirs", "-k": "none",
            "--phred-offset": ["33", "64"], "--custom-hmms": "dirs",
            "--grid-engine": ["slurm", "local", "mpi", "save_yaml"], "--grid-queue": "none",
            "--grid-nnodes": "none", "--grid-extra": "none", "--grid-time": "none", "--sanger": k("reads"),
            "--trusted-contigs": k("fasta"), "--untrusted-contigs": k("fasta"), "--cov-cutoff": ["auto", "off"],
        },
        args: [k("reads")],
    }
}

fn megahit() {
    #{
        opts: `
            -1 PE1                     paired-end #1 files (FASTA/Q, comma-separated), paired with those of -2
            -2 PE2                     paired-end #2 files (FASTA/Q, comma-separated), paired with those of -1
            --12 PE12                  comma-separated list of interleaved fasta/q paired-end files
            -r, --read SE              comma-separated list of fasta/q single-end files
            --min-count INT            minimum multiplicity for filtering (k_min+1)-mers
            --k-list INTS              comma-separated list of k-mer sizes (odd, 15-255, steps <= 28)
            --k-min INT                minimum kmer size (<= 255), must be odd number
            --k-max INT                maximum kmer size (<= 255), must be odd number
            --k-step INT               increment of kmer size of each iteration (<= 28), must be even number
            --no-mercy                 do not add mercy kmers
            --bubble-level INT         intensity of bubble merging (0-2), 0 to disable
            --merge-level L,S          merge complex bubbles of length <= l*kmer_size and similarity >= s
            --prune-level INT          strength of low depth pruning (0-3)
            --prune-depth INT          remove unitigs with avg kmer depth less than this value
            --disconnect-ratio FLOAT   disconnect unitigs whose depth is below this ratio of their and their siblings' total
            --low-local-ratio FLOAT    remove unitigs whose depth is below this ratio of the mean depth of their neighbours
            --max-tip-len INT          remove tips less than this value [2*k]
            --cleaning-rounds INT      number of rounds for graph cleanning
            --no-local                 disable local assembly
            --kmin-1pass               use 1pass mode to build SdBG of k_min
            --presets STR              override a group of parameters: meta-sensitive, meta-large
            -m, --memory FLOAT         max memory in byte to be used in SdBG construction
            --mem-flag INT             SdBG builder memory mode: 0 minimum, 1 moderate, others all of --memory
            -t, --num-cpu-threads INT  number of CPU threads
            --no-hw-accel              run MEGAHIT without BMI2 and POPCNT hardware instructions
            -o, --out-dir STRING       output directory
            --out-prefix STRING        output prefix (the contig file will be OUT_DIR/OUT_PREFIX.contigs.fa)
            --min-contig-len INT       minimum length of contigs to output
            --keep-tmp-files           keep all temporary files
            --tmp-dir STRING           set temp directory
            --continue                 continue a MEGAHIT run from its last available check point
            --test                     run MEGAHIT on a toy test dataset
            -h, --help                 print the usage message
            -v, --version              print version
        `,
        values: #{
            "-1": k("reads"), "-2": k("reads"), "--12": k("reads"), "-r": k("reads"), "--read": k("reads"),
            "--min-count": "none", "--k-list": "none", "--k-min": "none", "--k-max": "none", "--k-step": "none",
            "--bubble-level": "none", "--merge-level": "none", "--prune-level": "none", "--prune-depth": "none",
            "--disconnect-ratio": "none", "--low-local-ratio": "none", "--max-tip-len": "none",
            "--cleaning-rounds": "none", "--presets": ["meta-sensitive", "meta-large"], "-m": "none",
            "--memory": "none", "--mem-flag": "none", "-t": "none", "--num-cpu-threads": "none", "-o": "dirs",
            "--out-dir": "dirs", "--out-prefix": "none", "--min-contig-len": "none", "--tmp-dir": "dirs",
        },
        args: ["none"],
    }
}

fn flye() {
    #{
        opts: `
            -h, --help                   show this help message and exit
            --pacbio-raw path            pacBio regular CLR reads
            --pacbio-corr path           pacBio reads that were corrected with other methods
            --pacbio-hifi path           pacBio HiFi reads
            --nano-raw path              ONT reads with older chemistries, pre R9 Guppy5 (10-20% error)
            --nano-corr path             ONT reads that were corrected with other methods
            --nano-hq path               ONT R10 reads, aka Q20
            --subassemblies path         [deprecated] high-quality contigs input
            -g, --genome-size size       estimated genome size (for example, 5m or 2.6g)
            -o, --out-dir path           output directory
            -t, --threads int            number of parallel threads
            -i, --iterations int         number of polishing iterations
            -m, --min-overlap int        minimum overlap between reads
            --asm-coverage int           reduced coverage for initial disjointig assembly [not set]
            --hifi-error float           [deprecated] same as --read-error
            --read-error float           adjust parameters for given read error rate (as fraction e.g 0.03)
            --extra-params extra_params  extra configuration parameters list (comma-separated)
            --plasmids                   unused (retained for backward compatibility)
            --meta                       metagenome / uneven coverage mode
            --keep-haplotypes            do not collapse alternative haplotypes
            --no-alt-contigs             do not output contigs representing alternative haplotypes
            --scaffold                   enable scaffolding using graph [disabled by default]
            --trestle                    [deprecated] enable Trestle [disabled by default]
            --polish-target path         run polisher on the target sequence
            --resume                     resume from the last completed stage
            --resume-from stage_name     resume from a custom stage
            --stop-after stage_name      stop after the specified stage completed
            --debug                      enable debug output
            -v, --version                show program's version number and exit
            --deterministic              perform disjointig assembly single-threaded
        `,
        values: #{
            "--pacbio-raw": k("reads"), "--pacbio-corr": k("reads"), "--pacbio-hifi": k("reads"),
            "--nano-raw": k("reads"), "--nano-corr": k("reads"), "--nano-hq": k("reads"),
            "--subassemblies": k("reads"), "-g": "none", "--genome-size": "none", "-o": "dirs",
            "--out-dir": "dirs", "-t": "none", "--threads": "none", "-i": "none", "--iterations": "none",
            "-m": "none", "--min-overlap": "none", "--asm-coverage": "none", "--hifi-error": "none",
            "--read-error": "none", "--extra-params": "none", "--polish-target": k("fasta"),
            "--resume-from": [
                "configure", "assembly", "consensus", "repeat", "contigger", "finalize", "polishing",
            ],
            "--stop-after": ["configure", "assembly", "consensus", "repeat", "contigger", "finalize", "polishing"],
        },
        args: [k("reads")],
    }
}

fn quast() {
    #{
        opts: `
            -o, --output-dir DIRNAME            directory to store all result files
            -r FILENAME                         reference genome file
            -g, --features FILENAME             file with genomic feature coordinates in the reference (GFF, BED, NCBI or TXT)
            -m, --min-contig INT                lower threshold for contig length
            -t, --threads INT                   maximum number of threads
            -s, --split-scaffolds               split assemblies by continuous fragments of N's and add such "contigs" to the comparison
            -l, --labels LABELS                 names of assemblies to use in reports, comma-separated
            -L                                  take assembly names from their parent directory names
            -e, --eukaryote                     genome is eukaryotic (primarily affects gene prediction)
            --fungus                            genome is fungal (primarily affects gene prediction)
            --large                             use optimal parameters for evaluation of large genomes
            -k, --k-mer-stats                   compute k-mer-based quality metrics (recommended for large genomes)
            --k-mer-size INT                    size of k used in --k-mer-stats
            --circos                            draw Circos plot
            -f, --gene-finding                  predict genes using GeneMarkS (prokaryotes, default) or GeneMark-ES
            --mgm                               use MetaGeneMark for gene prediction (instead of the default finder, see above)
            --glimmer                           use GlimmerHMM for gene prediction (instead of the default finder, see above)
            --gene-thresholds INTS              comma-separated list of threshold lengths of genes to search with Gene Finding module
            --rna-finding                       predict ribosomal RNA genes using Barrnap
            -b, --conserved-genes-finding       count conserved orthologs using BUSCO (only on Linux)
            --operons FILENAME                  file with operon coordinates in the reference (GFF, BED, NCBI or TXT)
            --est-ref-size INT                  estimated reference size (for computing NGx metrics without a reference)
            --contig-thresholds INTS            comma-separated list of contig length thresholds
            --x-for-Nx INT                      value of 'x' for Nx, Lx, etc metrics reported in addition to N50, L50, etc (0, 100)
            -u, --use-all-alignments            compute genome fraction, # genes, # operons in QUAST v1.* style
            -i, --min-alignment INT             the minimum alignment length
            --min-identity FLOAT                the minimum alignment identity (80.0, 100.0)
            -a, --ambiguity-usage NONE|ONE|ALL  use none, one, or all alignments of a contig when all of them
            --ambiguity-score FLOAT             score S for defining equally good alignments of a single contig
            --strict-NA                         break contigs in any misassembly event when compute NAx and NGAx
            -x, --extensive-mis-size INT        lower threshold for extensive misassembly size
            --local-mis-size INT                lower threshold on local misassembly size
            --scaffold-gap-max-size INT         max allowed scaffold gap length difference
            --unaligned-part-size INT           lower threshold for detecting partially unaligned contigs
            --skip-unaligned-mis-contigs        do not distinguish contigs with >= 50% unaligned bases as a separate group
            --fragmented                        reference genome may be fragmented into small pieces
            --fragmented-max-indent INT         mark translocation as fake if both alignments are located no further than N bases
            --upper-bound-assembly              simulate upper bound assembly based on the reference genome and reads
            --upper-bound-min-con INT           minimal number of 'connecting reads' needed for joining upper bound contigs into a
            --est-insert-size INT               use provided insert size in upper bound assembly simulation
            --report-all-metrics                keep all quality metrics in the main report even if their values are '-' for all
            --plots-format STR                  save plots in specified format
            --memory-efficient                  run everything using one thread, separately per each assembly
            --space-efficient                   create only reports and plots files
            -1, --pe1 FILENAME                  file with forward paired-end reads (in FASTQ format, may be gzipped)
            -2, --pe2 FILENAME                  file with reverse paired-end reads (in FASTQ format, may be gzipped)
            --pe12 FILENAME                     file with interlaced forward and reverse paired-end reads
            --mp1 FILENAME                      file with forward mate-pair reads (in FASTQ format, may be gzipped)
            --mp2 FILENAME                      file with reverse mate-pair reads (in FASTQ format, may be gzipped)
            --mp12 FILENAME                     file with interlaced forward and reverse mate-pair reads (in FASTQ format, may be gzipped)
            --single FILENAME                   file with unpaired short reads (in FASTQ format, may be gzipped)
            --pacbio FILENAME                   file with PacBio reads (in FASTQ format, may be gzipped)
            --nanopore FILENAME                 file with Oxford Nanopore reads (in FASTQ format, may be gzipped)
            --ref-sam FILENAME                  SAM alignment file obtained by aligning reads to reference genome file
            --ref-bam FILENAME                  BAM alignment file obtained by aligning reads to reference genome file
            --sam FILENAMES                     comma-separated list of SAM alignment files obtained by aligning reads to assemblies
            --bam FILENAMES                     comma-separated list of BAM alignment files obtained by aligning reads to assemblies
            --sv-bedpe FILENAME                 file with structural variations (in BEDPE format)
            --no-check                          do not check and correct input fasta files
            --no-plots                          do not draw static plots
            --no-html                           do not build html reports and Icarus viewers
            --no-icarus                         do not build Icarus viewers
            --no-snps                           do not report SNPs (may significantly reduce memory consumption on large genomes)
            --no-gc                             do not compute GC% and GC-distribution
            --no-sv                             do not run structural variation detection (make sense only if reads are specified)
            --no-read-stats                     do not align reads to assemblies
            --fast                              a combination of all speedup options except --no-check
            --silent                            do not print detailed information about each step to stdout (log file is not affected)
            --test                              run QUAST on the data from the test_data folder, output to quast_test_output
            --test-sv                           run QUAST with structural variants detection on the data from the test_data folder
            -h, --help                          print full usage message
            -v, --version                       print version
        `,
        values: #{
            "-o": "dirs", "--output-dir": "dirs", "-r": k("fasta"), "-g": "files", "--features": "files",
            "-m": "none", "--min-contig": "none", "-t": "none", "--threads": "none", "-l": "none",
            "--labels": "none", "--k-mer-size": "none", "--gene-thresholds": "none", "--operons": "files",
            "--est-ref-size": "none", "--contig-thresholds": "none", "--x-for-Nx": "none", "-i": "none",
            "--min-alignment": "none", "--min-identity": "none", "-a": ["none", "one", "all"],
            "--ambiguity-usage": ["none", "one", "all"], "--ambiguity-score": "none", "-x": "none",
            "--extensive-mis-size": "none", "--local-mis-size": "none", "--scaffold-gap-max-size": "none",
            "--unaligned-part-size": "none", "--fragmented-max-indent": "none", "--upper-bound-min-con": "none",
            "--est-insert-size": "none",
            "--plots-format": ["emf", "eps", "pdf", "png", "ps", "raw", "rgba", "svg", "svgz"], "-1": k("fastq"),
            "--pe1": k("fastq"), "-2": k("fastq"), "--pe2": k("fastq"), "--pe12": k("fastq"), "--mp1": k("fastq"),
            "--mp2": k("fastq"), "--mp12": k("fastq"), "--single": k("fastq"), "--pacbio": k("reads"),
            "--nanopore": k("reads"), "--ref-sam": k("sam"), "--ref-bam": k("bam"), "--sam": k("sam"),
            "--bam": k("bam"), "--sv-bedpe": k("bed"), "--references-list": "files", "--blast-db": "files",
        },
        args: [k("fasta")],
    }
}

fn metaquast() {
    #{
        opts: `
            -o, --output-dir DIRNAME            directory to store all result files
            -r FILENAMES                        comma-separated list of reference genomes or directory with reference genomes
            --references-list FILENAME          text file with list of reference genome names for downloading from NCBI
            -g, --features FILENAME             file with genomic feature coordinates in the references (GFF, BED, NCBI or TXT)
            -m, --min-contig INT                lower threshold for contig length
            -t, --threads INT                   maximum number of threads
            -s, --split-scaffolds               split assemblies by continuous fragments of N's and add such "contigs" to the comparison
            -l, --labels LABELS                 names of assemblies to use in reports, comma-separated
            -L                                  take assembly names from their parent directory names
            -e, --eukaryote                     genome is eukaryotic (primarily affects gene prediction)
            --fungus                            genome is fungal (primarily affects gene prediction)
            --large                             use optimal parameters for evaluation of large genomes
            -k, --k-mer-stats                   compute k-mer-based quality metrics (recommended for large genomes)
            --k-mer-size INT                    size of k used in --k-mer-stats
            --circos                            draw Circos plot
            -f, --gene-finding                  predict genes using MetaGeneMark
            --glimmer                           use GlimmerHMM for gene prediction (instead of the default finder, see above)
            --gene-thresholds INTS              comma-separated list of threshold lengths of genes to search with Gene Finding module
            --rna-finding                       predict ribosomal RNA genes using Barrnap
            -b, --conserved-genes-finding       count conserved orthologs using BUSCO (only on Linux)
            --operons FILENAME                  file with operon coordinates in the reference (GFF, BED, NCBI or TXT)
            --max-ref-number INT                maximum number of references (per each assembly) to download after looking in SILVA
            --blast-db FILENAME                 custom BLAST database (.nsq file)
            --use-input-ref-order               use provided order of references in MetaQUAST summary plots
            --contig-thresholds INTS            comma-separated list of contig length thresholds
            --x-for-Nx INT                      value of 'x' for Nx, Lx, etc metrics reported in addition to N50, L50, etc (0, 100)
            --reuse-combined-alignments         reuse the alignments from the combined_reference stage on runs_per_reference stages
            -u, --use-all-alignments            compute genome fraction, # genes, # operons in QUAST v1.* style
            -i, --min-alignment INT             the minimum alignment length
            --min-identity FLOAT                the minimum alignment identity (80.0, 100.0)
            -a, --ambiguity-usage NONE|ONE|ALL  use none, one, or all alignments of a contig when all of them
            --ambiguity-score FLOAT             score S for defining equally good alignments of a single contig
            --unique-mapping                    disable --ambiguity-usage=all for the combined reference run
            --strict-NA                         break contigs in any misassembly event when compute NAx and NGAx
            -x, --extensive-mis-size INT        lower threshold for extensive misassembly size
            --local-mis-size INT                lower threshold on local misassembly size
            --scaffold-gap-max-size INT         max allowed scaffold gap length difference
            --unaligned-part-size INT           lower threshold for detecting partially unaligned contigs
            --skip-unaligned-mis-contigs        do not distinguish contigs with >= 50% unaligned bases as a separate group
            --fragmented                        reference genome may be fragmented into small pieces
            --fragmented-max-indent INT         mark translocation as fake if both alignments are located no further than N bases
            --upper-bound-assembly              simulate upper bound assembly based on the reference genome and reads
            --upper-bound-min-con INT           minimal number of 'connecting reads' needed for joining upper bound contigs into a
            --est-insert-size INT               use provided insert size in upper bound assembly simulation
            --report-all-metrics                keep all quality metrics in the main report even if their values are '-' for all
            --plots-format STR                  save plots in specified format
            --memory-efficient                  run everything using one thread, separately per each assembly
            --space-efficient                   create only reports and plots files
            -1, --pe1 FILENAME                  file with forward paired-end reads (in FASTQ format, may be gzipped)
            -2, --pe2 FILENAME                  file with reverse paired-end reads (in FASTQ format, may be gzipped)
            --pe12 FILENAME                     file with interlaced forward and reverse paired-end reads
            --mp1 FILENAME                      file with forward mate-pair reads (in FASTQ format, may be gzipped)
            --mp2 FILENAME                      file with reverse mate-pair reads (in FASTQ format, may be gzipped)
            --mp12 FILENAME                     file with interlaced forward and reverse mate-pair reads (in FASTQ format, may be gzipped)
            --single FILENAME                   file with unpaired short reads (in FASTQ format, may be gzipped)
            --pacbio FILENAME                   file with PacBio reads (in FASTQ format, may be gzipped)
            --nanopore FILENAME                 file with Oxford Nanopore reads (in FASTQ format, may be gzipped)
            --ref-sam FILENAME                  SAM alignment file obtained by aligning reads to reference genome file
            --ref-bam FILENAME                  BAM alignment file obtained by aligning reads to reference genome file
            --sam FILENAMES                     comma-separated list of SAM alignment files obtained by aligning reads to assemblies
            --bam FILENAMES                     comma-separated list of BAM alignment files obtained by aligning reads to assemblies
            --sv-bedpe FILENAME                 file with structural variations (in BEDPE format)
            --no-check                          do not check and correct input fasta files
            --no-plots                          do not draw static plots
            --no-krona                          do not draw Krona pie charts (in the without references mode)
            --no-html                           do not build html reports and Icarus viewers
            --no-icarus                         do not build Icarus viewers
            --no-snps                           do not report SNPs (may significantly reduce memory consumption on large genomes)
            --no-gc                             do not compute GC% and GC-distribution
            --no-sv                             do not run structural variation detection (make sense only if reads are specified)
            --no-read-stats                     do not align reads to assemblies
            --fast                              a combination of all speedup options except --no-check
            --silent                            do not print detailed information about each step to stdout (log file is not affected)
            --test                              run MetaQUAST on the data from the test_data folder, output to quast_test_output
            --test-no-ref                       run MetaQUAST without references on the data from the test_data folder, output to
            -h, --help                          print full usage message
            -v, --version                       print version
        `,
        values: #{
            "-o": "dirs", "--output-dir": "dirs", "-r": k("fasta"), "--references-list": "files", "-g": "files",
            "--features": "files", "-m": "none", "--min-contig": "none", "-t": "none", "--threads": "none",
            "-l": "none", "--labels": "none", "--k-mer-size": "none", "--gene-thresholds": "none",
            "--operons": "files", "--max-ref-number": "none", "--blast-db": "files", "--contig-thresholds": "none",
            "--x-for-Nx": "none", "-i": "none", "--min-alignment": "none", "--min-identity": "none",
            "-a": ["none", "one", "all"], "--ambiguity-usage": ["none", "one", "all"], "--ambiguity-score": "none",
            "-x": "none", "--extensive-mis-size": "none", "--local-mis-size": "none",
            "--scaffold-gap-max-size": "none", "--unaligned-part-size": "none", "--fragmented-max-indent": "none",
            "--upper-bound-min-con": "none", "--est-insert-size": "none",
            "--plots-format": ["emf", "eps", "pdf", "png", "ps", "raw", "rgba", "svg", "svgz"], "-1": k("fastq"),
            "--pe1": k("fastq"), "-2": k("fastq"), "--pe2": k("fastq"), "--pe12": k("fastq"), "--mp1": k("fastq"),
            "--mp2": k("fastq"), "--mp12": k("fastq"), "--single": k("fastq"), "--pacbio": k("reads"),
            "--nanopore": k("reads"), "--ref-sam": k("sam"), "--ref-bam": k("bam"), "--sam": k("sam"),
            "--bam": k("bam"), "--sv-bedpe": k("bed"),
        },
        args: [k("fasta")],
    }
}

fn busco() {
    #{
        opts: `
            -i, --in SEQUENCE_FILE                 input sequence file in FASTA format
            -o, --out OUTPUT                       give your analysis run a recognisable short name
            -m, --mode MODE                        specify which BUSCO analysis mode to run
            -l, --lineage_dataset LINEAGE          specify the name of the BUSCO lineage to be used
            --augustus                             use augustus gene predictor for eukaryote runs
            --augustus_parameters PARAMS           pass additional arguments to Augustus
            --augustus_species AUGUSTUS_SPECIES    specify a species for Augustus training
            --auto-lineage                         run auto-lineage to find optimum lineage path
            --auto-lineage-euk                     run auto-placement just on eukaryote tree to find optimum lineage path
            --auto-lineage-prok                    run auto-lineage just on non-eukaryote trees to find optimum lineage path
            -c, --cpu N                            specify the number (N=integer) of threads/cores to use
            --config CONFIG_FILE                   provide a config file
            --contig_break n                       number of contiguous Ns to signify a break between contigs
            --datasets_version DATASETS_VERSION    specify the version of BUSCO datasets, e.g odb10, odb12 or odb12.2
            --download dataset                     download dataset
            --download_base_url DOWNLOAD_BASE_URL  set the url to the remote BUSCO dataset location
            --download_path DOWNLOAD_PATH          specify local filepath for storing BUSCO dataset downloads
            -e, --evalue N                         e-value cutoff for BLAST searches
            -f, --force                            force rewriting of existing files
            -h, --help                             show this help message and exit
            --limit N                              how many candidate regions (contig or transcript) to consider per BUSCO
            --list-datasets[=LIST_DATASETS]        print the list of available BUSCO datasets
            --long                                 optimization mode of Augustus self-training (slow)
            --metaeuk                              use Metaeuk gene predictor
            --metaeuk_parameters PARAMS            pass additional arguments to Metaeuk for the first run
            --metaeuk_rerun_parameters PARAMS      pass additional arguments to Metaeuk for the second run
            --miniprot                             use Miniprot gene predictor
            --skip_bbtools                         skip BBTools for assembly statistics
            --offline                              to indicate that BUSCO cannot attempt to download files
            --opt-out-run-stats                    opt out of data collection
            --out_path OUTPUT_PATH                 optional location for results folder, excluding results folder name
            --plot WORKING_DIRECTORY               generate a BUSCO summary plot for all short summary files in the given working directory
            --plot_percentages                     plot the percentages of BUSCOs instead of the number of BUSCOs
            -q, --quiet                            disable the info logs, displays only errors
            -r, --restart                          continue a run that had already partially completed
            --scaffold_composition                 writes ACGTN content per scaffold to a file scaffold_composition.txt
            --tar                                  compress some subdirectories with many files to save space
            -v, --version                          show this version and exit
        `,
        values: #{
            "-i": k("fasta"), "--in": k("fasta"), "-o": "none", "--out": "none",
            "-m": ["genome", "geno", "transcriptome", "tran", "proteins", "prot"],
            "--mode": ["genome", "geno", "transcriptome", "tran", "proteins", "prot"], "-l": k("busco_lineage"),
            "--lineage_dataset": k("busco_lineage"), "--augustus_parameters": "none", "--augustus_species": "none",
            "-c": "none", "--cpu": "none", "--config": "files", "--contig_break": "none",
            "--datasets_version": ["odb10", "odb12", "odb12.2"], "--download": k("busco_download"),
            "--download_base_url": "none", "--download_path": "dirs", "-e": "none", "--evalue": "none",
            "--limit": "none", "--list-datasets": ["odb10", "odb12", "odb12.2"], "--metaeuk_parameters": "none",
            "--metaeuk_rerun_parameters": "none", "--out_path": "dirs", "--plot": "dirs",
        },
        args: ["none"],
    }
}

fn prodigal() {
    #{
        opts: `
            -a TRANS_FILE     write protein translations to the selected file
            -c                closed ends: don't let genes run off the edges
            -d NUC_FILE       write nucleotide sequences of genes to the selected file
            -f OUTPUT_TYPE    select output format (gbk, gff, or sco)
            -g TR_TABLE       specify a translation table to use
            -h                print help menu and exit
            -i INPUT_FILE     specify FASTA/Genbank input file
            -m                treat runs of N as masked sequence; don't build genes across them
            -n                bypass Shine-Dalgarno trainer and force a full motif scan
            -o OUTPUT_FILE    specify output file
            -p MODE           select procedure (single or meta)
            -q                run quietly (suppress normal stderr output)
            -s START_FILE     write all potential genes (with scores) to the selected file
            -t TRAINING_FILE  write a training file, or read it if it exists
            -v                print version number and exit
        `,
        values: #{
            "-a": "files", "-d": "files", "-f": ["gbk", "gff", "sco"], "-g": "none", "-i": k("fasta"),
            "-o": "files", "-p": ["single", "meta"], "-s": "files", "-t": "files",
        },
        args: ["none"],
    }
}

fn prokka() {
    #{
        opts: `
            --help            this help
            --version         print version and exit
            --citation        print citation for referencing Prokka
            --quiet           no screen output
            --debug           debug mode: keep all temporary files
            --dbdir X         Prokka database root folders
            --listdb          list all configured databases
            --setupdb         index all installed databases
            --cleandb         remove all database indices
            --depends         list all software dependencies
            --outdir X        output folder [auto]
            --force           force overwriting existing output folder
            --prefix X        filename output prefix [auto]
            --addgenes        add 'gene' features for each 'CDS' feature
            --addmrna         add 'mRNA' features for each 'CDS' feature
            --locustag X      locus tag prefix [auto]
            --increment N     locus tag counter increment
            --gffver N        GFF version
            --compliant       force Genbank/ENA/DDJB compliance: --addgenes --mincontiglen 200 --centre XXX
            --centre X        sequencing centre ID
            --accver N        version to put in Genbank file
            --genus X         genus name
            --species X       species name
            --strain X        strain name
            --plasmid X       plasmid name or identifier
            --kingdom X       annotation mode: Archaea|Bacteria|Mitochondria|Viruses
            --gcode N         genetic code / Translation table (set if --kingdom is set)
            --prodigaltf X    prodigal training file
            --gram X          gram: -/neg +/pos
            --usegenus        use genus-specific BLAST databases (needs --genus)
            --proteins X      FASTA or GBK file to use as 1st priority
            --hmms X          trusted HMM to first annotate from
            --metagenome      improve gene predictions for highly fragmented genomes
            --rawproduct      do not clean up /product annotation
            --cdsrnaolap      allow [tr]RNA to overlap CDS
            --evalue NUM      similarity e-value cut-off
            --coverage NUM    minimum coverage on query protein
            --cpus N          number of CPUs to use [0=all]
            --fast            fast mode - only use basic BLASTP databases
            --noanno          for CDS just set /product="unannotated protein"
            --mincontiglen N  minimum contig size [NCBI needs 200]
            --rfam            enable searching for ncRNAs with Infernal+Rfam (SLOW!)
            --norrna          don't run rRNA search
            --notrna          don't run tRNA search
            --rnammer         prefer RNAmmer over Barrnap for rRNA prediction
        `,
        values: #{
            "--dbdir": "dirs", "--outdir": "dirs", "--prefix": "none", "--locustag": "none", "--increment": "none",
            "--gffver": ["1", "2", "3"], "--centre": "none", "--accver": "none", "--genus": "none",
            "--species": "none", "--strain": "none", "--plasmid": "none",
            "--kingdom": ["Archaea", "Bacteria", "Mitochondria", "Viruses"], "--gcode": "none",
            "--prodigaltf": "files", "--gram": ["neg", "pos"], "--proteins": "files", "--hmms": k("hmm"),
            "--evalue": "none", "--coverage": "none", "--cpus": "none", "--mincontiglen": "none",
        },
        args: [k("fasta")],
    }
}

fn bakta() {
    #{
        opts: `
            -d, --db DB                                database path
            -m, --min-contig-length MIN_CONTIG_LENGTH  minimum contig/sequence size
            -p, --prefix PREFIX                        prefix for output files
            -o, --output OUTPUT                        output directory
            -f, --force                                force overwriting existing output folder (except for current working directory)
            --genus GENUS                              genus name
            --species SPECIES                          species name
            --strain STRAIN                            strain name
            --plasmid PLASMID                          plasmid name
            --complete                                 all sequences are complete replicons (chromosome/plasmid[s])
            --prodigal-tf PRODIGAL_TF                  path to existing Prodigal training file to use for CDS prediction
            --translation-table 11|4|25                translation table: 11/4/25
            --gram +|-|?                               gram type for signal peptide predictions: +/-/?
            --locus LOCUS                              locus prefix
            --locus-tag LOCUS_TAG                      locus tag prefix
            --locus-tag-increment 1|5|10               locus tag increment: 1/5/10
            --keep-contig-headers                      keep original contig/sequence headers
            --compliant                                force Genbank/ENA/DDJB compliance
            -r, --replicons REPLICONS                  replicon information table (tsv/csv)
            --regions REGIONS                          path to pre-annotated regions in GFF3 or Genbank format
            --proteins PROTEINS                        fasta file of trusted protein sequences for CDS annotation
            --hmms HMMS                                HMM file of trusted hidden markov models in HMMER format for CDS annotation
            --meta                                     run in metagenome mode
            --partial                                  predict partial (truncated) genes spanning linear sequence ends
            --skip-trna                                skip tRNA detection & annotation
            --skip-tmrna                               skip tmRNA detection & annotation
            --skip-rrna                                skip rRNA detection & annotation
            --skip-ncrna                               skip ncRNA detection & annotation
            --skip-ncrna-region                        skip ncRNA region detection & annotation
            --skip-crispr                              skip CRISPR array detection & annotation
            --skip-cds                                 skip CDS detection & annotation
            --skip-pseudo                              skip pseudogene detection & annotation
            --skip-sorf                                skip sORF detection & annotation
            --skip-gap                                 skip gap detection & annotation
            --skip-ori                                 skip oriC/oriT detection & annotation
            --skip-filter                              skip feature overlap filters
            --skip-plot                                skip generation of circular genome plots
            -h, --help                                 show this help message and exit
            -v, --verbose                              print verbose information
            --debug                                    run Bakta in debug mode
            -t, --threads THREADS                      number of threads to use
            --tmp-dir TMP_DIR                          location for temporary files
            --version                                  show program's version number and exit
        `,
        values: #{
            "-d": "dirs", "--db": "dirs", "-m": "none", "--min-contig-length": "none", "-p": "none",
            "--prefix": "none", "-o": "dirs", "--output": "dirs", "--genus": "none", "--species": "none",
            "--strain": "none", "--plasmid": "none", "--prodigal-tf": "files",
            "--translation-table": ["11", "4", "25"], "--gram": ["+", "-", "?"], "--locus": "none",
            "--locus-tag": "none", "--locus-tag-increment": ["1", "5", "10"], "-r": "files",
            "--replicons": "files", "--regions": "files", "--proteins": "files", "--hmms": k("hmm"), "-t": "none",
            "--threads": "none", "--tmp-dir": "dirs",
        },
        args: [k("fasta")],
    }
}

fn barrnap() {
    #{
        opts: `
            --help         this help
            --version      print version and exit
            --citation     print citation for referencing barrnap
            --quiet        no screen output
            --debug        debug mode
            --listdb       show installed database
            --updatedb     update databases from internet
            --dbdir STR    location of databases
            --kingdom STR  kingdom: bac arc fun
            --gcode STR    genetic code table
            --all          find all RNA features
            --rrna         find rRNA, disable with --no-rrna
            --trna         find tRNA/tmRNA, disable with --no-trna
            --ncrna        find ncRNA, disable with --no-ncrna
            --mrna         identify mRNA coding regions, disable with --no-mrna
            --threads INT  CPU cores to use
            --fast         trade speed for accuracy
            --evalue NUM   similarity e-value cut-off
            --addids       add unique ID tags
            --incseq       include original input sequences
            --incseqreg    include #sequence-region headers
            --outseq STR   save RNA hits to a FASTA file
            --no-rrna      don't find rRNA
            --no-trna      don't find tRNA
            --no-ncrna     don't find ncRNA
            --no-mrna      don't find mRNA
        `,
        values: #{
            "--dbdir": "dirs", "--kingdom": ["bac", "arc", "fun"], "--gcode": "none", "--threads": "none",
            "--evalue": "none", "--outseq": "files",
        },
        args: [k("sequences")],
    }
}

fn spec(cmd) {
    switch cmd {
        "spades.py" => spades(),
        "metaspades.py" => metaspades(),
        "megahit" => megahit(),
        "flye" => flye(),
        "quast" => quast(),
        "quast.py" => quast(),
        "metaquast" => metaquast(),
        "metaquast.py" => metaquast(),
        "busco" => busco(),
        "prodigal" => prodigal(),
        "prokka" => prokka(),
        "bakta" => bakta(),
        "barrnap" => barrnap(),
        _ => #{},
    }
}
