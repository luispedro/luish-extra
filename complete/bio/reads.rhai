fn rasusa() {
    #{
        opts: `
            -v             switch on verbosity
            -h, --help     print help
            -V, --version  print version
        `,
        commands: `
            reads  randomly subsample reads (FASTA/Q, unaligned SAM/BAM/CRAM)
            aln    randomly subsample alignments to a specified depth of coverage
            cite   get a bibtex formatted citation for this package
            help   print this message or the help of the given subcommand(s)
        `,
        subs: #{
            reads: #{
                opts: `
                    -o, --output <OUTPUT>                output filepath(s); stdout if not present
                    -g, --genome-size <size|faidx>       genome size to calculate coverage with respect to
                    -c, --coverage <FLOAT>               the desired depth of coverage to subsample the reads to
                    -b, --bases <bases>                  explicitly set the number of bases required e.g., 4.3kb, 7Tb, 9000, 4.1MB
                    -n, --num <INT>                      subsample to a specific number of reads
                    -f, --frac <FLOAT>                   subsample to a fraction of the reads - e.g., 0.5 samples half the reads
                    -1, --one-pass                       read the input exactly once, keeping each read independently with probability --frac
                    -p, --probability <FLOAT>            keep each read independently with this probability, streaming the input once
                    -e, --strict                         exit with an error if the requested coverage/bases/reads is not possible
                    -s, --seed <INT>                     random seed to use
                    -v                                   switch on verbosity
                    -Z, --compress-type <u|b|g|l|x|z>    u: uncompressed; b: Bzip2; g: Gzip; l: Lzma; x: Xz (Lzma); z: Zstd
                    -O, --output-format <OUTPUT_FORMAT>  explicitly set the output format
                    -l, --compress-level <1-21>          compression level to use if compressing output
                    -@, --threads <INT>                  number of threads to use for BAM (de)compression
                    -h, --help                           print help (see a summary with '-h')
                    -V, --version                        print version
                `,
                values: #{
                    "-o": "files", "--output": "files", "-g": "files", "--genome-size": "files", "-c": "none",
                    "--coverage": "none", "-b": "none", "--bases": "none", "-n": "none", "--num": "none",
                    "-f": "none", "--frac": "none", "-p": "none", "--probability": "none", "-s": "none",
                    "--seed": "none", "-Z": ["u", "b", "g", "l", "x", "z"],
                    "--compress-type": ["u", "b", "g", "l", "x", "z"],
                    "-O": ["fasta", "fastq", "sam", "bam", "cram"],
                    "--output-format": ["fasta", "fastq", "sam", "bam", "cram"], "-l": "none",
                    "--compress-level": "none", "-@": "none", "--threads": "none",
                },
                args: [k("reads")],
            },
            aln: #{
                opts: `
                    -o, --output <FILE>        path to the output subsampled alignment file
                    -O, --output-format <FMT>  output format
                    -c, --coverage <INT>       the desired depth of coverage to subsample the alignment to
                    -s, --seed <INT>           random seed to use
                    --strategy <STRATEGY>      subsampling strategy
                    --swap-distance <INT>      [Stream] A maximum distance (bp) allowed between start position of new read and the worst
                    --step-size <INT>          [Fetch] When a region has less than the desired coverage, the step size to move along the
                    --batch-size <INT>         [Fetch] The size of the genomic window (bp) to cache into memory at once
                    -@, --threads <INT>        number of threads to use for BAM (de)compression
                    -h, --help                 print help (see a summary with '-h')
                    -V, --version              print version
                `,
                values: #{
                    "-o": "files", "--output": "files", "-O": ["sam", "bam", "cram"],
                    "--output-format": ["sam", "bam", "cram"], "-c": "none", "--coverage": "none", "-s": "none",
                    "--seed": "none", "--strategy": ["stream", "fetch"], "--swap-distance": "none",
                    "--step-size": "none", "--batch-size": "none", "-@": "none", "--threads": "none",
                },
