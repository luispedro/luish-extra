// Read QC, trimming and filtering: fastp, fastqc, falco, cutadapt, trimmomatic,
// trim_galore, fastq_screen, seqtk, filtlong, chopper, nanoq, rasusa, porechop,
// NanoPlot, NanoFilt and NanoStat. Generated by scripts/gen/mk_reads.py from
// the tools' own `--help` or argparse parser (versions in completion-todo.md).

fn k(name) { "@extra-complete/bio/kinds:" + name }

fn fastp() {
    #{
        opts: `
            -i, --in1 FILE                         read1 input file name
            -o, --out1 FILE                        read1 output file name
            -I, --in2 FILE                         read2 input file name
            -O, --out2 FILE                        read2 output file name
            --unpaired1 FILE                       for PE input, if read1 passed QC but read2 not, it will be written to unpaired1
            --unpaired2 FILE                       for PE input, if read2 passed QC but read1 not, it will be written to unpaired2
            --overlapped_out FILE                  for each read pair, output the overlapped region if it has no any mismatched base
            --failed_out FILE                      specify the file to store reads that cannot pass the filters
            -m, --merge                            for paired-end input, merge each pair of reads into a single read if they are overlapped
            --merged_out FILE                      in the merging mode, specify the file name to store merged output, or specify --stdout to
            --include_unmerged                     in the merging mode, write the unmerged or unpaired reads to the file specified by --merge
            -6, --phred64                          indicate the input is using phred64 scoring
            -z, --compression INT                  compression level for gzip output (1 ~ 9)
            --stdin                                input from STDIN. If the STDIN is interleaved paired-end FASTQ, please also add
            --stdout                               stream passing-filters reads to STDOUT. This option will result in interleaved FASTQ
            --interleaved_in                       indicate that <in1> is an interleaved FASTQ which contains both read1 and read2
            --reads_to_process INT                 specify how many reads/pairs to be processed
            --dont_overwrite                       don't overwrite existing files
            --fix_mgi_id                           the MGI FASTQ ID format is not compatible with many BAM operation tools, enable this
            -V, --verbose                          output verbose log information
            -A, --disable_adapter_trimming         adapter trimming is enabled by default
            -a, --adapter_sequence STR             the adapter for read1
            --adapter_sequence_r2 STR              the adapter for read2 (PE data only)
            --adapter_fasta FILE                   specify a FASTA file to trim both read1 and read2 (if PE) by all the sequences in this
            -2, --detect_adapter_for_pe            enable adapter detection for PE data to get ultra-clean data
            --allow_gap_overlap_trimming           allow up to one gap when trim adapters by overlap analysis for PE data
            --dimer_max_len INT                    if the read length is less than or equal to this value after adapter trimming, it is
            -f, --trim_front1 INT                  trimming how many bases in front for read1, default is 0
            -t, --trim_tail1 INT                   trimming how many bases in tail for read1, default is 0
            -b, --max_len1 INT                     if read1 is longer than max_len1, then trim read1 at its tail to make it as long as
            -F, --trim_front2 INT                  trimming how many bases in front for read2
            -T, --trim_tail2 INT                   trimming how many bases in tail for read2
            -B, --max_len2 INT                     if read2 is longer than max_len2, then trim read2 at its tail to make it as long as
            -D, --dedup                            enable deduplication to drop the duplicated reads/pairs
            --dup_calc_accuracy INT                accuracy level to calculate duplication (1~6), higher level uses more memory
            --dont_eval_duplication                don't evaluate duplication rate to save time and use less memory
            -g, --trim_poly_g                      force polyG tail trimming, by default trimming is automatically enabled for Illumina
            --poly_g_min_len INT                   the minimum length to detect polyG in the read tail
            -G, --disable_trim_poly_g              disable polyG tail trimming, by default trimming is automatically enabled for Illumina
            -x, --trim_poly_x                      enable polyX trimming in 3' ends
            --poly_x_min_len INT                   the minimum length to detect polyX in the read tail
            -5, --cut_front                        move a sliding window from front (5') to tail, drop the bases in the window if its mean
            -3, --cut_tail                         move a sliding window from tail (3') to front, drop the bases in the window if its mean
            -r, --cut_right                        move a sliding window from front to tail, if meet one window with mean quality <
            -W, --cut_window_size INT              the window size option shared by cut_front, cut_tail or cut_sliding
            -M, --cut_mean_quality INT             the mean quality requirement option shared by cut_front, cut_tail or cut_sliding
            --cut_front_window_size INT            the window size option of cut_front, default to cut_window_size if not specified
            --cut_front_mean_quality INT           the mean quality requirement option for cut_front, default to cut_mean_quality if not
            --cut_tail_window_size INT             the window size option of cut_tail, default to cut_window_size if not specified
            --cut_tail_mean_quality INT            the mean quality requirement option for cut_tail, default to cut_mean_quality if not
            --cut_right_window_size INT            the window size option of cut_right, default to cut_window_size if not specified
            --cut_right_mean_quality INT           the mean quality requirement option for cut_right, default to cut_mean_quality if not
            -Q, --disable_quality_filtering        quality filtering is enabled by default
            -q, --qualified_quality_phred INT      the quality value that a base is qualified
            -u, --unqualified_percent_limit INT    how many percents of bases are allowed to be unqualified (0~100)
            -n, --n_base_limit INT                 if one read's number of N base is >n_base_limit, then this read/pair is discarded
            -e, --average_qual INT                 if one read's average quality score <avg_qual, then this read/pair is discarded
            -L, --disable_length_filtering         length filtering is enabled by default
            -l, --length_required INT              reads shorter than length_required will be discarded, default is 15
            --length_limit INT                     reads longer than length_limit will be discarded, default 0 means no limitation
            -y, --low_complexity_filter            enable low complexity filter
            -Y, --complexity_threshold INT         the threshold for low complexity filter (0~100)
            --filter_by_index1 FILE                specify a file contains a list of barcodes of index1 to be filtered out, one barcode per
            --filter_by_index2 FILE                specify a file contains a list of barcodes of index2 to be filtered out, one barcode per
            --filter_by_index_threshold INT        the allowed difference of index barcode for index filtering, default 0 means completely
            -c, --correction                       enable base correction in overlapped regions (only for PE data), default is disabled
            --overlap_len_require INT              the minimum length to detect overlapped region of PE reads
            --overlap_diff_limit INT               the maximum number of mismatched bases to detect overlapped region of PE reads
            --overlap_diff_percent_limit INT       the maximum percentage of mismatched bases to detect overlapped region of PE reads
            -U, --umi                              enable unique molecular identifier (UMI) preprocessing
            --umi_loc STR                          specify the location of UMI, can be
            --umi_len INT                          if the UMI is in read1/read2, its length should be provided
            --umi_prefix STR                       if specified, an underline will be used to connect prefix and UMI
            --umi_skip INT                         if the UMI is in read1/read2, fastp can skip several bases following UMI, default is 0
            --umi_delim STR                        delimiter to use between the read name and the UMI, default is :
            -p, --overrepresentation_analysis      enable overrepresented sequence analysis
            -P, --overrepresentation_sampling INT  one in (--overrepresentation_sampling) reads will be computed for overrepresentation
            -j, --json FILE                        the json format report file name
            -h, --html FILE                        the html format report file name
            -R, --report_title STR                 should be quoted with ' or ", default is "fastp report"
            -w, --thread INT                       worker thread number, default is 3
            -s, --split INT                        split output by limiting total split file number with this option (2~999), a sequential
            -S, --split_by_lines INT               split output by limiting lines of each file with this option(>=1000), a sequential number
            -d, --split_prefix_digits INT          the digits for the sequential number padding (1~10), default is 4, so the filename will
            -?, --help                             print this message
        `,
        values: #{
            "-i": k("fastq"), "--in1": k("fastq"), "-o": "files", "--out1": "files", "-I": k("fastq"),
            "--in2": k("fastq"), "-O": "files", "--out2": "files", "--unpaired1": "files", "--unpaired2": "files",
            "--overlapped_out": "files", "--failed_out": "files", "--merged_out": "files", "-z": "none",
            "--compression": "none", "--reads_to_process": "none", "-a": "none", "--adapter_sequence": "none",
            "--adapter_sequence_r2": "none", "--adapter_fasta": k("fasta"), "--dimer_max_len": "none",
            "-f": "none", "--trim_front1": "none", "-t": "none", "--trim_tail1": "none", "-b": "none",
            "--max_len1": "none", "-F": "none", "--trim_front2": "none", "-T": "none", "--trim_tail2": "none",
            "-B": "none", "--max_len2": "none", "--dup_calc_accuracy": "none", "--poly_g_min_len": "none",
            "--poly_x_min_len": "none", "-W": "none", "--cut_window_size": "none", "-M": "none",
            "--cut_mean_quality": "none", "--cut_front_window_size": "none", "--cut_front_mean_quality": "none",
            "--cut_tail_window_size": "none", "--cut_tail_mean_quality": "none", "--cut_right_window_size": "none",
            "--cut_right_mean_quality": "none", "-q": "none", "--qualified_quality_phred": "none", "-u": "none",
            "--unqualified_percent_limit": "none", "-n": "none", "--n_base_limit": "none", "-e": "none",
            "--average_qual": "none", "-l": "none", "--length_required": "none", "--length_limit": "none",
            "-Y": "none", "--complexity_threshold": "none", "--filter_by_index1": "files",
            "--filter_by_index2": "files", "--filter_by_index_threshold": "none", "--overlap_len_require": "none",
            "--overlap_diff_limit": "none", "--overlap_diff_percent_limit": "none",
            "--umi_loc": ["index1", "index2", "read1", "read2", "per_index", "per_read"], "--umi_len": "none",
            "--umi_prefix": "none", "--umi_skip": "none", "--umi_delim": "none", "-P": "none",
            "--overrepresentation_sampling": "none", "-j": "files", "--json": "files", "-h": "files",
            "--html": "files", "-R": "none", "--report_title": "none", "-w": "none", "--thread": "none",
            "-s": "none", "--split": "none", "-S": "none", "--split_by_lines": "none", "-d": "none",
            "--split_prefix_digits": "none",
        },
        args: ["none"],
    }
}

fn fastqc() {
    #{
        opts: `
            -h, --help               print this help file and exit
            -v, --version            print the version of the program and exit
            -o, --outdir DIR         create all output files in the specified output directory
            --casava                 files come from raw casava output
            --nano                   files come from nanopore sequences and are in fast5 format
            --nofilter               if running with --casava then don't remove read flagged by casava as poor quality when
            --extract                if set then the zipped output file will be uncompressed in the same directory after it
            -j, --java FILE          provides the full path to the java binary you want to use to launch fastqc
            --noextract              do not uncompress the output file after creating it
            --nogroup                disable grouping of bases for reads >50bp
            --min_length INT         sets an artificial lower limit on the length of the sequence to be shown in the report
            --dup_length INT         sets a length to which the sequences will be truncated when defining them to be
            -f, --format FORMAT      bypasses the normal sequence file format detection and forces the program to use the
            --memory MB              sets the base amount of memory, in Megabytes, used to process each file
            --svg                    save the graphs in the report in SVG format
            -t, --threads INT        specifies the number of files which can be processed simultaneously
            -c, --contaminants FILE  specifies a non-default file which contains the list of contaminants to screen
            -a, --adapters FILE      specifies a non-default file which contains the list of adapter sequences which will be
            -l, --limits FILE        specifies a non-default file which contains a set of criteria which will be used to
            -k, --kmers INT          specifies the length of Kmer to look for in the Kmer content module
            -q, --quiet              suppress all progress messages on stdout and only report errors
            -d, --dir DIR            selects a directory to be used for temporary files written when generating report images
        `,
        values: #{
            "-o": "dirs", "--outdir": "dirs", "-j": "files", "--java": "files", "--min_length": "none",
            "--dup_length": "none", "-f": ["bam", "sam", "bam_mapped", "sam_mapped", "fastq"],
            "--format": ["bam", "sam", "bam_mapped", "sam_mapped", "fastq"], "--memory": "none", "-t": "none",
            "--threads": "none", "-c": "files", "--contaminants": "files", "-a": "files", "--adapters": "files",
            "-l": "files", "--limits": "files", "-k": "none", "--kmers": "none", "-d": "dirs", "--dir": "dirs",
        },
        args: [k("reads")],
    }
}

fn falco() {
    #{
        opts: `
            -h, --help           print more detailed help
            --version            print program version
            --license            print full license
            -o, --output DIR     output directory (required)
            -t, --threads INT    threads for analysis (this machine supports: 16)
            -m, --mem SIZE       input memory buffer size (G/M/K units ok)
            -v, --verbose        print more info about the run
            --config FILE        config file (priority to command line options)
            --contaminants FILE  file of non-default contaminant sequences to use
            --adapters FILE      file of non-default adapters sequences to use
            --max-length SIZE    use for reads longer than 1M bp (G/M/K units ok)
            --stdin fq|sam[:N]   read from stdin assuming given format (see help)
            --bisulfite          assume bisulfite when grading sequence content
            --preseq             make file for preseq input (excludes --orig-dups)
            --orig-dups          use original duplication mode (enables --dups)
            --groups             group base positions in output (see help)
            --tiles, --no-tiles  toggle per-tile quality analysis
            --dups, --no-dups    toggle sequence duplication analysis
            --adap, --no-adap    toggle adapter analysis
            --kmers, --no-kmers  toggle k-mer analysis
        `,
        values: #{
            "-o": "dirs", "--output": "dirs", "-t": "none", "--threads": "none", "-m": "none", "--mem": "none",
            "--config": "files", "--contaminants": "files", "--adapters": "files", "--max-length": "none",
            "--stdin": ["fq", "sam", "fq:4", "fq:6", "sam:4", "sam:6"],
        },
        args: [k("reads")],
    }
}

fn cutadapt() {
    #{
        opts: `
            -h, --help                                    show this help message and exit
            --version                                     show version number and exit
            --debug                                       print debug log
            -j, --cores CORES                             number of CPU cores to use
            -a, --adapter ADAPTER                         sequence of an adapter ligated to the 3' end (paired data: of the first read)
            -g, --front ADAPTER                           sequence of an adapter ligated to the 5' end (paired data: of the first read)
            -b, --anywhere ADAPTER                        sequence of an adapter that may be ligated to the 5' or 3' end
            -e, --error-rate, --errors E                  maximum allowed error rate (if 0 <= E < 1), or absolute number of errors for full-length
            --no-indels                                   allow only mismatches in alignments
            -n, --times COUNT                             remove up to COUNT adapters from each read
            -O, --overlap MINLENGTH                       require MINLENGTH overlap between read and adapter for an adapter to be found
            --match-read-wildcards                        interpret IUPAC wildcards in reads
            -N, --no-match-adapter-wildcards              do not interpret IUPAC wildcards in adapters
            --action TRIM|RETAIN|MASK|LOWERCASE|CROP|NONE  what to do if a match was found
            --rc, --revcomp                               check both the read and its reverse complement for adapter matches
            -u, --cut LEN                                 remove LEN bases from each read (or R1 if paired; use -U option for R2)
            --nextseq-trim 3'CUTOFF                       nextSeq-specific quality trimming (each read)
            -q, --quality-cutoff [5'CUTOFF,]3'CUTOFF      trim low-quality bases from 5' and/or 3' ends of each read before adapter removal
            --quality-base N                              assume that quality values in FASTQ are encoded as ascii(quality + N)
            --poly-a                                      trim poly-A tails
            -l, --length LENGTH                           shorten reads to LENGTH. Positive values remove bases at the end while negative ones
            --trim-n                                      trim N's on ends of reads
            --length-tag TAG                              search for TAG followed by a decimal number in the description field of the read
            --strip-suffix STRIP_SUFFIX                   remove this suffix from read names if present
            -x, --prefix PREFIX                           add this prefix to read names
            -y, --suffix SUFFIX                           add this suffix to read names; can also include {name}
            --rename TEMPLATE                             rename reads using TEMPLATE containing variables such as {id}, {adapter_name} etc
            -z, --zero-cap                                change negative quality values to zero
            -m, --minimum-length LEN[:LEN2]               discard reads shorter than LEN. Default: 0
            -M, --maximum-length LEN[:LEN2]               discard reads longer than LEN. Default: no limit
            --max-n COUNT                                 discard reads with more than COUNT 'N' bases
            --max-expected-errors, --max-ee ERRORS        discard reads whose expected number of errors (computed from quality values) exceeds
            --max-average-error-rate, --max-aer ERROR_RATE  as --max-expected-errors (see above), but divided by length to account for reads of
            --discard-trimmed, --discard                  discard reads that contain an adapter
            --discard-untrimmed, --trimmed-only           discard reads that do not contain an adapter
            --discard-casava                              discard reads that did not pass CASAVA filtering (header has :Y:)
            --quiet                                       print only error messages
            --report FULL|MINIMAL                         which type of report to print: 'full' or 'minimal'. Default: full
            --json FILE                                   dump report in JSON format to FILE
            -o, --output FILE                             write trimmed reads to FILE. FASTQ or FASTA format is chosen depending on input
            --fasta                                       output FASTA to standard output even on FASTQ input
            --compression-level N                         compression level for compressed output files
            --info-file FILE                              write information about each read and its adapter matches into FILE. See the
            -r, --rest-file FILE                          when the adapter matches in the middle of a read, write the rest (after the adapter) to
            --wildcard-file FILE                          when the adapter has N wildcard bases, write adapter bases matching wildcard positions to
            --too-short-output FILE                       write reads that are too short (according to length specified by -m) to FILE. Default
            --too-long-output FILE                        write reads that are too long (according to length specified by -M) to FILE. Default
            --untrimmed-output FILE                       write reads that do not contain any adapter to FILE. Default: output to same file as
            -A ADAPTER                                    3' adapter to be removed from R2
            -G ADAPTER                                    5' adapter to be removed from R2
            -B ADAPTER                                    5'/3 adapter to be removed from R2
            -U LENGTH                                     remove LENGTH bases from R2
            -Q [5'CUTOFF,]3'CUTOFF                        quality-trimming cutoff for R2
            -L LENGTH                                     shorten R2 to LENGTH. Default: same as for R1
            -p, --paired-output FILE                      write R2 to FILE
            --info-file-paired FILE                       write info about R2 to FILE (see --info-file)
            --pair-adapters                               treat adapters given with -a/-A etc
            --pair-filter ANY|BOTH|FIRST                  which of the reads in a paired-end read have to match the filtering criterion in order
            --interleaved                                 read and/or write interleaved paired-end reads
            --untrimmed-paired-output FILE                write second read in a pair to this FILE when no adapter was found
            --too-short-paired-output FILE                write second read in a pair to this file if pair is too short
            --too-long-paired-output FILE                 write second read in a pair to this file if pair is too long
        `,
        values: #{
            "-j": "none", "--cores": "none", "-a": k("cutadapt_adapter"), "--adapter": k("cutadapt_adapter"),
            "-g": k("cutadapt_adapter"), "--front": k("cutadapt_adapter"), "-b": k("cutadapt_adapter"),
            "--anywhere": k("cutadapt_adapter"), "-e": "none", "--error-rate": "none", "--errors": "none",
            "-n": "none", "--times": "none", "-O": "none", "--overlap": "none",
            "--action": ["trim", "retain", "mask", "lowercase", "crop", "none"], "-u": "none", "--cut": "none",
            "--nextseq-trim": "none", "-q": "none", "--quality-cutoff": "none", "--quality-base": "none",
            "-l": "none", "--length": "none", "--length-tag": "none", "--strip-suffix": "none", "-x": "none",
            "--prefix": "none", "-y": "none", "--suffix": "none", "--rename": "none", "-m": "none",
            "--minimum-length": "none", "-M": "none", "--maximum-length": "none", "--max-n": "none",
            "--max-expected-errors": "none", "--max-ee": "none", "--max-average-error-rate": "none",
            "--max-aer": "none", "--report": ["full", "minimal"], "--json": "files", "-o": "files",
            "--output": "files", "--compression-level": "none", "--info-file": "files", "-r": "files",
            "--rest-file": "files", "--wildcard-file": "files", "--too-short-output": "files",
            "--too-long-output": "files", "--untrimmed-output": "files", "-A": k("cutadapt_adapter"),
            "-G": k("cutadapt_adapter"), "-B": k("cutadapt_adapter"), "-U": "none", "-Q": "none", "-L": "none",
            "-p": "files", "--paired-output": "files", "--info-file-paired": "files",
            "--pair-filter": ["any", "both", "first"], "--untrimmed-paired-output": "files",
            "--too-short-paired-output": "files", "--too-long-paired-output": "files",
        },
        args: [k("sequences")],
    }
}

fn trimmomatic() {
    #{
        commands: `
            PE  paired-end reads: two inputs, four outputs, then steps
            SE  single-end reads: an input, an output, then steps
        `,
        subs: #{
            PE: #{
                opts: `
                    -threads N      number of threads
                    -phred33        qualities are Phred+33
                    -phred64        qualities are Phred+64
                    -trimlog FILE   log of the trimming of each read
                    -summary FILE   summary of the statistics
                    -quiet          print only errors
                    -version        print the version
                    -validatePairs  check that the names of the pairs match
                    -basein FILE    the first input file, whose name gives the second's
                    -baseout FILE   the base name of the four output files
                `,
                values: #{
                    "-threads": "none", "-trimlog": "files", "-summary": "files", "-basein": k("fastq"),
                    "-baseout": "files",
                },
                args: [k("fastq"), k("fastq"), k("trimmomatic_step")],
                single_dash: true,
                args_if: #{"-basein": [k("trimmomatic_step")]},
            },
            SE: #{
                opts: `
                    -threads N     number of threads
                    -phred33       qualities are Phred+33
                    -phred64       qualities are Phred+64
                    -trimlog FILE  log of the trimming of each read
                    -summary FILE  summary of the statistics
                    -quiet         print only errors
                    -version       print the version
                `,
                values: #{
                    "-threads": "none", "-trimlog": "files", "-summary": "files",
                },
                args: [k("fastq"), k("trimmomatic_step")],
                single_dash: true,
            },
        },
    }
}

fn trim_galore() {
    #{
        opts: `
            -q, --quality <QUALITY>                                quality trimming cutoff (Phred score)
            -a, --adapter <ADAPTER>                                adapter sequence for trimming
            -a2, --adapter2 <ADAPTER2>                             optional adapter sequence for Read 2 (paired-end only)
            --illumina                                             use Illumina universal adapter (AGATCGGAAGAGC)
            --nextera                                              use Nextera transposase adapter (CTGTCTCTTATA)
            --small_rna                                            use Illumina Small RNA adapter (TGGAATTCTCGG)
            --stranded_illumina                                    use Illumina Stranded mRNA adapter (ACTGTCTCTTATA)
            --bgiseq                                               use BGI/DNBSEQ adapter
            --paired                                               paired-end mode
            -e, --error_rate <ERROR_RATE>                          maximum allowed error rate for adapter matching (0-1)
            --stringency <STRINGENCY>                              minimum overlap with adapter sequence required to trim (stringency)
            --length <LENGTH>                                      minimum required sequence length after trimming
            --max_length <MAX_LENGTH>                              maximum allowed sequence length (discard reads longer than this)
            --max_n <MAX_N>                                        maximum number of N bases allowed in a read
            --trim-n                                               trim N bases from both ends of reads
            --clip_R1 <CLIP_R1>                                    remove N bases from the 5' end of Read 1
            --clip_R2 <CLIP_R2>                                    remove N bases from the 5' end of Read 2 (paired-end only)
            --three_prime_clip_R1 <THREE_PRIME_CLIP_R1>            remove N bases from the 3' end of Read 1, after adapter/quality trimming
            --three_prime_clip_R2 <THREE_PRIME_CLIP_R2>            remove N bases from the 3' end of Read 2 (paired-end only), after adapter/quality trimming
            --nextseq <NEXTSEQ>                                    nextSeq/NovaSeq 2-colour quality trimming
            --phred64                                              use Phred+64 quality encoding (Illumina 1.5)
            --phred33                                              use Phred+33 quality encoding
            -o, --output_dir <OUTPUT_DIR>                          output directory for trimmed files
            --basename <BASENAME>                                  custom basename for output files (replaces input filename stem)
            --dont_gzip                                            do not gzip-compress output files
            --clumpify                                             reorder reads in the gzip output so reads sharing a canonical 16-mer minimizer land
            --compression <COMPRESSION>                            gzip compression level for output FASTQ (1–9)
            --memory <MEMORY>                                      total memory budget for Trim Galore
            --no_report_file                                       suppress the trimming report
            --preserve-tags <PRESERVE_TAGS>                        comma-separated list of BAM tags
            --output-format <OUTPUT_FORMAT>                        output container format
            --retain_unpaired                                      retain unpaired reads when the mate is too short (paired-end only)
            -r, --length_1 <LENGTH_1>                              minimum length for unpaired Read 1 (with --retain_unpaired)
            --length_2 <LENGTH_2>                                  minimum length for unpaired Read 2 (with --retain_unpaired)
            --passthrough <PASSTHROUGH>                            pass a third FASTQ file through unchanged but keep it in lockstep with R1/R2
            --rename                                               add clipped sequences to read IDs for --clip_R1/R2, --three_prime_clip_R1/R2, and
            --consider_already_trimmed <CONSIDER_ALREADY_TRIMMED>  if auto-detected adapter count is at or below this threshold, skip adapter trimming
            --rrbs                                                 RRBS mode for MspI-digested samples
            --non_directional                                      non-directional RRBS libraries
            --fastqc                                               run FastQC on the trimmed output files
            --fastqc_args <FASTQC_ARGS>                            additional arguments to pass to FastQC. Implies --fastqc
            -j, --cores <CORES>                                    number of worker threads for parallel processing
            --poly_a                                               trim poly-A tails from the 3' end of Read 1 (and single-end reads), and poly-T heads from
            --poly_g                                               trim poly-G tails from the 3' end of Read 1 (and single-end reads), and poly-C heads from
            --no_poly_g                                            disable poly-G auto-detection and trimming
            -n, --times <TIMES>                                    number of adapter trimming rounds per read
            --discard_untrimmed                                    discard reads that did not contain an adapter sequence
            --hardtrim5 <HARDTRIM5>                                hard-trim to keep only the first N bases from the 5' end
            --hardtrim3 <HARDTRIM3>                                hard-trim to keep only the last N bases from the 3' end
            --clock                                                epigenetic Clock mode (paired-end only)
            --implicon[=<IMPLICON>]                                transfer the first N bases from Read 2 as a UMI barcode to both read IDs, then clip R2 by
            --demux <DEMUX>                                        demultiplex reads after trimming based on 3' inline barcodes
            -h, --help                                             print help (see a summary with '-h')
            -V, --version                                          print version
        `,
        values: #{
            "-q": "none", "--quality": "none", "-a": "none", "--adapter": "none", "-a2": "none",
            "--adapter2": "none", "-e": "none", "--error_rate": "none", "--stringency": "none", "--length": "none",
            "--max_length": "none", "--max_n": "none", "--clip_R1": "none", "--clip_R2": "none",
            "--three_prime_clip_R1": "none", "--three_prime_clip_R2": "none", "--nextseq": "none", "-o": "dirs",
            "--output_dir": "dirs", "--basename": "none", "--compression": "none", "--memory": "none",
            "--preserve-tags": "none", "--output-format": ["fastq", "ubam"], "-r": "none", "--length_1": "none",
            "--length_2": "none", "--passthrough": k("fastq"), "--consider_already_trimmed": "none",
            "--fastqc_args": "none", "-j": "none", "--cores": "none", "-n": "none", "--times": "none",
            "--hardtrim5": "none", "--hardtrim3": "none", "--demux": "files",
        },
