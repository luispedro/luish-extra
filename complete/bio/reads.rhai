}

fn fastq_screen() {
    #{
        opts: `
            --add_genome <text>    edits the file 'fastq_screen.conf' (in the folder where this script is saved) to add a
            --aligner <func>       specify the aligner to use for the mapping
            --bisulfite            process bisulfite libraries
            --bismark <text>       specify extra parameters to be passed to Bismark
            --bowtie <text>        specify extra parameters to be passed to Bowtie
            --bowtie2 <text>       specify extra parameters to be passed to Bowtie 2
            --bwa <text>           specify extra parameters to be passed to BWA
            --minimap2 <text>      specify extra parameters to be passed to minimap2
            --conf <path>          manually specify a location for the configuration
            --filter <text>        produce a FASTQ file containing reads mapping to specified genomes
            --force                do not terminate if output files already exist, instead overwrite the files
            --get_genomes          download pre-indexed Bowtie2 genomes for a range of commonly studied species and sequences
            --help                 print program help and exit
            --illumina1_3          assume that the quality values are in encoded in Illumina v1.3 format
            --inverse              inverts the --filter results
            --nohits               writes to a file the sequences that did not map to any of the specified genomes
            --outdir <text>        specify a directory in which to save output files
            --pass <int>           used in conjunction with --filter
            --quiet                suppress all progress reports on stderr and only report errors
            --subset <int>         don't use the whole sequence file, but create a temporary dataset of this specified
            --tag                  label each FASTQ read header with a tag listing to which genomes the read did, or did not
            --threads <int>        specify across how many threads bowtie will be allowed to run
            --top <int>/<int,int>  don't use the whole sequence file, but create a temporary dataset of the specified number
            --version              print the program version and exit
        `,
        values: #{
            "--add_genome": "none", "--aligner": ["bowtie", "bowtie2", "bwa", "minimap2"], "--bismark": "none",
            "--bowtie": "none", "--bowtie2": "none", "--bwa": "none", "--minimap2": "none", "--conf": "files",
            "--filter": "none", "--outdir": "dirs", "--pass": "none", "--subset": "none", "--threads": "none",
            "--top": "none",
        },
        args: [k("fastq")],
    }
}

fn seqtk() {
    #{
        commands: `
            seq       common transformation of FASTA/Q
            size      report the number sequences and bases
            comp      get the nucleotide composition of FASTA/Q
            sample    subsample sequences
            subseq    extract subsequences from FASTA/Q
            fqchk     fastq QC (base/quality summary)
            mergepe   interleave two PE FASTA/Q files
            split     split one file into multiple smaller files
            trimfq    trim FASTQ using the Phred algorithm
            hety      regional heterozygosity
            gc        identify high- or low-GC regions
            mutfa     point mutate FASTA at specified positions
            mergefa   merge two FASTA/Q files
            famask    apply a X-coded FASTA to a source FASTA
            dropse    drop unpaired from interleaved PE FASTA/Q
            rename    rename sequence names
            randbase  choose a random base from hets
            cutN      cut sequence at long N
            gap       get the gap locations
            listhet   extract the position of each het
            hpc       homopolyer-compressed sequence
            telo      identify telomere repeats in asm or long reads
        `,
        sub_spec: "@extra-complete/bio/reads:seqtk",
    }
}

fn seqtk_sub(sub) {
    switch sub {
        "seq" => #{
            opts: `
                -q INT    mask bases with quality lower than INT
                -X INT    mask bases with quality higher than INT
                -n CHAR   masked bases converted to CHAR; 0 for lowercase
                -l INT    number of residues per line; 0 for 2^32-1
                -Q INT    quality shift: ASCII-INT gives base quality
                -s INT    random seed (effective with -f)
                -f FLOAT  sample FLOAT fraction of sequences
                -M FILE   mask regions in BED or name list FILE
                -L INT    drop sequences with length shorter than INT
                -F CHAR   fake FASTQ quality
                -c        mask complement region (effective with -M)
                -r        reverse complement
                -R        output both forward and reverse complement
                -A        force FASTA output (discard quality)
                -C        drop comments at the header lines
                -N        drop sequences containing ambiguous bases
                -1        output the 2n-1 reads only
                -2        output the 2n reads only
                -V        shift quality by '(-Q) - 33'
                -U        convert all bases to uppercases
                -x        convert all lowercases to -n
                -S        strip of white spaces in sequences
            `,
            values: #{
                "-q": "none", "-X": "none", "-n": "none", "-l": "none", "-Q": "none", "-s": "none", "-f": "none",
                "-M": "files", "-L": "none", "-F": "none",
            },
            args: [k("sequences")],
        },
        "size" => #{
            args: [k("sequences")],
        },
        "comp" => #{
            opts: `
                -r FILE  count only in the regions of a BED file
                -u       count uppercase bases only
            `,
            values: #{
                "-r": k("bed"),
            },
            args: [k("sequences")],
        },
        "sample" => #{
            opts: `
                -s INT  RNG seed
                -2      2-pass mode: twice as slow but with much reduced memory
            `,
            values: #{
                "-s": "none",
            },
            args: [k("sequences")],
        },
        "subseq" => #{
            opts: `
                -t      TAB delimited output
                -s      strand aware
                -l INT  sequence line length
            `,
            values: #{
                "-l": "none",
            },
            args: [k("sequences"), "files"],
        },
        "fqchk" => #{
            opts: `
                -q INT  quality threshold; 0 for the distribution of all qualities
            `,
            values: #{
                "-q": "none",
            },
            args: [k("sequences")],
        },
        "mergepe" => #{
            args: [k("fastq"), k("fastq")],
        },
        "split" => #{
            opts: `
                -n INT  number of files
                -l INT  line length
            `,
            values: #{
                "-n": "none", "-l": "none",
            },
            args: ["none", k("sequences")],
        },
        "trimfq" => #{
            opts: `
                -q FLOAT  error rate threshold (disabled by -b/-e)
                -l INT    maximally trim down to INT bp (disabled by -b/-e)
                -b INT    trim INT bp from left (non-zero to disable -q/-l)
                -e INT    trim INT bp from right (non-zero to disable -q/-l)
                -L INT    retain at most INT bp from the 5'-end (non-zero to disable -q/-l)
                -Q        force FASTQ output
            `,
            values: #{
                "-q": "none", "-l": "none", "-b": "none", "-e": "none", "-L": "none",
            },
            args: [k("sequences")],
        },
        "hety" => #{
            opts: `
                -w INT  window size
                -t INT  number of start positions in a window
                -m      treat lowercases as masked
            `,
            values: #{
                "-w": "none", "-t": "none",
            },
            args: [k("fasta")],
        },
        "gc" => #{
            opts: `
                -w        identify high-AT regions
                -f FLOAT  min GC fraction (or AT fraction for -w)
                -l INT    min region length to output
                -x FLOAT  x-dropoff
            `,
            values: #{
                "-f": "none", "-l": "none", "-x": "none",
            },
            args: [k("fasta")],
        },
        "mutfa" => #{
            args: [k("fasta"), "files"],
        },
        "mergefa" => #{
            opts: `
                -q INT  quality threshold
                -i      take intersection
                -m      convert to lowercase when one of the input base is N
                -r      pick a random allele from het
                -h      suppress hets in the input
            `,
            values: #{
                "-q": "none",
            },
            args: [k("fasta"), k("fasta")],
        },
        "famask" => #{
            args: [k("fasta"), k("fasta")],
        },
        "dropse" => #{
            args: [k("sequences")],
        },
        "rename" => #{
            args: [k("sequences"), "none"],
        },
        "randbase" => #{
            args: [k("fasta")],
        },
        "cutN" => #{
            opts: `
                -n INT  min size of N tract
                -p INT  penalty for a non-N
                -g      print gaps only, no sequence
            `,
            values: #{
                "-n": "none", "-p": "none",
            },
            args: [k("fasta")],
        },
        "gap" => #{
            opts: `
                -l INT  minimum length of a gap
            `,
            values: #{
                "-l": "none",
            },
            args: [k("fasta")],
        },
        "listhet" => #{
            args: [k("fasta")],
        },
        "hpc" => #{
            args: [k("sequences")],
        },
        "telo" => #{
            opts: `
                -m STR  motif
                -p INT  penalty
                -d INT  max drop
                -s INT  min score
                -P      print scoring
            `,
            values: #{
                "-m": "none", "-p": "none", "-d": "none", "-s": "none",
            },
            args: [k("sequences")],
        },
        _ => (),
    }
}

fn filtlong() {
    #{
        opts: `
            -t, --target_bases INT    keep only the best reads up to this many total bases (unit suffixes: k, kb, m, mb, g, gb)
            -p, --keep_percent FLOAT  keep only this percentage of the best reads (measured by bases)
            -l, --min_length INT      minimum length threshold (unit suffixes: k, kb, m, mb, g, gb)
