fn strainphlan() {
    #{
        opts: `
            -h, --help                                 show this help message and exit
            -d, --database FILE                        the MetaPhlAn database: its .pkl file, or 'latest'
            -m, --clade_markers FILE                   the clade markers as FASTA file
            -s, --samples FILE                         the reconstructed markers of each sample (json.bz2 or pkl)
            --sample_list FILE                         a file with the path of a sample on each line (json.bz2 or pkl)
            -r, --references FILE                      the reference genomes
            --reference_list FILE                      a file containing one reference path per line
            -c, --clade CLADE                          the clade to investigate
            -o, --output_dir DIR                       the output directory
            -n, --nprocs N                             the number of threads to use
            --trim_sequences N                         the number of bases to remove from both ends when trimming markers
            --sample_with_n_markers N                  minimum number of markers for a sample to be kept
            --sample_with_n_markers_perc N             minimum percentage of markers for a sample to be kept
            --marker_in_n_samples_perc N               minimum percentage of the primary samples to keep a marker
            --sample_with_n_markers_after_filt N       minimum number of markers after filtering for a sample to be kept
            --sample_with_n_markers_after_filt_perc N  minimum percentage of markers kept after filtering for a sample to be kept
            --breadth_thres N                          threshold defining the minimum breadth of coverage for the markers
            --polymorphism_perc N                      maximum percentage of polymorphic sites in a marker
            --phylophlan_mode ACCURATE|FAST            the presets for fast or accurate phylogenetic analysis
            --phylophlan_configuration FILE            the PhyloPhlAn configuration file
            --tmp DIR                                  the directory of the temporary files
            --mutation_rates                           produce a table of mutation rates for each clade
            --phylophlan_params PARAMS                 additional phylophlan parameters
            --print_clades_only                        only print the potential clades
            --non_interactive                          select the first SGB available when the clade is a species
            --treeshrink                               run TreeShrink after building the tree
            --debug                                    don't remove the temporary folders
            -v, --version                              prints the current StrainPhlAn version and exit
        `,
        values: #{
            "-d": "files", "--database": "files", "-m": k("fasta"), "--clade_markers": k("fasta"), "-s": "files",
            "--samples": "files", "--sample_list": "files", "-r": k("fasta"), "--references": k("fasta"),
            "--reference_list": "files", "-c": "none", "--clade": "none", "-o": "dirs", "--output_dir": "dirs",
            "-n": "none", "--nprocs": "none", "--trim_sequences": "none", "--sample_with_n_markers": "none",
            "--sample_with_n_markers_perc": "none", "--marker_in_n_samples_perc": "none",
            "--sample_with_n_markers_after_filt": "none", "--sample_with_n_markers_after_filt_perc": "none",
            "--breadth_thres": "none", "--polymorphism_perc": "none", "--phylophlan_mode": ["accurate", "fast"],
            "--phylophlan_configuration": "files", "--tmp": "dirs", "--phylophlan_params": "none",
        },
        args: ["none"],
    }
}

fn sample2markers() {
    #{
        opts: `
            -i, --input FILE            the input samples as SAM or BAM files
            -o, --output_dir DIR        the output directory
            -d, --database FILE         the MetaPhlAn database: its .pkl file, or 'latest'
            --clades CLADE              restricts the reconstruction of the markers to the specified clades
            -f, --input_format FILE     the format of the input samples: bam, sam or bz2
            --sorted                    whether the BAM input files are sorted
            --min_reads_aligning N      minimum number of reads to cover a marker
            --min_base_coverage N       the minimum depth of coverage for a base to be considered
            --min_base_quality N        minimum quality of a base to be considered
            --min_mapping_quality N     minimum quality of the mapping of a read to be considered
            --max_gcsd N                maximum gap-compressed sequence divergence (for minimap2 alignments)
            --dominant_frq_threshold N  the cutoff of 'allele dominance' for a position to be considered polymorphic
            --quasi_marker_frac N       fraction (0-1) of markers with a hit of another SGB to disqualify a marker
            --depth_avg_q N             quantile to cut from both ends of the coverage distributions to compute the mean depth
            --tmp DIR                   the directory of the temporary files
            -b, --breadth_threshold N   the breadth of coverage threshold for the consensus markers
            --debug                     don't remove the temporary folders
            -n, --nprocs N              the number of threads to execute the script
            -v, --version               show program's version number and exit
            -h, --help                  show help
        `,
        values: #{
            "-i": k("sam"), "--input": k("sam"), "-o": "dirs", "--output_dir": "dirs", "-d": "files",
            "--database": "files", "--clades": "none", "-f": ["bam", "sam", "bz2"],
            "--input_format": ["bam", "sam", "bz2"], "--min_reads_aligning": "none", "--min_base_coverage": "none",
            "--min_base_quality": "none", "--min_mapping_quality": "none", "--max_gcsd": "none",
            "--dominant_frq_threshold": "none", "--quasi_marker_frac": "none", "--depth_avg_q": "none",
            "--tmp": "dirs", "-b": "none", "--breadth_threshold": "none", "-n": "none", "--nprocs": "none",
        },
        args: ["none"],
    }
}

