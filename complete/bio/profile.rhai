fn humann() {
    #{
        opts: `
            -h, --help                                    show this help message and exit
            -i, --input INPUT                             input file: FASTA/FASTQ (gzip), SAM/BAM, blastm8, gene table or biom
            -o, --output OUTPUT                           directory to write output files
            --threads N                                   number of threads/processes
            --version                                     show program's version number and exit
            -r, --resume                                  bypass commands if the output files exist
            --bypass-nucleotide-index                     bypass the nucleotide index step and run on the indexed ChocoPhlAn database
            --bypass-nucleotide-search                    bypass the nucleotide search steps
            --bypass-prescreen                            bypass the prescreen step and run on the full ChocoPhlAn database
            --bypass-translated-search                    bypass the translated search step
            --taxonomic-profile TAXONOMIC_PROFILE         a taxonomic profile (the output file created by metaphlan)
            --memory-use MINIMUM|MAXIMUM                  the amount of memory to use
            --input-format INPUT_FORMAT                   the format of the input file
            --search-mode UNIREF50|UNIREF90               search for uniref50 or uniref90 gene families
            -v, --verbose                                 additional output is printed
            --metaphlan METAPHLAN                         directory containing the MetaPhlAn software
            --metaphlan-options METAPHLAN_OPTIONS         options to be provided to the MetaPhlAn software
            --prescreen-threshold N                       minimum percentage of reads matching a species
            --bowtie2 BOWTIE2                             directory containing the bowtie2 executable
            --bowtie-options BOWTIE_OPTIONS               options to be provided to the bowtie software
            --nucleotide-database NUCLEOTIDE_DATABASE     directory containing the nucleotide database
            --nucleotide-identity-threshold N             identity threshold for nucleotide alignments
            --nucleotide-query-coverage-threshold N       query coverage threshold for nucleotide alignments
            --nucleotide-subject-coverage-threshold N     subject coverage threshold for nucleotide alignments
            --diamond DIAMOND                             directory containing the diamond executable
            --diamond-options DIAMOND_OPTIONS             options to be provided to the diamond software
            --evalue N                                    the evalue threshold to use with the translated search
            --protein-database PROTEIN_DATABASE           directory containing the protein database
            --rapsearch RAPSEARCH                         directory containing the rapsearch executable
            --translated-alignment USEARCH|RAPSEARCH|DIAMOND  software to use for translated alignment
            --translated-identity-threshold N             identity threshold for translated alignments
            --translated-query-coverage-threshold N       query coverage threshold for translated alignments
            --translated-subject-coverage-threshold N     subject coverage threshold for translated alignments
            --usearch USEARCH                             directory containing the usearch executable
            --gap-fill ON|OFF                             turn on/off the gap fill computation
            --minpath ON|OFF                              turn on/off the minpath computation
            --pathways METACYC|UNIPATHWAY                 the database to use for pathway computations
            --pathways-database PATHWAYS_DATABASE         mapping file(s) for the pathway computations, at most two, comma-separated
            --xipe ON|OFF                                 turn on/off the xipe computation
            --annotation-gene-index N                     the index of the gene in the sequence annotation
            --id-mapping ID_MAPPING                       id mapping file for alignments
            --remove-temp-output                          remove temp output files
            --log-level LOG_LEVEL                         level of messages to display in log
            --o-log FILE                                  log file
            --output-basename SAMPLE_NAME                 the basename for the output files
            --output-format TSV|BIOM                      the format of the output files
            --output-max-decimals N                       the number of decimals to output
            --remove-column-description-output            remove the description in the output column
            --remove-stratified-output                    remove stratification from output
        `,
        values: #{
            "-i": "files", "--input": "files", "-o": "dirs", "--output": "dirs", "--threads": "none",
            "--taxonomic-profile": "files", "--memory-use": ["minimum", "maximum"],
            "--input-format": [
                "fastq", "fastq.gz", "fasta", "fasta.gz", "sam", "bam", "blastm8", "genetable", "biom",
            ], "--search-mode": ["uniref50", "uniref90"], "--metaphlan": "dirs", "--metaphlan-options": "none",
            "--prescreen-threshold": "none", "--bowtie2": "dirs", "--bowtie-options": "none",
            "--nucleotide-database": "dirs", "--nucleotide-identity-threshold": "none",
            "--nucleotide-query-coverage-threshold": "none", "--nucleotide-subject-coverage-threshold": "none",
            "--diamond": "dirs", "--diamond-options": "none", "--evalue": "none", "--protein-database": "dirs",
            "--rapsearch": "dirs", "--translated-alignment": ["usearch", "rapsearch", "diamond"],
            "--translated-identity-threshold": "none", "--translated-query-coverage-threshold": "none",
            "--translated-subject-coverage-threshold": "none", "--usearch": "dirs", "--gap-fill": ["on", "off"],
            "--minpath": ["on", "off"], "--pathways": ["metacyc", "unipathway"], "--pathways-database": "files",
            "--xipe": ["on", "off"], "--annotation-gene-index": "none", "--id-mapping": "files",
            "--log-level": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"], "--o-log": "files",
            "--output-basename": "none", "--output-format": ["tsv", "biom"], "--output-max-decimals": "none",
        },
        args: ["none"],
    }
}

