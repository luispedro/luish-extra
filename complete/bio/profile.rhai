            -g, --groups UNIREF90_RXN|UNIREF50_RXN  built-in grouping options
            -c, --custom CUSTOM                     custom groups file (.tsv or .tsv.gz format)
            -r, --reversed                          custom groups file is reversed: mapping from features to groups
            -f, --function SUM|MEAN                 how to combine grouped features
            -e, --precision PRECISION               decimal places to round to after applying the function
            -u, --ungrouped Y|N                     include an UNGROUPED group for the features in no group
