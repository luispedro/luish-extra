// Taxonomic and functional profiling of metagenomes: kraken2, bracken,
// krakenuniq, centrifuge, kaiju, metaphlan, humann and motus, and the programs
// that come with them (databases, reports, tables). Generated by
// scripts/gen/mk_profile.py from the tools' own `--help` or argparse parser
// (versions in completion-todo.md).

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn k(name) { own("kinds:") + name }

fn kraken2() {
    #{
        opts: `
            --db NAME                    name for Kraken 2 DB
            --threads NUM                number of threads
            --quick                      quick operation (use first hit or hits)
            --unclassified-out FILENAME  print unclassified sequences to filename
            --classified-out FILENAME    print classified sequences to filename
            --output FILENAME            print output to filename (default: stdout); "-" suppresses it
            --confidence FLOAT           confidence score threshold (default: 0.0); must be in [0, 1]
            --minimum-base-quality NUM   minimum base quality used in classification
            --report FILENAME            print a report with aggregate counts/clade to file
            --use-mpa-style              with --report, format report output like Kraken 1's kraken-mpa-report
            --report-zero-counts         with --report, report counts for ALL taxa, even if counts are zero
            --report-minimizer-data      with --report, report minimizer and distinct minimizer counts too
            --memory-mapping             avoids loading database into RAM
            --paired                     the filenames provided have paired-end reads
            --use-names                  print scientific names instead of just taxids
            --gzip-compressed            input files are compressed with gzip
            --bzip2-compressed           input files are compressed with bzip2
            --minimum-hit-groups NUM     minimum number of hit groups (overlapping k-mers sharing a minimizer) to make a call
            --help                       print this message
            --version                    print version information
        `,
        values: #{
            "--db": "dirs", "--threads": "none", "--unclassified-out": "files", "--classified-out": "files",
            "--output": "files", "--confidence": "none", "--minimum-base-quality": "none", "--report": "files",
            "--minimum-hit-groups": "none",
        },
        args: [k("sequences")],
    }
}

fn kraken2_build() {
    #{
        opts: `
            --download-taxonomy      download NCBI taxonomic information
            --download-library TYPE  download a partial library: archaea, bacteria, plasmid, viral, human, fungi, plant, protozoa, ...
            --special TYPE           download and build a special database: greengenes, silva, rdp
            --add-to-library FILE    add FILE to library
            --build                  create the DB from the library (with the taxonomy and at least one file in the library)
            --clean                  remove unneeded files from a built database
            --standard               download and build default database
            --help                   print this message
            --version                print version information
            --db NAME                Kraken 2 DB name
            --threads NUM            number of threads
            --kmer-len NUM           k-mer length in bp/aa (build task only; def: 35 nt, 15 aa)
            --minimizer-len NUM      minimizer length in bp/aa (build task only; def: 31 nt, 12 aa)
            --minimizer-spaces NUM   number of characters in minimizer that are ignored in comparisons (build task only)
            --protein                build a protein database for translated search
            --no-masking             don't mask low-complexity sequences before building (with dustmasker or segmasker)
            --max-db-size NUM        maximum number of bytes for the hash table (the library is downsampled to fit)
            --use-ftp                use FTP for downloading instead of rsync
            --skip-maps              avoids downloading accession number to taxid maps, used with --download-taxonomy
            --load-factor FRAC       proportion of the hash table to be populated (build task only)
            --fast-build             don't require a deterministic database when using multiple threads (faster)
        `,
        values: #{
            "--download-library": ["archaea", "bacteria", "plasmid", "viral", "human", "fungi", "plant", "protozoa", "nr", "nt", "UniVec", "UniVec_Core"],
            "--special": ["greengenes", "silva", "rdp"], "--add-to-library": k("fasta"), "--db": "dirs",
            "--threads": "none", "--kmer-len": "none", "--minimizer-len": "none", "--minimizer-spaces": "none",
            "--max-db-size": "none", "--load-factor": "none",
        },
        args: ["none"],
    }
}

fn kraken2_inspect() {
    #{
        opts: `
            --db NAME             name for Kraken 2 DB
            --threads NUM         number of threads to use
            --skip-counts         only print database summary statistics
            --use-mpa-style       format output like Kraken 1's kraken-mpa-report
            --report-zero-counts  report counts for ALL taxa, even if counts are zero
            --help                print this message
            --version             print version information
        `,
        values: #{
            "--db": "dirs", "--threads": "none",
        },
        args: ["none"],
    }
}

fn k2() {
    #{
        opts: `
            -h, --help     show the help of each subcommand
            -v, --version  show program's version number and exit
        `,
        commands: `
            add-to-library              add file(s) to library
            download-library, download  download and build a special database
            download-taxonomy           download NCBI taxonomic information
            build                       build a database from library
            classify                    classify a set of sequences
            inspect                     inspect Kraken 2 database(s)
            clean                       removes unwanted files from database
            merge-classifications       merge classification results for different databases
        `,
        sub_spec: own("profile:k2"),
    }
}

fn k2_sub(sub) {
    switch sub {
        "add-to-library" => #{
            opts: `
                -h, --help                       show this help message and exit
                --db PATHNAME                    pathname to Kraken2 database
                --threads THREADS                the number of threads/processes k2 uses when adding library files
                --file, --files FILES            pathname or patterns of file(s) to be added to library
                --protein                        files being added are for a protein database
                --log FILENAME                   specify a log filename
                --no-masking                     don't mask low-complexity sequences before building (with k2mask or segmasker)
                --masker-threads K2MASK_THREADS  number of threads used by k2mask during masking process
            `,
            values: #{
                "--db": "dirs", "--threads": "none", "--file": k("fasta"), "--files": k("fasta"), "--log": "files",
                "--masker-threads": "none",
            },
            args: ["none"],
        },
        "download-library" | "download" => #{
            opts: `
                -h, --help                            show this help message and exit
                --db PATHNAME                         pathname to Kraken2 database
                --library LIBRARY                     the library to download
                --taxid TAXID                         the taxid to download
                --project PROJECT                     the project to download
                --accession ACCESSION                 the accession to download
                --assembly-source REFSEQ|GENBANK|ALL  download RefSeq (GCF_) or GenBank (GCA_) genome assemblies or both
                --resume                              resume fetching the files of a library, skipping those already downloaded
                --assembly-levels ASSEMBLY_LEVELS     only return genome assemblies that have one of the specified assembly levels
                --has-annotation                      return only annotated genome assemblies
                --blast-volumes BLAST_VOLUMES         a comma separated list of the blast volume numbers to download
                --protein                             files being added are for a protein database
                --log FILENAME                        specify a log filename
                --threads THREADS                     the number of threads/processes k2 uses when downloading and processing library files
                --no-masking                          don't mask low-complexity sequences before building (with k2mask or segmasker)
                --masker-threads K2MASK_THREADS       number of threads used by k2mask during masking process
            `,
            values: #{
                "--db": "dirs",
                "--library": [
                    "archaea", "bacteria", "plasmid", "plastid", "viral", "human", "invertebrate", "fungi",
                    "plant", "protozoa", "vertebrate_other", "vertebrate_mammalian", "mitochondrion", "nr", "nt",
                    "UniVec", "UniVec_Core",
                ], "--taxid": "none", "--project": "none", "--accession": "none",
                "--assembly-source": ["refseq", "genbank", "all"],
                "--assembly-levels": ["chromosome", "complete_genome", "scaffold", "contig"],
                "--blast-volumes": "none", "--log": "files", "--threads": "none", "--masker-threads": "none",
            },
            args: ["none"],
        },
        "download-taxonomy" => #{
            opts: `
                -h, --help      show this help message and exit
                --db PATHNAME   pathname to Kraken2 database
                --protein       files being added are for a protein database
                --skip-maps     avoids downloading accession number to taxid maps
                --log FILENAME  specify a log filename
            `,
            values: #{
                "--db": "dirs", "--log": "files",
            },
            args: ["none"],
        },
        "build" => #{
            opts: `
                -h, --help                           show this help message and exit
                --db PATHNAME                        pathname to database folder where building will take place
                --standard                           make the standard database: archaea, bacteria, human, plasmid, UniVec_Core, viral
                --special GREENGENES|RDP|SILVA|GTDB  build special database
                --gtdb-files GTDB_FILES              the file, or a regular expression matching the files, to build the GTDB database
                --parts, --part PARTS                build db which has been split into parts
                --gtdb-use-ncbi-taxonomy             use NCBI tax IDs and taxonomy tree when building GTDB database
                --gtdb-representatives-only          use only genomes flagged as "GTDB Representatives"
                --gtdb-split-database                split GTDB database into parts
                --gtdb-server GTDB_SERVER            the GTDB server to use
                --no-masking                         don't mask low-complexity sequences before building (with k2mask or segmasker)
                --masker-threads K2MASK_THREADS      number of threads used by k2mask during masking process
                --kmer-len INT                       k-mer length in bp/aa
                --minimizer-len INT                  minimizer length in bp/aa
                --minimizer-spaces INT               number of characters in minimizer that are ignored in comparisons
                --threads INT                        number of threads
                --load-factor FLOAT                  proportion of the hash table to be populated
                --fast-build                         do not require database to be deterministically built when using multiple threads
                --max-db-size SIZE                   maximum number of bytes for the hash table (the library is downsampled to fit)
                --skip-maps                          avoids downloading accession number to taxid maps
                --protein                            build a protein database for translated search
                --block-size INT                     read block size
                --sub-block-size INT                 read subblock size
                --cht-cell-size INT                  number of bits used by Compact Hash Table cells
                --minimum-bits-for-taxid INT         bit storage requested for taxid
                --log FILENAME                       specify a log file
            `,
            values: #{
                "--db": "dirs", "--special": ["greengenes", "rdp", "silva", "gtdb"], "--gtdb-files": "none",
                "--parts": "none", "--part": "none", "--gtdb-server": "none", "--masker-threads": "none",
                "--kmer-len": "none", "--minimizer-len": "none", "--minimizer-spaces": "none", "--threads": "none",
                "--load-factor": "none", "--max-db-size": "none", "--block-size": "none",
                "--sub-block-size": "none", "--cht-cell-size": ["32", "40"], "--minimum-bits-for-taxid": "none",
                "--log": "files",
            },
            args: ["none"],
        },
        "classify" => #{
            opts: `
                -h, --help                   show this help message and exit
                --db PATHNAME                pathname to Kraken2 database(s)
                --merge-policy MERGE_POLICY  policy for resolving classified reads across databases
                --check-pair-order           when aligning paired-end reads check if the headers match
                --threads INT                number of threads
                --use-daemon                 spawn a background process that keeps any loaded indexes in memory
                --quick                      quick operation (use first hit or hits)
                --unclassified-out FILENAME  print unclassified sequences to filename
                --classified-out FILENAME    print classified sequences to filename
                --output FILENAME            print output to file (default: stdout); "-" suppresses it
                --confidence FLOAT           confidence score threshold, in [0, 1]
                --minimum-base-quality INT   minimum base quality used in classification
                --report FILENAME            print a report with aggregate counts/clade to file
                --use-mpa-style              with --report, format report output like Kraken 1's kraken-mpa-report
                --report-zero-counts         with --report, report counts for ALL taxa, even if counts are zero
                --report-minimizer-data      with --report, report minimizer and distinct minimizer counts too
                --memory-mapping             avoids loading entire database into RAM
                --paired                     the filenames provided have paired-end reads
                --interleaved                the files have interleaved paired-end reads
                --use-names                  print scientific names instead of just taxids
                --minimum-hit-groups INT     minimum number of hit groups (overlapping k-mers sharing a minimizer) to make a call
                --log FILENAME               specify a log filename
            `,
            values: #{
                "--db": "dirs", "--merge-policy": ["first-classified", "last-classified", "resolve-lca"],
                "--threads": "none", "--unclassified-out": "files", "--classified-out": "files",
                "--output": "files", "--confidence": "none", "--minimum-base-quality": "none", "--report": "files",
                "--minimum-hit-groups": "none", "--log": "files",
            },
            args: [k("sequences")],
        },
        "inspect" => #{
            opts: `
                -h, --help                show this help message and exit
                --db PATHNAME             pathname to Kraken2 database(s)
                --skip-counts             only print database summary statistics
                --use-mpa-style           format output like Kraken 1's kraken-mpa-report
                --report-zero-counts      report counts for ALL taxa, even if counts are zero
                --log FILENAME            specify a log filename
                --output, --out FILENAME  print output to file (default: stdout); "-" suppresses it
                --memory-mapping          avoids loading entire database into RAM
            `,
            values: #{
                "--db": "dirs", "--log": "files", "--output": "files", "--out": "files",
            },
            args: ["none"],
        },
        "clean" => #{
            opts: `
                -h, --help             show this help message and exit
                --stop-daemon          stop a running background process
                --db PATHNAME          pathname to Kraken2 database
                --log FILENAME         specify a log filename
                --pattern SHELL_REGEX  files that match this regular expression will be deleted
            `,
            values: #{
                "--db": "dirs", "--log": "files", "--pattern": "none",
            },
            args: ["none"],
        },
        "merge-classifications" => #{
            opts: `
                -h, --help                show this help message and exit
                --db PATHNAME             pathname to Kraken2 database(s)
                --use-names               print scientific names instead of just taxids
                --report FILENAME         print a report with aggregate counts/clade to file
                --use-mpa-style           with --report, format report output like Kraken 1's kraken-mpa-report
                --report-zero-counts      with --report, report counts for ALL taxa, even if counts are zero
                --log FILENAME            specify a log filename
                --threads INT             number of threads that merge process uses
                --output, --out FILENAME  write the merged output to FILENAME
            `,
            values: #{
                "--db": "dirs", "--report": "files", "--log": "files", "--threads": "none", "--output": "files",
                "--out": "files",
            },
            args: ["files"],
        },
        _ => (),
    }
}

fn bracken() {
    #{
        opts: `
            -v            echoes the current software version and exits
            -d MY_DB      location of Kraken database
            -i INPUT      Kraken report file to use for abundance estimation
            -o OUTPUT     file name for Bracken default output
            -w OUTREPORT  new Kraken report with Bracken's read estimates
            -r READ_LEN   read length to get all classifications for
            -l LEVEL      level to estimate abundance at: D, P, C, O, F, G, S, S1, ...
            -t THRESHOLD  number of reads required prior to abundance estimation to reestimate
        `,
        values: #{
            "-d": "dirs", "-i": "files", "-o": "files", "-w": "files", "-r": "none",
            "-l": ["D", "P", "C", "O", "F", "G", "S", "D1", "P1", "C1", "O1", "F1", "G1", "S1"], "-t": "none",
        },
        args: ["none"],
    }
}

fn bracken_build() {
    #{
        opts: `
            -v                 echoes the current software version and exits
            -k KMER_LEN        kmer length used to build the kraken database
            -t THREADS         number of threads for the kraken classification and the bracken scripts
            -l READ_LEN        read length to get all classifications for
            -d MY_DB           location of Kraken database
            -x K_INSTALLATION  directory of the kraken/kraken-build programs (default: those in PATH)
            -y K_TYPE          version of kraken: kraken2 (the default), kraken or krakenuniq
        `,
        values: #{
            "-k": "none", "-t": "none", "-l": "none", "-d": "dirs", "-x": "dirs",
            "-y": ["kraken2", "kraken", "krakenuniq"],
        },
        args: ["none"],
    }
}

fn combine_bracken_outputs() {
    #{
        opts: `
            -h, --help           show this help message and exit
            --files FILES        bracken output files to combine
            --names NAMES        names of the input files, comma-separated, for the column headers
            -o, --output OUTPUT  name of output file with combined Bracken results
        `,
        values: #{
            "--files": "files", "--names": "none", "-o": "files", "--output": "files",
        },
        args: ["files"],
    }
}

fn krakenuniq() {
    #{
        opts: `
            --db NAME                    name for Kraken DB
            --threads NUM                number of threads
            --hll-precision INT          precision for HyperLogLog k-mer cardinality estimation, between 10 and 18
            --exact                      compute exact cardinality instead of an estimate (slower, more memory)
            --quick                      quick operation (use first hit or hits)
            --min-hits NUM               in quick operation, number of hits required for classification
            --unclassified-out FILENAME  print unclassified sequences to filename
            --classified-out FILENAME    print classified sequences to filename
            --output FILENAME            print output to filename (default: stdout); "off" suppresses it
            --only-classified-output     print no Kraken output for unclassified sequences
            --preload                    loads the entire DB into memory before classification
            --preload-size SIZE          load the DB into memory in chunks of SIZE (500M, 7G), overrides --preload
            --paired                     the two filenames provided are paired-end reads
            --check-names                ensure the names of each pair of reads agree (with --paired)
            --help                       print this message
            --version                    print version information
            --uid-mapping                map using UID database
            --report-file FILENAME       write the report (with unique k-mer counts) to filename
        `,
        values: #{
            "--db": "dirs", "--threads": "none", "--hll-precision": "none", "--min-hits": "none",
            "--unclassified-out": "files", "--classified-out": "files", "--output": "files",
            "--preload-size": "none", "--report-file": "files",
        },
        args: [k("sequences")],
    }
}

fn krakenuniq_build() {
    #{
        opts: `
            --download-taxonomy        download NCBI taxonomic information
            --download-library TYPE    download a partial library: refseq/bacteria, refseq/archaea, refseq/viral
            --add-to-library FILE      add FILE to library
            --build                    create the DB from the library (with the taxonomy and at least one file in the library)
            --rebuild                  create the DB from the library like --build, removing the other files first
            --clean                    remove unneeded files from a built database
            --shrink NEW_CT            shrink an existing DB to have only NEW_CT k-mers
            --standard                 download and create the default database (complete genomes of archaea, bacteria and viruses)
            --help                     print this message
            --version                  print version information
            --db DBDIR                 Kraken DB directory
            --threads NUM              number of threads
            --new-db NAME              new Kraken DB name (shrink task only; mandatory for shrink task)
            --kmer-len NUM             k-mer length in bp (build/shrink tasks only; def: 31)
            --minimizer-len NUM        minimizer length in bp (build/shrink tasks only; def: 15)
            --jellyfish-hash-size STR  pass a specific hash size argument to jellyfish when building database (build task only)
            --jellyfish-bin STR        use STR as Jellyfish 1 binary
            --max-db-size SIZE         shrink the DB before the build so that database and index use at most SIZE GB
            --shrink-block-offset NUM  when shrinking, select the k-mer NUM positions from the end of a block of k-mers
            --work-on-disk             perform most operations on disk rather than in RAM (will slow down build in most cases)
            --taxids-for-genomes       add taxonomy IDs (starting with 1 billion) for genomes
            --taxids-for-sequences     add taxonomy IDs for sequences, starting with 1 billion
            --min-contig-size NUM      minimum contig size for inclusion in database
            --library-dir DIR          use DIR for reference sequences instead of DBDIR/library
            --taxonomy-dir DIR         use DIR for taxonomy instead of DBDIR/taxonomy
            --uid-database             build a UID database
            --lca-database             build a LCA database
            --no-lca-database          do not build a LCA database
            --lca-order DIR            set the LCAs from this directory of the library first (once per directory, in order)
        `,
        values: #{
            "--download-library": ["refseq/bacteria", "refseq/archaea", "refseq/viral"],
            "--add-to-library": k("fasta"), "--shrink": "none", "--db": "dirs", "--threads": "none",
            "--new-db": "dirs", "--kmer-len": "none", "--minimizer-len": "none", "--jellyfish-hash-size": "none",
            "--jellyfish-bin": "files", "--max-db-size": "none", "--shrink-block-offset": "none",
            "--min-contig-size": "none", "--library-dir": "dirs", "--taxonomy-dir": "dirs", "--lca-order": "dirs",
        },
        args: ["none"],
    }
}

fn krakenuniq_report() {
    #{
        opts: `
            --db KRAKEN_DB_NAME  Kraken DB directory
            --show-zeros         show full taxonomy table
            --taxon-counts       the input files are 'TAXID<tab>COUNT' instead of Kraken output
            --taxon-list         the input files are lists of taxon IDs instead of Kraken output
            -h                   show the help
        `,
        values: #{
            "--db": "dirs",
        },
        args: ["files"],
    }
}

fn krakenuniq_download() {
    #{
        opts: `
            -o DIRECTORY                  folder to which the files are downloaded
            --db DIRECTORY                download to DIRECTORY/{library,taxonomy} (instead of -o)
            --threads N                   number of processes when downloading
            -R, --rsync                   download using rsync
            --overwrite                   redownload and overwrite files with the same name
            --verbose                     be verbose
            -D, --dust                    mask low-complexity regions using dustmasker
            --min-seq-len X               filter all sequences from the FASTA files that have less than X bp
            --search SEARCH_TERM          download all sequences returned from a NCBI nucleotide search
            --ac ACS                      accessions of the nucleotide database to download, comma-separated (instead of --search)
            --mapping-file MAP            map accessions with these files: nucl_est, nucl_gb, nucl_gss, nucl_wgs
            --retmode RM                  return mode: text, asn.1, xml
            --rettype RT                  return type: fasta, gb, gbc, native, ...
            --taxa TAXLIST                taxa to keep from nt, comma-separated: taxIDXXXX or a division (bacteria, viral, ...)
            --exclude-environmental-taxa  exclude taxa that are named 'environmental samples'
            --fna SEQTYPES                sequence types, comma-separated: genomic, rna, rna_from_genomic, cds_from_genomic
            -u                            filter unplaced sequences
        `,
        values: #{
            "-o": "dirs", "--db": "dirs", "--threads": "none", "--min-seq-len": "none", "--search": "none",
            "--ac": "none", "--mapping-file": ["nucl_est", "nucl_gb", "nucl_gss", "nucl_wgs"],
            "--retmode": ["text", "asn.1", "xml"],
            "--rettype": [
                "fasta", "gb", "gbc", "native", "acc", "seqid", "ft", "gbwithparts", "fasta_cds_na",
                "fasta_cds_aa",
            ],
            "--taxa": "none", "--fna": "none",
        },
        args: [[
            "contaminants", "taxonomy", "nucleotide", "microbial-nt", "nt", "viral-neighbors", "refseq/bacteria",
            "refseq/viral", "refseq/archaea", "refseq/fungi", "refseq/protozoa", "refseq/invertebrate",
            "refseq/plant", "refseq/vertebrate_mammalian", "refseq/vertebrate_other", "genbank/bacteria",
            "genbank/viral", "genbank/archaea", "genbank/fungi", "genbank/protozoa", "genbank/invertebrate",
            "genbank/plant", "genbank/vertebrate_mammalian", "genbank/vertebrate_other",
        ]],
    }
}

fn centrifuge() {
    #{
        opts: `
            -x CF_IDX                index filename prefix (minus the trailing .X.cf)
            -1 M1                    files with #1 mates, paired with the files of -2
            -2 M2                    files with #2 mates, paired with the files of -1
            -U R                     files with unpaired reads
            --sample-sheet S         a TSV file where each line is a sample
            -S FILENAME              file for the classification output (default: stdout)
            --report-file REPORT     file for the tabular report (default: centrifuge_report.tsv)
            -c                       the reads (-1, -2, -U) are sequences themselves, not files
            -q                       query input files are FASTQ .fq/.fastq
            --qseq                   query input files are in Illumina's qseq format
            -f                       query input files are (multi-)FASTA .fa/.mfa
            -r                       query input files are raw one-sequence-per-line
            -s, --skip INT           skip the first N reads/pairs in the input
            -u, --upto INT           stop after first N reads/pairs
            -5, --trim5 INT          trim N bases from 5'/left end of reads
            -3, --trim3 INT          trim N bases from 3'/right end of reads
            --phred33                qualities are Phred+33
            --phred64                qualities are Phred+64
            --int-quals              qualities encoded as space-delimited integers
            --ignore-quals           treat all quality values as 30 on Phred scale
            --nofw                   do not align forward (original) version of read
            --norc                   do not align reverse-complement version of read
            --min-hitlen INT         minimum length of partial hits
            -k INT                   report upto N distinct, primary assignments for each read or pair
            --host-taxids TAXIDS     comma-separated list of taxonomic IDs that will be preferred in classification
            --exclude-taxids TAXIDS  comma-separated list of taxonomic IDs that will be excluded in classification
            --out-fmt STR            output format: tab or sam
            --tab-fmt-cols STR       columns of the tabular format, comma separated
            -t, --time               print wall-clock time taken by search phases
            --un PATH                write unpaired reads that didn't align to PATH
            --al PATH                write unpaired reads that aligned at least once to PATH
            --un-conc PATH           write pairs that didn't align concordantly to PATH
            --al-conc PATH           write pairs that aligned concordantly at least once to PATH
            --quiet                  print nothing to stderr except serious errors
            --met-file PATH          send metrics to file at PATH
            --met-stderr             send metrics to stderr
            --met INT                report internal counters & metrics every N secs
            -p, --threads INT        number of alignment threads to launch
            --mm                     use memory-mapped I/O for the index, which several instances can share
            --qc-filter              filter out reads that are bad according to QSEQ filter
            --seed INT               seed for random number generator
            --non-deterministic      seed the random number generator arbitrarily, not from the reads
            --version                print version information and quit
            -h, --help               print this usage message
            --un-gz PATH             like --un, gzip compressed
            --un-bz2 PATH            like --un, bzip2 compressed
            --al-gz PATH             like --al, gzip compressed
            --al-bz2 PATH            like --al, bzip2 compressed
            --un-conc-gz PATH        like --un-conc, gzip compressed
            --un-conc-bz2 PATH       like --un-conc, bzip2 compressed
            --al-conc-gz PATH        like --al-conc, gzip compressed
            --al-conc-bz2 PATH       like --al-conc, bzip2 compressed
        `,
        values: #{
            "-x": k("centrifuge_index"), "-1": k("sequences"), "-2": k("sequences"), "-U": k("sequences"),
            "--sample-sheet": "files", "-S": "files", "--report-file": "files", "-s": "none", "--skip": "none",
            "-u": "none", "--upto": "none", "-5": "none", "--trim5": "none", "-3": "none", "--trim3": "none",
            "--min-hitlen": "none", "-k": "none", "--host-taxids": "none", "--exclude-taxids": "none",
            "--out-fmt": ["tab", "sam"], "--tab-fmt-cols": "none", "--un": "files", "--al": "files",
            "--un-conc": "files", "--al-conc": "files", "--met-file": "files", "--met": "none", "-p": "none",
            "--threads": "none", "--seed": "none", "--un-gz": "files", "--un-bz2": "files", "--al-gz": "files",
            "--al-bz2": "files", "--un-conc-gz": "files", "--un-conc-bz2": "files", "--al-conc-gz": "files",
            "--al-conc-bz2": "files",
        },
        args: ["none"],
    }
}

fn centrifuge_build() {
    #{
        opts: `
            -c                       the reference sequences are given on the command line, not files
            -a, --noauto             disable automatic -p/--bmax/--dcv memory-fitting
            --bmax INT               maximum bucket size for the blockwise suffix-array builder
            --bmaxdivn INT           maximum bucket size as a divisor of the reference length
            --dcv INT                diff-cover period for blockwise
            --nodc                   disable diff-cover (algorithm becomes quadratic)
            -r, --noref              don't build the .3/.4 (packed reference) portion
            -3, --justref            just build the .3/.4 (packed reference) portion
            -o, --offrate INT        sample the SA every 2^offrate BWT characters
            -t, --ftabchars INT      number of characters consumed in the initial lookup
            --conversion-table FILE  a table that converts any id to a taxonomy id
            --taxonomy-tree FILE     taxonomy tree
            --name-table FILE        names corresponding to taxonomic IDs
            --size-table FILE        table of contig (or genome) sizes
            --seed INT               seed for random number generator
            -q, --quiet              quiet output
            -p, --threads INT        number of alignment threads to launch
            --kmer-count INT         k size for counting the number of distinct k-mer
            -h, --help               print detailed description of tool and its options
            --usage                  print this usage message
            --version                print version information and quit
        `,
        values: #{
            "--bmax": "none", "--bmaxdivn": "none", "--dcv": "none", "-o": "none", "--offrate": "none",
            "-t": "none", "--ftabchars": "none", "--conversion-table": "files", "--taxonomy-tree": k("taxdump"),
            "--name-table": k("taxdump"), "--size-table": "files", "--seed": "none", "-p": "none",
            "--threads": "none", "--kmer-count": "none",
        },
        args: [k("fasta"), k("centrifuge_index")],
    }
}

fn centrifuge_inspect() {
    #{
        opts: `
            -a, --across INT    number of characters across in FASTA output
            -n, --names         print reference sequence names only
            -s, --summary       print a summary: reference names, lengths, index properties
            -e, --bt2-ref       reconstruct reference from .cf (slow, preserves colors)
            --conversion-table  print conversion table
            --taxonomy-tree     print taxonomy tree
            --name-table        print names corresponding to taxonomic IDs
            --size-table        print the lengths of the sequences belonging to the same taxonomic ID
