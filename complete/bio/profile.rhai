            "-f": ["sum", "mean"], "--function": ["sum", "mean"], "-e": "none", "--precision": "none",
            "-u": ["Y", "N"], "--ungrouped": ["Y", "N"], "-p": ["Y", "N"], "--protected": ["Y", "N"],
            "-o": "files", "--output": "files",
        },
        args: ["none"],
    }
}

