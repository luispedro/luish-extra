fn metaphlan() {
    #{
        opts: `
            --input_type FASTQ|FASTA|MAPOUT|SAM      whether the input is reads (FASTA/FASTQ), a mapout file or a SAM file
            --force                                  force profiling of the input file by removing the mapout file
            --db_dir METAPHLAN_DB                    folder containing the MetaPhlAn database (old --bowtie2db option)
            -x, --index INDEX                        specify the id of the database version to use
            --mapout FILE_NAME                       the file for saving the mapping output (old --bowtie2out option)
            --min_mapq_val MIN_MAPQ_VAL              minimum mapping quality value (MAPQ)
            --no_map                                 avoid storing the --mapout map file
            --tmp_dir TMP_DIR                        the folder used to store temporary files
            --bt2_ps PRESET                          presets of bowtie2 (for FASTA/FASTQ input)
            --bowtie2_exe BOWTIE2_EXE                full path and name of the BowTie2 executable
            --bowtie2_build BOWTIE2_BUILD            full path of the bowtie2-build command
            --tax_lev TAXONOMIC_LEVEL                the taxonomic level of the relative abundances: a (all), k, p, c, o, f, g, s, t
            --min_alignment_len MIN_ALIGNMENT_LEN    minimum length of the longest subalignment of a read's SAM records
            --ignore_eukaryotes                      do not profile eukaryotic organisms
            --ignore_bacteria                        do not profile bacterial organisms
            --ignore_archaea                         do not profile archeal organisms
            --ignore_ksgbs                           do not profile known SGBs
            --ignore_usgbs                           do not profile unknown SGBs
            --stat_q STAT_Q                          quantile value for the robust average
            --perc_nonzero PERC_NONZERO              percentage of markers with a non-zero relative abundance to misidentify a species
            --ignore_markers IGNORE_MARKERS          file containing a list of markers to ignore
            --avoid_disqm                            don't disambiguate the quasi-markers by the marker abundances
            --stat STAT                              statistical approach for converting marker abundances into clade abundances
            -t TYPE                                  type of analysis to perform
            --nreads NUMBER_OF_READS                 the total number of reads in the original metagenome
            --pres_th PRESENCE_THRESHOLD             threshold for calling a marker present by the -t marker_pres_table option
            -o, --output_file FILE                   the output file (if not specified stdout)
            --sample_id_key NAME                     specify the sample ID key for this analysis
            --use_group_representative               use a species as representative for species groups
            --sample_id ID                           specify the sample ID for this analysis
            -s, --samout FILE                        the sam output file
            --CAMI_format_output                     report the profiling using the CAMI output format
            --skip_unclassified_estimation           do not scale relative abundances to the estimate unclassified taxa
            --biom_format_output                     report the profiling using the biom output format
            --biom_mdelim DELIM                      delimiter for metadata in the biom output format
            --profile_vsc                            add this parameter to profile Viruses with VSCs approach
            --vsc_out VSC_OUT                        path to the VSCs breadth-of-coverage output file
            --vsc_breadth VSC_BREADTH                minimum Breadth of Coverage for a Viral Group to be reported
            --long_reads                             add this parameter to profile long reads
            --max_gcsd MAX_GCSD                      maximum gap-compressed sequence divergence (minimap2) between marker and read
            --minimap2_exe MINIMAP2_EXE              full path and name of the Minimap2 executable
            --minimap2_ps PRESET                     presets of minimap2 (for FASTA/FASTQ input)
            --nbases NUMBER_OF_BASES                 the total number of bases in the original metagenome
            --split_reads                            add this parameter to profile long reads by splitting into short reads
            --split_readlen SPLIT_READLEN            length of the reads to split into (with --split_reads)
            --nproc N                                the number of CPUs to use for parallelizing the mapping
            --subsampling SUBSAMPLING                specify the number of reads to be considered from the input metagenomes
            --mapping_subsampling                    if used, the subsamping will be done on the mapping results instead of on the reads
            --subsampling_seed SUBSAMPLING_SEED      random seed to use in the selection of the subsampled reads
            --subsampling_output SUBSAMPLING_OUTPUT  the output file for the subsampled reads
            --subsampling_paired SUBSAMPLING_PAIRED  specify the number of paired reads to be considered from the input metagenomes
            -1 FORWARD_READS                         specify the fastq file with forward reads of the input metagenomes
            -2 REVERSE_READS                         specify the fastq file with reverse reads of the input metagenomes
            --install                                only checks if the MetaPhlAn DB is installed and installs it if not
            --offline                                if used, MetaPhlAn will not check for new database updates
            --force_download                         force the re-download of the latest MetaPhlAn database
            --read_min_len READ_MIN_LEN              minimum length of the reads to consider when parsing the input file
            --verbose                                makes MetaPhlAn verbose
            -v, --version                            prints the current MetaPhlAn version and exit
            -h, --help                               show this help message and exit
        `,
        values: #{
            "--input_type": ["fastq", "fasta", "mapout", "sam"], "--db_dir": "dirs", "-x": "none",
            "--index": "none", "--mapout": "files", "--min_mapq_val": "none", "--tmp_dir": "dirs",
            "--bt2_ps": ["sensitive", "very-sensitive", "sensitive-local", "very-sensitive-local"],
            "--bowtie2_exe": "files", "--bowtie2_build": "files",
            "--tax_lev": ["a", "k", "p", "c", "o", "f", "g", "s", "t"], "--min_alignment_len": "none",
            "--stat_q": "none", "--perc_nonzero": "none", "--ignore_markers": "files",
            "--stat": ["avg_g", "avg_l", "tavg_g", "tavg_l", "wavg_g", "wavg_l", "med", "npos_lr", "nreads_lr"],
            "-t": ["rel_ab", "rel_ab_w_read_stats", "clade_profiles", "marker_ab_table", "marker_pres_table"],
            "--nreads": "none", "--pres_th": "none", "-o": "files", "--output_file": "files",
            "--sample_id_key": "none", "--sample_id": "none", "-s": "files", "--samout": "files",
            "--biom_mdelim": "none", "--vsc_out": "files", "--vsc_breadth": "none", "--max_gcsd": "none",
            "--minimap2_exe": "files", "--minimap2_ps": "none", "--nbases": "none", "--split_readlen": "none",
            "--nproc": "none", "--subsampling": "none", "--subsampling_seed": "none",
            "--subsampling_output": "files", "--subsampling_paired": "none", "-1": k("fastq"), "-2": k("fastq"),
            "--read_min_len": "none",
        },
        args: [k("reads")],
    }
}

