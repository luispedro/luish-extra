// Utilities for alignment and variant files: sambamba, bamtools, samblaster,
// mosdepth, cramino and vcftools. Generated by scripts/gen/mk_bam.py from the
// tools' own help, and vcftools' man page (versions in completion-todo.md).

fn k(name) { "@extra-complete/bio/kinds:" + name }

fn sambamba() {
    #{
        opts: `
            -q  quiet mode (do not show banner)
        `,
        commands: `
            view       view contents and convert from one format to another (SAM/BAM/JSON/UNPACK)
            index      build index (BAI)
            merge      merge files (BAM)
            sort       sort file (BAM)
            slice      slice file (BAM using BED)
            markdup    mark or remove duplicates (BAM)
            subsample  subsample (BAM)
            flagstat   output statistics (BAM)
            depth      output statistics (BAM)
            validate   simple validator (BAM)
            mpileup    parallel execution of samtools (BAM)
        `,
        sub_spec: "@extra-complete/bio/bam:sambamba",
    }
}

fn sambamba_sub(sub) {
    switch sub {
        "view" => #{
            opts: `
                -F, --filter FILTER               keep only the reads that satisfy FILTER
                --num-filter NUMFILTER            filter flag bits: 'i1/i2' is samtools' -f i1 -F i2
                -f, --format sam|bam|json|unpack  the output format
                -h, --with-header                 print the header before the reads
                -H, --header                      print only the header
                -I, --reference-info              output to stdout only reference names and lengths in JSON
                -L, --regions FILENAME            output only reads overlapping one of regions from the BED file
                -c, --count                       print only the number of matching records
                -v, --valid                       output only valid alignments
                -S, --sam-input                   the input is SAM
                -T, --ref-filename FASTA          the reference, for writing CRAM
                -p, --show-progress               show a progress bar on standard error
                -l, --compression-level N         the compression level (0 to 9)
                -o, --output-filename FILE        the output file
                -t, --nthreads NTHREADS           maximum number of threads to use
                -s, --subsample FRACTION          subsample reads (read pairs)
                --subsampling-seed SEED           set seed for subsampling
            `,
            values: #{
                "-F": "none", "--filter": "none", "--num-filter": "none", "-f": ["sam", "bam", "json", "unpack"],
                "--format": ["sam", "bam", "json", "unpack"], "-L": k("bed"), "--regions": k("bed"),
                "-T": k("fasta"), "--ref-filename": k("fasta"), "-l": "none", "--compression-level": "none",
                "-o": "files", "--output-filename": "files", "-t": "none", "--nthreads": "none", "-s": "none",
                "--subsample": "none", "--subsampling-seed": "none",
            },
            args: [k("sam"), k("regions")],
        },
        "index" => #{
            opts: `
                -t, --nthreads NTHREADS  number of threads to use for decompression
                -p, --show-progress      show a progress bar on standard error
                -c, --check-bins         check that bins are set correctly
                -F, --fasta-input        the input is FASTA
            `,
            values: #{
                "-t": "none", "--nthreads": "none",
            },
            args: [k("bam"), "files"],
            args_if: #{"-F": [k("fasta"), "files"]},
        },
        "merge" => #{
            opts: `
                -t, --nthreads NTHREADS                    number of threads to use for compression/decompression
                -l, --compression-level COMPRESSION_LEVEL  the compression level (0 to 9)
                -H, --header                               print the merged header as SAM, and nothing else
                -p, --show-progress                        show a progress bar on standard error
                -F, --filter FILTER                        keep only the reads that satisfy FILTER
            `,
            values: #{
                "-t": "none", "--nthreads": "none", "-l": "none", "--compression-level": "none", "-F": "none",
                "--filter": "none",
            },
            args: ["files", k("bam")],
        },
        "sort" => #{
            opts: `
                -m, --memory-limit LIMIT                   approximate total memory limit for all threads
                --tmpdir TMPDIR                            the directory for temporary files
                -o, --out OUTPUTFILE                       the output file (default: .sorted.bam)
                -n, --sort-by-name                         sort by read name instead of coordinate (lexicographical order)
                --sort-picard                              sort by query name like in picard
                -N, --natural-sort                         sort by read name instead of coordinate (so-called 'natural' sort as in samtools)
                -M, --match-mates                          pull mates of the same alignment together when sorting by read name
                -l, --compression-level COMPRESSION_LEVEL  the compression level (0 to 9)
                -u, --uncompressed-chunks                  write the sorted chunks uncompressed
                -p, --show-progress                        show a progress bar on standard error
                -t, --nthreads NTHREADS                    use specified number of threads
                -F, --filter FILTER                        keep only the reads that satisfy FILTER
            `,
            values: #{
                "-m": "none", "--memory-limit": "none", "--tmpdir": "dirs", "-o": "files", "--out": "files",
                "-l": "none", "--compression-level": "none", "-t": "none", "--nthreads": "none", "-F": "none",
                "--filter": "none",
            },
            args: [k("bam")],
        },
        "slice" => #{
            opts: `
                -L, --regions FILENAME  output only reads overlapping one of regions from the BED file
                -F, --fasta-input       the input is FASTA
            `,
            values: #{
                "-L": k("bed"), "--regions": k("bed"),
            },
            args: [k("bam"), k("regions")],
            args_if: #{"-F": [k("fasta"), k("regions")]},
        },
        "markdup" => #{
            opts: `
                -r, --remove-duplicates                  remove duplicates instead of just marking them
                -t, --nthreads NTHREADS                  number of threads to use
                -l, --compression-level N                the compression level (0 to 9)
                -p, --show-progress                      show a progress bar on standard error
                --tmpdir TMPDIR                          specify directory for temporary files
                --hash-table-size HASH_TABLE_SIZE        the size of the hash table for finding pairs
                --overflow-list-size OVERFLOW_LIST_SIZE  the size of the overflow list of reads thrown from the hash table
                --sort-buffer-size SORT_BUFFER_SIZE      memory for sorting, in megabytes
                --io-buffer-size BUFFER_SIZE             the size of the I/O buffers, in megabytes
            `,
            values: #{
                "-t": "none", "--nthreads": "none", "-l": "none", "--compression-level": "none",
                "--tmpdir": "dirs", "--hash-table-size": "none", "--overflow-list-size": "none",
                "--sort-buffer-size": "none", "--io-buffer-size": "none",
            },
            args: [k("bam")],
        },
        "subsample" => #{
            opts: `
                --type TYPE        the subsampling algorithm
                --max-cov DEPTH    the maximum coverage
                -o, --output FILE  the output file
                -r, --remove       remove over sampled reads from output
                --logging LEVEL    the logging level
            `,
            values: #{
                "--type": ["fasthash"], "--max-cov": "none", "-o": "files", "--output": "files",
                "--logging": ["debug", "info", "warning", "critical"],
            },
            args: [k("bam")],
        },
        "flagstat" => #{
            opts: `
                -p, --show-progress  show a progress bar on standard error
                -b, --tabular        output in csv format
            `,
            args: [k("bam")],
        },
        "depth" => #{
            commands: `
                base    the depth of each base
                region  the depth of each region of a BED file
                window  the depth of windows along the genome
            `,
            subs: #{
                base: #{
                    opts: `
                        -F, --filter FILTER             a custom filter for alignments
                        -o, --output-file FILENAME      output filename
                        -t, --nthreads NTHREADS         maximum number of threads to use
                        -c, --min-coverage MINCOVERAGE  minimum mean coverage for output
                        -C, --max-coverage MAXCOVERAGE  maximum mean coverage for output
                        -q, --min-base-quality QUAL     don't count bases with lower base quality
                        --combined                      output combined statistics for all samples
                        -a, --annotate                  mark records that fail the criteria with a column of y/n instead of skipping them
                        -m, --fix-mate-overlaps         detect overlaps of mate reads and handle them on per-base basis
                        -L, --regions FILENAME|REGION   a BED file of regions, or a region chr:beg-end
                    `,
                    values: #{
                        "-F": "none", "--filter": "none", "-o": "files", "--output-file": "files", "-t": "none",
                        "--nthreads": "none", "-c": "none", "--min-coverage": "none", "-C": "none",
                        "--max-coverage": "none", "-q": "none", "--min-base-quality": "none", "-L": k("bed"),
                        "--regions": k("bed"),
                    },
                    args: [k("bam")],
                },
                region: #{
                    opts: `
                        -F, --filter FILTER               a custom filter for alignments
                        -o, --output-file FILENAME        output filename
                        -t, --nthreads NTHREADS           maximum number of threads to use
                        -c, --min-coverage MINCOVERAGE    minimum mean coverage for output
                        -C, --max-coverage MAXCOVERAGE    maximum mean coverage for output
                        -q, --min-base-quality QUAL       don't count bases with lower base quality
                        --combined                        output combined statistics for all samples
                        -a, --annotate                    mark records that fail the criteria with a column of y/n instead of skipping them
                        -m, --fix-mate-overlaps           detect overlaps of mate reads and handle them on per-base basis
                        -L, --regions FILENAME|REGION     a BED file of regions, or a region chr:beg-end
                        -T, --cov-threshold COVTHRESHOLD  a coverage threshold: a column with the percentage of bases above it
                    `,
                    values: #{
                        "-F": "none", "--filter": "none", "-o": "files", "--output-file": "files", "-t": "none",
                        "--nthreads": "none", "-c": "none", "--min-coverage": "none", "-C": "none",
                        "--max-coverage": "none", "-q": "none", "--min-base-quality": "none", "-L": k("bed"),
                        "--regions": k("bed"), "-T": "none", "--cov-threshold": "none",
                    },
                    args: [k("bam")],
                },
                window: #{
                    opts: `
                        -F, --filter FILTER               a custom filter for alignments
                        -o, --output-file FILENAME        output filename
                        -t, --nthreads NTHREADS           maximum number of threads to use
                        -c, --min-coverage MINCOVERAGE    minimum mean coverage for output
                        -C, --max-coverage MAXCOVERAGE    maximum mean coverage for output
                        -q, --min-base-quality QUAL       don't count bases with lower base quality
                        --combined                        output combined statistics for all samples
                        -a, --annotate                    mark records that fail the criteria with a column of y/n instead of skipping them
                        -m, --fix-mate-overlaps           detect overlaps of mate reads and handle them on per-base basis
                        -w, --window-size WINDOWSIZE      breadth of the window, in bp (required)
                        --overlap OVERLAP                 overlap of successive windows, in bp
                        -T, --cov-threshold COVTHRESHOLD  a coverage threshold: a column with the percentage of bases above it
                    `,
                    values: #{
                        "-F": "none", "--filter": "none", "-o": "files", "--output-file": "files", "-t": "none",
                        "--nthreads": "none", "-c": "none", "--min-coverage": "none", "-C": "none",
                        "--max-coverage": "none", "-q": "none", "--min-base-quality": "none", "-w": "none",
                        "--window-size": "none", "--overlap": "none", "-T": "none", "--cov-threshold": "none",
                    },
                    args: [k("bam")],
                },
            },
        },
        "validate" => #{
            args: [k("bam")],
        },
        "mpileup" => #{
            opts: `
                -L, --regions FILENAME         a BED file of regions (all inputs must be indexed)
                -o, --output-filename FILE     the output file
                --tmpdir TMPDIR                directory for temporary files
                -t, --nthreads NTHREADS        maximum number of threads to use
                -b, --buffer-size SIZE         chunk size (in bytes)
                -B, --output-buffer-size SIZE  output buffer size (in bytes)
                --samtools                     the arguments of samtools mpileup follow
                --bcftools                     the arguments of bcftools call follow
            `,
            values: #{
                "-L": k("bed"), "--regions": k("bed"), "-o": "files", "--output-filename": "files",
                "--tmpdir": "dirs", "-t": "none", "--nthreads": "none", "-b": "none", "--buffer-size": "none",
                "-B": "none", "--output-buffer-size": "none",
            },
            args: [k("bam")],
        },
        _ => (),
    }
}

fn bamtools() {
    #{
        opts: `
            -h, --help  show help
            --version   show the version
        `,
        commands: `
            convert    converts between BAM and a number of other formats
            count      prints number of alignments in BAM file(s)
            coverage   prints coverage statistics from the input BAM file
            filter     filters BAM file(s) by user-specified criteria
            header     prints BAM header information
            index      generates index for BAM file
            merge      merge multiple BAM files into single file
            random     select random alignments from BAM file(s)
            resolve    resolves paired-end reads (marking the IsProperPair flag as needed)
            revert     removes duplicate marks and restores original base qualities
            sort       sorts the BAM file according to some criteria
            split      split a BAM file on a property, a BAM file for each value
            stats      prints some basic statistics from input BAM file(s)
            help       show the help of a command
        `,
        sub_spec: "@extra-complete/bio/bam:bamtools",
    }
}

fn bamtools_sub(sub) {
    switch sub {
        "convert" => #{
            opts: `
                -in BAM_FILENAME       the input BAM file(s)
                -list FILENAME         the input BAM file list, one line per file
                -out BAM_FILENAME      the output BAM file
                -format FORMAT         the output format
                -region REGION         genomic region
                -fasta FASTA_FILENAME  FASTA reference file
                -mapqual               print the mapping qualities
                -noheader              omit the SAM header from output
                -h, --help             shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files", "-out": "files",
                "-format": ["bed", "fasta", "fastq", "json", "pileup", "sam", "yaml"], "-region": "none",
                "-fasta": k("fasta"),
            },
            single_dash: true,
        },
        "count" => #{
            opts: `
                -in BAM_FILENAME  the input BAM file(s)
                -list FILENAME    the input BAM file list, one line per file
                -region REGION    genomic region
                -h, --help        shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files", "-region": "none",
            },
            single_dash: true,
        },
        "coverage" => #{
            opts: `
                -in BAM_FILENAME  the input BAM file
                -out FILENAME     the output file
                -h, --help        shows this help text
            `,
            values: #{
                "-in": k("bam"), "-out": "files",
            },
            single_dash: true,
        },
        "filter" => #{
            opts: `
                -in BAM_FILENAME                 the input BAM file(s)
                -list FILENAME                   the input BAM file list, one line per file
                -out BAM_FILENAME                the output BAM file
                -region REGION                   only read data from this genomic region
                -script FILENAME                 the filter script file
                -forceCompression                compress the output also when it goes to standard output
                -alignmentFlag INT               keep reads with this exact alignment flag
                -insertSize INT                  keep reads with insert size that matches pattern
                -length INT                      keep reads with length that matches pattern
                -mapQuality [0-255]              keep reads with map quality that matches pattern
                -name STRING                     keep reads with name that matches pattern
                -queryBases STRING               keep reads with motif that matches pattern
                -tag TAG:VALUE                   split by the values of this tag
                -isDuplicate TRUE|FALSE          keep only alignments that are marked as duplicate?
                -isFailedQC TRUE|FALSE           keep only alignments that failed QC?
                -isFirstMate TRUE|FALSE          keep only alignments marked as first mate?
                -isMapped TRUE|FALSE             keep only alignments that were mapped?
                -isMateMapped TRUE|FALSE         keep only alignments with mates that mapped
                -isMateReverseStrand TRUE|FALSE  keep only alignments with mate on reverse strand?
                -isPaired TRUE|FALSE             keep only alignments that were sequenced as paired?
                -isPrimaryAlignment TRUE|FALSE   keep only alignments marked as primary?
                -isProperPair TRUE|FALSE         keep only alignments that passed PE resolution?
                -isReverseStrand TRUE|FALSE      keep only alignments on reverse strand?
                -isSecondMate TRUE|FALSE         keep only alignments marked as second mate?
                -isSingleton TRUE|FALSE          keep only singletons
                -h, --help                       shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files", "-out": "files", "-region": "none", "-script": "files",
                "-alignmentFlag": "none", "-insertSize": "none", "-length": "none", "-mapQuality": "none",
                "-name": "none", "-queryBases": "none", "-tag": "none", "-isDuplicate": ["true", "false"],
                "-isFailedQC": ["true", "false"], "-isFirstMate": ["true", "false"],
                "-isMapped": ["true", "false"], "-isMateMapped": ["true", "false"],
                "-isMateReverseStrand": ["true", "false"], "-isPaired": ["true", "false"],
                "-isPrimaryAlignment": ["true", "false"], "-isProperPair": ["true", "false"],
                "-isReverseStrand": ["true", "false"], "-isSecondMate": ["true", "false"],
                "-isSingleton": ["true", "false"],
            },
            single_dash: true,
        },
        "header" => #{
            opts: `
                -in BAM_FILENAME  the input BAM file(s)
                -list FILENAME    the input BAM file list, one line per file
                -h, --help        shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files",
            },
            single_dash: true,
        },
        "index" => #{
            opts: `
                -in BAM_FILENAME  the input BAM file
                -bti              create (non-standard) BamTools index file (*.bti)
                -h, --help        shows this help text
            `,
            values: #{
                "-in": k("bam"),
            },
            single_dash: true,
        },
        "merge" => #{
            opts: `
                -in BAM_FILENAME   the input BAM file(s)
                -list FILENAME     the input BAM file list, one line per file
                -out BAM_FILENAME  the output BAM file
                -forceCompression  compress the output also when it goes to standard output
                -region REGION     genomic region
                -h, --help         shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files", "-out": "files", "-region": "none",
            },
            single_dash: true,
        },
        "random" => #{
            opts: `
                -in BAM_FILENAME        the input BAM file
                -list FILENAME          the input BAM file list, one line per file
                -out BAM_FILENAME       the output BAM file
                -region REGION          only pull random alignments from within this genomic region
                -forceCompression       compress the output also when it goes to standard output
                -n COUNT                number of alignments to grab
                -seed UNSIGNED_INTEGER  random number generator seed (for repeatable results)
                -h, --help              shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files", "-out": "files", "-region": "none", "-n": "none",
                "-seed": "none",
            },
            single_dash: true,
        },
        "resolve" => #{
            opts: `
                -in BAM_FILENAME       the input BAM file(s)
                -out BAM_FILENAME      the output BAM file
                -stats STATS_FILENAME  the statistics file, read or written
                -forceCompression      compress the output also when it goes to standard output
                -makeStats             write the fragment-length statistics of the input to the -stats file
                -markPairs             mark proper pairs, with the statistics of the -stats file
                -twoPass               -makeStats and -markPairs in one command (not from standard input)
                -minMQ UNSIGNED_SHORT  minimum map quality
                -ci DOUBLE             confidence interval
                -umt DOUBLE            unused model threshold: above it, a read group is ambiguous
                -force                 mark the pairs of ambiguous read groups too
                -h, --help             shows this help text
            `,
            values: #{
                "-in": k("bam"), "-out": "files", "-stats": "files", "-minMQ": "none", "-ci": "none",
                "-umt": "none",
            },
            single_dash: true,
        },
        "revert" => #{
            opts: `
                -in BAM_FILENAME   the input BAM file
                -out BAM_FILENAME  the output BAM file
                -forceCompression  compress the output also when it goes to standard output
                -keepDuplicate     keep duplicates marked
                -keepQualities     keep base qualities (do not replace with OQ contents)
                -h, --help         shows this help text
            `,
            values: #{
                "-in": k("bam"), "-out": "files",
            },
            single_dash: true,
        },
        "sort" => #{
            opts: `
                -in BAM_FILENAME   the input BAM file
                -out BAM_FILENAME  the output BAM file
                -byname            sort by alignment name
                -n COUNT           max number of alignments per tempfile
                -mem MB            max memory to use
                -h, --help         shows this help text
            `,
            values: #{
                "-in": k("bam"), "-out": "files", "-n": "none", "-mem": "none",
            },
            single_dash: true,
        },
        "split" => #{
            opts: `
                -in BAM_FILENAME      the input BAM file
                -refPrefix STRING     custom prefix for splitting by references
                -tagPrefix STRING     custom prefix for splitting by tags
                -stub FILENAME_STUB   the prefix of the output files
                -tagListDelim STRING  the separator of the values of list-type tags in file names
                -mapped               split mapped/unmapped alignments
                -paired               split single-end/paired-end alignments
                -reference            split alignments by reference
                -tag TAG_NAME         split by the values of this tag
                -h, --help            shows this help text
            `,
            values: #{
                "-in": k("bam"), "-refPrefix": "none", "-tagPrefix": "none", "-stub": "none",
                "-tagListDelim": "none", "-tag": "none",
            },
            single_dash: true,
        },
        "stats" => #{
            opts: `
                -in BAM_FILENAME  the input BAM file
                -list FILENAME    the input BAM file list, one line per file
                -insert           summarize insert size data
                -h, --help        shows this help text
            `,
            values: #{
                "-in": k("bam"), "-list": "files",
            },
            single_dash: true,
        },
        "help" => #{
            args: [["convert", "count", "coverage", "filter", "header", "index", "merge", "random", "resolve", "revert", "sort", "split", "stats"]],
        },
        _ => (),
    }
}

fn samblaster() {
    #{
        opts: `
            -i, --input FILE           input sam file
            -o, --output FILE          output sam file for all input alignments
            -d, --discordantFile FILE  output discordant read pairs to this file
            -s, --splitterFile FILE    output split reads to this file
            -u, --unmappedFile FILE    output unmapped or clipped reads as FASTQ to this file
            -a, --acceptDupMarks       accept the duplicate marks of the input instead of looking for duplicates
            -e, --excludeDups          leave duplicates out of the discordant, splitter and unmapped files
            -r, --removeDups           remove duplicates reads from all output files
            --addMateTags              add MC and MQ tags to all output paired-end SAM lines
            --ignoreUnmated            suppress abort on unmated alignments
            -M                         compatibility mode: both 0x100 and 0x800 are chimeric (as bwa mem -M)
            --maxReadLength INT        maximum length of SEQ/QUAL in the input
            --maxSplitCount INT        maximum number of split alignments of a read in the splitter file
            --maxUnmappedBases INT     maximum number of unaligned bases between two alignments in the splitter file
            --minIndelSize INT         minimum structural variant size of split alignments in the splitter file
            --minNonOverlap INT        minimum non-overlapping bases between two alignments in the splitter file
            --minClipSize INT          minimum number of clipped bases of a read in the unmapped file
            -q, --quiet                output fewer statistics
        `,
        values: #{
            "-i": k("sam"), "--input": k("sam"), "-o": "files", "--output": "files", "-d": "files",
            "--discordantFile": "files", "-s": "files", "--splitterFile": "files", "-u": "files",
            "--unmappedFile": "files", "--maxReadLength": "none", "--maxSplitCount": "none",
            "--maxUnmappedBases": "none", "--minIndelSize": "none", "--minNonOverlap": "none",
            "--minClipSize": "none",
        },
    }
}

fn mosdepth() {
    #{
        opts: `
            -t, --threads THREADS            number of BAM decompression threads
            -c, --chrom CHROM                chromosome to restrict depth calculation
            -b, --by BED|WINDOW              optional BED file or (integer) window-sizes
            -n, --no-per-base                dont output per-base depth
            -f, --fasta FASTA                fasta file for use with CRAM files
            --d4                             output per-base depth in d4 format
            -F, --flag FLAG                  exclude reads with any of the bits in FLAG set
            -i, --include-flag FLAG          only include reads with any of the bits in FLAG set
            -x, --fast-mode                  dont look at internal cigar operations or correct mate overlaps
            -a, --fragment-mode              count the coverage of the full fragment including the full insert (proper pairs only)
            -q, --quantize SEGMENTS          write quantized output see docs for description
            -Q, --mapq MAPQ                  mapping quality threshold
            -l, --min-frag-len MIN-FRAG-LEN  minimum insert size
            -u, --max-frag-len MAX-FRAG-LEN  maximum insert size
            -T, --thresholds THRESHOLDS      for each interval in --by, write number of bases covered by at least threshold bases
            -m, --use-median                 output median of each region (in --by) instead of mean
            -R, --read-groups STRING         only calculate depth for these comma-separated read groups IDs
            -h, --help                       show help
        `,
        values: #{
            "-t": "none", "--threads": "none", "-c": k("regions"), "--chrom": k("regions"), "-b": k("bed"),
            "--by": k("bed"), "-f": k("fasta"), "--fasta": k("fasta"), "-F": "none", "--flag": "none",
            "-i": "none", "--include-flag": "none", "-q": "none", "--quantize": "none", "-Q": "none",
            "--mapq": "none", "-l": "none", "--min-frag-len": "none", "-u": "none", "--max-frag-len": "none",
            "-T": "none", "--thresholds": "none", "-R": "none", "--read-groups": "none",
        },
        args: ["none", k("bam")],
    }
}

fn cramino() {
    #{
        opts: `
            -t, --threads THREADS            number of parallel decompression threads to use
            --reference REFERENCE            reference for decompressing cram
            -m, --min-read-len MIN_READ_LEN  minimal aligned length of a read to be considered (full length for unmapped reads)
            --hist[=FILE]                    if histograms have to be generated (optionally specify output file as --hist=FILE)
            --arrow ARROW                    write data to an arrow format file
            --karyotype                      provide normalized number of reads per chromosome
            --phased                         calculate metrics for phased reads
            --spliced                        provide metrics for spliced data
            --ubam                           also include unmapped reads, and estimate the identity from base qualities
            --format FORMAT                  output format (text, json, or tsv)
            --scaled                         scale histogram bins by total basepairs in each bin (not just read count)
            --hist-count[=FILE]              output read length histogram bin counts in TSV format
            -h, --help                       print help
            -V, --version                    print version
        `,
        values: #{
            "-t": "none", "--threads": "none", "--reference": k("fasta"), "-m": "none", "--min-read-len": "none",
            "--arrow": "files", "--format": ["text", "json", "tsv"],
        },
        args: [k("bam")],
    }
}

fn vcftools() {
    #{
        opts: `
            --vcf INPUT_FILENAME                     the VCF file to process
            --gzvcf INPUT_FILENAME                   a gzipped VCF file to process
            --bcf INPUT_FILENAME                     a BCF file to process
            --out OUTPUT_PREFIX                      the prefix of the output files
            --stdout                                 write to standard output
            -c                                       write to standard output
            --temp TEMPORARY_DIRECTORY               the directory for temporary files
            --chr CHROMOSOME                         include sites on this chromosome
            --not-chr CHROMOSOME                     exclude sites on this chromosome
            --from-bp INTEGER                        the lower bound of the sites
            --to-bp INTEGER                          the upper bound of the sites
            --positions FILENAME                     include the sites listed in a file
            --exclude-positions FILENAME             exclude the sites listed in a file
            --positions-overlap FILENAME             include sites whose reference allele overlaps the positions in a file
            --exclude-positions-overlap FILENAME     exclude sites whose reference allele overlaps the positions in a file
            --bed FILENAME                           include the sites in a BED file
            --exclude-bed FILENAME                   exclude the sites in a BED file
            --thin INTEGER                           no two sites closer than this
            --mask FILENAME                          a FASTA-like mask file to filter with
            --invert-mask FILENAME                   a mask file to filter with, inverted
            --mask-min INTEGER                       the threshold of the mask values
            --snp STRING                             include the SNP with this ID
            --snps FILENAME                          include the SNPs listed in a file
            --exclude FILENAME                       exclude the SNPs listed in a file
            --keep-only-indels                       include only sites with an indel
            --remove-indels                          exclude sites with an indel
            --remove-filtered-all                    remove sites with a FILTER other than PASS
            --keep-filtered STRING                   include sites with this FILTER flag
            --remove-filtered STRING                 exclude sites with this FILTER flag
            --keep-INFO STRING                       include sites with this INFO flag
            --remove-INFO STRING                     exclude sites with this INFO flag
            --maf FLOAT                              minimum minor allele frequency
            --max-maf FLOAT                          maximum minor allele frequency
            --non-ref-af FLOAT                       minimum frequency of all non-reference alleles
            --max-non-ref-af FLOAT                   maximum frequency of all non-reference alleles
            --non-ref-ac INTEGER                     minimum count of all non-reference alleles
            --max-non-ref-ac INTEGER                 maximum count of all non-reference alleles
            --non-ref-af-any FLOAT                   minimum frequency of any non-reference allele
            --max-non-ref-af-any FLOAT               maximum frequency of any non-reference allele
            --non-ref-ac-any INTEGER                 minimum count of any non-reference allele
            --max-non-ref-ac-any INTEGER             maximum count of any non-reference allele
            --mac INTEGER                            minimum minor allele count
            --max-mac INTEGER                        maximum minor allele count
            --min-alleles INTEGER                    minimum number of alleles
            --max-alleles INTEGER                    maximum number of alleles
            --min-meanDP FLOAT                       minimum mean depth of a site
            --max-meanDP FLOAT                       maximum mean depth of a site
            --hwe FLOAT                              exclude sites out of Hardy-Weinberg equilibrium (p-value below this)
            --max-missing FLOAT                      maximum proportion of missing data (1: none allowed)
            --max-missing-count INTEGER              maximum number of missing genotypes of a site
            --phased                                 exclude sites with unphased genotypes
            --minQ FLOAT                             minimum quality of a site
            --indv STRING                            keep this individual
            --remove-indv STRING                     remove this individual
            --keep FILENAME                          keep the individuals listed in a file
            --remove FILENAME                        remove the individuals listed in a file
            --max-indv INTEGER                       keep at most this many individuals, chosen at random
            --remove-filtered-geno-all               exclude genotypes with a FILTER other than . or PASS
            --remove-filtered-geno STRING            exclude genotypes with a specific FILTER flag
            --minGQ FLOAT                            minimum quality of a genotype
            --minDP FLOAT                            minimum depth of a genotype
            --maxDP FLOAT                            maximum depth of a genotype
            --freq                                   allele frequency of each site
            --freq2                                  allele frequency of each site, without the alleles
            --counts                                 allele counts of each site
            --counts2                                allele counts of each site, without the alleles
            --derived                                the ancestral allele first (with the frequency options)
            --depth                                  mean depth per individual
            --site-depth                             depth per site, summed over the individuals
            --site-mean-depth                        mean depth per site over the individuals
            --geno-depth                             depth of each genotype
            --hap-r2                                 r2, D and D' from phased haplotypes
            --geno-r2                                r2 between genotypes (as PLINK)
            --geno-chisq                             chi-squared test of genotype independence, for multi-allelic sites
            --hap-r2-positions POSITIONS_LIST_FILE   r2 of the sites in a file against all others, from haplotypes
            --geno-r2-positions POSITIONS_LIST_FILE  r2 of the sites in a file against all others, from genotypes
            --ld-window INTEGER                      maximum number of SNPs between the SNPs tested for LD
            --ld-window-bp INTEGER                   maximum number of bases between the SNPs tested for LD
            --ld-window-min INTEGER                  minimum number of SNPs between the SNPs tested for LD
            --ld-window-bp-min INTEGER               minimum number of bases between the SNPs tested for LD
            --min-r2 FLOAT                           minimum r2 to report
            --interchrom-hap-r2                      r2 of sites on different chromosomes, from haplotypes
            --interchrom-geno-r2                     r2 of sites on different chromosomes, from genotypes
            --TsTv INTEGER                           Ts/Tv ratio in bins of this size
            --TsTv-summary                           summary of transitions and transversions
            --TsTv-by-count                          Ts/Tv ratio by alternative allele count
            --TsTv-by-qual                           Ts/Tv ratio by quality
            --FILTER-summary                         number of SNPs and Ts/Tv ratio of each FILTER
            --site-pi                                nucleotide diversity per site
            --window-pi INTEGER                      nucleotide diversity in windows of this size
            --window-pi-step INTEGER                 the step of --window-pi
            --weir-fst-pop FILENAME                  a file of the individuals of a population, for Weir and Cockerham's Fst
            --fst-window-size INTEGER                the window size of --weir-fst-pop
            --fst-window-step INTEGER                the step of --weir-fst-pop
            --het                                    heterozygosity of each individual
            --hardy                                  Hardy-Weinberg equilibrium test of each site
            --TajimaD INTEGER                        Tajima's D in bins of this size
            --indv-freq-burden                       number of variants of each frequency in each individual
            --LROH                                   long runs of homozygosity (experimental)
            --relatedness                            relatedness (Yang et al. 2010)
            --relatedness2                           relatedness (Manichaikul et al. 2010)
            --site-quality                           quality of each site
            --missing-indv                           missingness of each individual
            --missing-site                           missingness of each site
            --SNPdensity INTEGER                     number and density of SNPs in bins of this size
            --kept-sites                             list the sites kept after filtering
            --removed-sites                          list the sites removed by filtering
            --singletons                             singletons and private doubletons
            --hist-indel-len                         histogram of indel lengths
            --hapcount BED_FILE                      number of unique haplotypes in the regions of a BED file
            --mendel PED_FILE                        Mendel errors in the trios of a PED file
            --extract-FORMAT-info STRING             extract a FORMAT field of the genotypes
            --get-INFO STRING                        extract an INFO field
            --recode                                 write a new VCF after filtering
            --recode-bcf                             write a new BCF after filtering
            --recode-INFO STRING                     an INFO key to keep when recoding
            --recode-INFO-all                        keep all INFO values when recoding
            --contigs FILENAME                       a file of contig header lines, for --recode-bcf
            --012                                    the genotypes as a matrix of 0, 1 and 2
            --IMPUTE                                 phased haplotypes in IMPUTE reference-panel format
            --ldhat                                  output in LDhat format (phased)
            --ldhelmet                               output in LDhelmet format
            --ldhat-geno                             output in LDhat format (unphased)
            --BEAGLE-GL                              output GL likelihoods for BEAGLE
            --BEAGLE-PL                              output PL likelihoods for BEAGLE
            --plink                                  output in PLINK PED format
            --plink-tped                             output in PLINK transposed format
            --chrom-map FILENAME                     a file mapping chromosome names to integers, for PLINK
            --diff FILENAME                          a VCF file to compare with
            --gzdiff FILENAME                        a gzipped VCF file to compare with
            --diff-bcf FILENAME                      a BCF file to compare with
            --diff-site                              the sites common to or unique to each file
            --diff-indv                              the individuals common to or unique to each file
            --diff-site-discordance                  discordance of each site
            --diff-indv-discordance                  discordance of each individual
            --diff-indv-map FILENAME                 a file mapping the individuals of the second file to those of the first
            --diff-discordance-matrix                discordance matrix (bi-allelic sites)
            --diff-switch-error                      phasing switch errors
        `,
        values: #{
            "--vcf": k("vcf"), "--gzvcf": k("vcf"), "--bcf": k("vcf"), "--out": "files", "--temp": "dirs",
            "--chr": k("vcf_regions"), "--not-chr": k("vcf_regions"), "--from-bp": "none", "--to-bp": "none",
            "--positions": "files", "--exclude-positions": "files", "--positions-overlap": "files",
            "--exclude-positions-overlap": "files", "--bed": k("bed"), "--exclude-bed": k("bed"), "--thin": "none",
            "--mask": "files", "--invert-mask": "files", "--mask-min": "none", "--snp": "none", "--snps": "files",
            "--exclude": "files", "--keep-filtered": "none", "--remove-filtered": "none", "--keep-INFO": "none",
            "--remove-INFO": "none", "--maf": "none", "--max-maf": "none", "--non-ref-af": "none",
            "--max-non-ref-af": "none", "--non-ref-ac": "none", "--max-non-ref-ac": "none",
            "--non-ref-af-any": "none", "--max-non-ref-af-any": "none", "--non-ref-ac-any": "none",
            "--max-non-ref-ac-any": "none", "--mac": "none", "--max-mac": "none", "--min-alleles": "none",
            "--max-alleles": "none", "--min-meanDP": "none", "--max-meanDP": "none", "--hwe": "none",
            "--max-missing": "none", "--max-missing-count": "none", "--minQ": "none", "--indv": k("vcf_samples"),
            "--remove-indv": k("vcf_samples"), "--keep": "files", "--remove": "files", "--max-indv": "none",
            "--remove-filtered-geno": "none", "--minGQ": "none", "--minDP": "none", "--maxDP": "none",
            "--hap-r2-positions": "files", "--geno-r2-positions": "files", "--ld-window": "none",
            "--ld-window-bp": "none", "--ld-window-min": "none", "--ld-window-bp-min": "none", "--min-r2": "none",
            "--TsTv": "none", "--window-pi": "none", "--window-pi-step": "none", "--weir-fst-pop": "files",
            "--fst-window-size": "none", "--fst-window-step": "none", "--TajimaD": "none", "--SNPdensity": "none",
            "--hapcount": k("bed"), "--mendel": "files", "--extract-FORMAT-info": "none", "--get-INFO": "none",
            "--recode-INFO": "none", "--contigs": "files", "--chrom-map": "files", "--diff": k("vcf"),
            "--gzdiff": k("vcf"), "--diff-bcf": k("vcf"), "--diff-indv-map": "files",
        },
    }
}

fn spec(cmd) {
    switch cmd {
        "sambamba" => sambamba(),
        "bamtools" => bamtools(),
        "samblaster" => samblaster(),
        "mosdepth" => mosdepth(),
        "cramino" => cramino(),
        "vcftools" => vcftools(),
        _ => #{},
    }
}

fn sub_spec(name, sub) {
    switch name {
        "sambamba" => sambamba_sub(sub),
        "bamtools" => bamtools_sub(sub),
        _ => (),
    }
}
