// pytest 9.1.1, with the options of pytest-xdist 3.8.0 and pytest-cov 7.1.0, from its argparse parser (`pytest
// --help`). The arguments are test files and directories, and the tests in a file (`test_x.py::TestY::test_z`).
// Generated by scripts/gen/mk_pytest.py.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn spec(cmd) {
    #{
        opts: `
            -k EXPRESSION                                 only run tests which match the given substring expression
            -m MARKEXPR                                   only run tests matching given mark expression
            --markers                                     show markers (builtin, plugin and per-project ones)
            -x, --exitfirst                               exit instantly on first error or failed test
            --maxfail num                                 exit after first num failures or errors
            --strict-config                               enables the strict_config option
            --strict-markers                              enables the strict_markers option
            --strict                                      enables the strict option
            -W, --pythonwarnings PYTHONWARNINGS           set which warnings to report, see -W option of Python itself
            --max-warnings num                            exit with error if all tests pass but the number of warnings exceeds this threshold
            --collectonly, --collect-only, --co           only collect tests, don't execute them
            --pyargs                                      try to interpret all arguments as Python packages
            --ignore path                                 ignore path during collection (multi-allowed)
            --ignore-glob path                            ignore path pattern during collection (multi-allowed)
            --deselect nodeid_prefix                      deselect item (via node id prefix) during collection (multi-allowed)
            --confcutdir dir                              only load conftest.py's relative to specified dir
            --noconftest                                  don't load any conftest.py files
            --keepduplicates, --keep-duplicates           keep duplicate tests
            --collect-in-virtualenv                       don't ignore tests in a local virtualenv directory
            --continue-on-collection-errors               force test execution even if collection errors occur
            --import-mode PREPEND|APPEND|IMPORTLIB        prepend/append to sys.path when importing test modules and conftest files
            -c, --config-file FILE                        load configuration from FILE instead of the implicit configuration files
            --rootdir ROOTDIR                             define root directory for tests
            --basetemp dir                                base temporary directory for this test run
            --durations N                                 show N slowest setup/test durations (N=0 for all)
            --durations-min N                             minimal duration in seconds for inclusion in slowest list
            --fixtures, --funcargs                        show available fixtures, sorted by plugin appearance
            --fixtures-per-test                           show fixtures per test
            -V, --version                                 display pytest version and information about plugins
            -h, --help                                    show help message and configuration info
            -p name                                       early-load given plugin module name or entry point (multi-allowed)
            --disable-plugin-autoload                     disable plugin auto-loading through entry point packaging metadata
            --traceconfig, --trace-config                 trace considerations of conftest.py files
            --debug[=DEBUG_FILE_NAME]                     store internal tracing debug information in this log file
            -o, --override-ini OVERRIDE_INI               override a configuration option (NAME=VALUE)
            -v, --verbose                                 increase verbosity
            --no-header                                   disable header
            --no-summary                                  disable summary
            --no-fold-skipped                             do not fold skipped tests in short summary
            --force-short-summary                         force condensed summary output regardless of verbosity level
            -q, --quiet                                   decrease verbosity
            --verbosity VERBOSE                           set verbosity
            -r, --report-chars chars                      show extra test summary info as specified by chars: (f)ailed, (E)rror, (s)kipped
            --disable-warnings, --disable-pytest-warnings  disable warnings summary
            -l, --showlocals                              show locals in tracebacks (disabled by default)
            --no-showlocals                               hide locals in tracebacks (negate --showlocals passed through addopts)
            --tb style                                    traceback print mode (auto/long/short/line/native/no)
            --xfail-tb                                    show tracebacks for xfail (as long as --tb != no)
            --show-capture NO|STDOUT|STDERR|LOG|ALL       controls how captured stdout/stderr/log is shown on failed tests
            --fulltrace, --full-trace                     don't cut any tracebacks
            --color color                                 color terminal output (yes/no/auto)
            --code-highlight YES|NO                       whether code should be highlighted (only if --color is also enabled)
            --pdb                                         start the interactive Python debugger on errors or KeyboardInterrupt
            --pdbcls modulename:classname                 custom interactive Python debugger for --pdb (modulename:classname)
            --trace                                       immediately break when running each test
            --capture method                              per-test capturing method: one of fd|sys|no|tee-sys
            -s                                            shortcut for --capture=no
            --runxfail                                    report the results of xfail tests as if they were not marked
            --pastebin mode                               send failed|all info to bpaste.net pastebin service
            --assert MODE                                 control assertion debugging tools
            --junitxml, --junit-xml path                  create junit-xml style report file at given path
            --junitprefix, --junit-prefix str             prepend prefix to classnames in junit-xml output
            --doctest-modules                             run doctests in all .py modules
            --doctest-report NONE|CDIFF|NDIFF|UDIFF|ONLY_FIRST_FAILURE  choose another output format for diffs on doctest failure
            --doctest-glob pat                            doctests file matching pattern, default: test*.txt
            --doctest-ignore-import-errors                ignore doctest collection errors
            --doctest-continue-on-failure                 for a given doctest, continue to run after the first failure
            --lf, --last-failed                           rerun only the tests that failed at the last run (or all if none failed)
            --ff, --failed-first                          run all tests, but run the last failures first
            --nf, --new-first                             run tests from new files first, then the rest of the tests sorted by file mtime
            --cache-show[=CACHESHOW]                      show cache contents, don't perform collection or tests
            --cache-clear                                 remove all cache contents at start of test run
            --lfnf, --last-failed-no-failures ALL|NONE    with --lf, what to run when there are no known failures
            --setuponly, --setup-only                     only setup fixtures, do not execute tests
            --setupshow, --setup-show                     show setup of fixtures while executing tests
            --setupplan, --setup-plan                     show what fixtures and tests would be executed but don't execute anything
            --sw, --stepwise                              exit on test failure and continue from last failing test next time
            --sw-skip, --stepwise-skip                    ignore the first failing test but stop on the next failing test
            --sw-reset, --stepwise-reset                  resets stepwise state, restarting the stepwise workflow
            --log-level LEVEL                             level of messages to catch/display
            --log-format LOG_FORMAT                       log format used by the logging module
            --log-date-format LOG_DATE_FORMAT             log date format used by the logging module
            --log-cli-level LOG_CLI_LEVEL                 CLI logging level
            --log-cli-format LOG_CLI_FORMAT               log format used by the logging module
            --log-cli-date-format LOG_CLI_DATE_FORMAT     log date format used by the logging module
            --log-file LOG_FILE                           path to a file when logging will be written to
            --log-file-mode W|A                           log file open mode
            --log-file-level LOG_FILE_LEVEL               log file logging level
            --log-file-format LOG_FILE_FORMAT             log format used by the logging module
            --log-file-date-format LOG_FILE_DATE_FORMAT   log date format used by the logging module
            --log-auto-indent LOG_AUTO_INDENT             auto-indent multiline messages passed to the logging module
            --log-disable LOGGER_DISABLE                  disable a logger by name
            -n, --numprocesses numprocesses               number of workers (auto: one per CPU, logical: per logical CPU)
            --maxprocesses maxprocesses                   maximum number of workers with --numprocesses
            --max-worker-restart MAXWORKERRESTART         maximum number of workers that can be restarted when crashed
            --dist distmode                               set mode for distributing tests to exec environments
            --loadscope-reorder                           reorder tests by number of tests per scope with --dist loadscope
            --no-loadscope-reorder                        don't reorder tests with --dist loadscope
            --tx xspec                                    add a test execution environment
            --px xspec                                    add a proxy gateway to pass to test execution environments
            -d                                            load-balance tests
            --rsyncdir DIR                                add directory for rsyncing to remote tx nodes
            --rsyncignore GLOB                            add expression for ignores when rsyncing to remote tx nodes
            --testrunuid TESTRUNUID                       provide an identifier shared amongst all workers as the value of the 'testrun_uid' fixture
            --maxschedchunk MAXSCHEDCHUNK                 maximum number of tests scheduled in one step for --dist=load
            -f, --looponfail                              run tests in subprocess: wait for files to be modified, then re-run failing test set
            --cov[=SOURCE]                                path or package name to measure during execution (multi-allowed)
            --cov-reset                                   reset cov sources accumulated in options so far
            --cov-report TYPE                             type of report to generate: term, term-missing, annotate, html, xml, json, markdown
            --cov-config PATH                             config file for coverage
            --no-cov-on-fail                              do not report coverage if test run fails
            --no-cov                                      disable coverage report completely (useful for debuggers)
            --cov-fail-under MIN                          fail if the total coverage is less than MIN
            --cov-append                                  do not delete coverage but append to current
            --cov-branch                                  enable branch coverage
            --cov-precision COV_PRECISION                 override the reporting precision
            --cov-context CONTEXT                         dynamic contexts to use
        `,
        values: #{
            "-k": "none", "-m": own("kinds:pytest_markers"), "--maxfail": "none",
            "-W": ["default", "error", "ignore", "always", "module", "once"],
            "--pythonwarnings": ["default", "error", "ignore", "always", "module", "once"],
            "--max-warnings": "none", "--ignore": "files", "--ignore-glob": "none",
            "--deselect": own("kinds:pytest_tests"), "--confcutdir": "dirs",
            "--import-mode": ["prepend", "append", "importlib"], "-c": "files", "--config-file": "files",
            "--rootdir": "dirs", "--basetemp": "dirs", "--durations": "none", "--durations-min": "none",
            "-p": "none", "--debug": "files", "-o": own("pytest:ini"), "--override-ini": own("pytest:ini"),
            "--verbosity": "none", "-r": ["fE", "a", "A", "N", "f", "E", "s", "x", "X", "p", "P", "w"],
            "--report-chars": ["fE", "a", "A", "N", "f", "E", "s", "x", "X", "p", "P", "w"],
            "--tb": ["auto", "long", "short", "no", "line", "native"],
            "--show-capture": ["no", "stdout", "stderr", "log", "all"], "--color": ["yes", "no", "auto"],
            "--code-highlight": ["yes", "no"], "--pdbcls": "none", "--capture": ["fd", "sys", "no", "tee-sys"],
            "--pastebin": ["failed", "all"], "--assert": ["rewrite", "plain"], "--junitxml": "files",
            "--junit-xml": "files", "--junitprefix": "none", "--junit-prefix": "none",
            "--doctest-report": ["none", "cdiff", "ndiff", "udiff", "only_first_failure"],
            "--doctest-glob": "none", "--cache-show": "none", "--lfnf": ["all", "none"],
            "--last-failed-no-failures": ["all", "none"],
            "--log-level": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"], "--log-format": "none",
            "--log-date-format": "none", "--log-cli-level": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
            "--log-cli-format": "none", "--log-cli-date-format": "none", "--log-file": "files",
            "--log-file-mode": ["w", "a"], "--log-file-level": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
            "--log-file-format": "none", "--log-file-date-format": "none",
            "--log-auto-indent": ["true", "false", "on", "off"], "--log-disable": "none",
            "-n": ["auto", "logical"], "--numprocesses": ["auto", "logical"], "--maxprocesses": "none",
            "--max-worker-restart": "none",
            "--dist": ["each", "load", "loadscope", "loadfile", "loadgroup", "worksteal", "no"], "--tx": "none",
            "--px": "none", "--rsyncdir": "dirs", "--rsyncignore": "none", "--testrunuid": "none",
            "--maxschedchunk": "none", "--cov": "dirs",
            "--cov-report": [
                "term", "term-missing", "term:skip-covered", "annotate", "html", "xml", "json", "lcov", "markdown",
                "markdown-append",
            ], "--cov-config": "files", "--cov-fail-under": "none", "--cov-precision": "none",
            "--cov-context": ["test"],
        },
        args: [own("kinds:pytest_tests")],
        args_if: #{"--doctest-modules": [own("kinds:pytest_modules")], "--pyargs": ["dev:python_modules"]},
    }
}

// The configuration options, for `-o NAME=VALUE`.
fn ini() {
    [
        #{value: "assertion_text_diff_style=", desc: "choose how pytest renders diffs for string equality assertions: ndiff or block", suffix: ""},
        #{value: "cache_dir=", desc: "cache directory path", suffix: ""},
        #{value: "collect_imported_tests=", desc: "whether to collect tests in imported modules outside 'testpaths'", suffix: ""},
        #{value: "consider_namespace_packages=", desc: "consider namespace packages when resolving module names during import", suffix: ""},
        #{value: "console_output_style=", desc: "console output: 'classic', or with additional progress information", suffix: ""},
        #{value: "disable_test_id_escaping_and_forfeit_all_rights_to_community_support=", desc: "disable string escape non-ASCII characters, might cause unwanted side effects", suffix: ""},
        #{value: "doctest_encoding=", desc: "encoding used for doctest files", suffix: ""},
        #{value: "doctest_optionflags=", desc: "option flags for doctests", suffix: ""},
        #{value: "empty_parameter_set_mark=", desc: "default marker for empty parametersets", suffix: ""},
        #{value: "enable_assertion_pass_hook=", desc: "enables the pytest_assertion_pass hook", suffix: ""},
        #{value: "faulthandler_exit_on_timeout=", desc: "exit the test process if a test takes more than faulthandler_timeout seconds to finish", suffix: ""},
        #{value: "faulthandler_timeout=", desc: "dump the traceback of all threads if a test takes more than TIMEOUT seconds to finish", suffix: ""},
        #{value: "filterwarnings=", desc: "each line specifies a pattern for warnings.filterwarnings", suffix: ""},
        #{value: "junit_duration_report=", desc: "duration time to report: one of total|call", suffix: ""},
        #{value: "junit_family=", desc: "emit XML for schema: one of legacy|xunit1|xunit2", suffix: ""},
        #{value: "junit_log_passing_tests=", desc: "capture log information for passing tests to JUnit report", suffix: ""},
        #{value: "junit_logging=", desc: "write captured log messages to JUnit report", suffix: ""},
        #{value: "junit_suite_name=", desc: "test suite name for JUnit report", suffix: ""},
        #{value: "log_auto_indent=", desc: "default value for --log-auto-indent", suffix: ""},
        #{value: "log_cli=", desc: "enable log display during test run (also known as 'live logging')", suffix: ""},
        #{value: "log_cli_date_format=", desc: "default value for --log-cli-date-format", suffix: ""},
        #{value: "log_cli_format=", desc: "default value for --log-cli-format", suffix: ""},
        #{value: "log_cli_level=", desc: "default value for --log-cli-level", suffix: ""},
        #{value: "log_date_format=", desc: "default value for --log-date-format", suffix: ""},
        #{value: "log_file=", desc: "default value for --log-file", suffix: ""},
        #{value: "log_file_date_format=", desc: "default value for --log-file-date-format", suffix: ""},
        #{value: "log_file_format=", desc: "default value for --log-file-format", suffix: ""},
        #{value: "log_file_level=", desc: "default value for --log-file-level", suffix: ""},
        #{value: "log_file_mode=", desc: "default value for --log-file-mode", suffix: ""},
        #{value: "log_format=", desc: "default value for --log-format", suffix: ""},
        #{value: "log_level=", desc: "default value for --log-level", suffix: ""},
        #{value: "looponfailroots=", desc: "directories to check for changes", suffix: ""},
        #{value: "markers=", desc: "register new markers for test functions", suffix: ""},
        #{value: "max_warnings=", desc: "exit with error if all tests pass but the number of warnings exceeds this threshold", suffix: ""},
        #{value: "norecursedirs=", desc: "directory patterns to avoid for recursion", suffix: ""},
        #{value: "python_classes=", desc: "prefixes or glob names for Python test class discovery", suffix: ""},
        #{value: "python_files=", desc: "glob-style file patterns for Python test module discovery", suffix: ""},
        #{value: "python_functions=", desc: "prefixes or glob names for Python test function and method discovery", suffix: ""},
        #{value: "rsyncdirs=", desc: "list of (relative) paths to be rsynced for remote distributed testing", suffix: ""},
        #{value: "rsyncignore=", desc: "list of (relative) glob-style paths to be ignored for rsyncing", suffix: ""},
        #{value: "strict=", desc: "enables all strictness options, currently: strict_config, strict_markers, strict_xfail", suffix: ""},
        #{value: "strict_config=", desc: "any warnings encountered while parsing the 'pytest' section of the configuration file", suffix: ""},
        #{value: "strict_markers=", desc: "markers not registered in the 'markers' section of the configuration file raise errors", suffix: ""},
        #{value: "strict_parametrization_ids=", desc: "emit an error if non-unique parameter set IDs are detected", suffix: ""},
        #{value: "strict_xfail=", desc: "default for the strict parameter of xfail markers when not given explicitly", suffix: ""},
        #{value: "testpaths=", desc: "directories to search for tests when no files or directories are given on the command line", suffix: ""},
        #{value: "tmp_path_retention_count=", desc: "how many sessions should we keep the 'tmp_path' directories, according to", suffix: ""},
        #{value: "tmp_path_retention_policy=", desc: "controls which directories created by the 'tmp_path' fixture are kept around, based on", suffix: ""},
        #{value: "truncation_limit_chars=", desc: "set threshold of CHARS after which truncation will take effect", suffix: ""},
        #{value: "truncation_limit_lines=", desc: "set threshold of LINES after which truncation will take effect", suffix: ""},
        #{value: "usefixtures=", desc: "list of default fixtures to be used with this project", suffix: ""},
        #{value: "verbosity_assertions=", desc: "specify a verbosity level for assertions, overriding the main level", suffix: ""},
        #{value: "verbosity_subtests=", desc: "specify verbosity level for subtests", suffix: ""},
        #{value: "verbosity_test_cases=", desc: "specify a verbosity level for test case execution, overriding the main level", suffix: ""},
    ]
}

fn kind(name, cur, words) {
    switch name {
        "ini" => ini(),
        _ => throw `unknown kind: ${name}`,
    }
}
