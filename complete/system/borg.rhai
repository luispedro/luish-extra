// BorgBackup 1.2.8, from its argparse parser (`borg COMMAND --help`): the commands, their options and arguments,
// and the options common to all of them. Repositories are directories or `HOST:PATH`, and archives `REPO::NAME` (or
// `::NAME`, with BORG_REPO). Generated by scripts/gen/mk_borg.py.

fn spec(cmd) {
    #{
        opts: `
            -V, --version  show version number and exit
        `,
        common: `
            -h, --help                     show this help message and exit
            --critical                     work on log level CRITICAL
            --error                        work on log level ERROR
            --warning                      work on log level WARNING
            -v, --info, --verbose          work on log level INFO
            --debug                        enable debug output, work on log level DEBUG
            --debug-topic TOPIC            enable TOPIC debugging (can be specified multiple times)
            -p, --progress                 show progress information
            --iec                          format using IEC units (1KiB = 1024B)
            --log-json                     output one JSON object per log line instead of formatted text
            --lock-wait SECONDS            wait at most SECONDS for acquiring a repository/cache lock
            --bypass-lock                  bypass locking mechanism
            --show-version                 show/log the borg version
            --show-rc                      show/log the return code (rc)
            --umask M                      set umask to M (local only, default: 0077)
            --remote-path PATH             use PATH as borg executable on the remote
            --remote-ratelimit RATE        deprecated, use --upload-ratelimit instead
            --upload-ratelimit RATE        set network upload rate limit in kiByte/s
            --remote-buffer UPLOAD_BUFFER  deprecated, use --upload-buffer instead
            --upload-buffer UPLOAD_BUFFER  set network upload buffer size in MiB
            --consider-part-files          treat part files like normal files (e.g to list/extract them)
            --debug-profile FILE           write an execution profile into FILE
            --rsh RSH                      use this command to connect to the 'borg serve' process
        `,
        values: #{
            "--debug-topic": "none", "--lock-wait": "none", "--umask": "none", "--remote-path": "none",
            "--remote-ratelimit": "none", "--upload-ratelimit": "none", "--remote-buffer": "none",
            "--upload-buffer": "none", "--debug-profile": "files", "--rsh": "none",
        },
        commands: `
            benchmark   benchmark command
            break-lock  break repository and cache locks
            check       verify repository
            compact     compact segment files / free space in repo
            config      get and set configuration values
            create      create backup
            debug       debugging command
            delete      delete archive
            diff        find differences in archive contents
            export-tar  create tarball from archive
            extract     extract archive contents
            help        show help on a command or a topic
            info        show repository or archive information
            init        initialize empty repository
            key         manage repository key
            list        list archive or repository contents
            mount       mount repository
            prune       prune archives
            recreate    re-create archives
            rename      rename archive
            serve       start repository server process
            umount      umount repository
            upgrade     upgrade repository format
            with-lock   run user command with lock held
            import-tar  create a backup archive from a tarball
        `,
        subs: #{
            "benchmark": #{
                commands: `
                    crud  benchmarks borg CRUD (create, extract, update, delete)
                `,
                subs: #{
                    "crud": #{
                        args: ["@extra-complete/system/kinds:borg_location", "dirs"],
                    },
                },
            },
            "break-lock": #{
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "check": #{
                opts: `
                    --repository-only         only perform repository checks
                    --archives-only           only perform archives checks
                    --verify-data             perform cryptographic archive data integrity verification
                    --repair                  attempt to repair any inconsistencies found
                    --save-space              work slower, but using less space
                    --max-duration SECONDS    do only a partial repository check, for at most SECONDS
                    -P, --prefix PREFIX       only consider archive names starting with this prefix
                    -a, --glob-archives GLOB  only consider archive names matching the glob
                    --sort-by KEYS            comma-separated list of sorting keys; valid keys are: timestamp, archive, name, id
                    --first N                 consider first N archives after other filters were applied
                    --last N                  consider last N archives after other filters were applied
                `,
                values: #{
                    "--max-duration": "none", "-P": "none", "--prefix": "none", "-a": "none",
                    "--glob-archives": "none", "--sort-by": ["timestamp", "archive", "name", "id"],
                    "--first": "none", "--last": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "compact": #{
                opts: `
                    --cleanup-commits    cleanup commit-only 17-byte segment files
                    --threshold PERCENT  set minimum threshold for saved space in PERCENT
                `,
                values: #{
                    "--threshold": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "config": #{
                opts: `
                    -c, --cache   get and set values from the repo cache
                    -d, --delete  delete the key from the config file
                    -l, --list    list the configuration of the repo
                `,
                args: ["@extra-complete/system/kinds:borg_location", "none", "none"],
            },
            "create": #{
                opts: `
                    -n, --dry-run                      do not create a backup archive
                    -s, --stats                        print statistics for the created archive
                    --list                             output verbose list of items (files, dirs, ...)
                    --filter STATUSCHARS               only display items with the given status characters (see description)
                    --json                             output stats as JSON. Implies --stats
                    --no-cache-sync                    experimental: do not synchronize the cache
                    --stdin-name NAME                  use NAME in archive for stdin data
                    --stdin-user USER                  set user USER in archive for stdin data
                    --stdin-group GROUP                set group GROUP in archive for stdin data
                    --stdin-mode M                     set mode to M in archive for stdin data
                    --content-from-command             interpret PATH as command and store its stdout
                    --paths-from-stdin                 read DELIM-separated list of paths to backup from stdin
                    --paths-from-command               interpret PATH as command and treat its output as --paths-from-stdin
                    --paths-delimiter DELIM            set path delimiter for --paths-from-stdin and --paths-from-command
                    -e, --exclude PATTERN              exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE         read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN                  include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE        read include/exclude patterns from PATTERNFILE, one per line
                    --exclude-caches                   exclude directories that contain a CACHEDIR.TAG file
                    --exclude-if-present NAME          exclude directories that are tagged by containing a filesystem object with the given NAME
                    --keep-exclude-tags                if tag objects are specified with --exclude-if-present, don't omit the tag objects
                    --exclude-nodump                   exclude files flagged NODUMP
                    -x, --one-file-system              stay in the same file system
                    --numeric-owner                    deprecated, use --numeric-ids instead
                    --numeric-ids                      only store numeric user and group identifiers
                    --noatime                          do not store atime into archive
                    --atime                            do store atime into archive
                    --noctime                          do not store ctime into archive
                    --nobirthtime                      do not store birthtime (creation date) into archive
                    --nobsdflags                       deprecated, use --noflags instead
                    --noflags                          do not read and store flags (e.g NODUMP, IMMUTABLE) into archive
                    --noacls                           do not read and store ACLs into archive
                    --noxattrs                         do not read and store xattrs into archive
                    --sparse                           detect sparse holes in input (supported only by fixed chunker)
                    --files-cache MODE                 operate files cache in MODE. default: ctime,size,inode
                    --read-special                     open and read block and char device files as well as FIFOs as if they were regular files
                    --comment COMMENT                  add a comment text to the archive
                    --timestamp TIMESTAMP              manually specify the archive creation date/time (UTC, yyyy-mm-ddThh:mm:ss format)
                    -c, --checkpoint-interval SECONDS  write checkpoint every SECONDS seconds
                    --chunker-params PARAMS            specify the chunker parameters
                    -C, --compression COMPRESSION      the compression algorithm (see borg help compression)
                `,
                values: #{
                    "--filter": "none", "--stdin-name": "none", "--stdin-user": "users", "--stdin-group": "groups",
                    "--stdin-mode": "none", "--paths-delimiter": "none", "-e": "none", "--exclude": "none",
                    "--exclude-from": "files", "--pattern": "none", "--patterns-from": "files",
                    "--exclude-if-present": "none",
                    "--files-cache": [
                        "ctime,size,inode", "mtime,size,inode", "ctime,size", "mtime,size", "rechunk,ctime",
                        "rechunk,mtime", "size", "disabled",
                    ], "--comment": "none", "--timestamp": "none", "-c": "none", "--checkpoint-interval": "none",
                    "--chunker-params": "@extra-complete/system/kinds:borg_chunker_params",
                    "-C": "@extra-complete/system/kinds:borg_compression",
                    "--compression": "@extra-complete/system/kinds:borg_compression",
                },
                args: ["@extra-complete/system/kinds:borg_location", "files"],
            },
            "debug": #{
                commands: `
                    info                show system infos for debugging / bug reports
                    dump-archive-items  dump archive items (metadata)
                    dump-archive        dump decoded archive metadata
                    dump-manifest       dump decoded repository metadata
                    dump-repo-objs      dump repo objects
                    search-repo-objs    search repo objects
                    id-hash             compute id-hash for some file content
                    get-obj             get object from repository
                    put-obj             put object to repository
                    delete-obj          delete object from repository
                    refcount-obj        show refcount for object from repository
                    dump-hints          dump repo hints
                    convert-profile     convert Borg profile to Python profile
                `,
                subs: #{
                    "info": #{
                        args: ["none"],
                    },
                    "dump-archive-items": #{
                        args: ["@extra-complete/system/kinds:borg_location"],
                    },
                    "dump-archive": #{
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "dump-manifest": #{
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "dump-repo-objs": #{
                        opts: `
                            --ghost        dump all segment file contents, including deleted/uncommitted objects and commits
                            --segment SEG  used together with --ghost: limit processing to given segment
                            --offset OFFS  used together with --ghost: limit processing to given offset
                        `,
                        values: #{
                            "--segment": "none", "--offset": "none",
                        },
                        args: ["@extra-complete/system/kinds:borg_location"],
                    },
                    "search-repo-objs": #{
                        args: ["@extra-complete/system/kinds:borg_location", "none"],
                    },
                    "id-hash": #{
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "get-obj": #{
                        args: ["@extra-complete/system/kinds:borg_location", "none", "files"],
                    },
                    "put-obj": #{
                        args: ["@extra-complete/system/kinds:borg_location", "none", "files"],
                    },
                    "delete-obj": #{
                        args: ["@extra-complete/system/kinds:borg_location", "none"],
                    },
                    "refcount-obj": #{
                        args: ["@extra-complete/system/kinds:borg_location", "none"],
                    },
                    "dump-hints": #{
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "convert-profile": #{
                        args: ["files", "files"],
                    },
                },
            },
            "delete": #{
                opts: `
                    -n, --dry-run                      do not change repository
                    --list                             output verbose list of archives
                    -s, --stats                        print statistics for the deleted archive
                    --cache-only                       delete only the local cache for the given repository
                    --force                            force the deletion of corrupted archives (twice: even if that fails)
                    --keep-security-info               keep the local security info when deleting a repository
                    --save-space                       work slower, but using less space
                    -c, --checkpoint-interval SECONDS  write checkpoint every SECONDS seconds
                    -P, --prefix PREFIX                only consider archive names starting with this prefix
                    -a, --glob-archives GLOB           only consider archive names matching the glob
                    --sort-by KEYS                     comma-separated list of sorting keys; valid keys are: timestamp, archive, name, id
                    --first N                          consider first N archives after other filters were applied
                    --last N                           consider last N archives after other filters were applied
                `,
                values: #{
                    "-c": "none", "--checkpoint-interval": "none", "-P": "none", "--prefix": "none", "-a": "none",
                    "--glob-archives": "none", "--sort-by": ["timestamp", "archive", "name", "id"],
                    "--first": "none", "--last": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location", "none"],
            },
            "diff": #{
                opts: `
                    --numeric-owner              deprecated, use --numeric-ids instead
                    --numeric-ids                only consider numeric user and group identifiers
                    --same-chunker-params        override check of chunker parameters
                    --sort                       sort the output lines by file path
                    --content-only               only compare differences in content (exclude metadata differences)
                    --json-lines                 format output as JSON Lines
                    -e, --exclude PATTERN        exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE   read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN            include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE  read include/exclude patterns from PATTERNFILE, one per line
                `,
                values: #{
                    "-e": "none", "--exclude": "none", "--exclude-from": "files", "--pattern": "none",
                    "--patterns-from": "files",
                },
                args: ["@extra-complete/system/kinds:borg_location", "none", "none"],
            },
            "export-tar": #{
                opts: `
                    --tar-filter TAR_FILTER      filter program to pipe data through
                    --list                       output verbose list of items (files, dirs, ...)
                    -e, --exclude PATTERN        exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE   read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN            include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE  read include/exclude patterns from PATTERNFILE, one per line
                    --strip-components NUMBER    remove the specified number of leading path elements
                `,
                values: #{
                    "--tar-filter": ["auto", "gzip", "bzip2", "xz", "lzma", "lz4", "zstd"], "-e": "none",
                    "--exclude": "none", "--exclude-from": "files", "--pattern": "none",
                    "--patterns-from": "files", "--strip-components": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location", "files", "none"],
            },
            "extract": #{
                opts: `
                    --list                       output verbose list of items (files, dirs, ...)
                    -n, --dry-run                do not actually change any files
                    --numeric-owner              deprecated, use --numeric-ids instead
                    --numeric-ids                only obey numeric user and group identifiers
                    --nobsdflags                 deprecated, use --noflags instead
                    --noflags                    do not extract/set flags (e.g NODUMP, IMMUTABLE)
                    --noacls                     do not extract/set ACLs
                    --noxattrs                   do not extract/set xattrs
                    --stdout                     write all extracted data to stdout
                    --sparse                     create holes in output sparse file from all-zero chunks
                    -e, --exclude PATTERN        exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE   read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN            include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE  read include/exclude patterns from PATTERNFILE, one per line
                    --strip-components NUMBER    remove the specified number of leading path elements
                `,
                values: #{
                    "-e": "none", "--exclude": "none", "--exclude-from": "files", "--pattern": "none",
                    "--patterns-from": "files", "--strip-components": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location", "none"],
            },
            "help": #{
                opts: `
                    --epilog-only  show only the epilog
                    --usage-only   show only the usage
                `,
                args: ["@extra-complete/system/borg:topics"],
            },
            "info": #{
                opts: `
                    --json                    format output as JSON
                    -P, --prefix PREFIX       only consider archive names starting with this prefix
                    -a, --glob-archives GLOB  only consider archive names matching the glob
                    --sort-by KEYS            comma-separated list of sorting keys; valid keys are: timestamp, archive, name, id
                    --first N                 consider first N archives after other filters were applied
                    --last N                  consider last N archives after other filters were applied
                `,
                values: #{
                    "-P": "none", "--prefix": "none", "-a": "none", "--glob-archives": "none",
                    "--sort-by": ["timestamp", "archive", "name", "id"], "--first": "none", "--last": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "init": #{
                opts: `
                    -e, --encryption MODE  select encryption key mode
                    --append-only          create an append-only mode repository
                    --storage-quota QUOTA  set storage quota of the new repository (e.g 5G, 1.5T)
                    --make-parent-dirs     create the parent directories of the repository directory, if they are missing
                `,
                values: #{
                    "-e": [
                        "none", "keyfile", "repokey", "authenticated", "keyfile-blake2", "repokey-blake2",
                        "authenticated-blake2",
                    ],
                    "--encryption": [
                        "none", "keyfile", "repokey", "authenticated", "keyfile-blake2", "repokey-blake2",
                        "authenticated-blake2",
                    ], "--storage-quota": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "key": #{
                commands: `
                    export              export repository key for backup
                    import              import repository key from backup
                    change-passphrase   change repository passphrase
                    migrate-to-repokey  migrate passphrase-mode repository to repokey
                `,
                subs: #{
                    "export": #{
                        opts: `
                            --paper    create an export suitable for printing and later type-in
                            --qr-html  create an html file suitable for printing and later type-in or qr scan
                        `,
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "import": #{
                        opts: `
                            --paper  interactively import from a backup done with --paper
                        `,
                        args: ["@extra-complete/system/kinds:borg_location", "files"],
                    },
                    "change-passphrase": #{
                        args: ["@extra-complete/system/kinds:borg_location"],
                    },
                    "migrate-to-repokey": #{
                        args: ["@extra-complete/system/kinds:borg_location"],
                    },
                },
            },
            "list": #{
                opts: `
                    --consider-checkpoints       show checkpoint archives in the repository contents list
                    --short                      only print file/directory names, nothing else
                    --format FORMAT              specify format for file or archive listing
                    --json                       only valid for listing repository contents
                    --json-lines                 only valid for listing archive contents
                    -P, --prefix PREFIX          only consider archive names starting with this prefix
                    -a, --glob-archives GLOB     only consider archive names matching the glob
                    --sort-by KEYS               comma-separated list of sorting keys; valid keys are: timestamp, archive, name, id
                    --first N                    consider first N archives after other filters were applied
                    --last N                     consider last N archives after other filters were applied
                    -e, --exclude PATTERN        exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE   read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN            include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE  read include/exclude patterns from PATTERNFILE, one per line
                `,
                values: #{
                    "--format": "none", "-P": "none", "--prefix": "none", "-a": "none", "--glob-archives": "none",
                    "--sort-by": ["timestamp", "archive", "name", "id"], "--first": "none", "--last": "none",
                    "-e": "none", "--exclude": "none", "--exclude-from": "files", "--pattern": "none",
                    "--patterns-from": "files",
                },
                args: ["@extra-complete/system/kinds:borg_location", "none"],
            },
            "mount": #{
                opts: `
                    --consider-checkpoints       show checkpoint archives in the repository contents list
                    -f, --foreground             stay in foreground, do not daemonize
                    -o OPTIONS                   extra mount options
                    --numeric-owner              deprecated, use --numeric-ids instead
                    --numeric-ids                use numeric user and group identifiers from archive(s)
                    -P, --prefix PREFIX          only consider archive names starting with this prefix
                    -a, --glob-archives GLOB     only consider archive names matching the glob
                    --sort-by KEYS               comma-separated list of sorting keys; valid keys are: timestamp, archive, name, id
                    --first N                    consider first N archives after other filters were applied
                    --last N                     consider last N archives after other filters were applied
                    -e, --exclude PATTERN        exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE   read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN            include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE  read include/exclude patterns from PATTERNFILE, one per line
                    --strip-components NUMBER    remove the specified number of leading path elements
                `,
                values: #{
                    "-o": ["versions", "allow_damaged_files", "ignore_permissions", "allow_other", "allow_root"],
                    "-P": "none", "--prefix": "none", "-a": "none", "--glob-archives": "none",
                    "--sort-by": ["timestamp", "archive", "name", "id"], "--first": "none", "--last": "none",
                    "-e": "none", "--exclude": "none", "--exclude-from": "files", "--pattern": "none",
                    "--patterns-from": "files", "--strip-components": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location", "dirs", "none"],
            },
            "prune": #{
                opts: `
                    -n, --dry-run                          do not change repository
                    --force                                force the pruning of corrupted archives (twice: even if that fails)
                    -s, --stats                            print statistics for the deleted archive
                    --list                                 output verbose list of archives it keeps/prunes
                    --keep-within INTERVAL                 keep all archives within this time interval
                    --keep-last, --keep-secondly SECONDLY  number of secondly archives to keep
                    --keep-minutely MINUTELY               number of minutely archives to keep
                    -H, --keep-hourly HOURLY               number of hourly archives to keep
                    -d, --keep-daily DAILY                 number of daily archives to keep
                    -w, --keep-weekly WEEKLY               number of weekly archives to keep
                    -m, --keep-monthly MONTHLY             number of monthly archives to keep
                    -y, --keep-yearly YEARLY               number of yearly archives to keep
                    -P, --prefix PREFIX                    only consider archive names starting with this prefix
                    -a, --glob-archives GLOB               only consider archive names matching the glob
                    --save-space                           work slower, but using less space
                    -c, --checkpoint-interval SECONDS      write checkpoint every SECONDS seconds
                `,
                values: #{
                    "--keep-within": "none", "--keep-last": "none", "--keep-secondly": "none",
                    "--keep-minutely": "none", "-H": "none", "--keep-hourly": "none", "-d": "none",
                    "--keep-daily": "none", "-w": "none", "--keep-weekly": "none", "-m": "none",
                    "--keep-monthly": "none", "-y": "none", "--keep-yearly": "none", "-P": "none",
                    "--prefix": "none", "-a": "none", "--glob-archives": "none", "-c": "none",
                    "--checkpoint-interval": "none",
                },
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "recreate": #{
                opts: `
                    --list                             output verbose list of items (files, dirs, ...)
                    --filter STATUSCHARS               only display items with the given status characters (listed in borg create --help)
                    -n, --dry-run                      do not change anything
                    -s, --stats                        print statistics at end
                    -e, --exclude PATTERN              exclude paths matching PATTERN
                    --exclude-from EXCLUDEFILE         read exclude patterns from EXCLUDEFILE, one per line
                    --pattern PATTERN                  include/exclude paths matching PATTERN
                    --patterns-from PATTERNFILE        read include/exclude patterns from PATTERNFILE, one per line
                    --exclude-caches                   exclude directories that contain a CACHEDIR.TAG file
                    --exclude-if-present NAME          exclude directories that are tagged by containing a filesystem object with the given NAME
                    --keep-exclude-tags                if tag objects are specified with --exclude-if-present, don't omit the tag objects
                    --target TARGET                    create a new archive with the name ARCHIVE, do not replace existing archive
                    -c, --checkpoint-interval SECONDS  write checkpoint every SECONDS seconds
                    --comment COMMENT                  add a comment text to the archive
                    --timestamp TIMESTAMP              manually specify the archive creation date/time (UTC, yyyy-mm-ddThh:mm:ss format)
                    -C, --compression COMPRESSION      the compression algorithm (see borg help compression)
                    --recompress[=MODE]                recompress data chunks according to MODE and --compression
                    --chunker-params PARAMS            rechunk using given chunker parameters
                `,
                values: #{
                    "--filter": "none", "-e": "none", "--exclude": "none", "--exclude-from": "files",
                    "--pattern": "none", "--patterns-from": "files", "--exclude-if-present": "none",
                    "--target": "none", "-c": "none", "--checkpoint-interval": "none", "--comment": "none",
                    "--timestamp": "none", "-C": "@extra-complete/system/kinds:borg_compression",
                    "--compression": "@extra-complete/system/kinds:borg_compression",
                    "--recompress": ["never", "if-different", "always"],
                    "--chunker-params": "@extra-complete/system/kinds:borg_chunker_params",
                },
                args: ["@extra-complete/system/kinds:borg_location", "none"],
            },
            "rename": #{
                args: ["@extra-complete/system/kinds:borg_location", "none"],
            },
            "serve": #{
                opts: `
                    --restrict-to-path PATH        restrict repository access to PATH (can be repeated)
                    --restrict-to-repository PATH  restrict repository access
                    --append-only                  only allow appending to repository segment files
                    --storage-quota QUOTA          override storage quota of the repository (e.g 5G, 1.5T)
                `,
                values: #{
                    "--restrict-to-path": "dirs", "--restrict-to-repository": "dirs", "--storage-quota": "none",
                },
                args: ["none"],
            },
            "umount": #{
                args: ["@extra-complete/system/kinds:fuse_mounts"],
            },
            "upgrade": #{
                opts: `
                    -n, --dry-run         do not change repository
                    --inplace             rewrite the repository in place (with no going back to older versions)
                    --force               force upgrade
                    --tam                 enable manifest authentication (in key and cache) (Borg 1.0.9 and later)
                    --check-tam           check manifest authentication (in key and cache)
                    --disable-tam         disable manifest authentication (in key and cache)
                    --check-archives-tam  check TAM authentication for all archives
                    --archives-tam        add TAM authentication for all archives
                `,
                args: ["@extra-complete/system/kinds:borg_location"],
            },
            "with-lock": #{
                args: ["@extra-complete/system/kinds:borg_location", "commands", "files"],
            },
            "import-tar": #{
                opts: `
                    --tar-filter TAR_FILTER            filter program to pipe data through
                    -s, --stats                        print statistics for the created archive
                    --list                             output verbose list of items (files, dirs, ...)
                    --filter STATUSCHARS               only display items with the given status characters
                    --json                             output stats as JSON (implies --stats)
                    --ignore-zeros                     ignore zero-filled blocks in the input tarball
                    --comment COMMENT                  add a comment text to the archive
                    --timestamp TIMESTAMP              manually specify the archive creation date/time (UTC, yyyy-mm-ddThh:mm:ss format)
                    -c, --checkpoint-interval SECONDS  write checkpoint every SECONDS seconds
                    --chunker-params PARAMS            specify the chunker parameters
                    -C, --compression COMPRESSION      the compression algorithm (see borg help compression)
                `,
                values: #{
                    "--tar-filter": ["auto", "gzip", "bzip2", "xz", "lzma", "lz4", "zstd"], "--filter": "none",
                    "--comment": "none", "--timestamp": "none", "-c": "none", "--checkpoint-interval": "none",
                    "--chunker-params": "@extra-complete/system/kinds:borg_chunker_params",
                    "-C": "@extra-complete/system/kinds:borg_compression",
                    "--compression": "@extra-complete/system/kinds:borg_compression",
                },
                args: ["@extra-complete/system/kinds:borg_location", "files"],
            },
        },
    }
}

// What `borg help` shows help on: its topics, and the commands.
fn topics() {
    [
        "patterns", "placeholders", "compression", "benchmark", "break-lock", "check", "compact", "config",
        "create", "debug", "delete", "diff", "export-tar", "extract", "help", "import-tar", "info", "init", "key",
        "list", "mount", "prune", "recreate", "rename", "serve", "umount", "upgrade", "with-lock",
    ]
}

fn kind(name, cur, words) {
    switch name {
        "topics" => topics(),
        _ => throw `unknown kind: ${name}`,
    }
}
