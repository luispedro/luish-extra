// flake8 [OPTIONS] FILE...
fn flake8() {
    #{
        opts: `
            -h, --help                               show this help message and exit
            -v, --verbose                            print more information about what is happening in flake8
            --output-file OUTPUT_FILE                redirect report to a file
            --append-config APPEND_CONFIG            provide extra config files to parse in addition to the files found by Flake8 by default
            --config CONFIG                          path to the config file that will be the authoritative config source
            --isolated                               ignore all configuration files
            --enable-extensions ENABLE_EXTENSIONS    enable plugins and extensions that are otherwise disabled by default
            --require-plugins REQUIRE_PLUGINS        require specific plugins to be installed before running
            --version                                show program's version number and exit
            -q, --quiet                              report only file names, or nothing
            --color AUTO|ALWAYS|NEVER                whether to use color in output
            --count                                  print total number of errors to standard output after all other output
            --exclude patterns                       comma-separated list of files or directories to exclude
            --extend-exclude patterns                comma-separated list of files or directories to add to the list of excluded ones
            --filename patterns                      only check for filenames matching the patterns in this comma-separated list
            --stdin-display-name STDIN_DISPLAY_NAME  the name used when reporting errors from code passed via stdin
            --format format                          the format of the errors: a formatter, or a %-style format string
            --hang-closing                           hang closing bracket instead of matching indentation of opening bracket's line
            --ignore errors                          ignore the codes that these prefixes match (comma-separated)
            --extend-ignore errors                   add these code prefixes to --ignore (comma-separated)
            --per-file-ignores PER_FILE_IGNORES      the codes to ignore in files (FILES:CODES ..., as in the configuration)
            --max-line-length n                      maximum allowed line length for the entirety of this run
            --max-doc-length n                       maximum allowed doc line length for the entirety of this run
            --indent-size n                          number of spaces used for indentation
            --select errors                          report only the codes that these prefixes match (comma-separated)
            --extend-select errors                   add these code prefixes to the default --select (comma-separated)
            --disable-noqa                           report errors on the lines that end in '# noqa' too
            --show-source                            show the source generate each error or warning
            --no-show-source                         negate --show-source
            --statistics                             count errors
            --exit-zero                              exit with status code "0" even if there are errors
            -j, --jobs JOBS                          the number of processes to check files in (auto: one per CPU)
            --tee                                    write to stdout and output-file
            --benchmark                              print benchmark information about this run of Flake8
            --bug-report                             print information necessary when preparing a bug report
            --max-complexity MAX_COMPLEXITY          the McCabe complexity threshold
            --builtins BUILTINS                      define more built-ins, comma separated
            --doctests                               also check syntax of the doctests
        `,
        values: #{
            "--output-file": "files", "--append-config": "files", "--config": "files",
            "--enable-extensions": "none", "--require-plugins": "none", "--color": ["auto", "always", "never"],
            "--exclude": "none", "--extend-exclude": "none", "--filename": "none", "--stdin-display-name": "none",
            "--format": ["default", "pylint", "quiet-filename", "quiet-nothing"],
            "--ignore": own("lint:flake8_codes"), "--extend-ignore": own("lint:flake8_codes"),
            "--per-file-ignores": "none", "--max-line-length": "none", "--max-doc-length": "none",
            "--indent-size": "none", "--select": own("lint:flake8_codes"),
            "--extend-select": own("lint:flake8_codes"), "-j": ["auto"], "--jobs": ["auto"],
            "--max-complexity": "none", "--builtins": "none",
        },
        args: [own("kinds:python_files")],
    }
}

// autopep8 [OPTIONS] FILE...
fn autopep8() {
    #{
        opts: `
            -h, --help                  show this help message and exit
            --version                   show program's version number and exit
            -v, --verbose               print verbose messages; multiple -v result in more verbose messages
            -d, --diff                  print the diff for the fixed source
            -i, --in-place              make changes to files in place
            --global-config filename    path to a global pep8 config file; if this file does not exist then this is ignored
            --ignore-local-config       don't apply the configuration files in the project's root directory
            -r, --recursive             run recursively over directories; must be used with --in-place or --diff
            -j, --jobs n                number of parallel jobs; match CPU count if value is less than 1
            -p, --pep8-passes n         maximum number of additional pep8 passes
            -a, --aggressive            enable non-whitespace changes; multiple -a result in more aggressive changes
            --experimental              enable experimental fixes
            --exclude globs             exclude file/directory names that match these comma-separated globs
            --list-fixes                list codes for fixes; used by --ignore and --select
            --ignore errors             don't fix these codes (comma-separated prefixes)
            --select errors             fix only these codes (comma-separated prefixes, such as E4,W)
            --max-line-length n         set maximum allowed line length
            --line-range, --range line  fix only the errors between the lines LINE and LINE (1 99)
            --hang-closing              hang-closing option passed to pycodestyle
            --exit-code                 exit with 2 if there are differences (and 0 without, 1 on an error)
        `,
        values: #{
            "--global-config": "files", "-j": "none", "--jobs": "none", "-p": "none", "--pep8-passes": "none",
            "--exclude": "none", "--ignore": own("lint:autopep8_fixes"), "--select": own("lint:autopep8_fixes"),
            "--max-line-length": "none", "--line-range": "none", "--range": "none",
        },
        args: [own("kinds:python_files")],
    }
}

fn spec(cmd) {
    switch cmd {
        "pylint" => pylint(),
        "flake8" => flake8(),
        "autopep8" => autopep8(),
        _ => #{},
    }
}

