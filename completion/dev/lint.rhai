}

// Codes in a comma-separated list (flake8's `--select`, autopep8's): the prefixes `prefixes`, and, once a digit is
// typed, the codes of `codes` that start with the word.
fn codes(cur, prefixes, list) {
    let w = cur.sub_string(lib_text::last_of(cur, [',']) + 1);
    let last = if w == "" { ' ' } else { w[w.len() - 1] };
    let out = prefixes;
    if last >= '0' && last <= '9' {
        for c in list {
            if c[0].starts_with(w) {
                out.push(#{value: c[0], desc: c[1]});
            }
        }
    }
    lib_text::comma_list(cur, out)
}

fn kind(name, cur, words) {
    switch name {
        "pylint_messages" => pylint_messages(cur),
        "pylint_confidence" => lib_text::comma_list(cur, ["HIGH", "CONTROL_FLOW", "INFERENCE", "INFERENCE_FAILURE", "UNDEFINED"]),
        "pylint_extensions" => lib_text::comma_list(cur, [
            "pylint.extensions.bad_builtin", "pylint.extensions.broad_try_clause", "pylint.extensions.check_elif",
            "pylint.extensions.code_style", "pylint.extensions.comparison_placement",
            "pylint.extensions.confusing_elif", "pylint.extensions.consider_refactoring_into_while_condition",
            "pylint.extensions.consider_ternary_expression", "pylint.extensions.dict_init_mutate",
            "pylint.extensions.docparams", "pylint.extensions.docstyle", "pylint.extensions.dunder",
            "pylint.extensions.empty_comment", "pylint.extensions.eq_without_hash",
            "pylint.extensions.for_any_all", "pylint.extensions.magic_value", "pylint.extensions.mccabe",
            "pylint.extensions.no_self_use", "pylint.extensions.overlapping_exceptions",
            "pylint.extensions.private_import", "pylint.extensions.redefined_loop_name",
            "pylint.extensions.redefined_variable_type", "pylint.extensions.set_membership",
            "pylint.extensions.typing", "pylint.extensions.while_used",
        ]),
        "flake8_codes" => codes(cur, [#{value: "E", desc: "pycodestyle errors"}, #{value: "W", desc: "pycodestyle warnings"}, #{value: "F", desc: "pyflakes"}, #{value: "C90", desc: "mccabe"}],
                                flake8_code_list()),
        "autopep8_fixes" => codes(cur, [
            #{value: "E", desc: "pycodestyle errors"}, #{value: "W", desc: "pycodestyle warnings"},
        ], autopep8_fix_list()),
        _ => throw `unknown kind: ${name}`,
    }
}
