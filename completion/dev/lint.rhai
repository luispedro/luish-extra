// Python linters: pylint 4.1.3 (with the options of its checkers), flake8 7.5.0 (with those of pycodestyle,
// pyflakes and mccabe) and autopep8 2.3.2, from their argparse parsers, with the codes they take: pylint's messages
// and extensions, the codes of flake8's checkers and autopep8's fixes. Generated by scripts/gen/mk_lint.py.
import "../extra-lib/text" as lib_text;

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

// pylint [OPTIONS] MODULE_OR_PACKAGE...
fn pylint() {
    #{
        opts: `
            -h, --help                                    show this help message and exit
            --rcfile FILE                                 specify a configuration file to load
            --output FILE                                 specify an output file
            --init-hook CODE                              python code to execute, usually for sys.path manipulation such as pygtk.require()
            --help-msg MSG_IDS                            show the help of the messages MSG_IDS and exit
            --list-msgs                                   list pylint's messages, by whether they can be emitted with the configuration
            --list-msgs-enabled                           list the messages that are enabled, disabled and that can't be emitted
            --list-groups                                 list pylint's message groups
            --list-conf-levels                            generate pylint's confidence levels
            --list-extensions                             list available extensions
            --full-documentation                          generate pylint's full documentation
            --generate-rcfile                             generate a sample configuration file according to the current configuration
            --generate-toml-config                        generate a sample configuration file according to the current configuration
            -E, --errors-only                             show only errors (and fatal messages), and no reports
            -v, --verbose                                 in verbose mode, extra non-checker-related info will be displayed
            --enable-all-extensions                       load and enable all available extensions
            --long-help                                   show more verbose help
            --ignore FILE[,FILE...]                       files or directories to be skipped
            --ignore-patterns PATTERN[,PATTERN...]        files or directories matching the regular expression patterns are skipped
            --ignore-paths PATTERN[,PATTERN...]           add files or directories matching the regular expressions patterns to the ignore-list
            --persistent Y_OR_N                           pickle collected data for later comparisons
            --load-plugins MODULES                        the plugins to load (comma-separated module names)
            -f, --output-format FORMAT                    the output format (a reporter, or a comma-separated list of FORMAT:FILE)
            -r, --reports Y_OR_N                          tells whether to display a full report or only the messages
            --evaluation PYTHON_EXPRESSION                python expression which should return a score less than or equal to 10
            -s, --score Y_OR_N                            activate the evaluation score
            --fail-under SCORE                            specify a score threshold under which the program will exit with error
            --fail-on MSG_IDS                             exit with an error if any of these messages or categories is emitted
            --confidence LEVELS                           only show warnings with these confidence levels (comma-separated)
            -e, --enable MSG_IDS                          enable the messages, categories or checkers MSG_IDS (comma-separated)
            -d, --disable MSG_IDS                         disable the messages, categories or checkers MSG_IDS (comma-separated; all: every message)
            --msg-template TEMPLATE                       template used to display messages
            -j, --jobs N-PROCESSES                        use multiple processes to speed up Pylint
            --limit-inference-results NUMBER-OF-RESULTS   control the amount of potential inferred values when inferring a single object
            --extension-pkg-allow-list PKG[,PKG]          a comma-separated list of package or module names from where C extensions may be loaded
            --extension-pkg-whitelist PKG[,PKG]           a comma-separated list of package or module names from where C extensions may be loaded
            --exit-zero                                   always return a 0 (non-error) status code, even if lint errors are found
            --from-stdin                                  read the module to check from standard input (the argument is its file name)
            --source-roots PATH[,PATH...]                 add paths to the list of the source roots
            --recursive YN                                discover python modules and packages in the file system subtree
            --py-version PY_VERSION                       minimum Python version to use for version dependent checks
            --ignored-modules MODULE_NAMES                list of module names for which member attributes should not be checked and will not be
            --analyse-fallback-blocks Y_OR_N              analyse import fallback blocks
            --clear-cache-post-run Y_OR_N                 clear in-memory caches upon conclusion of linting
            --prefer-stubs Y_OR_N                         resolve imports to .pyi stubs if available
            --max-args INT                                maximum number of arguments for function / method
            --max-positional-arguments INT                maximum number of positional arguments for function / method
            --max-locals INT                              maximum number of locals for function / method body
            --max-returns INT                             maximum number of return / yield for function / method body
            --max-branches INT                            maximum number of branch for function / method body
            --max-statements INT                          maximum number of statements in function / method body
            --max-parents NUM                             maximum number of parents for a class (see R0901)
            --ignored-parents COMMA_SEPARATED_LIST_OF_CLASS_NAMES  list of qualified class names to ignore when counting class parents (see R0901)
            --max-attributes NUM                          maximum number of attributes for a class (see R0902)
            --min-public-methods NUM                      minimum number of public methods for a class (see R0903)
            --max-public-methods NUM                      maximum number of public methods for a class (see R0904)
            --max-bool-expr NUM                           maximum number of boolean expressions in an if statement (see R0916)
            --exclude-too-few-public-methods PATTERN[,PATTERN...]  list of regular expressions of class ancestor names to ignore when counting public
            --overgeneral-exceptions COMMA-SEPARATED_CLASS_NAMES  exceptions that will emit a warning when caught
            --min-similarity-lines INT                    minimum lines number of a similarity
            --ignore-comments Y_OR_N                      comments are removed from the similarity computation
            --ignore-docstrings Y_OR_N                    docstrings are removed from the similarity computation
            --ignore-imports Y_OR_N                       imports are removed from the similarity computation
            --ignore-signatures Y_OR_N                    signatures are removed from the similarity computation
            --max-nested-blocks INT                       maximum number of nested blocks for function / method body
            --never-returning-functions MEMBERS_NAMES     complete name of functions that never returns
            --suggest-join-with-non-empty-separator Y_OR_N  let 'consider-using-join' be raised when the separator to join on would be non-empty
            --init-import Y_OR_N                          tells whether we should check for unused import in __init__ files
            --dummy-variables-rgx REGEXP                  a regular expression matching the name of dummy variables (i.e expected to not be used)
            --additional-builtins COMMA_SEPARATED_LIST    list of additional names supposed to be defined in builtins
            --callbacks CALLBACKS                         list of strings which can identify a callback function by name
            --redefining-builtins-modules COMMA_SEPARATED_LIST  list of qualified module names which can have objects that can redefine builtins
            --ignored-argument-names REGEXP               argument names that match this expression will be ignored
            --allow-global-unused-variables Y_OR_N        tells whether unused global variables should be treated as a violation
            --allowed-redefined-builtins COMMA_SEPARATED_LIST  list of names allowed to shadow builtins
            --defining-attr-methods METHOD_NAMES          list of method names used to declare (i.e assign) instance attributes
            --valid-classmethod-first-arg ARGUMENT_NAMES  list of valid names for the first argument in a class method
            --valid-metaclass-classmethod-first-arg ARGUMENT_NAMES  list of valid names for the first argument in a metaclass class method
            --exclude-protected PROTECTED_ACCESS_EXCLUSIONS  list of member names, which should be excluded from the protected access warning
            --check-protected-access-in-special-methods Y_OR_N  warn about protected attribute access inside special methods
            --deprecated-modules MODULES                  deprecated modules which should not be used, separated by a comma
            --preferred-modules MODULE:PREFERRED-MODULE   couples of modules and preferred modules, separated by a comma
            --import-graph FILE.GV                        output a graph (.gv or any supported image format) of all (i.e internal and external)
            --ext-import-graph FILE.GV                    output a graph (.gv or any supported image format) of external dependencies to the given
            --int-import-graph FILE.GV                    output a graph (.gv or any supported image format) of internal dependencies to the given
            --known-standard-library MODULES              force import order to recognize a module as part of the standard compatibility libraries
            --known-first-party MODULES                   force import order to recognize a module as part of a first party library
            --known-third-party MODULES                   force import order to recognize a module as part of a third party library
            --allow-any-import-level MODULES              list of modules that can be imported at any level, not just the top level one
            --allow-wildcard-with-all Y_OR_N              allow wildcard imports from modules that define __all__
            --allow-reexport-from-package Y_OR_N          allow explicit reexports by alias from a package __init__
            --notes COMMA_SEPARATED_VALUES                list of note tags to take in consideration, separated by a comma
            --notes-rgx REGEXP                            regular expression of note tags to take in consideration
            --check-fixme-in-docstring Y_OR_N             whether or not to search for fixme's in docstrings
            --check-str-concat-over-line-jumps Y_OR_N     this flag controls whether the implicit-str-concat should generate a warning on implicit
            --check-quote-consistency Y_OR_N              this flag controls whether inconsistent-quotes generates a warning when the character
            --max-line-length INT                         maximum number of characters on a single line
            --ignore-long-lines REGEXP                    regexp for a line that is allowed to be longer than the limit
            --ignore-pattern-in-long-lines REGEXP         regexp for a part of a line that will not be counted when calculating the line length
            --single-line-if-stmt Y_OR_N                  allow the body of an if to be on the same line as the test if there is no else
            --single-line-class-stmt Y_OR_N               allow the body of a class to be on the same line as the declaration if body contains
            --max-module-lines INT                        maximum number of lines in a module
            --indent-string STRING                        string used as indentation unit
            --indent-after-paren INT                      number of spaces of indent required inside a hanging or continued line
            --expected-line-ending-format LF|CRLF         expected format of line ending, e.g empty (any line ending), LF or CRLF
