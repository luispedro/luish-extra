            --mixin-class-rgx REGEXP                      regex pattern to define which classes are considered mixins
            --ignore-mixin-members Y_OR_N                 tells whether missing members accessed in mixin class should be ignored
            --ignored-checks-for-mixins LIST_OF_MESSAGES_NAMES  list of symbolic message names to ignore for Mixin members
            --ignore-none Y_OR_N                          tells whether to warn about missing members when the owner of the attribute is inferred
            --ignored-classes MEMBERS_NAMES               list of class names for which member attributes should not be checked
            --generated-members MEMBERS_NAMES             list of members which are set dynamically and missed by pylint inference system, and so
            --contextmanager-decorators DECORATOR_NAMES   list of decorators that produce context managers, such as contextlib.contextmanager
            --missing-member-hint-distance MEMBER_HINT_EDIT_DISTANCE  the maximum edit distance a name should have in order to be considered a similar match
            --missing-member-max-choices MEMBER_HINT_MAX_CHOICES  the total number of similar names that should be taken in consideration when showing a
            --missing-member-hint MISSING_MEMBER_HINT     show a hint with possible names when a member name was not found
            --signature-mutators DECORATOR_NAMES          list of decorators that change the signature of a decorated function
