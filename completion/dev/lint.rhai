            "-f": ["colorized", "github", "json", "json2", "junit", "msvs", "no-header", "parseable", "text"],
            "--output-format": [
                "colorized", "github", "json", "json2", "junit", "msvs", "no-header", "parseable", "text",
            ], "-r": ["y", "n"], "--reports": ["y", "n"], "--evaluation": "none", "-s": ["y", "n"],
            "--score": ["y", "n"], "--fail-under": "none", "--fail-on": own("lint:pylint_messages"),
            "--confidence": own("lint:pylint_confidence"), "-e": own("lint:pylint_messages"),
            "--enable": own("lint:pylint_messages"), "-d": own("lint:pylint_messages"),
            "--disable": own("lint:pylint_messages"), "--msg-template": "none", "-j": "none", "--jobs": "none",
            "--limit-inference-results": "none", "--extension-pkg-allow-list": "none",
            "--extension-pkg-whitelist": "none", "--source-roots": "dirs", "--recursive": ["y", "n"],
