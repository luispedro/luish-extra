// Poetry 2.5.1, from its Cleo application (`poetry list`, `poetry COMMAND --help`): the commands, their options and
// arguments, and the global options. Generated by scripts/gen/mk_poetry.py.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn spec(cmd) {
    #{
        common: `
            -h, --help                 display help for the given command
            -q, --quiet                do not output any message
            -v, --verbose              increase the verbosity of messages (-vv, -vvv: more)
            -V, --version              display this application version
            --ansi                     force ANSI output
            --no-ansi                  disable ANSI output
            -n, --no-interaction       do not ask any interactive question
            --no-plugins               disables plugins
            --no-cache                 disables the use of Poetry's caches
            -P, --project PROJECT      specify another path as the project root
            -C, --directory DIRECTORY  the working directory for the Poetry command
        `,
        values: #{
            "-P": "dirs", "--project": "dirs", "-C": "dirs", "--directory": "dirs",
        },
        commands: `
            about    shows information about Poetry
            add      adds a new dependency to pyproject.toml and installs it
            build    builds a package, as a tarball and a wheel by default
            cache    manage Poetry's caches
            check    validates the content of the pyproject.toml file and its consistency with the poetry.lock
            config   manages configuration settings
            debug    debug Poetry
            env      manage the project's virtual environments
            help     displays help for a command
            init     creates a basic pyproject.toml file in the current directory
            install  installs the project dependencies
            list     lists commands
            lock     locks the project dependencies
            new      creates a new Python project at <path>
            publish  publishes a package to a remote repository
            python   manage the Python versions Poetry installs
            remove   removes a package from the project dependencies
            run      runs a command in the appropriate environment
            search   searches for packages on remote repositories
            self     manage Poetry's own installation
            show     shows information about packages
            source   manage the package sources of the project
            sync     update the project's environment according to the lockfile
            update   update the dependencies as according to the pyproject.toml file
            version  shows the version of the project or bumps it when a valid bump rule is provided
        `,
        subs: #{
            "about": #{
                args: ["none"],
            },
            "add": #{
                opts: `
                    -G, --group GROUP    the group to add the dependency to
                    -D, --dev            add as a development dependency
                    -e, --editable       add vcs/path dependencies as editable
                    -E, --extras EXTRAS  extras to activate for the dependency
                    --optional OPTIONAL  add as an optional dependency to an extra
                    --python PYTHON      python version for which the dependency must be installed
                    --platform PLATFORM  platforms for which the dependency must be installed
                    --markers MARKERS    environment markers which describe when the dependency should be installed
                    --source SOURCE      name of the source to use to install the package
                    --allow-prereleases  accept prereleases
                    --dry-run            output the operations but do not execute anything (implicitly enables --verbose)
                    --lock               do not perform operations (only update the lockfile)
                `,
                values: #{
                    "-G": own("kinds:poetry_groups"), "--group": own("kinds:poetry_groups"),
                    "-E": own("kinds:poetry_extras"), "--extras": own("kinds:poetry_extras"),
                    "--optional": own("kinds:poetry_extras"), "--python": "none",
                    "--platform": ["linux", "darwin", "win32"], "--markers": "none",
                    "--source": own("kinds:poetry_sources"),
                },
                args: ["none"],
            },
            "build": #{
                opts: `
                    -f, --format FORMAT                    limit the format to either sdist or wheel
                    --clean                                clean output directory before building
                    -l, --local-version LOCAL-VERSION      add or replace a local version label to the build
                    -o, --output OUTPUT                    set output directory for build artifacts
                    -c, --config-settings CONFIG-SETTINGS  config settings to pass to the backend (KEY=VALUE)
                `,
                values: #{
                    "-f": ["sdist", "wheel"], "--format": ["sdist", "wheel"], "-l": "none",
                    "--local-version": "none", "-o": "dirs", "--output": "dirs", "-c": "none",
                    "--config-settings": "none",
                },
                args: ["none"],
            },
            "cache": #{
                commands: `
                    clear  clear Poetry's caches
                    list   list Poetry's caches
                `,
                subs: #{
                    "clear": #{
                        opts: `
                            --all  clear all entries in the cache
                        `,
                        args: ["none"],
                    },
                    "list": #{
                        args: ["none"],
                    },
                },
            },
            "check": #{
                opts: `
                    --lock    checks that poetry.lock exists for the current version of pyproject.toml
                    --strict  fail if check reports warnings
                `,
                args: ["none"],
            },
            "config": #{
                opts: `
                    --list     list configuration settings
                    --unset    unset configuration setting
                    --local    set or get from the project's local configuration
                    --migrate  migrate outdated configuration settings
                `,
                args: [own("poetry:config_keys"), "none"],
            },
            "debug": #{
                commands: `
                    info     shows debug information
                    resolve  debugs dependency resolution
                    tags     shows compatible tags for your project's current active environment
                `,
                subs: #{
                    "info": #{
                        args: ["none"],
                    },
                    "resolve": #{
                        opts: `
                            -E, --extras EXTRAS  extras to activate for the dependency
                            --python PYTHON      python version(s) to use for resolution
                            --tree               display the dependency tree
                            --install            show what would be installed for the current system
                        `,
                        values: #{
                            "-E": own("kinds:poetry_extras"), "--extras": own("kinds:poetry_extras"),
                            "--python": "none",
                        },
                        args: ["none"],
                    },
                    "tags": #{
                        args: ["none"],
                    },
                },
            },
            "env": #{
                commands: `
                    activate  print the command to activate a virtual environment
                    info      displays information about the current environment
                    list      lists all virtualenvs associated with the current project
                    remove    remove virtual environments associated with the project
                    use       activates or creates a new virtualenv for the current project
                `,
                subs: #{
                    "activate": #{
                        args: ["none"],
                    },
                    "info": #{
                        opts: `
                            -p, --path        only display the environment's path
                            -e, --executable  only display the environment's python executable path
                        `,
                        args: ["none"],
                    },
                    "list": #{
                        opts: `
                            --full-path  output the full paths of the virtualenvs
                        `,
                        args: ["none"],
                    },
                    "remove": #{
                        opts: `
                            --all  remove all managed virtual environments associated with the project
                        `,
                        args: [own("kinds:pythons")],
                    },
                    "use": #{
                        args: [own("kinds:pythons")],
                    },
                },
            },
            "help": #{
                args: [own("poetry:commands")],
            },
            "init": #{
                opts: `
                    --name NAME                      name of the package
                    --description DESCRIPTION        description of the package
                    --author AUTHOR                  author name of the package
                    --python PYTHON                  compatible Python versions
                    --dependency DEPENDENCY          package to require, with an optional version constraint
                    --dev-dependency DEV-DEPENDENCY  package to require for development, with an optional version constraint
                    -l, --license LICENSE            license of the package
                `,
                values: #{
                    "--name": "none", "--description": "none", "--author": "none", "--python": "none",
                    "--dependency": "none", "--dev-dependency": "none", "-l": "none", "--license": "none",
                },
                args: ["none"],
            },
            "install": #{
                opts: `
                    --without WITHOUT    the dependency groups to ignore
                    --with WITH          the optional dependency groups to include
                    --only ONLY          the only dependency groups to include
                    --sync               synchronize the environment with the locked packages and the specified groups
                    --no-root            do not install the root package (the current project)
                    --no-directory       do not install any directory path dependencies
                    --dry-run            output the operations but do not execute anything (implicitly enables --verbose)
                    -E, --extras EXTRAS  extra sets of dependencies to install
                    --all-extras         install all extra dependencies
                    --all-groups         install dependencies from all groups
                    --only-root          exclude all dependencies
                    --compile            compile Python source files to bytecode
                `,
                values: #{
                    "--without": own("kinds:poetry_groups"), "--with": own("kinds:poetry_groups"),
                    "--only": own("kinds:poetry_groups"), "-E": own("kinds:poetry_extras"),
                    "--extras": own("kinds:poetry_extras"),
                },
                args: ["none"],
            },
            "list": #{
                args: [["cache", "debug", "env", "python", "self", "source"]],
            },
            "lock": #{
                opts: `
                    --regenerate  ignore existing lock file and overwrite it with a new lock file created from scratch
                `,
                args: ["none"],
            },
            "new": #{
                opts: `
                    -i, --interactive                allow interactive specification of project configuration
                    --name NAME                      set the resulting package name
                    --src                            use the src layout for the project
                    --flat                           use the flat layout for the project
                    --readme README                  specify the readme file format
                    --description DESCRIPTION        description of the package
                    --author AUTHOR                  author name of the package
                    --python PYTHON                  compatible Python versions
                    --dependency DEPENDENCY          package to require, with an optional version constraint
                    --dev-dependency DEV-DEPENDENCY  package to require for development, with an optional version constraint
                    -l, --license LICENSE            license of the package
                `,
                values: #{
                    "--name": "none", "--readme": ["md", "rst"], "--description": "none", "--author": "none",
                    "--python": "none", "--dependency": "none", "--dev-dependency": "none", "-l": "none",
                    "--license": "none",
                },
                args: ["dirs"],
            },
            "publish": #{
                opts: `
                    -r, --repository REPOSITORY  the repository to publish the package to
                    -u, --username USERNAME      the username to access the repository
                    -p, --password PASSWORD      the password to access the repository
                    --cert CERT                  certificate authority to access the repository
                    --client-cert CLIENT-CERT    client certificate to access the repository
                    --dist-dir DIST-DIR          dist directory where built artifact are stored
                    --build                      build the package before publishing
                    --dry-run                    perform all actions except upload the package
                    --skip-existing              ignore errors from files already existing in the repository
                `,
                values: #{
                    "-r": "none", "--repository": "none", "-u": "none", "--username": "none", "-p": "none",
                    "--password": "none", "--cert": "files", "--client-cert": "files", "--dist-dir": "dirs",
                },
                args: ["none"],
            },
            "python": #{
                commands: `
                    install  install the specified Python version from the Python Standalone Builds project
                    list     shows Python versions available for this environment
                    remove   remove the specified Python version if managed by Poetry
                `,
                subs: #{
                    "install": #{
                        opts: `
                            -c, --clean                          clean up installation if check fails
                            -t, --free-threaded                  use free-threaded version if available
                            -i, --implementation IMPLEMENTATION  python implementation to use
                            -r, --reinstall                      reinstall if installation already exists
                        `,
                        values: #{
                            "-i": ["cpython", "pypy"], "--implementation": ["cpython", "pypy"],
                        },
                        args: ["none"],
                    },
                    "list": #{
                        opts: `
                            -a, --all                            list all versions, including those available for download
                            -t, --free-threaded                  list only free-threaded Python versions
                            -i, --implementation IMPLEMENTATION  python implementation to search for
                            -m, --managed                        list only Poetry managed Python versions
                        `,
                        values: #{
                            "-i": ["cpython", "pypy"], "--implementation": ["cpython", "pypy"],
                        },
                        args: ["none"],
                    },
                    "remove": #{
                        opts: `
                            -t, --free-threaded                  use free-threaded version if available
                            -i, --implementation IMPLEMENTATION  python implementation to use
                        `,
                        values: #{
                            "-i": ["cpython", "pypy"], "--implementation": ["cpython", "pypy"],
                        },
                        args: ["none"],
                    },
                },
            },
            "remove": #{
                opts: `
                    -G, --group GROUP  the group to remove the dependency from
                    -D, --dev          remove a package from the development dependencies
                    --dry-run          output the operations but do not execute anything (implicitly enables --verbose)
                    --lock             do not perform operations (only update the lockfile)
                `,
                values: #{
                    "-G": own("kinds:poetry_groups"), "--group": own("kinds:poetry_groups"),
                },
                args: [own("kinds:poetry_deps")],
            },
            "run": #{
                args: [own("kinds:poetry_run"), "files"],
            },
            "search": #{
                args: ["none"],
            },
            "self": #{
                commands: `
                    add      add additional packages to Poetry's runtime environment
                    install  install locked packages
                    lock     lock the Poetry installation's system requirements
                    remove   remove additional packages from Poetry's runtime environment
                    show     show packages from Poetry's runtime environment
                    sync     sync Poetry's own environment according to the locked packages
                    update   updates Poetry to the latest version
                `,
                subs: #{
                    "add": #{
                        opts: `
                            -e, --editable       add vcs/path dependencies as editable
                            -E, --extras EXTRAS  extras to activate for the dependency
                            --source SOURCE      name of the source to use to install the package
                            --allow-prereleases  accept prereleases
                            --dry-run            output the operations but do not execute anything (implicitly enables --verbose)
                        `,
                        values: #{
                            "-E": own("kinds:poetry_extras"), "--extras": own("kinds:poetry_extras"),
                            "--source": own("kinds:poetry_sources"),
                        },
                        args: ["none"],
                    },
                    "install": #{
                        opts: `
                            --sync     synchronize the environment with the locked packages and the specified groups
                            --dry-run  output the operations but do not execute anything (implicitly enables --verbose)
                        `,
                        args: ["none"],
                    },
                    "lock": #{
                        opts: `
                            --regenerate  ignore existing lock file and overwrite it with a new lock file created from scratch
                        `,
                        args: ["none"],
                    },
                    "remove": #{
                        opts: `
                            --dry-run  output the operations but do not execute anything (implicitly enables --verbose)
                        `,
                        args: ["none"],
                    },
                    "show": #{
                        opts: `
                            --addons             list only add-on packages installed
                            -t, --tree           list the dependencies as a tree
                            -l, --latest         show the latest version
                            -o, --outdated       show the latest version but only for packages that are outdated
                            -f, --format FORMAT  specify the output format ('json' or 'text')
                        `,
                        values: #{
                            "-f": ["json", "text"], "--format": ["json", "text"],
                        },
                        args: ["none"],
                        commands: `
                            plugins  shows information about the currently installed plugins
                        `,
                        subs: #{
                            "plugins": #{
                                args: ["none"],
                            },
                        },
                    },
                    "sync": #{
                        opts: `
                            --dry-run  output the operations but do not execute anything (implicitly enables --verbose)
                        `,
                        args: ["none"],
                    },
                    "update": #{
                        opts: `
                            --preview  allow the installation of pre-release versions
                            --dry-run  output the operations but do not execute anything (implicitly enables --verbose)
                        `,
                        args: ["none"],
                    },
                },
            },
            "show": #{
                opts: `
                    --without WITHOUT    the dependency groups to ignore
                    --with WITH          the optional dependency groups to include
                    --only ONLY          the only dependency groups to include
                    -t, --tree           list the dependencies as a tree
                    --why                show whether packages are direct dependencies or required by others
                    -l, --latest         show the latest version
                    -o, --outdated       show the latest version but only for packages that are outdated
                    -a, --all            show all packages (even those not compatible with current system)
                    -T, --top-level      show only top-level dependencies
                    --no-truncate        do not truncate the output based on the terminal width
                    -f, --format FORMAT  specify the output format ('json' or 'text')
                `,
                values: #{
                    "--without": own("kinds:poetry_groups"), "--with": own("kinds:poetry_groups"),
                    "--only": own("kinds:poetry_groups"), "-f": ["json", "text"], "--format": ["json", "text"],
                },
                args: [own("kinds:poetry_locked")],
            },
            "source": #{
                commands: `
                    add     add source configuration for project
                    remove  remove source configured for the project
                    show    show information about sources configured for the project
                `,
                subs: #{
                    "add": #{
                        opts: `
                            -p, --priority PRIORITY  set the priority of this source
                        `,
                        values: #{
                            "-p": ["primary", "supplemental", "explicit"],
                            "--priority": ["primary", "supplemental", "explicit"],
                        },
                        args: ["none"],
                    },
                    "remove": #{
                        args: [own("kinds:poetry_sources")],
                    },
                    "show": #{
                        args: [own("kinds:poetry_sources")],
                    },
                },
            },
            "sync": #{
                opts: `
                    --without WITHOUT    the dependency groups to ignore
                    --with WITH          the optional dependency groups to include
                    --only ONLY          the only dependency groups to include
                    --no-root            do not install the root package (the current project)
                    --no-directory       do not install any directory path dependencies
                    --dry-run            output the operations but do not execute anything (implicitly enables --verbose)
                    -E, --extras EXTRAS  extra sets of dependencies to install
                    --all-extras         install all extra dependencies
                    --all-groups         install dependencies from all groups
                    --only-root          exclude all dependencies
                    --compile            compile Python source files to bytecode
                `,
                values: #{
                    "--without": own("kinds:poetry_groups"), "--with": own("kinds:poetry_groups"),
                    "--only": own("kinds:poetry_groups"), "-E": own("kinds:poetry_extras"),
                    "--extras": own("kinds:poetry_extras"),
                },
                args: ["none"],
            },
            "update": #{
                opts: `
                    --without WITHOUT  the dependency groups to ignore
                    --with WITH        the optional dependency groups to include
                    --only ONLY        the only dependency groups to include
                    --sync             synchronize the environment with the locked packages and the specified groups
                    --dry-run          output the operations but do not execute anything (implicitly enables --verbose)
                    --lock             do not perform operations (only update the lockfile)
                `,
                values: #{
                    "--without": own("kinds:poetry_groups"), "--with": own("kinds:poetry_groups"),
                    "--only": own("kinds:poetry_groups"),
                },
                args: [own("kinds:poetry_deps")],
            },
            "version": #{
                opts: `
                    -s, --short   output the version number only
                    --dry-run     do not update pyproject.toml file
                    --next-phase  increment the phase of the current version
                `,
                args: [["patch", "minor", "major", "prepatch", "preminor", "premajor", "prerelease"]],
            },
        },
    }
}

// The commands, for `poetry help`.
fn commands() {
    [
        "about", "add", "build", "cache", "check", "config", "debug", "env", "help", "init", "install", "list",
        "lock", "new", "publish", "python", "remove", "run", "search", "self", "show", "source", "sync", "update",
        "version",
    ]
}

// The settings of `poetry config`, and the prefixes of those that name a repository.
fn config_keys() {
    [
        "cache-dir",
        "data-dir",
        "installer.builtin-uninstall",
        "installer.max-workers",
        "installer.no-binary",
        "installer.only-binary",
        "installer.parallel",
        "installer.re-resolve",
        "keyring.enabled",
        "python.installation-dir",
        "requests.max-retries",
        "solver.lazy-wheel",
        "solver.min-release-age",
        "solver.min-release-age-exclude",
        "solver.min-release-age-exclude-source",
        "system-git-client",
        "virtualenvs.create",
        "virtualenvs.in-project",
        "virtualenvs.options.always-copy",
        "virtualenvs.options.no-pip",
        "virtualenvs.options.system-site-packages",
        "virtualenvs.path",
        "virtualenvs.prompt",
        "virtualenvs.use-poetry-python",
        #{value: "repositories.", suffix: ""},
        #{value: "http-basic.", suffix: ""},
        #{value: "pypi-token.", suffix: ""},
        #{value: "certificates.", suffix: ""},
    ]
}

fn kind(name, cur, words) {
    switch name {
        "config_keys" => config_keys(),
        "commands" => commands(),
        _ => throw `unknown kind: ${name}`,
    }
}
