// Python tools: coverage 7.17.0 (from its optparse parsers) and Cython 3.3.0's cython and cythonize (from their
// argparse parsers), with Cython's compiler directives for `-X`. Generated by scripts/gen/mk_pytools.py.
import "../extra-lib/text" as lib_text;

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

// coverage COMMAND [OPTIONS] [ARGS]
fn coverage() {
    #{
        opts: `
            --version   show the version
            -h, --help  show help
        `,
        commands: `
            annotate  annotate source files with execution information
            combine   combine a number of data files
            debug     display information about the internals of coverage.py
            erase     erase previously collected coverage data
            help      get help on using coverage.py
            html      create an HTML report
            json      create a JSON report of coverage results
            lcov      create an LCOV report of coverage results
            report    report coverage stats on modules
            run       run a Python program and measure code execution
            xml       create an XML report of coverage results
        `,
        subs: #{
            "annotate": #{
                opts: `
                    -d, --directory DIR      write the output files to DIR
                    --data-file INFILE       read coverage data for report generation from this file
                    -i, --ignore-errors      ignore errors while reading source files
                    --include PAT1,PAT2,...  only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined          keep original coverage files, otherwise they are deleted after combining
                    --omit PAT1,PAT2,...     omit the files whose paths match these patterns (comma-separated, shell-style)
                    --debug OPTS             debug options (comma-separated)
                    -h, --help               get help on this command
                    --rcfile RCFILE          the configuration file to read
                `,
                values: #{
                    "-d": "dirs", "--directory": "dirs", "--data-file": "files", "--include": "none",
                    "--omit": "none", "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
            "combine": #{
                opts: `
                    -a, --append          append data to the data file
                    --data-file DATAFILE  base name of the data files to operate on
                    --keep                keep original coverage files, otherwise they are deleted
                    -q, --quiet           don't print messages about what is happening
                    --debug OPTS          debug options (comma-separated)
                    -h, --help            get help on this command
                    --rcfile RCFILE       the configuration file to read
                `,
                values: #{
                    "--data-file": "files", "--debug": "none", "--rcfile": "files",
                },
                args: ["files"],
            },
            "debug": #{
                opts: `
                    --debug OPTS     debug options (comma-separated)
                    -h, --help       get help on this command
                    --rcfile RCFILE  the configuration file to read
                `,
                values: #{
                    "--debug": "none", "--rcfile": "files",
                },
                args: [own("pytools:debug_topics"), "files"],
            },
            "erase": #{
                opts: `
                    --data-file DATAFILE  base name of the data files to operate on
                    --debug OPTS          debug options (comma-separated)
                    -h, --help            get help on this command
                    --rcfile RCFILE       the configuration file to read
                `,
                values: #{
                    "--data-file": "files", "--debug": "none", "--rcfile": "files",
                },
                args: ["none"],
            },
            "help": #{
                opts: `
                    --debug OPTS     debug options (comma-separated)
                    -h, --help       get help on this command
                    --rcfile RCFILE  the configuration file to read
                `,
                values: #{
                    "--debug": "none", "--rcfile": "files",
                },
                args: [["annotate", "combine", "debug", "erase", "help", "html", "json", "lcov", "report", "run", "xml"]],
            },
            "html": #{
                opts: `
                    --contexts REGEX1,REGEX2,...  only the lines covered in these contexts (comma-separated regular expressions)
                    -d, --directory DIR           write the output files to DIR
                    --data-file INFILE            read coverage data for report generation from this file
                    --fail-under MIN              exit with 2 if the total coverage is less than MIN
                    -i, --ignore-errors           ignore errors while reading source files
                    --include PAT1,PAT2,...       only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined               keep original coverage files, otherwise they are deleted after combining
                    --omit PAT1,PAT2,...          omit the files whose paths match these patterns (comma-separated, shell-style)
                    --precision N                 number of digits after the decimal point to display for reported coverage percentages
                    -q, --quiet                   don't print messages about what is happening
                    --show-contexts               show contexts for covered lines
                    --skip-covered                skip files with 100% coverage
                    --no-skip-covered             disable --skip-covered
                    --skip-empty                  skip files with no code
                    --title TITLE                 a text string to use as the title on the HTML
                    --debug OPTS                  debug options (comma-separated)
                    -h, --help                    get help on this command
                    --rcfile RCFILE               the configuration file to read
                `,
                values: #{
                    "--contexts": "none", "-d": "dirs", "--directory": "dirs", "--data-file": "files",
                    "--fail-under": "none", "--include": "none", "--omit": "none", "--precision": "none",
                    "--title": "none", "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
            "json": #{
                opts: `
                    --contexts REGEX1,REGEX2,...  only the lines covered in these contexts (comma-separated regular expressions)
                    --data-file INFILE            read coverage data for report generation from this file
                    --fail-under MIN              exit with 2 if the total coverage is less than MIN
                    -i, --ignore-errors           ignore errors while reading source files
                    --include PAT1,PAT2,...       only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined               keep original coverage files, otherwise they are deleted after combining
                    --omit PAT1,PAT2,...          omit the files whose paths match these patterns (comma-separated, shell-style)
                    -o OUTFILE                    write the JSON report to this file
                    --pretty-print                format the JSON for human readers
                    -q, --quiet                   don't print messages about what is happening
                    --show-contexts               show contexts for covered lines
                    --debug OPTS                  debug options (comma-separated)
                    -h, --help                    get help on this command
                    --rcfile RCFILE               the configuration file to read
                `,
                values: #{
                    "--contexts": "none", "--data-file": "files", "--fail-under": "none", "--include": "none",
                    "--omit": "none", "-o": "files", "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
            "lcov": #{
                opts: `
                    --data-file INFILE       read coverage data for report generation from this file
                    --fail-under MIN         exit with 2 if the total coverage is less than MIN
                    -i, --ignore-errors      ignore errors while reading source files
                    --include PAT1,PAT2,...  only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined          keep original coverage files, otherwise they are deleted after combining
                    -o OUTFILE               write the LCOV report to this file
                    --omit PAT1,PAT2,...     omit the files whose paths match these patterns (comma-separated, shell-style)
                    -q, --quiet              don't print messages about what is happening
                    --debug OPTS             debug options (comma-separated)
                    -h, --help               get help on this command
                    --rcfile RCFILE          the configuration file to read
                `,
                values: #{
                    "--data-file": "files", "--fail-under": "none", "--include": "none", "-o": "files",
                    "--omit": "none", "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
            "report": #{
                opts: `
                    --contexts REGEX1,REGEX2,...  only the lines covered in these contexts (comma-separated regular expressions)
                    --data-file INFILE            read coverage data for report generation from this file
                    --fail-under MIN              exit with 2 if the total coverage is less than MIN
                    --format FORMAT               output format, either text (default), markdown, or total
                    -i, --ignore-errors           ignore errors while reading source files
                    --include PAT1,PAT2,...       only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined               keep original coverage files, otherwise they are deleted after combining
                    --omit PAT1,PAT2,...          omit the files whose paths match these patterns (comma-separated, shell-style)
                    --precision N                 number of digits after the decimal point to display for reported coverage percentages
                    --sort COLUMN                 sort the report by the named column: name, stmts, miss, branch, brpart, or cover
                    -m, --show-missing            the program is a module, to run as python -m does
                    --skip-covered                skip files with 100% coverage
                    --no-skip-covered             disable --skip-covered
                    --skip-empty                  skip files with no code
                    --debug OPTS                  debug options (comma-separated)
                    -h, --help                    get help on this command
                    --rcfile RCFILE               the configuration file to read
                `,
                values: #{
                    "--contexts": "none", "--data-file": "files", "--fail-under": "none",
                    "--format": ["text", "markdown", "total"], "--include": "none", "--omit": "none",
                    "--precision": "none", "--sort": ["name", "stmts", "miss", "branch", "brpart", "cover"],
                    "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
            "run": #{
                opts: `
                    -a, --append             append data to the data file
                    --branch                 measure branch coverage in addition to statement coverage
                    --concurrency LIBS       measure code that uses these concurrency libraries (comma-separated)
                    --context LABEL          the context label to record for this coverage run
                    --data-file OUTFILE      write the recorded coverage data to this file
                    --include PAT1,PAT2,...  only the files whose paths match these patterns (comma-separated, shell-style)
                    -m, --module             the program is a module, to run as python -m does
                    --omit PAT1,PAT2,...     omit the files whose paths match these patterns (comma-separated, shell-style)
                    -L, --pylib              measure coverage even inside the Python installed library, which isn't done by default
                    -p, --parallel-mode      add a unique suffix to the data file's name (for the data of several processes)
                    --save-signal SIGNAL     specify a signal that will trigger coverage to write its collected data
                    --source SRC1,SRC2,...   the directories or importable names of the code to measure (comma-separated)
                    --timid                  use the slower Python trace function core
                    --debug OPTS             debug options (comma-separated)
                    -h, --help               get help on this command
                    --rcfile RCFILE          the configuration file to read
                `,
                values: #{
                    "--concurrency": own("pytools:concurrency"), "--context": "none", "--data-file": "files",
                    "--include": "none", "--omit": "none", "--save-signal": ["USR1", "USR2"], "--source": "dirs",
                    "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files"), "files"],
                args_if: #{"-m": ["dev:python_modules", "files"], "--module": ["dev:python_modules", "files"]},
            },
            "xml": #{
                opts: `
                    --data-file INFILE       read coverage data for report generation from this file
                    --fail-under MIN         exit with 2 if the total coverage is less than MIN
                    -i, --ignore-errors      ignore errors while reading source files
                    --include PAT1,PAT2,...  only the files whose paths match these patterns (comma-separated, shell-style)
                    --keep-combined          keep original coverage files, otherwise they are deleted after combining
                    --omit PAT1,PAT2,...     omit the files whose paths match these patterns (comma-separated, shell-style)
                    -o OUTFILE               write the XML report to this file
                    -q, --quiet              don't print messages about what is happening
                    --skip-empty             skip files with no code
                    --debug OPTS             debug options (comma-separated)
                    -h, --help               get help on this command
                    --rcfile RCFILE          the configuration file to read
                `,
                values: #{
                    "--data-file": "files", "--fail-under": "none", "--include": "none", "--omit": "none",
                    "-o": "files", "--debug": "none", "--rcfile": "files",
                },
                args: [own("kinds:python_files")],
            },
        },
    }
}

// cython [OPTIONS] SOURCE...
fn cython() {
    #{
        opts: `
            -h, --help                             show this help message and exit
            -V, --version                          display version number of cython compiler
            -l, --create-listing                   write error messages to a listing file
            -I, --include-dir DIR                  search for include files in named directory (multiple include directories are allowed)
            -o, --output-file FILE                 specify name of generated C file
            -t, --timestamps                       only compile newer source files
            -f, --force                            compile all source files (overrides implied -t)
            -v, --verbose                          be verbose, print file names on multiple compilation
            -p, --embed-positions                  embed the positions of the definitions in the Cython files in their docstrings
            --cleanup LEVEL                        release interned objects at exit, for memory debugging (LEVEL: how far; 0: nothing)
            --cache                                enables Cython compilation cache
            -w, --working DIR                      sets the working directory for Cython (the directory modules are searched from)
            --gdb                                  output debug information for cygdb
            --gdb-outdir DIR                       specify gdb debug information output directory
            -D, --no-docstrings                    strip docstrings from the compiled module
            -a, --annotate                         produce a colorized HTML version of the source
            --annotate-fullc                       produce a colorized HTML version of the source which includes entire generated C/C++-code
            --annotate-coverage FILE               annotate, with the coverage of the XML report FILE
            --line-directives                      produce #line directives pointing to the .pyx source
            -+, --cplus                            output a C++ rather than C file
            --embed[=NAME]                         generate a main() function (or NAME()) that embeds the Python interpreter
            --embed-modules MODULES                the modules to embed with --embed (comma-separated)
            -2                                     compile based on Python-2 syntax and code semantics
            -3                                     compile based on Python-3 syntax and code semantics
            --3str                                 compile based on Python-3 syntax and code semantics (same as -3 since Cython 3.1)
            --lenient                              change some compile time errors to runtime errors to improve Python compatibility
            --capi-reexport-cincludes              add cincluded headers to any auto-generated header files
            --fast-fail                            abort the compilation on the first error
            -Werror, --warning-errors              make all warnings into errors
            -Wextra, --warning-extra               enable extra warnings
            -X, --directive NAME=VALUE,...         override compiler directives (NAME=VALUE, comma-separated)
            -E, --compile-time-env NAME=VALUE,...  set compile-time constants, as DEF would (NAME=VALUE, comma-separated)
            --module-name NAME                     fully qualified module name
            -M, --depfile                          produce depfiles for the sources
            --shared MODULE                        imports utility code from shared module specified by fully qualified module name
            --generate-shared FILE                 generates shared module with specified name
        `,
        values: #{
            "-I": "dirs", "--include-dir": "dirs", "-o": "files", "--output-file": "files", "--cleanup": "none",
            "-w": "dirs", "--working": "dirs", "--gdb-outdir": "dirs", "--annotate-coverage": "files",
            "--embed": "none", "--embed-modules": "none", "-X": own("pytools:directives"),
            "--directive": own("pytools:directives"), "-E": "none", "--compile-time-env": "none",
            "--module-name": "none", "--shared": "none", "--generate-shared": "files",
        },
        args: [own("kinds:cython_sources")],
    }
}

// cythonize [OPTIONS] SOURCE...
fn cythonize() {
    #{
        opts: `
            -h, --help                             show this help message and exit
            -X, --directive NAME=VALUE,...         override compiler directives (NAME=VALUE, comma-separated)
            -E, --compile-time-env NAME=VALUE,...  set compile-time constants, as DEF would (NAME=VALUE, comma-separated)
            -s, --option NAME=VALUE                set an option of cythonize (NAME=VALUE)
            -2                                     use Python 2 syntax mode by default
            -3                                     use Python 3 syntax mode by default
            --3str                                 use Python 3 syntax mode by default (deprecated alias for -3)
            -+, --cplus                            compile as C++ rather than C
            -a, --annotate                         produce a colorized HTML version of the source
            --annotate-fullc                       produce a colorized HTML version of the source which includes entire generated C/C++-code
            -x, --exclude PATTERN                  exclude certain file patterns from the compilation
            -b, --build                            build extension modules using distutils/setuptools
            -i, --inplace                          build extension modules in place using distutils/setuptools (implies -b)
            --timeit CODESTRING                    build in place, then compile+run CODESTRING as benchmark in first module's namespace
            --setup CODESTRING                     use CODESTRING as pre-benchmark setup code for --bench
            -j, --parallel N                       run builds in N parallel jobs
            -f, --force                            force recompilation
            -q, --quiet                            be less verbose during compilation
            --lenient                              increase Python compatibility by ignoring some compile time errors
            -k, --keep-going                       compile as much as possible, ignore compilation failures
            --no-docstrings                        strip docstrings
            -M, --depfile                          produce depfiles for the sources
        `,
        values: #{
            "-X": own("pytools:directives"), "--directive": own("pytools:directives"), "-E": "none",
            "--compile-time-env": "none", "-s": "none", "--option": "none", "-x": "none", "--exclude": "none",
            "--timeit": "none", "--setup": "none", "-j": "none", "--parallel": "none",
        },
        args: [own("kinds:cython_sources")],
    }
}

fn spec(cmd) {
    switch cmd {
        "coverage" => coverage(),
        "cython" => cython(),
        "cythonize" => cythonize(),
        _ => #{},
    }
}

// Cython's compiler directives that a command line can set: [NAME, VALUES] (no values: any).
fn directive_list() {
    [
        ["allow_none_for_extension_args", ["True", "False"]],
        ["always_allow_keywords", ["True", "False"]],
        ["annotation_typing", ["True", "False"]],
        ["auto_cpdef", ["True", "False"]],
        ["auto_pickle", ["True", "False"]],
        ["autotestdict", ["True", "False"]],
        ["autotestdict.all", ["True", "False"]],
        ["autotestdict.cdef", ["True", "False"]],
        ["binding", ["True", "False"]],
        ["boundscheck", ["True", "False"]],
        ["c_api_binop_methods", ["True", "False"]],
        ["c_compile_guard", []],
        ["c_string_type", ["bytes", "bytearray", "str", "unicode"]],
        ["callspec", []],
        ["ccomplex", ["True", "False"]],
        ["cdivision", ["True", "False"]],
        ["cdivision_warnings", ["True", "False"]],
        ["collection_type", ["sequence", "mapping"]],
        ["control_flow.dot_annotate_defs", ["True", "False"]],
        ["control_flow.dot_output", []],
        ["cpow", ["True", "False"]],
        ["cpp_locals", ["True", "False"]],
        ["embedsignature", ["True", "False"]],
        ["embedsignature.format", ["c", "clinic", "python"]],
        ["emit_code_comments", ["True", "False"]],
        ["fast_getattr", ["True", "False"]],
        ["fast_gil", ["True", "False"]],
        ["final", ["True", "False"]],
        ["formal_grammar", ["True", "False"]],
        ["freelist", []],
        ["freethreading_compatible", ["True", "False"]],
        ["infer_types", ["True", "False"]],
        ["infer_types.verbose", ["True", "False"]],
        ["initializedcheck", ["True", "False"]],
        ["internal", ["True", "False"]],
        ["iterable_coroutine", ["True", "False"]],
        ["language_level", ["2", "3", "3str"]],
        ["legacy_implicit_noexcept", ["True", "False"]],
        ["linetrace", ["True", "False"]],
        ["no_gc", ["True", "False"]],
        ["no_gc_clear", ["True", "False"]],
        ["nonecheck", ["True", "False"]],
        ["np_pythran", ["True", "False"]],
        ["old_style_globals", ["True", "False"]],
        ["optimize.inline_defnode_calls", ["True", "False"]],
        ["optimize.unpack_method_calls", ["True", "False"]],
        ["optimize.unpack_method_calls_in_pyinit", ["True", "False"]],
        ["optimize.use_switch", ["True", "False"]],
        ["overflowcheck", ["True", "False"]],
        ["overflowcheck.fold", ["True", "False"]],
        ["preliminary_late_includes_cy28", ["True", "False"]],
        ["profile", ["True", "False"]],
        ["py2_import", ["True", "False"]],
        ["remove_unreachable", ["True", "False"]],
        ["set_initial_path", []],
        ["show_performance_hints", ["True", "False"]],
        ["subinterpreters_compatible", ["no", "shared_gil", "own_gil"]],
        ["test_body_needs_exception_handling", ["True", "False"]],
        ["trashcan", ["True", "False"]],
        ["type_version_tag", ["True", "False"]],
        ["unraisable_tracebacks", ["True", "False"]],
        ["warn.deprecated.DEF", ["True", "False"]],
        ["warn.deprecated.IF", ["True", "False"]],
        ["warn.maybe_uninitialized", ["True", "False"]],
        ["warn.multiple_declarators", ["True", "False"]],
        ["warn.undeclared", ["True", "False"]],
        ["warn.unreachable", ["True", "False"]],
        ["warn.unused", ["True", "False"]],
        ["warn.unused_arg", ["True", "False"]],
        ["warn.unused_result", ["True", "False"]],
        ["wraparound", ["True", "False"]],
    ]
}

// `-X NAME=VALUE,...`: the names of the directives, and after `NAME=`, its values.
fn directives(cur) {
    let k = lib_text::last_of(cur, [',']);
    let w = cur.sub_string(k + 1);
    let eq = w.index_of("=");
    let out = [];
    for d in directive_list() {
        if eq < 0 {
            out.push(#{value: d[0] + "=", suffix: ""});
        } else if d[0] == w.sub_string(0, eq) {
            out = d[1];
        }
    }
    #{prefix: cur.sub_string(0, k + 1 + if eq < 0 { 0 } else { eq + 1 }), candidates: out}
}

fn kind(name, cur, words) {
    switch name {
        "directives" => directives(cur),
        "concurrency" => lib_text::comma_list(cur, ["eventlet", "gevent", "greenlet", "multiprocessing", "thread"]),
        "debug_topics" => [
            #{value: "config", desc: "show configuration settings"},
            #{value: "data", desc: "summarize data files"},
            #{value: "premain", desc: "show what is calling coverage"},
            #{value: "pybehave", desc: "show internal flags describing Python behavior"},
            #{value: "sqlite", desc: "show SQLite compilation options"},
            #{value: "sys", desc: "show installation information"},
        ],
        _ => throw `unknown kind: ${name}`,
    }
}
