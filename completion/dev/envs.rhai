// Python environments: virtualenv 21.15.2, tox 4.67.4 and pipx 1.18.4, from their argparse parsers. tox's
// environments and labels are read from its configuration, and pipx's environments from its home. Generated by
// scripts/gen/mk_envs.py.

import "../extra-lib/text" as lib_text;

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

// virtualenv [OPTIONS] DEST
fn virtualenv() {
    #{
        opts: `
            --version                        display the version of the virtualenv package and its location, then exit
            --with-traceback                 on failure also display the stacktrace internals of virtualenv
            -v, --verbose                    increase verbosity
            -q, --quiet                      decrease verbosity
            --read-only-app-data             use app data folder in read-only mode (write operations will fail with error)
            --app-data APP_DATA              a data folder used as cache by the virtualenv
            --reset-app-data                 start with empty app data folder
            --upgrade-embed-wheels           trigger a manual update of the embedded wheels
            --discovery BUILTIN              interpreter discovery method
            -p, --python py                  the interpreter to create the environment with
            --try-first-with py_exe          try first these interpreters before starting the discovery
            --creator CREATOR                create the environment with (builtin: cpython3-posix)
            --seeder APP-DATA|PIP            seed packages install method
            --no-seed, --without-pip         do not install seed packages
            --activators comma_sep_list      the activators to generate (comma-separated; default: all supported)
            --clear                          remove the destination directory if exist before starting (will overwrite files otherwise)
            --no-vcs-ignore                  don't create VCS ignore directive in the destination directory
            --venv-redirect                  point a PEP-832 .venv redirect file next to the destination at the created environment
            --no-venv-redirect               write no PEP-832 .venv redirect file
            --system-site-packages           give the virtual environment access to the system site-packages dir
            --symlinks                       try to use symlinks rather than copies, when symlinks are not the default for the platform
            --copies, --always-copy          try to use copies rather than symlinks, even when symlinks are the default for the
            --no-download, --never-download  don't download the latest pip/setuptools/wheel from PyPI
            --download                       download the latest pip/setuptools/wheel from PyPI
            --extra-search-dir d             a path containing wheels to extend the internal wheel list (can be set 1+ times)
            --pip version                    version of pip to install as seed: embed, bundle, none or exact version
            --setuptools version             version of setuptools to install as seed: embed, bundle, none or exact version
            --no-pip                         do not install pip
            --no-setuptools                  do not install setuptools
            --no-periodic-update             disable the periodic (once every 14 days) update of the embedded wheels
            --symlink-app-data               symlink the python packages from the app-data folder
            --prompt prompt                  an alternative prompt prefix for the environment (.: the name of the current directory)
            -h, --help                       show this help message and exit
        `,
        values: #{
            "--app-data": "dirs", "--discovery": ["builtin"], "-p": own("kinds:pythons"),
            "--python": own("kinds:pythons"), "--try-first-with": "files",
            "--creator": ["builtin", "cpython3-posix", "venv"], "--seeder": ["app-data", "pip"],
            "--activators": own("envs:activators"), "--extra-search-dir": "dirs",
            "--pip": ["embed", "bundle", "none"], "--setuptools": ["embed", "bundle", "none"], "--prompt": "none",
        },
        args: ["dirs"],
    }
}

// tox [COMMAND] [OPTIONS] [-- ARGS]: without a command, `legacy`.
fn tox() {
    #{
        opts: `
            --result-json path                   write a JSON file with detailed information about all commands and results involved
            -i, --no-capture                     disable output capture (mutually exclusive with --result-json and parallel mode)
            --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
            --discover path                      for Python discovery first try these Python executables
            --list-dependencies                  list the dependencies installed during environment setup
            --no-list-dependencies               never list the dependencies installed during environment setup
            --help-ini, --hi                     show live configuration
            --showconfig                         show live configuration
            -a, --listenvs-all                   show list of all defined environments (with description if verbose)
            -l, --listenvs                       show list of test environments (with description if verbose)
            --devenv ENVDIR                      set up a development environment at ENVDIR
            -e ENV                               the environments to run (comma-separated; ALL: all of them; default: env_list)
            -m label                             labels to evaluate
            -f factor                            factors to evaluate
            --skip-env re                        exclude all environments selected that match this regular expression
            -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
            -n, --notest                         do not run the test commands
            -b, --pkg-only, --sdistonly          only perform the packaging activity
            --installpkg INSTALL_PKG             install this package instead of packaging the project
            --fail-fast                          stop execution after the first environment failure
            --develop                            install package in development mode
            --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
            --skip-pkg-install                   skip package installation for this run
            --skip-env-install                   skip dependency and package installation, reuse existing environment
            -p, --parallel[=VAL]                 run the environments in parallel, at most VAL at a time
            -o, --parallel-live                  connect to stdout while running environments
            --parallel-no-spinner                disable the spinner when running in parallel, enabled by default in CI
            --pre                                deprecated use PIP_PRE in set_env instead - install pre-releases and development versions
            --force-dep req                      force a version of a dependency
            --sitepackages                       deprecated use VIRTUALENV_SYSTEM_SITE_PACKAGES=1, override sitepackages setting to True
            --alwayscopy                         deprecated use VIRTUALENV_ALWAYS_COPY=1, override always copy setting to True in all envs
        `,
        common: `
            -h, --help                     show this help message and exit
            --colored YES|NO               whether to colour the output
            --stderr-color STDERR_COLOR    color for stderr output, use RESET for terminal defaults
            -v, --verbose                  increase verbosity
            -q, --quiet                    decrease verbosity
            --exit-and-dump-after seconds  dump tox's threads after SECONDS and exit (0: never)
            -c, --conf file                the configuration file or folder of tox
            --workdir dir                  tox working directory (if not specified will be the folder of the config file)
            --root dir                     project root directory (if not specified will be the folder of the config file)
            --runner DEFAULT_RUNNER        the tox run engine to use when not explicitly stated in tox env configuration
            --version                      show program's and plugins version number and exit
            --no-provision[=REQ_JSON]      don't provision tox, fail (and write the provision's metadata as JSON to REQ_JSON)
            --no-recreate-provision        if recreate is set do not recreate provision tox environment
            -r, --recreate                 recreate the tox environments
            -x, --override OVERRIDE        override a setting of the configuration (testenv:NAME.KEY=VALUE)
        `,
        values: #{
            "--colored": ["yes", "no"],
            "--stderr-color": [
                "BLACK", "BLUE", "CYAN", "GREEN", "LIGHTBLACK_EX", "LIGHTBLUE_EX", "LIGHTCYAN_EX", "LIGHTGREEN_EX",
                "LIGHTMAGENTA_EX", "LIGHTRED_EX", "LIGHTWHITE_EX", "LIGHTYELLOW_EX", "MAGENTA", "RED", "RESET",
                "WHITE", "YELLOW",
            ], "--exit-and-dump-after": "none", "-c": "files", "--conf": "files", "--workdir": "dirs",
            "--root": "dirs", "--runner": ["virtualenv", "virtualenv-pep-723"], "--no-provision": "files",
            "-x": "none", "--override": "none",
            "--result-json": "files", "--hashseed": "none", "--discover": "files", "--devenv": "dirs",
            "-e": own("kinds:tox_envs"), "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
            "-s": ["config", "true", "false"], "--skip-missing-interpreters": ["config", "true", "false"],
            "--installpkg": own("kinds:python_dists"), "-p": ["all", "auto", "0"],
            "--parallel": ["all", "auto", "0"], "--force-dep": "none",
        },
        commands: `
            run, r           run environments
            run-parallel, p  run environments in parallel
            depends, de      visualize tox environment dependencies
            man              set up tox's man page for the current shell
            list, l          list environments
            devenv, d        set up a development environment
            schema           generate the schema of tox's configuration
            config, c        show tox configuration
            quickstart, q    create a tox config file for a Python project
            exec, e          execute an arbitrary command within a tox environment
            legacy, le       legacy entry-point command
        `,
        subs: #{
            "run": #{
                opts: `
                    --result-json path                   write a JSON file with detailed information about all commands and results involved
                    -i, --no-capture                     disable output capture (mutually exclusive with --result-json and parallel mode)
                    --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path                      for Python discovery first try these Python executables
                    --list-dependencies                  list the dependencies installed during environment setup
                    --no-list-dependencies               never list the dependencies installed during environment setup
                    -e ENV                               the environments to run (comma-separated; ALL: all of them; default: env_list)
                    -m label                             labels to evaluate
                    -f factor                            factors to evaluate
                    --skip-env re                        exclude all environments selected that match this regular expression
                    -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
                    -n, --notest                         do not run the test commands
                    -b, --pkg-only, --sdistonly          only perform the packaging activity
                    --installpkg INSTALL_PKG             install this package instead of packaging the project
                    --fail-fast                          stop execution after the first environment failure
                    --develop                            install package in development mode
                    --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
                    --skip-pkg-install                   skip package installation for this run
                    --skip-env-install                   skip dependency and package installation, reuse existing environment
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files",
                    "-e": own("kinds:tox_envs"), "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
                    "-s": ["config", "true", "false"], "--skip-missing-interpreters": ["config", "true", "false"],
                    "--installpkg": own("kinds:python_dists"),
                },
                args: ["files"],
            },
            "run-parallel": #{
                opts: `
                    --result-json path                   write a JSON file with detailed information about all commands and results involved
                    -i, --no-capture                     disable output capture (mutually exclusive with --result-json and parallel mode)
                    --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path                      for Python discovery first try these Python executables
                    --list-dependencies                  list the dependencies installed during environment setup
                    --no-list-dependencies               never list the dependencies installed during environment setup
                    -e ENV                               the environments to run (comma-separated; ALL: all of them; default: env_list)
                    -m label                             labels to evaluate
                    -f factor                            factors to evaluate
                    --skip-env re                        exclude all environments selected that match this regular expression
                    -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
                    -n, --notest                         do not run the test commands
                    -b, --pkg-only, --sdistonly          only perform the packaging activity
                    --installpkg INSTALL_PKG             install this package instead of packaging the project
                    --fail-fast                          stop execution after the first environment failure
                    --develop                            install package in development mode
                    --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
                    --skip-pkg-install                   skip package installation for this run
                    --skip-env-install                   skip dependency and package installation, reuse existing environment
                    -p, --parallel VAL                   run the environments in parallel, at most VAL at a time
                    -o, --parallel-live                  connect to stdout while running environments
                    --parallel-no-spinner                disable the spinner when running in parallel, enabled by default in CI
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files",
                    "-e": own("kinds:tox_envs"), "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
                    "-s": ["config", "true", "false"], "--skip-missing-interpreters": ["config", "true", "false"],
                    "--installpkg": own("kinds:python_dists"), "-p": ["all", "auto", "0"],
                    "--parallel": ["all", "auto", "0"],
                },
                args: ["files"],
            },
            "depends": #{
                args: ["none"],
            },
            "man": #{
                args: ["none"],
            },
            "list": #{
                opts: `
                    --no-desc      do not show description
                    -m label       labels to evaluate
                    -f factor      factors to evaluate
                    --skip-env re  exclude all environments selected that match this regular expression
                    -d             list just default envs
                `,
                values: #{
                    "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
                },
                args: ["none"],
            },
            "devenv": #{
                opts: `
                    --result-json path      write a JSON file with detailed information about all commands and results involved
                    -i, --no-capture        disable output capture (mutually exclusive with --result-json and parallel mode)
                    --hashseed SEED         set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path         for Python discovery first try these Python executables
                    --list-dependencies     list the dependencies installed during environment setup
                    --no-list-dependencies  never list the dependencies installed during environment setup
                    -e ENV                  the environment to set up
                    --skip-env re           exclude all environments selected that match this regular expression
                    --no-recreate-pkg       if recreate is set do not recreate packaging tox environment(s)
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files",
                    "-e": own("kinds:tox_envs"), "--skip-env": "none",
                },
                args: ["dirs"],
            },
            "schema": #{
                opts: `
                    --strict  disallow extra properties in configuration
                `,
                args: ["none"],
            },
            "config": #{
                opts: `
                    --result-json path                   write a JSON file with detailed information about all commands and results involved
                    -i, --no-capture                     disable output capture (mutually exclusive with --result-json and parallel mode)
                    --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path                      for Python discovery first try these Python executables
                    --list-dependencies                  list the dependencies installed during environment setup
                    --no-list-dependencies               never list the dependencies installed during environment setup
                    -k key                               list just configuration keys specified
                    --core                               show core options
                    --format INI|JSON|TOML               output format
                    -o, --output-file OUTPUT_FILE        write output to file instead of stdout
                    -e ENV                               the environments to run (comma-separated; ALL: all of them; default: env_list)
                    -m label                             labels to evaluate
                    -f factor                            factors to evaluate
                    --skip-env re                        exclude all environments selected that match this regular expression
                    -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
                    --develop                            install package in development mode
                    --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files", "-k": "none",
                    "--format": ["ini", "json", "toml"], "-o": "files", "--output-file": "files",
                    "-e": own("kinds:tox_envs"), "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
                    "-s": ["config", "true", "false"], "--skip-missing-interpreters": ["config", "true", "false"],
                },
                args: ["none"],
            },
            "quickstart": #{
                args: ["dirs"],
            },
            "exec": #{
                opts: `
                    --result-json path                   write a JSON file with detailed information about all commands and results involved
                    --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path                      for Python discovery first try these Python executables
                    --list-dependencies                  list the dependencies installed during environment setup
                    --no-list-dependencies               never list the dependencies installed during environment setup
                    -e ENV                               the environment to run the command in
                    --skip-env re                        exclude all environments selected that match this regular expression
                    -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
                    -n, --notest                         do not run the test commands
                    -b, --pkg-only, --sdistonly          only perform the packaging activity
                    --installpkg INSTALL_PKG             install this package instead of packaging the project
                    --fail-fast                          stop execution after the first environment failure
                    --develop                            install package in development mode
                    --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
                    --skip-pkg-install                   skip package installation for this run
                    --skip-env-install                   skip dependency and package installation, reuse existing environment
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files",
                    "-e": own("kinds:tox_envs"), "--skip-env": "none", "-s": ["config", "true", "false"],
                    "--skip-missing-interpreters": ["config", "true", "false"],
                    "--installpkg": own("kinds:python_dists"),
                },
                args: ["commands", "files"],
            },
            "legacy": #{
                opts: `
                    --result-json path                   write a JSON file with detailed information about all commands and results involved
                    -i, --no-capture                     disable output capture (mutually exclusive with --result-json and parallel mode)
                    --hashseed SEED                      set PYTHONHASHSEED to SEED (notset: don't set it)
                    --discover path                      for Python discovery first try these Python executables
                    --list-dependencies                  list the dependencies installed during environment setup
                    --no-list-dependencies               never list the dependencies installed during environment setup
                    --help-ini, --hi                     show live configuration
                    --showconfig                         show live configuration
                    -a, --listenvs-all                   show list of all defined environments (with description if verbose)
                    -l, --listenvs                       show list of test environments (with description if verbose)
                    --devenv ENVDIR                      set up a development environment at ENVDIR
                    -e ENV                               the environments to run (comma-separated; ALL: all of them; default: env_list)
                    -m label                             labels to evaluate
                    -f factor                            factors to evaluate
                    --skip-env re                        exclude all environments selected that match this regular expression
                    -s, --skip-missing-interpreters[=v]  don't fail for missing interpreters
                    -n, --notest                         do not run the test commands
                    -b, --pkg-only, --sdistonly          only perform the packaging activity
                    --installpkg INSTALL_PKG             install this package instead of packaging the project
                    --fail-fast                          stop execution after the first environment failure
                    --develop                            install package in development mode
                    --no-recreate-pkg                    if recreate is set do not recreate packaging tox environment(s)
                    --skip-pkg-install                   skip package installation for this run
                    --skip-env-install                   skip dependency and package installation, reuse existing environment
                    -p, --parallel[=VAL]                 run the environments in parallel, at most VAL at a time
                    -o, --parallel-live                  connect to stdout while running environments
                    --parallel-no-spinner                disable the spinner when running in parallel, enabled by default in CI
                    --pre                                deprecated use PIP_PRE in set_env instead - install pre-releases and development versions
                    --force-dep req                      force a version of a dependency
                    --sitepackages                       deprecated use VIRTUALENV_SYSTEM_SITE_PACKAGES=1, override sitepackages setting to True
                    --alwayscopy                         deprecated use VIRTUALENV_ALWAYS_COPY=1, override always copy setting to True in all envs
                `,
                values: #{
                    "--result-json": "files", "--hashseed": "none", "--discover": "files", "--devenv": "dirs",
                    "-e": own("kinds:tox_envs"), "-m": own("kinds:tox_labels"), "-f": "none", "--skip-env": "none",
                    "-s": ["config", "true", "false"], "--skip-missing-interpreters": ["config", "true", "false"],
                    "--installpkg": own("kinds:python_dists"), "-p": ["all", "auto", "0"],
                    "--parallel": ["all", "auto", "0"], "--force-dep": "none",
                },
                args: ["files"],
            },
        },
        args: ["files"],
    }
}

// pipx COMMAND [OPTIONS] ...
fn pipx() {
    #{
        opts: `
            -h, --help  show this help message and exit
            --version   print version and exit
        `,
        common: `
            -q, --quiet         give less output
            -v, --verbose       give more output
            --skip-maintenance  do not upgrade shared libraries; use bundled pip when creating them
            --global            perform action globally for all users
            -h, --help          show this help message and exit
        `,
        commands: `
            install         install a package
            install-all     install all packages
            uninject        uninstall injected packages from an existing Virtual Environment
            inject          install packages into an existing Virtual Environment
            expose          relink hidden or missing resources of an environment
            unexpose        hide resources without removing an environment
            pin             pin the specified package to prevent it from being upgraded
            unpin           unpin the specified package
            upgrade         upgrade a package
            upgrade-all     upgrade all packages
            upgrade-shared  upgrade shared libraries
            uninstall       uninstall a package
            uninstall-all   uninstall all packages
            reset           return pipx to a fresh install
            reinstall       reinstall a package
            reinstall-all   reinstall all packages
            health          check installed package environments
            repair          repair broken package environments
            list            list installed packages
            interpreter     interact with interpreters managed by pipx
            cache           manage cached run environments
            manifest        manage tools declared in an explicit manifest
            run             run an app from a package in a temporary environment
            exec            run an application from an existing pipx environment
            runpip          run pip, or 'uv pip' under the uv backend, in an existing pipx-managed Virtual Environment
            ensurepath      ensure directories necessary for pipx operation are in your PATH environment variable
            environment     print a list of environment variables and paths used by pipx
            completions     print instructions on enabling shell completions for pipx
            help            show help for pipx or a command
        `,
        subs: #{
            "install": #{
                opts: `
                    --include-deps                           include apps and manual pages from all dependencies
                    --include-resources-from PACKAGE         include apps and manual pages from this dependency
                    -f, --force                              modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
                    -U, --upgrade                            upgrade or downgrade an installed package whose version doesn't satisfy the spec
                    --upgrade-strategy ONLY-IF-NEEDED|EAGER  how dependency upgrades are handled when --upgrade changes an existing package
                    --suffix SUFFIX                          optional suffix for virtual environment and executable names
                    --python PYTHON                          the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER      when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python                   deprecated: alias for --fetch-python=missing
                    --preinstall PREINSTALL                  a package to install into the environment before the main package
                    --app APP                                require this application entry point after installation
                    --lock LOCK                              install the environment from an explicit pylock.toml file
                    --system-site-packages                   give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL                the base URL of the Python package index
                    -e, --editable                           install a project in editable mode
                    --pip-args PIP_ARGS                      arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS                          ignore files uploaded to the index less than DAYS days ago
                    --backend PIP|UV                         backend used for creating venvs and managing packages
                    --output HUMAN|JSON                      select the output format
                `,
                values: #{
                    "--include-resources-from": "none", "--upgrade-strategy": ["only-if-needed", "eager"],
                    "--suffix": "none", "--python": own("kinds:pythons"),
                    "--fetch-python": ["always", "missing", "never"], "--preinstall": "none", "--app": "none",
                    "--lock": "files", "-i": "none", "--index-url": "none", "--pip-args": "none",
                    "--cooldown": "none", "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: ["files"],
            },
            "install-all": #{
                opts: `
                    -f, --force                          modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --system-site-packages               give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL            the base URL of the Python package index
                    -e, --editable                       install a project in editable mode
                    --pip-args PIP_ARGS                  arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS                      ignore files uploaded to the index less than DAYS days ago
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                `,
                values: #{
                    "--python": own("kinds:pythons"), "--fetch-python": ["always", "missing", "never"],
                    "-i": "none", "--index-url": "none", "--pip-args": "none", "--cooldown": "none",
                    "--backend": ["pip", "uv"],
                },
                args: ["files"],
            },
            "uninject": #{
                opts: `
                    --leave-deps         only uninstall the main injected package but leave its dependencies installed
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs"), own("kinds:pipx_injected")],
            },
            "inject": #{
                opts: `
                    -r, --requirement file            a file of packages to inject (one per line)
                    --include-apps                    add apps from the injected packages onto your PATH and expose their manual pages
                    --include-deps                    include apps and manual pages from all dependencies
                    --include-resources-from PACKAGE  include apps and manual pages from this dependency
                    --system-site-packages            give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL         the base URL of the Python package index
                    -e, --editable                    install a project in editable mode
                    --pip-args PIP_ARGS               arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS                   ignore files uploaded to the index less than DAYS days ago
                    -f, --force                       modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
                    --with-suffix                     add the suffix (if given) of the Virtual Environment to the packages to inject
                    --backend PIP|UV                  backend used for creating venvs and managing packages
                    --output HUMAN|JSON               select the output format
                `,
                values: #{
                    "-r": "files", "--requirement": "files", "--include-resources-from": "none", "-i": "none",
                    "--index-url": "none", "--pip-args": "none", "--cooldown": "none", "--backend": ["pip", "uv"],
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs"), "none"],
            },
            "expose": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "unexpose": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "pin": #{
                opts: `
                    --injected-only      pin injected packages in venv only, so that they will not be upgraded during upgrade
                    --skip SKIP          skip these packages
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--skip": own("kinds:pipx_venvs"), "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "unpin": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "upgrade": #{
                opts: `
                    --include-injected                   also upgrade packages injected into the main app's environment
                    -f, --force                          modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
                    --system-site-packages               give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL            the base URL of the Python package index
                    -e, --editable                       install a project in editable mode
                    --pip-args PIP_ARGS                  arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS                      ignore files uploaded to the index less than DAYS days ago
                    --install                            install package spec if missing
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                    --output HUMAN|JSON                  select the output format
                `,
                values: #{
                    "-i": "none", "--index-url": "none", "--pip-args": "none", "--cooldown": "none",
                    "--python": own("kinds:pythons"), "--fetch-python": ["always", "missing", "never"],
                    "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "upgrade-all": #{
                opts: `
                    --include-injected         also upgrade packages injected into the main app's environment
                    --skip SKIP                skip these packages
                    -f, --force                modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
                    --system-site-packages     give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL  the base URL of the Python package index
                    -e, --editable             install a project in editable mode
                    --pip-args PIP_ARGS        arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS            ignore files uploaded to the index less than DAYS days ago
                    --backend PIP|UV           backend used for creating venvs and managing packages
                    --output HUMAN|JSON        select the output format
                `,
                values: #{
                    "--skip": own("kinds:pipx_venvs"), "-i": "none", "--index-url": "none", "--pip-args": "none",
                    "--cooldown": "none", "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: ["none"],
            },
            "upgrade-shared": #{
                opts: `
                    --pip-args PIP_ARGS  arguments to pass to pip (quoted, as one word)
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--pip-args": "none", "--output": ["human", "json"],
                },
                args: ["none"],
            },
            "uninstall": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "uninstall-all": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: ["none"],
            },
            "reset": #{
                opts: `
                    -y, --yes            reset without asking for confirmation
                    --dry-run            report what a reset would remove and stop
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: ["none"],
            },
            "reinstall": #{
                opts: `
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                    --output HUMAN|JSON                  select the output format
                `,
                values: #{
                    "--python": own("kinds:pythons"), "--fetch-python": ["always", "missing", "never"],
                    "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "reinstall-all": #{
                opts: `
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --skip SKIP                          skip these packages
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                    --output HUMAN|JSON                  select the output format
                `,
                values: #{
                    "--python": own("kinds:pythons"), "--fetch-python": ["always", "missing", "never"],
                    "--skip": own("kinds:pipx_venvs"), "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: ["none"],
            },
            "health": #{
                opts: `
                    --output HUMAN|JSON  select the output format
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "repair": #{
                opts: `
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                    --output HUMAN|JSON                  select the output format
                `,
                values: #{
                    "--python": own("kinds:pythons"), "--fetch-python": ["always", "missing", "never"],
                    "--backend": ["pip", "uv"], "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "list": #{
                opts: `
                    --include-injected   show packages injected into the main app's environment
                    --outdated           list packages with an available upgrade
                    --short              list packages only
                    --pinned             list pinned packages only
                    --output HUMAN|JSON  select the output format
                    --json               print the installed-package snapshot as JSON, the format install-all consumes
                `,
                values: #{
                    "--output": ["human", "json"],
                },
                args: [own("kinds:pipx_venvs")],
            },
            "interpreter": #{
                commands: `
                    list     list available interpreters
                    prune    prune unused interpreters
                    upgrade  upgrade installed interpreters to the latest available micro/patch version
                `,
                subs: #{
                    "list": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["none"],
                    },
                    "prune": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["none"],
                    },
                    "upgrade": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["none"],
                    },
                },
            },
            "cache": #{
                commands: `
                    dir    show the cache directory
                    purge  remove cached run environments
                `,
                subs: #{
                    "dir": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["none"],
                    },
                    "purge": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["none"],
                    },
                },
            },
            "manifest": #{
                commands: `
                    lock  resolve a tool manifest with nab
                    sync  apply a tool manifest
                `,
                subs: #{
                    "lock": #{
                        opts: `
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--output": ["human", "json"],
                        },
                        args: ["files"],
                    },
                    "sync": #{
                        opts: `
                            --prune              uninstall environments absent from the manifest
                            --backend PIP|UV     backend used for creating venvs and managing packages
                            --output HUMAN|JSON  select the output format
                        `,
                        values: #{
                            "--backend": ["pip", "uv"], "--output": ["human", "json"],
                        },
                        args: ["files"],
                    },
                },
            },
            "run": #{
                opts: `
                    --no-cache                           do not reuse cached virtual environment if it exists
                    --refresh                            rebuild and cache the virtual environment
                    --no-path-check                      do not check whether the app is already on PATH
                    --python-args ARGS                   arguments to pass to the Python interpreter that runs the application
                    --path                               interpret app name as a local path
                    --pypackages                         require app to be run from local __pypackages__ directory
                    --with WITH_                         extra dependencies to add to the temporary environment
                    --spec SPEC                          the package name or specific installation source to install the app from
                    --python PYTHON                      the Python to install with (a version, such as 3.12, or a path)
                    --fetch-python ALWAYS|MISSING|NEVER  when to fetch a standalone Python build from python-build-standalone
                    --fetch-missing-python               deprecated: alias for --fetch-python=missing
                    --system-site-packages               give the virtual environment access to the system site-packages dir
                    -i, --index-url INDEX_URL            the base URL of the Python package index
                    -e, --editable                       install a project in editable mode
                    --pip-args PIP_ARGS                  arguments to pass to pip (quoted, as one word)
                    --cooldown DAYS                      ignore files uploaded to the index less than DAYS days ago
                    --backend PIP|UV                     backend used for creating venvs and managing packages
                `,
                values: #{
                    "--python-args": "none", "--with": "none", "--spec": "none", "--python": own("kinds:pythons"),
                    "--fetch-python": ["always", "missing", "never"], "-i": "none", "--index-url": "none",
                    "--pip-args": "none", "--cooldown": "none", "--backend": ["pip", "uv"],
                },
                args: ["none", "files"],
            },
            "exec": #{
                args: [own("kinds:pipx_venvs"), own("kinds:pipx_apps"), "files"],
            },
            "runpip": #{
                args: [own("kinds:pipx_venvs"), "files"],
            },
            "ensurepath": #{
                opts: `
                    --prepend     prepend directories to your PATH instead of appending
                    -f, --force   add to the shell's config file even if PATH seems to have the directories
                    --all-shells  add directories to PATH in all shells instead of just the current one
                    --dry-run     report what would be added to PATH without modifying PATH or any shell configuration file
                `,
                args: ["none"],
            },
            "environment": #{
                opts: `
                    -V, --value VARIABLE  print the value of the variable
                `,
                values: #{
                    "-V": [
                        "PIPX_HOME", "PIPX_GLOBAL_HOME", "PIPX_BIN_DIR", "PIPX_GLOBAL_BIN_DIR", "PIPX_MAN_DIR",
                        "PIPX_COMPLETION_DIR", "PIPX_GLOBAL_MAN_DIR", "PIPX_GLOBAL_COMPLETION_DIR",
                        "PIPX_SHARED_LIBS", "PIPX_DEFAULT_PYTHON", "PIPX_DEFAULT_BACKEND", "PIPX_COOLDOWN",
                        "PIPX_FETCH_MISSING_PYTHON", "PIPX_FETCH_PYTHON", "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE",
                        "PIPX_USE_EMOJI", "PIPX_MAX_LOGS", "PIPX_LOCAL_VENVS", "PIPX_LOG_DIR", "PIPX_TRASH_DIR",
                        "PIPX_VENV_CACHEDIR", "PIPX_STANDALONE_PYTHON_CACHEDIR", "PIPX_RESOLVED_BACKEND",
                        "PIPX_BACKEND_SOURCE", "PIPX_UV_BINARY", "UV_CACHE_DIR",
                    ],
                    "--value": [
                        "PIPX_HOME", "PIPX_GLOBAL_HOME", "PIPX_BIN_DIR", "PIPX_GLOBAL_BIN_DIR", "PIPX_MAN_DIR",
                        "PIPX_COMPLETION_DIR", "PIPX_GLOBAL_MAN_DIR", "PIPX_GLOBAL_COMPLETION_DIR",
                        "PIPX_SHARED_LIBS", "PIPX_DEFAULT_PYTHON", "PIPX_DEFAULT_BACKEND", "PIPX_COOLDOWN",
                        "PIPX_FETCH_MISSING_PYTHON", "PIPX_FETCH_PYTHON", "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE",
                        "PIPX_USE_EMOJI", "PIPX_MAX_LOGS", "PIPX_LOCAL_VENVS", "PIPX_LOG_DIR", "PIPX_TRASH_DIR",
                        "PIPX_VENV_CACHEDIR", "PIPX_STANDALONE_PYTHON_CACHEDIR", "PIPX_RESOLVED_BACKEND",
                        "PIPX_BACKEND_SOURCE", "PIPX_UV_BINARY", "UV_CACHE_DIR",
                    ],
                },
                args: ["none"],
            },
            "completions": #{
                args: ["none"],
            },
            "help": #{
                args: [["install", "install-all", "uninject", "inject", "expose", "unexpose", "pin", "unpin", "upgrade", "upgrade-all", "upgrade-shared", "uninstall", "uninstall-all", "reset", "reinstall", "reinstall-all", "health", "repair", "list", "interpreter", "cache", "manifest", "run", "exec", "runpip", "ensurepath", "environment", "completions", "help"]],
            },
        },
    }
}

fn spec(cmd) {
    switch cmd {
        "virtualenv" => virtualenv(),
        "tox" => tox(),
        "pipx" => pipx(),
        _ => #{},
    }
}

fn kind(name, cur, words) {
    switch name {
        // virtualenv's activation scripts, in a comma-separated list
        "activators" => lib_text::comma_list(cur, ["bash", "batch", "cshell", "fish", "nushell", "powershell", "python", "xonsh"]),
        _ => throw `unknown kind: ${name}`,
    }
}
