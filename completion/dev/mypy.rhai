// mypy 2.3.1, from its argparse parser (`mypy --help`), with the inverses of its flags (`--no-strict-optional`),
// which the help names but doesn't list. Generated by scripts/gen/mk_mypy.py.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn spec(cmd) {
    #{
        opts: `
            -h, --help                                    show this help message and exit
            -v, --verbose                                 more verbose messages
            -V, --version                                 show program's version number and exit
            -O, --output FORMAT                           set a custom output format
            --config-file CONFIG_FILE                     configuration file, must have a [mypy] section
            --warn-unused-configs                         warn about unused '[mypy-<pattern>]' or '[[tool.mypy.overrides]]' config sections
            --no-warn-unused-configs                      inverse of --warn-unused-configs
            --no-namespace-packages                       disable support for namespace packages (PEP 420, __init__.py-less)
            --namespace-packages                          inverse of --no-namespace-packages
            --ignore-missing-imports                      silently ignore imports of missing modules
            --follow-untyped-imports                      typecheck modules without stubs or py.typed marker
            --follow-imports NORMAL|SILENT|SKIP|ERROR     how to treat imports
            --python-executable EXECUTABLE                python executable used for finding PEP 561 compliant installed packages and stubs
            --no-site-packages                            do not search for installed PEP 561 compliant packages
            --no-silence-site-packages                    do not silence errors in PEP 561 compliant installed packages
            --python-version x.y                          type check code assuming it will be running on Python x.y
            --platform PLATFORM                           type check special-cased code for the given OS platform
            --always-true NAME                            additional variable to be considered True (may be repeated)
            --always-false NAME                           additional variable to be considered False (may be repeated)
            --disallow-any-expr                           disallow all expressions that have type Any
            --disallow-any-decorated                      disallow functions that have Any in their signature after decorator transformation
            --disallow-any-explicit                       disallow explicit Any in type positions
            --disallow-any-generics                       disallow usage of generic types that do not specify explicit type parameters
            --allow-any-generics                          inverse of --disallow-any-generics
            --disallow-any-unimported                     disallow Any types resulting from unfollowed imports
            --allow-any-unimported                        inverse of --disallow-any-unimported
            --disallow-subclassing-any                    disallow subclassing values of type 'Any' when defining classes
            --allow-subclassing-any                       inverse of --disallow-subclassing-any
            --disallow-untyped-calls                      disallow calling functions without type annotations from functions with type annotations
            --allow-untyped-calls                         inverse of --disallow-untyped-calls
            --untyped-calls-exclude MODULE                disable --disallow-untyped-calls for functions/methods coming from specific package
            --disallow-untyped-defs                       disallow defining functions without type annotations or with incomplete type annotations
            --allow-untyped-defs                          inverse of --disallow-untyped-defs
            --disallow-incomplete-defs                    disallow defining functions with incomplete type annotations
            --allow-incomplete-defs                       inverse of --disallow-incomplete-defs
            --check-untyped-defs                          type check the interior of functions without type annotations
            --no-check-untyped-defs                       inverse of --check-untyped-defs
            --disallow-untyped-decorators                 disallow decorating typed functions with untyped decorators
            --allow-untyped-decorators                    inverse of --disallow-untyped-decorators
            --implicit-optional                           assume arguments with default values of None are Optional
            --no-implicit-optional                        inverse of --implicit-optional
            --strict-optional                             inverse of --no-strict-optional
            --no-strict-optional                          disable strict Optional checks
            --warn-redundant-casts                        warn about casting an expression to its inferred type
            --no-warn-redundant-casts                     inverse of --warn-redundant-casts
            --warn-unused-ignores                         warn about unneeded '# type: ignore' comments
            --no-warn-unused-ignores                      inverse of --warn-unused-ignores
            --no-warn-no-return                           do not warn about functions that end without returning
            --warn-no-return                              inverse of --no-warn-no-return
            --warn-return-any                             warn about returning values of type Any from non-Any typed functions
            --no-warn-return-any                          inverse of --warn-return-any
            --warn-unreachable                            warn about statements or expressions inferred to be unreachable
            --no-warn-unreachable                         inverse of --warn-unreachable
            --report-deprecated-as-note                   report importing or using deprecated features as notes instead of errors
            --no-report-deprecated-as-note                inverse of --report-deprecated-as-note
            --deprecated-calls-exclude MODULE             disable deprecated warnings for functions/methods coming from specific package, module
            --allow-untyped-globals                       suppress toplevel errors caused by missing annotations
            --disallow-untyped-globals                    inverse of --allow-untyped-globals
            --allow-redefinition                          allow flexible variable redefinition with a new type
            --disallow-redefinition                       inverse of --allow-redefinition
            --allow-redefinition-old                      allow restricted, unconditional variable redefinition with a new type
            --disallow-redefinition-old                   inverse of --allow-redefinition-old
            --allow-redefinition-new                      deprecated alias for --allow-redefinition
            --disallow-redefinition-new                   inverse of --allow-redefinition-new
            --no-implicit-reexport                        treat imports as private unless aliased
            --implicit-reexport                           inverse of --no-implicit-reexport
            --strict-equality                             prohibit equality, identity, and container checks for non-overlapping types
            --no-strict-equality                          inverse of --strict-equality
            --strict-equality-for-none                    extend '--strict-equality' for 'None' checks
            --no-strict-equality-for-none                 inverse of --strict-equality-for-none
            --no-strict-bytes                             treat bytearray and memoryview as subtypes of bytes
            --strict-bytes                                inverse of --no-strict-bytes
            --extra-checks                                enable additional checks that are technically correct but may be impractical in real code
            --no-extra-checks                             inverse of --extra-checks
            --strict                                      strict mode; enables the following flags: --disallow-any-generics
            --disable-error-code NAME                     disable a specific error code
            --enable-error-code NAME                      enable a specific error code
            --show-error-context                          precede errors with "note:" messages explaining context
            --hide-error-context                          inverse of --show-error-context
            --show-column-numbers                         show column numbers in error messages
            --hide-column-numbers                         inverse of --show-column-numbers
            --show-error-end                              show end line/end column numbers in error messages
            --hide-error-end                              inverse of --show-error-end
            --hide-error-codes                            hide error codes in error messages
            --show-error-codes                            inverse of --hide-error-codes
            --show-error-code-links                       show links to error code documentation
            --hide-error-code-links                       inverse of --show-error-code-links
            --pretty                                      use visually nicer output in error messages: Use soft word wrap, show source code
            --no-pretty                                   inverse of --pretty
            --no-color-output                             do not colorize error messages
            --color-output                                inverse of --no-color-output
            --no-error-summary                            do not show error stats summary
            --error-summary                               inverse of --no-error-summary
            --show-absolute-path                          show absolute paths to files
            --hide-absolute-path                          inverse of --show-absolute-path
            -i, --incremental                             inverse of --no-incremental
            --no-incremental                              disable module cache
            --cache-dir DIR                               store module cache info in the given folder in incremental mode
            --sqlite-cache                                use a sqlite database to store the cache
            --no-sqlite-cache                             inverse of --sqlite-cache
            --cache-fine-grained                          include fine-grained dependency information in the cache for the mypy daemon
            --no-fixed-format-cache                       do not use new fixed format cache
            --fixed-format-cache                          inverse of --no-fixed-format-cache
            --skip-version-check                          allow using cache written by older mypy version
            --skip-cache-mtime-checks                     skip cache internal consistency checks based on mtime
            --pdb                                         invoke pdb on fatal error
            --show-traceback, --tb                        show traceback on fatal error
            --raise-exceptions                            raise exception on fatal error
            --custom-typing-module MODULE                 use a custom typing module
            --enable-incomplete-feature {InlineTypedDict,PreciseTupleTypes}  enable support of incomplete/experimental features for early preview
            --custom-typeshed-dir DIR                     use the custom typeshed in DIR
            --warn-incomplete-stub                        warn if missing type annotation in typeshed, only relevant with --disallow-untyped-defs
            --no-warn-incomplete-stub                     inverse of --warn-incomplete-stub
            --shadow-file SOURCE_FILE                     when encountering SOURCE_FILE, read and type check the contents of SHADOW_FILE instead
            -n, --num-workers NUM_WORKERS                 number of separate mypy worker processes (experimental)
            --any-exprs-report DIR                        write the any exprs report to DIR
            --cobertura-xml-report DIR                    write the cobertura xml report to DIR
            --html-report DIR                             write the html report to DIR
            --linecount-report DIR                        write the linecount report to DIR
            --linecoverage-report DIR                     write the linecoverage report to DIR
            --lineprecision-report DIR                    write the lineprecision report to DIR
            --txt-report DIR                              write the txt report to DIR
            --xml-report DIR                              write the xml report to DIR
            --xslt-html-report DIR                        write the xslt html report to DIR
            --xslt-txt-report DIR                         write the xslt txt report to DIR
            --junit-xml JUNIT_XML_OUTPUT_FILE             write a JUnit XML test result document with type checking results to the given file
            --junit-format GLOBAL|PER_FILE                if --junit-xml is set, specifies format
            --find-occurrences CLASS.MEMBER               print out all usages of a class member (experimental)
            --scripts-are-modules                         script x becomes module x instead of __main__
            --install-types                               install detected missing library stub packages using pip
            --no-install-types                            inverse of --install-types
            --non-interactive                             install stubs without asking for confirmation and hide errors, with --install-types
            --interactive                                 inverse of --non-interactive
            --native-parser                               enable faster parser that parses directly to mypy AST
            --no-native-parser                            inverse of --native-parser
            --explicit-package-bases                      use current directory and MYPYPATH to determine module names of files passed
            --no-explicit-package-bases                   inverse of --explicit-package-bases
            --exclude PATTERN                             regular expression to match file names, directory names or paths which mypy should ignore
            --exclude-gitignore                           use .gitignore file(s) to exclude files from checking
            --no-exclude-gitignore                        inverse of --exclude-gitignore
            -m, --module MODULE                           type-check module; can repeat for more modules
            -p, --package PACKAGE                         type-check package recursively; can be repeated
            -c, --command PROGRAM_TEXT                    type-check program passed in as string
        `,
        values: #{
            "-O": ["json"], "--output": ["json"], "--config-file": "files",
            "--follow-imports": ["normal", "silent", "skip", "error"], "--python-executable": "files",
            "--python-version": ["3.10", "3.11", "3.12", "3.13", "3.14"],
            "--platform": ["linux", "darwin", "win32"], "--always-true": "none", "--always-false": "none",
            "--untyped-calls-exclude": "none", "--deprecated-calls-exclude": "none",
            "--disable-error-code": own("mypy:error_codes"),
            "--enable-error-code": own("mypy:error_codes"), "--cache-dir": "dirs",
            "--custom-typing-module": "none",
            "--enable-incomplete-feature": ["InlineTypedDict", "PreciseTupleTypes"],
            "--custom-typeshed-dir": "dirs", "--shadow-file": "files", "-n": "none", "--num-workers": "none",
            "--any-exprs-report": "dirs", "--cobertura-xml-report": "dirs", "--html-report": "dirs",
            "--linecount-report": "dirs", "--linecoverage-report": "dirs", "--lineprecision-report": "dirs",
            "--txt-report": "dirs", "--xml-report": "dirs", "--xslt-html-report": "dirs",
            "--xslt-txt-report": "dirs", "--junit-xml": "files", "--junit-format": ["global", "per_file"],
            "--find-occurrences": "none", "--exclude": "none", "-m": "dev:python_modules",
            "--module": "dev:python_modules", "-p": "dev:python_modules", "--package": "dev:python_modules",
            "-c": "none", "--command": "none",
        },
        args: [own("kinds:python_files")],
        args_if: #{"-c": ["none"], "--command": ["none"]},
    }
}

// The error codes, for `--enable-error-code` and `--disable-error-code`.
fn error_codes() {
    [
        #{value: "abstract", desc: "prevent instantiation of classes with abstract attributes"},
        #{value: "annotation-unchecked", desc: "notify about type annotations in unchecked functions"},
        #{value: "arg-type", desc: "check argument types in calls"},
        #{value: "assert-type", desc: "check that assert_type() call succeeds"},
        #{value: "assignment", desc: "check that assigned value is compatible with target"},
        #{value: "attr-defined", desc: "check that attribute exists"},
        #{value: "await-not-async", desc: "warn about 'await' outside coroutine ('async def')"},
        #{value: "call-arg", desc: "check number, names and kinds of arguments in calls"},
        #{value: "call-overload", desc: "check that an overload variant matches arguments"},
        #{value: "comparison-overlap", desc: "check that types in comparisons and 'in' expressions overlap"},
        #{value: "deprecated", desc: "warn when importing or using deprecated (overloaded) functions, methods or classes"},
        #{value: "dict-item", desc: "check dict items in a dict expression {key: value, ...}"},
        #{value: "empty-body", desc: "a dedicated error code to opt out return errors for empty/trivial bodies"},
        #{value: "exhaustive-match", desc: "reject match statements that are not exhaustive"},
        #{value: "exit-return", desc: "warn about too general return type for '__exit__'"},
        #{value: "explicit-any", desc: "warn about explicit Any type annotations"},
        #{value: "explicit-override", desc: "require @override decorator if method is overriding a base class method"},
        #{value: "func-returns-value", desc: "check that called function returns a value in value context"},
        #{value: "has-type", desc: "check that type of reference can be determined"},
        #{value: "ignore-without-code", desc: "warn about '# type: ignore' comments which do not have error codes"},
        #{value: "import", desc: "require that imported module can be found or has stubs"},
        #{value: "import-not-found", desc: "require that imported module can be found"},
        #{value: "import-untyped", desc: "require that imported module has stubs"},
        #{value: "index", desc: "check indexing operations"},
        #{value: "list-item", desc: "check list items in a list expression [item, ...]"},
        #{value: "literal-required", desc: "check that value is a literal"},
        #{value: "maybe-unrecognized-str-typeform", desc: "error when a string is used where a TypeForm is expected but a string annotation cannot be recognized"},
        #{value: "metaclass", desc: "ensure that metaclass is valid"},
        #{value: "method-assign", desc: "check that assignment target is not a method"},
        #{value: "misc", desc: "miscellaneous other checks"},
        #{value: "mutable-override", desc: "reject covariant overrides for mutable attributes"},
        #{value: "name-defined", desc: "check that name is defined"},
        #{value: "name-match", desc: "check that type definition has consistent naming"},
        #{value: "narrowed-type-not-subtype", desc: "warn if a TypeIs function's narrowed type is not a subtype of the original type"},
        #{value: "no-any-return", desc: "reject returning value with 'Any' type if return type is not 'Any'"},
        #{value: "no-any-unimported", desc: "reject 'Any' types from unfollowed imports"},
        #{value: "no-overload-impl", desc: "check that overloaded functions outside stub files have an implementation"},
        #{value: "no-redef", desc: "check that each name is defined once"},
        #{value: "no-untyped-call", desc: "disallow calling functions without type annotations from annotated functions"},
        #{value: "no-untyped-def", desc: "check that every function has an annotation"},
        #{value: "nonetype-type", desc: "check that type (annotation) is not NoneType"},
        #{value: "operator", desc: "check that operator is valid for operands"},
        #{value: "overload-cannot-match", desc: "warn if an @overload signature can never be matched"},
        #{value: "overload-overlap", desc: "warn if multiple @overload variants overlap in unsafe ways"},
        #{value: "override", desc: "check that method override is compatible with base class"},
        #{value: "possibly-undefined", desc: "warn about variables that are defined only in some execution paths"},
        #{value: "prop-decorator", desc: "decorators on top of @property are not supported"},
        #{value: "redundant-cast", desc: "check that cast changes type of expression"},
        #{value: "redundant-expr", desc: "warn about redundant expressions"},
        #{value: "redundant-self", desc: "warn about redundant Self type annotations on method first argument"},
        #{value: "return", desc: "check that function always returns a value"},
        #{value: "return-value", desc: "check that return value is compatible with signature"},
        #{value: "safe-super", desc: "warn about calls to abstract methods with empty/trivial bodies"},
        #{value: "str-bytes-safe", desc: "warn about implicit coercions related to bytes and string types"},
        #{value: "str-format", desc: "check that string formatting/interpolation is type-safe"},
        #{value: "str-unpack", desc: "warn about expressions that unpack str"},
        #{value: "syntax", desc: "report syntax errors"},
        #{value: "top-level-await", desc: "warn about top level await expressions"},
        #{value: "truthy-bool", desc: "warn about expressions that could always evaluate to true in boolean contexts"},
        #{value: "truthy-function", desc: "warn about function that always evaluate to true in boolean contexts"},
        #{value: "truthy-iterable", desc: "warn about Iterable expressions that could always evaluate to true in boolean contexts"},
        #{value: "type-abstract", desc: "require only concrete classes where Type[...] is expected"},
        #{value: "type-arg", desc: "check that generic type arguments are present"},
        #{value: "type-var", desc: "check that type variable values are valid"},
        #{value: "typeddict-item", desc: "check items when constructing TypedDict"},
        #{value: "typeddict-readonly-mutated", desc: "typedDict's ReadOnly key is mutated"},
        #{value: "typeddict-unknown-key", desc: "check unknown keys when constructing TypedDict"},
        #{value: "unimported-reveal", desc: "require explicit import from typing or typing_extensions for reveal_type"},
        #{value: "union-attr", desc: "check that attribute exists in each item of a union"},
        #{value: "unreachable", desc: "warn about unreachable statements or expressions"},
        #{value: "untyped-decorator", desc: "error if an untyped decorator makes a typed function untyped"},
        #{value: "unused-awaitable", desc: "ensure that all awaitable values are used"},
        #{value: "unused-coroutine", desc: "ensure that all coroutines are used"},
        #{value: "unused-ignore", desc: "ensure that all type ignores are used"},
        #{value: "used-before-def", desc: "warn about variables that are used before they are defined"},
        #{value: "valid-newtype", desc: "check that argument 2 to NewType is valid"},
        #{value: "valid-type", desc: "check that type (annotation) is valid"},
        #{value: "var-annotated", desc: "require variable annotation if type can't be inferred"},
    ]
}

fn kind(name, cur, words) {
    switch name {
        "error_codes" => error_codes(),
        _ => throw `unknown kind: ${name}`,
    }
}
