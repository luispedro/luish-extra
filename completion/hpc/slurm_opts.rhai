// Slurm 26.05.5, generated by scripts/gen/mk_slurm.py from its source: the options of sbatch, salloc and srun from
// the table of src/common/slurm_opt.c, those of the other commands from their getopt tables, the descriptions from
// `--help` or the man pages, and the states and fields from the man pages and the source. The kinds are
// slurm.rhai's.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn k(name) { own("slurm:") + name }

// The options of a command.
fn spec(cmd) {
    switch cmd {
        "sbatch" => #{
            opts: `
                -A, --account=ACCOUNT            charge job to specified account
                --acctg-freq=LIST                define the job accounting and profiling sampling intervals in seconds
                -a, --array=INDEXES              job array index values
                --batch=LIST                     features that the node of the batch script must have
                --bb=SPEC                        burst buffer specifications
                --bbf=FILE_NAME                  burst buffer specification file
                -b, --begin=TIME                 defer job until HH:MM MM/DD/YY
                -D, --chdir=DIRECTORY            set working directory for batch script
                --cluster-constraint=LIST        specify a list of cluster constraints
                -M, --clusters=CLUSTERS          comma separated list of clusters to issue commands to
                --comment=STRING                 arbitrary comment
                --consolidate-segments           consolidate the segments of the allocation into one higher-level block
                -C, --constraint=LIST            specify a list of constraints
                --container=PATH_TO_CONTAINER    container path
                --container-id=CONTAINER_ID      container identifier
                --container-type=CONTAINER_TYPE  container type
                --contiguous                     demand a contiguous range of nodes
                -S, --core-spec=NUM              count of reserved cores
                --cores-per-socket=CORES         number of cores per socket to allocate
                --cpu-freq=FREQ                  requested cpu frequency (and governor)
                --cpus-per-gpu=NCPUS             number of CPUs required per allocated GPU
                -c, --cpus-per-task=NCPUS        number of cpus required per task
                --deadline=TIME                  remove the job if it can't end before this time
                --delay-boot=MINUTES             delay boot for desired node features
                -d, --dependency=TYPE:JOBID      defer job until condition on jobid is satisfied
                -m, --distribution=TYPE          how to distribute the tasks over the nodes
                -e, --error=FILENAME_PATTERN     file for batch script's standard error
                -x, --exclude=NODES              exclude a specific list of hosts
                --exclusive[=MODE]               allocate nodes exclusively
                --export=VARS                    specify environment variables to export
                --export-file=FILENAME           specify environment variables file or file descriptor to export
                --extra=STRING                   arbitrary string
                -B, --extra-node-info=S[:C[:T]]  sockets per node, cores per socket and threads per core
                --get-user-env                   load environment from local cluster
                --gid=GROUP                      group ID to run job as (user root only)
                --gpu-bind=TYPE                  task to gpu binding options
                --gpu-freq=SPEC                  frequency and voltage of GPUs
                -G, --gpus=NUMBER                count of GPUs required for the job
                --gpus-per-node=NUMBER           number of GPUs required per allocated node
                --gpus-per-socket=NUMBER         number of GPUs required per allocated socket
                --gpus-per-task=NUMBER           number of GPUs required per spawned task
                --gres=LIST                      required generic resources per node
                --gres-flags=TYPE                flags related to GRES management
                -h, --help                       show this help message
                --hint=TYPE                      bind tasks according to application hints
                -H, --hold                       submit job in held state
                --ignore-pbs                     ignore #PBS and #BSUB options in the batch script
                -i, --input=FILENAME_PATTERN     file for batch script's standard input
                -J, --job-name=JOBNAME           name of job
                --kill-on-invalid-dep=YES|NO     end the job if its dependency can never be satisfied
                -L, --licenses=LICENSES          required license, comma separated
                --mail-type=TYPE                 notify on state change: BEGIN, END, FAIL or ALL
                --mail-user=USER                 who to send email notification for job state changes
                --mcs-label=MCS                  mcs label if mcs plugin mcs/group is used
                --mem=SIZE                       minimum amount of real memory
                --mem-bind=TYPE                  bind memory to locality domains
                --mem-per-cpu=SIZE               maximum amount of real memory per allocated cpu required by the job
                --mem-per-gpu=SIZE               real memory required per allocated GPU
                --mem-update=MARGIN              reduce the job's memory limit after it has run for a time
                --mincpus=N                      minimum number of logical processors (threads) per node
                --network=TYPE                   specify information pertaining to the switch or network
                --nice[=ADJUSTMENT]              decrease scheduling priority by value
                -k, --no-kill[=OFF]              do not kill job on node failure
                --no-requeue                     if set, do not permit the job to be requeued
                -F, --nodefile=NODE_FILE         request a specific list of hosts
                -w, --nodelist=NODES             request a specific list of hosts
                -N, --nodes=MIN[-MAX]            number of nodes on which to run (N = min[-max])
                -n, --ntasks=NUMBER              number of tasks to run
                --ntasks-per-core=NTASKS         number of tasks to invoke on each core
                --ntasks-per-gpu=NTASKS          number of tasks to invoke for each GPU
                --ntasks-per-node=NTASKS         number of tasks to invoke on each node
                --ntasks-per-socket=NTASKS       number of tasks to invoke on each socket
                --oom-kill-step[=VALUE]          set the OOMKillStep behaviour
                --open-mode=append|truncate      append to the output and error files or truncate them
                -o, --output=FILENAME_PATTERN    file for batch script's standard output
                -O, --overcommit                 overcommit resources
                -s, --oversubscribe              over subscribe resources with other jobs
                --parsable                       print only the job ID and cluster name
                -p, --partition=PARTITION        partition requested
                --prefer=LIST                    features to prefer
                --priority=VALUE                 set the priority of the job to value
                --profile=TYPE                   the profiling data to gather
                --propagate[=RLIMIT]             propagate all [or specific list of] rlimits
                -q, --qos=QOS                    quality of service
                -Q, --quiet                      quiet mode (suppress informational messages)
                --reboot                         reboot compute nodes before starting job
                --requeue[=EXPEDITE]             if set, permit the job to be requeued
                --reservation=RESERVATION_NAMES  allocate resources from named reservation
                --resources=RESOURCE_NAMES       hierarchical resources to allocate
                --resv-ports[=COUNT]             reserve communication ports
                --segment=SEGMENT_SIZE           size of the segments of a block or ring topology
                --signal=[R|B:]SIG[@TIME]        send signal when time limit within time seconds
                --sockets-per-node=SOCKETS       number of sockets per node to allocate
                --spread-job                     spread job across as many nodes as possible
                --spread-segments                spread job segments across separate base blocks
                --stepmgr                        enable the management of steps by slurmstepd
                --switches=COUNT[@TIME]          optimum switches and max time to wait for optimum
                --test-only                      estimate when the job would start, without submitting it
                --thread-spec=NUM                count of reserved threads
                --threads-per-core=THREADS       number of threads per core to allocate
                -t, --time=TIME                  time limit
                --time-min=TIME                  minimum time limit (if distinct)
                --tmp=SIZE                       minimum amount of temporary disk
                --tres-bind=TRES                 task to tres binding options
                --tres-per-task=LIST             list of tres required per task
                --uid=USER                       user ID to run job as (user root only)
                --usage                          display brief usage message
                --use-min-nodes                  if a range of node counts is given, prefer the smaller count
                -v, --verbose                    verbose mode (multiple -v's increase verbosity)
                -V, --version                    output version information and exit
                -W, --wait                       wait for the job to end
                --wait-all-nodes=0|1             wait for all nodes to be ready
                --wckey=WCKEY                    wckey to run job under
                --wrap=COMMAND_STRING            wrap command string in a sh script and submit
            `,
            values: #{
                "-A": k("accounts"), "--account": k("accounts"), "--acctg-freq": "none", "-a": "none",
                "--array": "none", "--batch": k("features"), "--bb": "none", "--bbf": "files",
                "-b": ["now", "today", "tomorrow", "midnight", "noon", "teatime"],
                "--begin": ["now", "today", "tomorrow", "midnight", "noon", "teatime"], "-D": "dirs",
                "--chdir": "dirs", "--cluster-constraint": "none", "-M": k("clusters"),
                "--clusters": k("clusters"), "--comment": "none", "-C": k("features"),
                "--constraint": k("features"), "--container": "dirs", "--container-id": "none",
                "--container-type": "none", "-S": "none", "--core-spec": "none", "--cores-per-socket": "none",
                "--cpu-freq": [
                    "low", "medium", "high", "highm1", "Conservative", "OnDemand", "Performance", "PowerSave",
                    "SchedUtil", "UserSpace",
                ],
                "--cpus-per-gpu": "none", "-c": "none", "--cpus-per-task": "none", "--deadline": "none",
                "--delay-boot": "none", "-d": k("dependency"), "--dependency": k("dependency"),
                "-m": ["block", "cyclic", "plane=", "arbitrary"],
                "--distribution": ["block", "cyclic", "plane=", "arbitrary"], "-e": "files", "--error": "files",
                "-x": k("nodes"), "--exclude": k("nodes"), "--exclusive": ["user", "mcs", "topo"],
                "--export": k("list:export"), "--export-file": "files", "--extra": "none", "-B": "none",
                "--extra-node-info": "none", "--gid": "groups", "--gpu-bind": "none", "--gpu-freq": "none",
                "-G": "none", "--gpus": "none", "--gpus-per-node": "none", "--gpus-per-socket": "none",
                "--gpus-per-task": "none", "--gres": k("gres"),
                "--gres-flags": [
                    "allow-task-sharing", "disable-binding", "enforce-binding", "multiple-tasks-per-sharing",
                    "one-task-per-sharing",
                ],
                "--hint": ["compute_bound", "memory_bound", "multithread", "nomultithread", "help"], "-i": "files",
                "--input": "files", "-J": "none", "--job-name": "none", "--kill-on-invalid-dep": ["yes", "no"],
                "-L": k("licenses"), "--licenses": k("licenses"), "--mail-type": k("list:mail_types"),
                "--mail-user": "users", "--mcs-label": "none", "--mem": "none", "--mem-bind": k("list:mem_bind"),
                "--mem-per-cpu": "none", "--mem-per-gpu": "none", "--mem-update": "none", "--mincpus": "none",
                "--network": "none", "--nice": "none", "-k": ["off"], "--no-kill": ["off"], "-F": "files",
                "--nodefile": "files", "-w": k("nodes"), "--nodelist": k("nodes"), "-N": "none", "--nodes": "none",
                "-n": "none", "--ntasks": "none", "--ntasks-per-core": "none", "--ntasks-per-gpu": "none",
                "--ntasks-per-node": "none", "--ntasks-per-socket": "none", "--oom-kill-step": ["0", "1"],
                "--open-mode": ["append", "truncate"], "-o": "files", "--output": "files", "-p": k("partitions"),
                "--partition": k("partitions"), "--prefer": k("features"), "--priority": ["TOP"],
                "--profile": k("list:profile"), "--propagate": k("list:rlimits"), "-q": k("qos"),
                "--qos": k("qos"), "--requeue": ["expedite"], "--reservation": k("reservations"),
                "--resources": "none", "--resv-ports": "none", "--segment": "none", "--signal": "none",
                "--sockets-per-node": "none", "--switches": "none", "--thread-spec": "none",
                "--threads-per-core": "none", "-t": "none", "--time": "none", "--time-min": "none",
                "--tmp": "none", "--tres-bind": "none", "--tres-per-task": "none", "--uid": "users",
                "--wait-all-nodes": ["0", "1"], "--wckey": "none", "--wrap": "none",
            },
        },
        "salloc" => #{
            opts: `
                -A, --account=ACCOUNT            charge job to specified account
                --acctg-freq=LIST                define the job accounting and profiling sampling intervals in seconds
                --bb=SPEC                        burst buffer specifications
                --bbf=FILE_NAME                  burst buffer specification file
                --begin=TIME                     defer job until HH:MM MM/DD/YY
                --bell                           ring the terminal bell when the job is allocated
                -D, --chdir=PATH                 change working directory
                --cluster-constraint=LIST        specify a list of cluster constraints
                -M, --clusters=CLUSTERS          comma separated list of clusters to issue commands to
                --comment=STRING                 arbitrary comment
                --consolidate-segments           consolidate the segments of the allocation into one higher-level block
                -C, --constraint=LIST            specify a list of constraints
                --container=PATH_TO_CONTAINER    container path
                --container-id=CONTAINER_ID      container identifier
                --container-type=CONTAINER_TYPE  container type
                --contiguous                     demand a contiguous range of nodes
                -S, --core-spec=NUM              count of reserved cores
                --cores-per-socket=CORES         number of cores per socket to allocate
                --cpu-freq=FREQ                  requested cpu frequency (and governor)
                --cpus-per-gpu=NCPUS             number of CPUs required per allocated GPU
                -c, --cpus-per-task=NCPUS        number of cpus required per task
                --deadline=TIME                  remove the job if it can't end before this time
                --delay-boot=MINUTES             delay boot for desired node features
                -d, --dependency=TYPE:JOBID      defer job until condition on jobid is satisfied
                -m, --distribution=TYPE          how to distribute the tasks over the nodes
                -x, --exclude=NODES              exclude a specific list of hosts
                --exclusive[=MODE]               allocate nodes exclusively
                --extra=STRING                   arbitrary string
                -B, --extra-node-info=S[:C[:T]]  sockets per node, cores per socket and threads per core
                --gpu-bind=TYPE                  task to gpu binding options
                --gpu-freq=SPEC                  frequency and voltage of GPUs
                -G, --gpus=NUMBER                count of GPUs required for the job
                --gpus-per-node=NUMBER           number of GPUs required per allocated node
                --gpus-per-socket=NUMBER         number of GPUs required per allocated socket
                --gpus-per-task=NUMBER           number of GPUs required per spawned task
                --gres=LIST                      required generic resources per node
                --gres-flags=TYPE                flags related to GRES management
                -h, --help                       show this help message
                --hint=TYPE                      bind tasks according to application hints
                -H, --hold                       submit job in held state
                -I, --immediate[=SECONDS]        exit if resources not available in "secs"
                -J, --job-name=JOBNAME           name of job
                -K, --kill-command[=SIGNAL]      signal to send terminating job
                -L, --licenses=LICENSES          required license, comma separated
                --mail-type=TYPE                 notify on state change: BEGIN, END, FAIL or ALL
                --mail-user=USER                 who to send email notification for job state changes
                --mcs-label=MCS                  mcs label if mcs plugin mcs/group is used
                --mem=SIZE                       minimum amount of real memory
                --mem-bind=TYPE                  bind memory to locality domains
                --mem-per-cpu=SIZE               maximum amount of real memory per allocated cpu required by the job
                --mem-per-gpu=SIZE               real memory required per allocated GPU
                --mem-update=MARGIN              reduce the job's memory limit after it has run for a time
                --mincpus=N                      minimum number of logical processors (threads) per node
                --network=TYPE                   specify information pertaining to the switch or network
                --nice[=ADJUSTMENT]              decrease scheduling priority by value
                --no-bell                        do NOT ring the terminal bell
                -k, --no-kill[=OFF]              do not kill job on node failure
                --no-shell                       immediately exit after allocating resources, without running a command
                -F, --nodefile=NODE_FILE         request a specific list of hosts
                -w, --nodelist=NODES             request a specific list of hosts
                -N, --nodes=MIN[-MAX]            number of nodes on which to run (N = min[-max])
                -n, --ntasks=NUMBER              number of processors required
                --ntasks-per-core=NTASKS         number of tasks to invoke on each core
                --ntasks-per-gpu=NTASKS          number of tasks to invoke for each GPU
                --ntasks-per-node=NTASKS         number of tasks to invoke on each node
                --ntasks-per-socket=NTASKS       number of tasks to invoke on each socket
                --oom-kill-step[=VALUE]          set the OOMKillStep behaviour
                -O, --overcommit                 overcommit resources
                -s, --oversubscribe              oversubscribe resources with other jobs
                -p, --partition=PARTITION        partition requested
                --prefer=LIST                    features to prefer
                --priority=VALUE                 set the priority of the job to value
                --profile=TYPE                   the profiling data to gather
                -q, --qos=QOS                    quality of service
                -Q, --quiet                      quiet mode (suppress informational messages)
                --reboot                         reboot compute nodes before starting job
                --reservation=RESERVATION_NAMES  allocate resources from named reservation
                --resources=RESOURCE_NAMES       hierarchical resources to allocate
                --resv-ports[=COUNT]             reserve communication ports
                --segment=SEGMENT_SIZE           size of the segments of a block or ring topology
                --signal=[R|B:]SIG[@TIME]        send signal when time limit within time seconds
                --sockets-per-node=SOCKETS       number of sockets per node to allocate
                --spread-job                     spread job across as many nodes as possible
                --spread-segments                spread job segments across separate base blocks
                --stepmgr                        enable the management of steps by slurmstepd
                --switches=COUNT[@TIME]          optimum switches and max time to wait for optimum
                --thread-spec=NUM                count of reserved threads
                --threads-per-core=THREADS       number of threads per core to allocate
                -t, --time=TIME                  time limit
                --time-min=TIME                  minimum time limit (if distinct)
                --tmp=SIZE                       minimum amount of temporary disk
                --tres-bind=TRES                 task to tres binding options
                --tres-per-task=LIST             list of tres required per task
                --usage                          display brief usage message
                --use-min-nodes                  if a range of node counts is given, prefer the smaller count
                -v, --verbose                    verbose mode (multiple -v's increase verbosity)
                -V, --version                    output version information and exit
                --wait-all-nodes=0|1             wait for all nodes to be ready
                --wckey=WCKEY                    wckey to run job under
                --x11[=TARGET]                   forward X11 to the nodes
            `,
            values: #{
                "-A": k("accounts"), "--account": k("accounts"), "--acctg-freq": "none", "--bb": "none",
                "--bbf": "files", "--begin": ["now", "today", "tomorrow", "midnight", "noon", "teatime"],
                "-D": "dirs", "--chdir": "dirs", "--cluster-constraint": "none", "-M": k("clusters"),
                "--clusters": k("clusters"), "--comment": "none", "-C": k("features"),
                "--constraint": k("features"), "--container": "dirs", "--container-id": "none",
                "--container-type": "none", "-S": "none", "--core-spec": "none", "--cores-per-socket": "none",
                "--cpu-freq": [
                    "low", "medium", "high", "highm1", "Conservative", "OnDemand", "Performance", "PowerSave",
                    "SchedUtil", "UserSpace",
                ],
                "--cpus-per-gpu": "none", "-c": "none", "--cpus-per-task": "none", "--deadline": "none",
                "--delay-boot": "none", "-d": k("dependency"), "--dependency": k("dependency"),
                "-m": ["block", "cyclic", "plane=", "arbitrary"],
                "--distribution": ["block", "cyclic", "plane=", "arbitrary"], "-x": k("nodes"),
                "--exclude": k("nodes"), "--exclusive": ["user", "mcs", "topo"], "--extra": "none", "-B": "none",
                "--extra-node-info": "none", "--gpu-bind": "none", "--gpu-freq": "none", "-G": "none",
                "--gpus": "none", "--gpus-per-node": "none", "--gpus-per-socket": "none",
                "--gpus-per-task": "none", "--gres": k("gres"),
                "--gres-flags": [
                    "allow-task-sharing", "disable-binding", "enforce-binding", "multiple-tasks-per-sharing",
                    "one-task-per-sharing",
                ],
                "--hint": ["compute_bound", "memory_bound", "multithread", "nomultithread", "help"], "-I": "none",
                "--immediate": "none", "-J": "none", "--job-name": "none", "-K": "signals",
                "--kill-command": "signals", "-L": k("licenses"), "--licenses": k("licenses"),
                "--mail-type": k("list:mail_types"), "--mail-user": "users", "--mcs-label": "none",
                "--mem": "none", "--mem-bind": k("list:mem_bind"), "--mem-per-cpu": "none",
                "--mem-per-gpu": "none", "--mem-update": "none", "--mincpus": "none", "--network": "none",
                "--nice": "none", "-k": ["off"], "--no-kill": ["off"], "-F": "files", "--nodefile": "files",
                "-w": k("nodes"), "--nodelist": k("nodes"), "-N": "none", "--nodes": "none", "-n": "none",
                "--ntasks": "none", "--ntasks-per-core": "none", "--ntasks-per-gpu": "none",
                "--ntasks-per-node": "none", "--ntasks-per-socket": "none", "--oom-kill-step": ["0", "1"],
                "-p": k("partitions"), "--partition": k("partitions"), "--prefer": k("features"),
                "--priority": ["TOP"], "--profile": k("list:profile"), "-q": k("qos"), "--qos": k("qos"),
                "--reservation": k("reservations"), "--resources": "none", "--resv-ports": "none",
                "--segment": "none", "--signal": "none", "--sockets-per-node": "none", "--switches": "none",
                "--thread-spec": "none", "--threads-per-core": "none", "-t": "none", "--time": "none",
                "--time-min": "none", "--tmp": "none", "--tres-bind": "none", "--tres-per-task": "none",
                "--wait-all-nodes": ["0", "1"], "--wckey": "none", "--x11": ["all", "batch", "first", "last"],
            },
        },
        "srun" => #{
            opts: `
                -A, --account=ACCOUNT            charge job to specified account
                --acctg-freq=LIST                accounting and profiling sampling intervals
                --async                          create async step
                --bb=SPEC                        burst buffer specifications
                --bbf=FILE_NAME                  burst buffer specification file
                --bcast[=DEST]                   copy executable file to compute nodes
                --bcast-exclude=EXCLUDE_PATH     shared object directory paths to exclude
                -b, --begin=TIME                 defer job until HH:MM MM/DD/YY
                -D, --chdir=PATH                 change remote current working directory
                --cluster-constraint=LIST        specify a list of cluster-constraints
                -M, --clusters=CLUSTERS          comma separated list of clusters to issue commands to
                --comment=STRING                 arbitrary comment
                --compress[=TYPE]                data compression library used with --bcast
                --consolidate-segments           consolidate the segments of the allocation into one higher-level block
                -C, --constraint=LIST            specify a list of constraints
                --container=PATH_TO_CONTAINER    container path
                --container-id=CONTAINER_ID      container identifier
                --container-type=CONTAINER_TYPE  container type
                --contiguous                     demand a contiguous range of nodes
                -S, --core-spec=NUM              count of reserved cores
                --cores-per-socket=CORES         number of cores per socket to allocate
                --cpu-bind=TYPE                  bind tasks to CPUs
                --cpu-freq=FREQ                  requested cpu frequency (and governor)
                --cpus-per-gpu=NCPUS             number of CPUs required per allocated GPU
                -c, --cpus-per-task=NCPUS        number of cpus required per task
                --deadline=TIME                  remove the job if it can't end before this time
                --delay-boot=MINUTES             delay boot for desired node features
                -d, --dependency=TYPE:JOBID      defer job until condition on jobid is satisfied
                -X, --disable-status             disable Ctrl-C status feature
                -m, --distribution=TYPE          how to distribute the tasks over the nodes
                --epilog=EXECUTABLE              run "program" after launching job step
                -e, --error=FILENAME_PATTERN     location of stderr redirection
                --exact                          use only the resources requested for the step
                -x, --exclude=NODES              exclude a specific list of hosts
                --exclusive[=MODE]               allocate nodes exclusively
                --export=VARS                    environment variables to pass to the tasks
                --external-launcher[=VALUE]      create a step that uses no resources, for an external launcher
                --extra=STRING                   arbitrary string
                -B, --extra-node-info=S[:C[:T]]  sockets per node, cores per socket and threads per core
                --gpu-bind=TYPE                  task to gpu binding options
                --gpu-freq=SPEC                  frequency and voltage of GPUs
                -G, --gpus=NUMBER                count of GPUs required for the job
                --gpus-per-node=NUMBER           number of GPUs required per allocated node
                --gpus-per-socket=NUMBER         number of GPUs required per allocated socket
                --gpus-per-task=NUMBER           number of GPUs required per spawned task
                --gres=LIST                      required generic resources per node
                --gres-flags=TYPE                flags related to GRES management
                -h, --help                       show this help message
                --het-group=EXPR                 hetjob component allocation(s) in which to launch application
                --hint=TYPE                      bind tasks according to application hints (see "--hint=help" for options)
                -H, --hold                       submit job in held state
                --ignore-signals=SIGNALS_LIST    prevent forwarding of specified signals
                -I, --immediate[=SECONDS]        exit if resources not available in "secs"
                -i, --input=MODE                 location of stdin redirection
                -J, --job-name=JOBNAME           name of job
                --jobid=JOBID                    run under already allocated job
                -K, --kill-on-bad-exit[=0|1]     kill the job if any task terminates with a non-zero exit code
                -l, --label                      prepend task number to lines of stdout/err
                -L, --licenses=LICENSES          required license, comma separated
                --mail-type=TYPE                 notify on state change: BEGIN, END, FAIL or ALL
                --mail-user=USER                 who to send email notification for job state changes
                --mcs-label=MCS                  mcs label if mcs plugin mcs/group is used
                --mem=SIZE                       minimum amount of real memory
                --mem-bind=TYPE                  bind memory to locality domains
                --mem-per-cpu=SIZE               maximum amount of real memory per allocated cpu required by the job
                --mem-per-gpu=SIZE               real memory required per allocated GPU
                --mem-update=MARGIN              reduce the job's memory limit after it has run for a time
                --mincpus=N                      minimum number of logical processors (threads) per node
                --mpi=TYPE                       type of MPI being used
                --msg-timeout=SECONDS            modify the job launch message timeout
                --multi-prog                     the program is a file that configures a program for each task
                --network=TYPE                   specify information pertaining to the switch or network
                --nice[=ADJUSTMENT]              decrease scheduling priority by value
                -Z, --no-allocate                don't allocate nodes (must supply -w)
                -k, --no-kill[=OFF]              do not kill job on node failure
                -F, --nodefile=NODE_FILE         file of the nodes to use
                -w, --nodelist=NODES             request a specific list of hosts
                -N, --nodes=MIN[-MAX]            number of nodes on which to run (N = min[-max])
                -n, --ntasks=NUMBER              number of tasks to run
                --ntasks-per-core=NTASKS         number of tasks to invoke on each core
                --ntasks-per-gpu=NTASKS          number of tasks to invoke for each GPU
                --ntasks-per-node=NTASKS         number of tasks to invoke on each node
                --ntasks-per-socket=NTASKS       number of tasks to invoke on each socket
                --oom-kill-step[=VALUE]          set the OOMKillStep behaviour
                --open-mode=append|truncate      append to the output and error files or truncate them
                -o, --output=FILENAME_PATTERN    location of stdout redirection
                -O, --overcommit                 overcommit resources
                --overlap[=VALUE]                allow other steps to overlap this step
                -s, --oversubscribe              over-subscribe resources with other jobs
                --parsable                       print only the step ID (requires --async)
                -p, --partition=PARTITION        partition requested
                --prefer=LIST                    features to prefer
                -E, --preserve-env               env vars for node and task counts override command-line flags
                --priority=VALUE                 set the priority of the job to value
                --profile=TYPE                   the profiling data to gather
                --prolog=EXECUTABLE              run "program" before launching job step
                --propagate[=RLIMIT]             propagate all [or specific list of] rlimits
                --pty[=FILE_DESCRIPTOR]          run task zero in pseudo terminal [or in requested terminal given by fd]
                -q, --qos=QOS                    quality of service
                -Q, --quiet                      quiet mode (suppress informational messages)
                --quit-on-interrupt              quit on single Ctrl-C
                --reboot                         reboot block before starting job
                -r, --relative=N                 run job step relative to node n of allocation
                --reservation=RESERVATION_NAMES  allocate resources from named reservation
                --resources=RESOURCE_NAMES       hierarchical resources to allocate
                --resv-ports[=COUNT]             reserve communication ports
                --segment=SEGMENT_SIZE           size of the segments of a block or ring topology
                --send-libs[=YES|NO]             autodetect and broadcast shared objects
                --signal=[R|B:]SIG[@TIME]        send signal when time limit within time seconds
                --slurmd-debug=LEVEL             slurmd debug level
                --sockets-per-node=SOCKETS       number of sockets per node to allocate
                --spread-job                     spread job across as many nodes as possible
                --spread-segments                spread job segments across separate base blocks
                --stepmgr                        enable the management of steps by slurmstepd
                --switches=COUNT[@TIME]          optimum switches and max time to wait for optimum
                --task-epilog=EXECUTABLE         run "program" after launching task
                --task-prolog=EXECUTABLE         run "program" before launching task
                --test-only                      estimate when the job would start, without submitting it
                --thread-spec=NUM                count of reserved threads
                -T, --threads=N                  set srun launch fanout
                --threads-per-core=THREADS       number of threads per core to allocate
                -t, --time=TIME                  time limit
                --time-min=TIME                  minimum time limit (if distinct)
                --tmp=SIZE                       minimum amount of temporary disk
                --treewidth=SIZE                 specify the width of the fanout
                --tres-bind=TRES                 task to tres binding options
                --tres-per-task=LIST             list of tres required per task
                -u, --unbuffered                 do not line-buffer stdout/err
                --usage                          display brief usage message
                --use-min-nodes                  if a range of node counts is given, prefer the smaller count
                -v, --verbose                    verbose mode (multiple -v's increase verbosity)
                -V, --version                    output version information and exit
                --wait-for-children              wait for the children of a task to end before the task ends
                -W, --wait=SECONDS               seconds to wait after first task exits before killing job
                --wckey=WCKEY                    wckey to run job under
                --x11[=TARGET]                   forward X11 to the nodes
            `,
            values: #{
                "-A": k("accounts"), "--account": k("accounts"), "--acctg-freq": "none", "--bb": "none",
                "--bbf": "files", "--bcast": "files", "--bcast-exclude": "dirs",
                "-b": ["now", "today", "tomorrow", "midnight", "noon", "teatime"],
                "--begin": ["now", "today", "tomorrow", "midnight", "noon", "teatime"], "-D": "dirs",
                "--chdir": "dirs", "--cluster-constraint": "none", "-M": k("clusters"),
                "--clusters": k("clusters"), "--comment": "none", "--compress": ["lz4", "zlib", "none"],
                "-C": k("features"), "--constraint": k("features"), "--container": "dirs",
                "--container-id": "none", "--container-type": "none", "-S": "none", "--core-spec": "none",
                "--cores-per-socket": "none", "--cpu-bind": k("list:cpu_bind"),
                "--cpu-freq": [
                    "low", "medium", "high", "highm1", "Conservative", "OnDemand", "Performance", "PowerSave",
                    "SchedUtil", "UserSpace",
                ],
                "--cpus-per-gpu": "none", "-c": "none", "--cpus-per-task": "none", "--deadline": "none",
                "--delay-boot": "none", "-d": k("dependency"), "--dependency": k("dependency"),
                "-m": ["block", "cyclic", "plane=", "arbitrary"],
                "--distribution": ["block", "cyclic", "plane=", "arbitrary"], "--epilog": "files", "-e": "files",
                "--error": "files", "-x": k("nodes"), "--exclude": k("nodes"),
                "--exclusive": ["user", "mcs", "topo"], "--export": k("list:export"),
                "--external-launcher": "none", "--extra": "none", "-B": "none", "--extra-node-info": "none",
                "--gpu-bind": "none", "--gpu-freq": "none", "-G": "none", "--gpus": "none",
                "--gpus-per-node": "none", "--gpus-per-socket": "none", "--gpus-per-task": "none",
                "--gres": k("gres"),
                "--gres-flags": [
                    "allow-task-sharing", "disable-binding", "enforce-binding", "multiple-tasks-per-sharing",
                    "one-task-per-sharing",
                ],
                "--het-group": "none",
                "--hint": ["compute_bound", "memory_bound", "multithread", "nomultithread", "help"],
                "--ignore-signals": "none", "-I": "none", "--immediate": "none", "-i": "files", "--input": "files",
                "-J": "none", "--job-name": "none", "--jobid": k("jobs"), "-K": ["0", "1"],
                "--kill-on-bad-exit": ["0", "1"], "-L": k("licenses"), "--licenses": k("licenses"),
                "--mail-type": k("list:mail_types"), "--mail-user": "users", "--mcs-label": "none",
                "--mem": "none", "--mem-bind": k("list:mem_bind"), "--mem-per-cpu": "none",
                "--mem-per-gpu": "none", "--mem-update": "none", "--mincpus": "none",
                "--mpi": ["list", "none", "pmi2", "pmix", "cray_shasta"], "--msg-timeout": "none",
                "--network": "none", "--nice": "none", "-k": ["off"], "--no-kill": ["off"], "-F": "files",
                "--nodefile": "files", "-w": k("nodes"), "--nodelist": k("nodes"), "-N": "none", "--nodes": "none",
                "-n": "none", "--ntasks": "none", "--ntasks-per-core": "none", "--ntasks-per-gpu": "none",
                "--ntasks-per-node": "none", "--ntasks-per-socket": "none", "--oom-kill-step": ["0", "1"],
                "--open-mode": ["append", "truncate"], "-o": "files", "--output": "files", "--overlap": ["force"],
                "-p": k("partitions"), "--partition": k("partitions"), "--prefer": k("features"),
                "--priority": ["TOP"], "--profile": k("list:profile"), "--prolog": "files",
                "--propagate": k("list:rlimits"), "--pty": "none", "-q": k("qos"), "--qos": k("qos"), "-r": "none",
                "--relative": "none", "--reservation": k("reservations"), "--resources": "none",
                "--resv-ports": "none", "--segment": "none", "--send-libs": ["yes", "no"], "--signal": "none",
                "--slurmd-debug": [
                    "quiet", "fatal", "error", "info", "verbose", "debug", "debug2", "debug3", "debug4", "debug5",
                ],
                "--sockets-per-node": "none", "--switches": "none", "--task-epilog": "files",
                "--task-prolog": "files", "--thread-spec": "none", "-T": "none", "--threads": "none",
                "--threads-per-core": "none", "-t": "none", "--time": "none", "--time-min": "none",
                "--tmp": "none", "--treewidth": "none", "--tres-bind": "none", "--tres-per-task": "none",
                "-W": "none", "--wait": "none", "--wckey": "none", "--x11": ["all", "batch", "first", "last"],
            },
        },
        "squeue" => #{
            opts: `
                -A, --accounts=ACCOUNT_LIST         comma separated list of accounts to view, default is all accounts
                -a, --all                           display jobs in hidden partitions
                -r, --array                         display one job array element per line
                -M, --clusters=CLUSTERS             cluster to issue commands to
                --expand-patterns                   expand any filename patterns from in StdOut, StdErr and StdIn
                --federation                        report federated information if a member of one
                -o, --format=FORMAT                 format specification
                -l, --long                          long report
                -s, --steps[=VALUE]                 comma separated list of job steps to view, default is all
                -O, --Format=FIELDS                 format specification
                --help                              show this help message
                --hide                              do not display jobs in hidden partitions
                -i, --iterate=SECONDS               specify an iteration period
                -j, --jobs[=JOBS]                   comma separated list of job IDs to view
                --json[=PARSER]                     produce JSON output
                -L, --licenses=LICENSES             comma separated list of licenses to view
                --local                             report information only about jobs on the local cluster
                --me                                equivalent to --user=<my username>
                -n, --name=NAME_LIST                comma separated list of job names to view
                --noconvert                         don't convert units from their original type (e.g 2048M won't be converted to 2G)
                -w, --nodelist=NODES                list of nodes to view, default is all nodes
                -h, --noheader                      no headers on output
                --notme                             opposite of --me; only display jobs that are not from the invoking user
                --only-job-state                    only query job state
                -p, --partitions=PART_LIST          comma separated list of partitions to view, default is all partitions
                -P, --priority                      for pending jobs submitted to multiple partitions, list the job once per partition
                -q, --qos=QOS                       comma separated list of qos's to view, default is all qos's
                -R, --reservation=RESERVATION_LIST  comma separated list of reservations to view
                --running-over=TIME                 display only jobs that have been running over the specified time
                --running-under=TIME                display only jobs that have been running under the specified time
                --sibling                           report information about all sibling jobs on a federated cluster
                -S, --sort=SORT_LIST                comma separated list of fields to sort on
                --start                             print expected start times of pending jobs
                -t, --states=STATE_LIST             comma separated list of states to view, default is pending and running, '--states=all'
                --usage                             display a brief summary of squeue options
                -u, --user=USERS                    comma separated list of users to view
                -v, --verbose                       verbosity level
                -V, --version                       output version information and exit
                --yaml[=PARSER]                     produce YAML output
            `,
            values: #{
                "-A": k("accounts"), "--accounts": k("accounts"), "-M": k("clusters"), "--clusters": k("clusters"),
                "-o": "none", "--format": "none", "-s": "none", "--steps": "none", "-O": k("list:squeue_fields"),
                "--Format": k("list:squeue_fields"), "-i": "none", "--iterate": "none", "-j": k("jobs"),
                "--jobs": k("jobs"), "--json": "none", "-L": k("licenses"), "--licenses": k("licenses"),
                "-n": "none", "--name": "none", "-w": k("nodes"), "--nodelist": k("nodes"), "-p": k("partitions"),
                "--partitions": k("partitions"), "-q": k("qos"), "--qos": k("qos"), "-R": k("reservations"),
                "--reservation": k("reservations"), "--running-over": "none", "--running-under": "none",
                "-S": "none", "--sort": "none", "-t": k("list:job_states"), "--states": k("list:job_states"),
                "-u": k("users"), "--user": k("users"), "--yaml": "none",
            },
        },
        "scancel" => #{
            opts: `
                -A, --account=ACCOUNT               act only on jobs charging this account
                --admin-comment=COMMENT             set AdminComment on canceled jobs
                -b, --batch                         features that the node of the batch script must have
                -M, --clusters=CLUSTERS             clusters to issue commands to
                --ctld                              send request directly to slurmctld
                -c, --cron                          cancel an scrontab job
                -f, --full                          signal batch shell and all steps for specified job
                --help                              show this help message
                -H, --hurry                         avoid burst buffer stage out
                -i, --interactive                   require response from user for each job
                -n, --jobname, --name=JOB_NAME      act only on jobs with this name
                --me                                restrict the scancel operation to jobs owned by the current user
                -w, --nodelist=NODES                act only on jobs on these nodes
                -p, --partition=PARTITION           act only on jobs in this partition
                -q, --qos=QOS                       act only on jobs with this quality of service
                -Q, --quiet                         disable warnings
                -R, --reservation=RESERVATION_NAME  act only on jobs with this reservation
                --sibling=CLUSTER_NAME              remove an active sibling job from a federated job
                -s, --signal=[R|B:]SIG[@TIME]       signal to send to job, default is SIGKILL
                -t, --state=JOB_STATE_NAME          act only on jobs in this state
                --usage                             display brief usage message
                -u, --user=USERS                    act only on jobs of this user
                -v, --verbose                       verbosity level
                -V, --version                       output version information and exit
                --wckey=WCKEY                       act only on jobs with this workload charactization key
            `,
            values: #{
                "-A": k("accounts"), "--account": k("accounts"), "--admin-comment": "none", "-M": k("clusters"),
                "--clusters": k("clusters"), "-n": "none", "--jobname": "none", "--name": "none", "-w": k("nodes"),
                "--nodelist": k("nodes"), "-p": k("partitions"), "--partition": k("partitions"), "-q": k("qos"),
                "--qos": k("qos"), "-R": k("reservations"), "--reservation": k("reservations"),
                "--sibling": k("clusters"), "-s": "signals", "--signal": "signals", "-t": k("list:job_states"),
                "--state": k("list:job_states"), "-u": k("users"), "--user": k("users"), "--wckey": "none",
            },
        },
        "sinfo" => #{
            opts: `
                -a, --all                  show all partitions (including hidden and those not accessible)
                -M, --clusters=CLUSTERS    clusters to issue commands to
                -d, --dead                 show only nodes that are unexpectedly unresponsive
                -e, --exact                group nodes only on exact match of configuration
                --federation               report federated information if a member of one
                -F, --future               report information about nodes in \"FUTURE\" state
                -o, --format=FORMAT        format specification
                -O, --Format=FIELDS        long format specification
                --help                     show this help message
                --hide                     do not show hidden or non-accessible partitions
                -i, --iterate=SECONDS      specify an iteration period
                --json[=PARSER]            produce JSON output
                -R, --list-reasons         list reason nodes are down or drained
                --local                    show only local cluster in a federation
                -l, --long                 long output - displays more information
                --noconvert                don't convert units from their original type (e.g 2048M won't be converted to 2G)
                -N, --Node                 node-centric format
                -n, --nodes=NODES          report on specific node(s)
                -h, --noheader             no headers on output
                -p, --partition=PARTITION  report on specific partition
                -T, --reservation          show only reservation information
                -r, --responding           report only responding nodes (opposite of --dead)
                -S, --sort=SORT_LIST       comma separated list of fields to sort on
                -t, --states=STATES        specify the what states of nodes to view
                -s, --summarize            report state summary only
                --usage                    display brief usage message
                -v, --verbose              verbosity level
                -V, --version              output version information and exit
                --yaml[=PARSER]            produce YAML output
            `,
            values: #{
                "-M": k("clusters"), "--clusters": k("clusters"), "-o": "none", "--format": "none",
                "-O": k("list:sinfo_fields"), "--Format": k("list:sinfo_fields"), "-i": "none",
                "--iterate": "none", "--json": "none", "-n": k("nodes"), "--nodes": k("nodes"),
                "-p": k("partitions"), "--partition": k("partitions"), "-S": "none", "--sort": "none",
                "-t": k("list:node_states"), "--states": k("list:node_states"), "--yaml": "none",
            },
        },
        "sacct" => #{
            opts: `
                -A, --accounts=ACCOUNT_LIST        jobs of these accounts
                --array                            expand job arrays
                -L, --allclusters                  display jobs ran on all clusters
                -X, --allocations                  show the allocations, not their steps
                -a, --allusers                     display jobs for all users
                -x, --associations=ASSOC_LIST      jobs of these association IDs
                -B, --batch-script                 print batch script of job
                -b, --brief                        equivalent to '--format=jobstep,state,error'
                -M, --clusters=CLUSTERS            jobs of these clusters
                -c, --completion                   use job completion instead of accounting data
                -C, --constraints=CONSTRAINT_LIST  jobs that requested these features
                --delimiter=CHARACTERS             field separator of -p and -P
                -D, --duplicates                   show every record of a job ID, not only the most recent
                -E, --endtime=TIME                 select jobs eligible before this time
                --env-vars                         print the environment to launch the batch script of job
                --expand-patterns                  expand any filename patterns from in StdOut, StdErr and StdIn
                --federation                       report jobs from federation if a member of a one
                -f, --file=FILE                    read accounting data from this file
                -F, --flags=FLAG_LIST              jobs handled in these ways
                -o, --format=FIELDS                comma separated list of fields
                -g, --gid, --group=VALUE           jobs of these groups
                -h, --help                         print this description of use
                -e, --helpformat                   print a list of fields that can be specified with the '--format' option
                -j, --jobs=JOBS                    comma separated list of jobs (or job steps)
                --json[=PARSER]                    print JSON
                --local                            show only jobs local to this cluster
                -l, --long                         show many fields
                --name=JOBNAME_LIST                display jobs that have any of these name(s)
                -i, --nnodes=MIN[-MAX]             return jobs that ran on the specified number of nodes
                -I, --ncpus=MIN[-MAX]              return jobs that ran on the specified number of cpus
                --noconvert                        don't convert units from their original type (e.g 2048M won't be converted to 2G)
                -N, --nodelist=NODES               jobs that ran on these nodes
                -n, --noheader                     no header
                -p, --parsable                     output will be '|' delimited with a '|' at the end
                -P, --parsable2                    output will be '|' delimited without a '|' at the end
                -r, --partition=PARTITION          jobs in these partitions
                -q, --qos=QOS                      jobs with these QOS
                -R, --reason=REASON_LIST           jobs held for these reasons
                -S, --starttime=TIME               select jobs eligible after this time
                -s, --state=STATE_LIST             jobs in these states
                -K, --timelimit-max=TIME           maximum time limit, with --timelimit-min
                -k, --timelimit-min=TIME           jobs with this time limit (or more, with --timelimit-max)
                -T, --truncate                     truncate time
                -u, --uid, --user=VALUE            jobs of these users
                --units=K|M|G|T|P                  unit of the values
                --usage                            display brief usage message
                --use-local-uid                    show the UID of the local system
                -v, --verbose                      verbose mode
                -V, --version                      print version
                -W, --wckeys=WCKEY_LIST            jobs with these wckeys
                --whole-hetjob[=YES|NO]            show every component of a heterogeneous job
                --yaml[=PARSER]                    print YAML
            `,
            values: #{
                "-A": k("accounts"), "--accounts": k("accounts"), "-x": "none", "--associations": "none",
                "-M": k("clusters"), "--clusters": k("clusters"), "-C": k("features"),
                "--constraints": k("features"), "--delimiter": "none", "-E": ["now", "today"],
                "--endtime": ["now", "today"], "-f": "files", "--file": "files", "-F": k("list:sacct_flags"),
                "--flags": k("list:sacct_flags"), "-o": k("list:sacct_fields"), "--format": k("list:sacct_fields"),
                "-g": "groups", "--gid": "groups", "--group": "groups", "-j": k("past_jobs"),
                "--jobs": k("past_jobs"), "--json": "none", "--name": "none", "-i": "none", "--nnodes": "none",
                "-I": "none", "--ncpus": "none", "-N": k("nodes"), "--nodelist": k("nodes"), "-r": k("partitions"),
                "--partition": k("partitions"), "-q": k("qos"), "--qos": k("qos"), "-R": "none",
                "--reason": "none", "-S": ["now", "today", "midnight"],
                "--starttime": ["now", "today", "midnight"], "-s": k("list:job_states"),
                "--state": k("list:job_states"), "-K": "none", "--timelimit-max": "none", "-k": "none",
                "--timelimit-min": "none", "-u": k("users"), "--uid": k("users"), "--user": k("users"),
                "--units": ["K", "M", "G", "T", "P"], "-W": "none", "--wckeys": "none",
                "--whole-hetjob": ["yes", "no"], "--yaml": "none",
            },
        },
        _ => #{},
    }
}

// The fixed lists of values, for the kind `list:NAME`.
fn list(name) {
    switch name {
        "job_states" => [
            "BOOT_FAIL", "CANCELLED", "COMPLETED", "CONFIGURING", "COMPLETING", "DEADLINE", "FAILED", "NODE_FAIL",
            "OUT_OF_MEMORY", "PENDING", "PREEMPTED", "RUNNING", "RESV_DEL_HOLD", "REQUEUE_FED", "REQUEUE_HOLD",
            "REQUEUED", "RESIZING", "REVOKED", "SIGNALING", "SPECIAL_EXIT", "STAGE_OUT", "STOPPED", "SUSPENDED",
            "TIMEOUT", "all",
        ],
        "node_states" => [
            "allocated", "allocated+", "blocked", "completing", "down", "drained", "draining", "fail", "failing",
            "future", "idle", "inval", "maint", "reboot_issued", "reboot_requested", "mixed", "planned",
            "power_down", "powered_down", "powering_down", "powering_up", "reserved", "unknown", "all",
        ],
        "squeue_fields" => [
            "Account", "AccrueTime", "admin_comment", "AllocNodes", "AllocSID", "ArrayJobId", "ArrayTaskId",
            "AssocId", "BatchFlag", "BatchHost", "BoardsPerNode", "BurstBuffer", "BurstBufferState", "Cluster",
            "ClusterFeature", "Command", "Comment", "Container", "ContainerId", "Contiguous", "CoreSpec",
            "CPUsPerTask", "CronJob", "Deadline", "DelayBoot", "Dependency", "DerivedEC", "EligibleTime",
            "EndTime", "ExcNodes", "Exclusive", "exit_code", "Feature", "Gres", "GroupId", "GroupName", "HetJobId",
            "HetJobIdSet", "HetJobOffset", "JobArrayId", "JobId", "LastSchedEval", "Licenses", "LicensesAlloc",
            "MaxCPUs", "MaxNodes", "MCSLabel", "MinTime", "Name", "Network", "Nice", "NodeList", "NTPerCore",
            "NTPerNode", "NTPerSocket", "NTPerBoard", "NumCPUs", "NumNodes", "NumTasks", "Origin", "OriginRaw",
            "OverSubscribe", "PackJobId", "PackJobIdSet", "PackJobOffset", "Partition", "PendingTime",
            "PreemptTime", "Prefer", "Priority", "PriorityLong", "Profile", "QOS", "Reason", "ReasonList",
            "Reboot", "ReqNodes", "ReqSwitch", "Requeue", "Reservation", "ResizeTime", "RestartCnt", "SchedNodes",
            "SCT", "SegmentSize", "SiblingsActive", "SiblingsActiveRaw", "SiblingsViable", "SiblingsViableRaw",
            "Shared", "SPerBoard", "StartTime", "State", "StateCompact", "StdErr", "StdIn", "StdOut", "SubmitTime",
            "system_comment", "TimeLeft", "TimeLimit", "TimeUsed", "Tres", "UserId", "UserName", "Wait4Switch",
            "WCKey", "WorkDir",
        ],
        "sinfo_fields" => [
            "AllocMem", "AllocNodes", "Available", "Cluster", "Comment", "Cores", "CPUs", "CPUsLoad", "CPUsState",
            "DefaultTime", "Disk", "Extra", "Features", "features_act", "FreeMem", "Gres", "GresUsed", "Groups",
            "MaxCPUsPerNode", "Memory", "NodeAddr", "NodeAI", "NodeAIOT", "NodeHost", "NodeList", "Nodes",
            "OverSubscribe", "Partition", "PartitionName", "Port", "PreemptMode", "PriorityJobFactor",
            "PriorityTier", "Reason", "Reservation", "Root", "Share", "Size", "Sockets", "SocketCoreThread",
            "StateCompact", "StateComplete", "StateLong", "Threads", "Time", "TimeStamp", "User", "UserLong",
            "Version", "Weight",
        ],
        "sacct_fields" => [
            "Account", "AdminComment", "AllocCPUS", "AllocNodes", "AllocTRES", "AveCPU", "AveCPUFreq",
            "AveDiskRead", "AveDiskWrite", "AvePages", "AveRSS", "AveVMSize", "BlockID", "Cluster", "Comment",
            "Constraints", "ConsumedEnergy", "ConsumedEnergyRaw", "Container", "CPUTime", "CPUTimeRAW", "DBIndex",
            "DerivedExitCode", "Elapsed", "ElapsedRaw", "Eligible", "End", "Exclusive", "Extra", "Flags", "JobID",
            "JobIDRaw", "JobName", "Licenses", "MaxDiskRead", "MaxDiskReadNode", "MaxDiskReadTask", "MaxDiskWrite",
            "MaxDiskWriteNode", "MaxDiskWriteTask", "MaxPagesNode", "MaxPagesTask", "MaxRSS", "MaxRSSNode",
            "MaxRSSTask", "MaxVMSize", "MaxVMSizeNode", "MaxVMSizeTask", "McsLabel", "MinCPU", "MinCPUNode",
            "MinCPUTask", "NCPUS", "NodeList", "OriginalSLUID", "OverSubscribe", "Partition", "Planned",
            "PlannedCPU", "PlannedCPURAW", "Priority", "QOS", "QOSREQ", "Reason", "ReqCPUFreq", "ReqCPUFreqGov",
            "ReqCPUFreqMax", "ReqCPUFreqMin", "ReqMem", "ReqTRES", "ReqReservation", "SegmentSize", "SLUID",
            "Start", "State", "StdErr", "StdIn", "StdOut", "Submit", "SubmitLine", "Suspended", "SystemComment",
            "SystemCPU", "Timelimit", "TimelimitRaw", "TotalCPU", "TRESUsageInAve", "TRESUsageInMax",
            "TRESUsageInMaxNode", "TRESUsageInMaxTask", "TRESUsageInMin", "TRESUsageInMinNode",
            "TRESUsageInMinTask", "TRESUsageInTot", "TRESUsageOutAve", "TRESUsageOutMax", "TRESUsageOutMaxNode",
