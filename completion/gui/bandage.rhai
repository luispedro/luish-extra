// BandageNG 2026.9.1 (Bioconda's bandage_ng), generated by scripts/gen/mk_bandage.py from its `--help` and that of
// its subcommands. The options of the graph's scope, size, appearance and BLAST search are also taken after a
// subcommand (`BandageNG image graph.gfa out.png --scope aroundnodes --nodes 1`); without a subcommand, BandageNG opens
// its GUI.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn spec(cmd) {
    #{
        opts: `
            -h, --help  print this help message and exit
            --version   display program version information and exit
        `,
        common: `
            --scope SCOPE       the graph's scope
            --exact             match node names exactly
            --partial           match node names partially
            --distance INT      the number of node steps away to draw for the aroundnodes and aroundblast scopes
            --mindepth FLOAT    the minimum allowed depth for the depthrange scope
            --maxdepth FLOAT    the maximum allowed depth for the depthrange scope
            --query TEXT        a FASTA file of either nucleotide or protein sequences to be used as BLAST queries
            --nodes TEXT        a comma-separated list of starting nodes for the aroundnodes and aroundcomponent scopes
            --path TEXT         a comma-separated list of path names used as seeds for the aroundcomponent scope
            --walk TEXT         a comma-separated list of walk names used as seeds for the aroundcomponent scope
            --nodelen FLOAT     node length per megabase
            --minnodlen FLOAT   minimum node length
            --edgelen FLOAT     edge length
            --edgewidth FLOAT   edge width
            --linkwidth FLOAT   link edge width
            --jumps-as-links    treat GFA 1.2 jumps as links
            --doubsep FLOAT     double mode node separation
            --nodseglen FLOAT   node segment length
            --iter INT          graph layout iterations
            --linear            linear graph layout
            --edgecol COLOR     color for edges
            --outcol COLOR      color for node outlines
            --outline FLOAT     node outline thickness
            --selcol COLOR      color for selections
            --aa                enable antialiasing
            --noaa              disable antialiasing
            --double            draw the graph in double mode
            --single            draw the graph in single mode
            --singlearr         show node arrowheads in single mode
            --textcol COLOR     color for label text
            --toutcol COLOR     color for text outline
            --toutline FLOAT    surround text with an outline with this thickness
            --centre            node labels appear at the centre of the node
            --nodewidth FLOAT   average node width
            --depwidth FLOAT    depth effect on width
            --deppower FLOAT    power of depth effect on width
            --csv TEXT          a CSV file with additional info
            --names             label nodes with name
            --lengths           label nodes with length
            --depth             label nodes with depth
            --blasthits         label BLAST hits
            --fontsize INT      font size for node labels
            --colour VALUE      node colouring scheme
            --ransatpos INT     positive node saturation
            --ransatneg INT     negative node saturation
            --ranligpos INT     positive node lightness
            --ranligneg INT     negative node lightness
            --ranopapos INT     positive node opacity
            --ranopaneg INT     negative node opacity
            --unicolpos COLOR   positive node colour
            --unicolneg COLOR   negative node colour
            --unicolspe COLOR   special node colour
            --colormap ENUM     color map to use
            --depvallow FLOAT   low depth value
            --depvalhi FLOAT    high depth value
            --blastp TEXT       parameters of blastn and tblastn, as on their command line (quoted)
            --alfilter INT      alignment length filter for BLAST hits
            --qcfilter FLOAT    query coverage filter for BLAST hits
            --ifilter FLOAT     identity filter for BLAST hits
            --evfilter SCINOT   e-value filter for BLAST hits
            --bsfilter FLOAT    bit score filter for BLAST hits
            --pathnodes INT     the number of allowed nodes in a BLAST query path
            --minpatcov FLOAT   minimum fraction of a BLAST query which must be covered by a query path
            --minhitcov FLOAT   minimum fraction of a BLAST query covered by the BLAST hits of a query path
            --minmeanid FLOAT   minimum mean identity of BLAST hits in a query path
            --maxevprod SCINOT  maximum e-value product for all BLAST hits in a query path
            --minpatlen FLOAT   minimum allowed relative path length as compared to the query
            --maxpatlen FLOAT   maximum allowed relative path length as compared to the query
            --minlendis INT     minimum length discrepancy (in bases) between a BLAST query and its path
            --maxlendis INT     maximum length discrepancy (in bases) between a BLAST query and its path
        `,
        values: #{
            "--scope": ["entire", "aroundnodes", "aroundblast", "depthrange", "aroundcomponent"],
            "--distance": "none", "--mindepth": "none", "--maxdepth": "none", "--query": "files",
            "--nodes": "none", "--path": "none", "--walk": "none", "--nodelen": "none", "--minnodlen": "none",
            "--edgelen": "none", "--edgewidth": "none", "--linkwidth": "none", "--doubsep": "none",
            "--nodseglen": "none", "--iter": "none", "--edgecol": "none", "--outcol": "none", "--outline": "none",
            "--selcol": "none", "--textcol": "none", "--toutcol": "none", "--toutline": "none",
            "--nodewidth": "none", "--depwidth": "none", "--deppower": "none", "--csv": "files",
            "--fontsize": "none", "--colour": ["random", "uniform", "depth", "custom", "gc", "gfa", "csv"],
            "--ransatpos": "none", "--ransatneg": "none", "--ranligpos": "none", "--ranligneg": "none",
            "--ranopapos": "none", "--ranopaneg": "none", "--unicolpos": "none", "--unicolneg": "none",
            "--unicolspe": "none",
            "--colormap": ["viridis", "parula", "heat", "jet", "turbo", "hot", "gray", "magma", "inferno", "plasma", "cividis", "github", "cubehelix"],
            "--depvallow": "none", "--depvalhi": "none", "--blastp": "none", "--alfilter": "none",
            "--qcfilter": "none", "--ifilter": "none", "--evfilter": "none", "--bsfilter": "none",
            "--pathnodes": "none", "--minpatcov": "none", "--minhitcov": "none", "--minmeanid": "none",
            "--maxevprod": "none", "--minpatlen": "none", "--maxpatlen": "none", "--minlendis": "none",
            "--maxlendis": "none",
        },
        commands: `
            load          launch the BandageNG GUI and load a graph file
            image         generate an image file of a graph
            info          display information about a graph
            reduce        save a subgraph of a larger graph
            querypaths    output graph paths for BLAST queries
            layout        layout the graph
        `,
        subs: #{
            "load": #{
                opts: `
                    --draw  draw graph after loading
                `,
                args: [own("kinds:bandage_graph"), "none"],
            },
            "image": #{
                opts: `
                    --height UINT  image height
                    --width UINT   image width
                    --color TEXT   csv file with 2 columns: first the node name second the node color
                `,
                values: #{
                    "--height": "none", "--width": "none", "--color": "files",
                },
                args: [own("kinds:bandage_graph"), "files", "none"],
            },
            "info": #{
                opts: `
                    --tsv  output the information in a single tab-delimited line starting with the graph file
                `,
                args: [own("kinds:bandage_graph"), "none"],
            },
            "reduce": #{
                args: [own("kinds:bandage_graph"), "files", "none"],
            },
            "querypaths": #{
                opts: `
                    --pathfasta  put all query path sequences in a multi-FASTA file, not in the TSV file
                    --hitsfasta  produce a multi-FASTA file of all BLAST hits in the query paths
                    --gfapaths   align to GFA path sequences in addition to nodes
                `,
                args: [own("kinds:bandage_graph"), own("kinds:fasta"), "files", "none"],
            },
            "layout": #{
                args: [own("kinds:bandage_graph"), "files", "none"],
            },
        },
    }
}
