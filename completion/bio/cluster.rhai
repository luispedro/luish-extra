            --min_unmasked_pct REAL        min unmasked % of sequences to keep
            --maskfasta FILENAME           mask sequences in the given FASTA file
            --orient FILENAME              orient sequences in given FASTA/FASTQ file
            --dbmask none|dust|soft        mask db seqs with dust, soft or no method
            --wordlength INT               length of words for matching or database index, 3-15
            --notmatched FILENAME          FASTA file for non-matching sequences
            --fastq_join FILENAME          join paired-end reads into one sequence with gap
            --reverse FILENAME             specify FASTQ file with reverse reads
            --join_padgap STRING           sequence string used for padding
            --join_padgapq STRING          quality string used for padding
            --fastx_syncpairs FILENAME     reorder paired reads to match across both files
