fn cd_hit() {
    #{
        opts: `
            -i FILE   input filename
            -o FILE   output filename
            -c N      sequence identity threshold
            -G N      use global sequence identity
            -b N      band width of alignment
            -M N      memory limit (in MB) for the program
            -T N      number of threads
            -n N      word length
            -l N      throw away sequences shorter than this
            -t N      tolerance for redundance
            -d N      length of description in .clstr file
            -s N      length difference cutoff
            -S N      length difference cutoff in amino acid
            -aL N     alignment coverage for the longer sequence
            -AL N     alignment coverage control for the longer sequence
            -aS N     alignment coverage for the shorter sequence
            -AS N     alignment coverage control for the shorter sequence
            -A N      minimal alignment coverage control for both sequences
            -uL N     maximum unmatched percentage for the longer sequence
            -uS N     maximum unmatched percentage for the shorter sequence
            -U N      maximum unmatched length
            -B 0|1    store sequences on the hard drive (no longer supported)
            -p 0|1    print alignment overlap in the .clstr file
            -g 0|1    cluster to the most similar cluster, not the first (slow)
            -sc 0|1   sort clusters by size (number of sequences)
            -sf 0|1   sort FASTA/FASTQ by cluster size (number of sequences)
            -bak 0|1  write a backup cluster file
            -h        print this help
        `,
        values: #{
            "-i": k("fasta"), "-o": "files", "-c": "none", "-G": "none", "-b": "none", "-M": "none", "-T": "none",
            "-n": "none", "-l": "none", "-t": "none", "-d": "none", "-s": "none", "-S": "none", "-aL": "none",
            "-AL": "none", "-aS": "none", "-AS": "none", "-A": "none", "-uL": "none", "-uS": "none", "-U": "none",
            "-B": ["0", "1"], "-p": ["0", "1"], "-g": ["0", "1"], "-sc": ["0", "1"], "-sf": ["0", "1"],
            "-bak": ["0", "1"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn cd_hit_est() {
    #{
        opts: `
            -i FILE          input filename
            -j FILE          input filename for R2 reads, if paired-end
            -o FILE          output filename
            -op FILE         output filename for R2 reads, if paired-end
            -c N             sequence identity threshold
            -G N             use global sequence identity
            -b N             band width of alignment
            -M N             memory limit (in MB) for the program
            -T N             number of threads
            -n N             word length
            -l N             throw away sequences shorter than this
            -d N             length of description in .clstr file
            -s N             length difference cutoff
            -S N             length difference cutoff in amino acid
            -aL N            alignment coverage for the longer sequence
            -AL N            alignment coverage control for the longer sequence
            -aS N            alignment coverage for the shorter sequence
            -AS N            alignment coverage control for the shorter sequence
            -A N             minimal alignment coverage control for both sequences
            -uL N            maximum unmatched percentage for the longer sequence
            -uS N            maximum unmatched percentage for the shorter sequence
            -U N             maximum unmatched length
            -B 0|1           store sequences on the hard drive (no longer supported)
            -P 0|1           input paired-end reads, with -i and -j
            -cx N            length to keep after trimming the tail of sequence
            -cy N            length to keep after trimming the tail of R2 sequence
            -ap 0|1          force sequences to align at their beginnings
            -p 0|1           print alignment overlap in the .clstr file
            -g 0|1           cluster to the most similar cluster, not the first (slow)
            -r 0|1           align both strands (1) or only +/+ (0)
            -mask LETTERS    masking letters
            -match SCORE     matching score
            -mismatch SCORE  mismatching score
            -gap SCORE       gap opening score
            -gap-ext SCORE   gap extension score
            -bak 0|1         write a backup cluster file
            -sc 0|1          sort clusters by size (number of sequences)
            -sf 0|1          sort FASTA/FASTQ by cluster size (number of sequences)
            -h               print this help
        `,
        values: #{
            "-i": k("sequences"), "-j": k("sequences"), "-o": "files", "-op": "files", "-c": "none", "-G": "none",
            "-b": "none", "-M": "none", "-T": "none", "-n": "none", "-l": "none", "-d": "none", "-s": "none",
            "-S": "none", "-aL": "none", "-AL": "none", "-aS": "none", "-AS": "none", "-A": "none", "-uL": "none",
            "-uS": "none", "-U": "none", "-B": ["0", "1"], "-P": ["0", "1"], "-cx": "none", "-cy": "none",
            "-ap": ["0", "1"], "-p": ["0", "1"], "-g": ["0", "1"], "-r": ["0", "1"], "-mask": "none",
            "-match": "none", "-mismatch": "none", "-gap": "none", "-gap-ext": "none", "-bak": ["0", "1"],
            "-sc": ["0", "1"], "-sf": ["0", "1"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn cd_hit_2d() {
    #{
        opts: `
            -i FILE   input filename for db1
            -i2 FILE  input filename for db2
            -o FILE   output filename
            -c N      sequence identity threshold
            -G N      use global sequence identity
            -b N      band width of alignment
            -M N      memory limit (in MB) for the program
            -T N      number of threads
            -n N      word length
            -l N      throw away sequences shorter than this
            -t N      tolerance for redundance
            -d N      length of description in .clstr file
            -s N      length difference cutoff
            -S N      length difference cutoff in amino acid
            -s2 N     length difference cutoff for db1
            -S2 N     length difference cutoff
            -aL N     alignment coverage for the longer sequence
            -AL N     alignment coverage control for the longer sequence
            -aS N     alignment coverage for the shorter sequence
            -AS N     alignment coverage control for the shorter sequence
            -A N      minimal alignment coverage control for both sequences
            -uL N     maximum unmatched percentage for the longer sequence
            -uS N     maximum unmatched percentage for the shorter sequence
            -U N      maximum unmatched length
            -B 0|1    store sequences on the hard drive (no longer supported)
            -p 0|1    print alignment overlap in the .clstr file
            -g 0|1    cluster to the most similar cluster, not the first (slow)
            -bak 0|1  write a backup cluster file
            -h        print this help
        `,
        values: #{
            "-i": k("fasta"), "-i2": k("fasta"), "-o": "files", "-c": "none", "-G": "none", "-b": "none",
            "-M": "none", "-T": "none", "-n": "none", "-l": "none", "-t": "none", "-d": "none", "-s": "none",
            "-S": "none", "-s2": "none", "-S2": "none", "-aL": "none", "-AL": "none", "-aS": "none", "-AS": "none",
            "-A": "none", "-uL": "none", "-uS": "none", "-U": "none", "-B": ["0", "1"], "-p": ["0", "1"],
            "-g": ["0", "1"], "-bak": ["0", "1"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn cd_hit_est_2d() {
    #{
        opts: `
            -i FILE          input filename for db1
            -i2 FILE         input filename for db2
            -j FILE          input filename for R2 reads, if paired-end
            -j2 FILE         input filename for R2 reads of db2, if paired-end
            -o FILE          output filename
            -op FILE         output filename for R2 reads, if paired-end
            -c N             sequence identity threshold
            -G N             use global sequence identity
            -b N             band width of alignment
            -M N             memory limit (in MB) for the program
            -T N             number of threads
            -n N             word length
            -l N             throw away sequences shorter than this
            -d N             length of description in .clstr file
            -s N             length difference cutoff
            -S N             length difference cutoff in amino acid
            -s2 N            length difference cutoff for db1
            -S2 N            length difference cutoff
            -aL N            alignment coverage for the longer sequence
            -AL N            alignment coverage control for the longer sequence
            -aS N            alignment coverage for the shorter sequence
            -AS N            alignment coverage control for the shorter sequence
            -A N             minimal alignment coverage control for both sequences
            -uL N            maximum unmatched percentage for the longer sequence
            -uS N            maximum unmatched percentage for the shorter sequence
            -U N             maximum unmatched length
            -B 0|1           store sequences on the hard drive (no longer supported)
            -P 0|1           input paired-end reads, with -i and -j
            -cx N            length to keep after trimming the tail of sequence
            -cy N            length to keep after trimming the tail of R2 sequence
            -p 0|1           print alignment overlap in the .clstr file
            -g 0|1           cluster to the most similar cluster, not the first (slow)
            -r 0|1           align both strands (1) or only +/+ (0)
            -mask LETTERS    masking letters
            -match SCORE     matching score
            -mismatch SCORE  mismatching score
            -gap SCORE       gap opening score
            -gap-ext SCORE   gap extension score
            -bak 0|1         write a backup cluster file
            -h               print this help
        `,
        values: #{
            "-i": k("sequences"), "-i2": k("sequences"), "-j": k("sequences"), "-j2": k("sequences"),
            "-o": "files", "-op": "files", "-c": "none", "-G": "none", "-b": "none", "-M": "none", "-T": "none",
            "-n": "none", "-l": "none", "-d": "none", "-s": "none", "-S": "none", "-s2": "none", "-S2": "none",
            "-aL": "none", "-AL": "none", "-aS": "none", "-AS": "none", "-A": "none", "-uL": "none", "-uS": "none",
            "-U": "none", "-B": ["0", "1"], "-P": ["0", "1"], "-cx": "none", "-cy": "none", "-p": ["0", "1"],
            "-g": ["0", "1"], "-r": ["0", "1"], "-mask": "none", "-match": "none", "-mismatch": "none",
            "-gap": "none", "-gap-ext": "none", "-bak": ["0", "1"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn cd_hit_454() {
    #{
        opts: `
            -i FILE          input filename
            -o FILE          output filename
            -c N             sequence identity threshold
            -b N             band width of alignment
            -M N             memory limit (in MB) for the program
            -T N             number of threads
            -n N             word length
            -aL N            alignment coverage for the longer sequence
            -AL N            alignment coverage control for the longer sequence
            -aS N            alignment coverage for the shorter sequence
            -AS N            alignment coverage control for the shorter sequence
            -B 0|1           store sequences on the hard drive (no longer supported)
            -g 0|1           cluster to the most similar cluster, not the first (slow)
            -D N             max size per indel
            -match SCORE     matching score
            -mismatch SCORE  mismatching score
            -gap SCORE       gap opening score
            -gap-ext SCORE   gap extension score
            -bak 0|1         write a backup cluster file
            -h               print this help
        `,
        values: #{
            "-i": k("fasta"), "-o": "files", "-c": "none", "-b": "none", "-M": "none", "-T": "none", "-n": "none",
            "-aL": "none", "-AL": "none", "-aS": "none", "-AS": "none", "-B": ["0", "1"], "-g": ["0", "1"],
            "-D": "none", "-match": "none", "-mismatch": "none", "-gap": "none", "-gap-ext": "none",
            "-bak": ["0", "1"],
        },
        args: ["none"],
        single_dash: true,
    }
}

fn spec(cmd) {
    switch cmd {
        "vsearch" => vsearch(),
        "cd-hit" => cd_hit(),
        "cd-hit-est" => cd_hit_est(),
        "cd-hit-2d" => cd_hit_2d(),
        "cd-hit-est-2d" => cd_hit_est_2d(),
        "cd-hit-454" => cd_hit_454(),
        _ => #{},
    }
}
