// The options that take no value (OPT_TYPE_BOOL and the options that print something), in an input or an output.
fn switches() {
    #{
        "-L": true, "-accurate_seek": true, "-an": true, "-auto_conversion_filters": true, "-autorotate": true,
        "-autoscale": true, "-benchmark": true, "-benchmark_all": true, "-bitexact": true, "-bsfs": true,
        "-buildconf": true, "-codecs": true, "-colors": true, "-copy_unknown": true, "-copyinkf": true,
        "-copyts": true, "-debug_ts": true, "-decoders": true, "-demuxers": true, "-devices": true,
        "-display_hflip": true, "-display_vflip": true, "-dispositions": true, "-dn": true, "-dump": true,
        "-encoders": true, "-filters": true, "-find_stream_info": true, "-fix_sub_duration": true,
        "-fix_sub_duration_heartbeat": true, "-force_fps": true, "-formats": true, "-hex": true,
        "-hide_banner": true, "-hwaccels": true, "-ignore_unknown": true, "-layouts": true, "-license": true,
        "-muxers": true, "-n": true, "-noaccurate_seek": true, "-noan": true, "-noauto_conversion_filters": true,
        "-noautorotate": true, "-noautoscale": true, "-nobenchmark": true, "-nobenchmark_all": true,
        "-nobitexact": true, "-nocopy_unknown": true, "-nocopyinkf": true, "-nocopyts": true, "-nodebug_ts": true,
        "-nodisplay_hflip": true, "-nodisplay_vflip": true, "-nodn": true, "-nodump": true,
        "-nofind_stream_info": true, "-nofix_sub_duration": true, "-nofix_sub_duration_heartbeat": true,
        "-noforce_fps": true, "-nohex": true, "-nohide_banner": true, "-noignore_unknown": true, "-non": true,
        "-noprint_graphs": true, "-nore": true, "-norecast_media": true, "-noshortest": true, "-nosn": true,
        "-nostart_at_zero": true, "-nostats": true, "-nostdin": true, "-novn": true, "-noxerror": true,
        "-noy": true, "-pix_fmts": true, "-print_graphs": true, "-protocols": true, "-re": true,
        "-recast_media": true, "-report": true, "-sample_fmts": true, "-shortest": true, "-sn": true,
        "-start_at_zero": true, "-stats": true, "-stdin": true, "-version": true, "-vn": true, "-vstats": true,
        "-xerror": true, "-y": true,
    }
}

// The constants of a generic option of type flags, by `SIDE:NAME`.
fn flags(key) {
    switch key {
        "in:flags" => [
            #{value: "unaligned", desc: "allow decoders to produce unaligned output"},
            #{value: "gray", desc: "only decode/encode grayscale"},
            #{value: "low_delay", desc: "force low delay"},
            #{value: "bitexact", desc: "use only bitexact functions (except (I)DCT)"},
            #{value: "output_corrupt", desc: "output even potentially corrupted frames"},
        ],
        "in:flags2" => [
            #{value: "ignorecrop", desc: "ignore cropping information from sps"},
            #{value: "chunks", desc: "frame data might be split into multiple chunks"},
            #{value: "showall", desc: "show all frames before the first keyframe"},
            #{value: "export_mvs", desc: "export motion vectors through frame side data"},
            #{value: "skip_manual", desc: "do not skip samples and export skip information as frame side data"},
            #{value: "ass_ro_flush_noop", desc: "do not reset ASS ReadOrder field on flush"},
            #{value: "icc_profiles", desc: "generate/parse embedded ICC profiles from/to colorimetry tags"},
        ],
        "in:export_side_data" => [
            #{value: "mvs", desc: "export motion vectors through frame side data"},
            #{value: "venc_params", desc: "export video encoding parameters through frame side data"},
            #{value: "film_grain", desc: "export film grain parameters through frame side data"},
            #{value: "enhancements", desc: "export picture enhancement metadata through frame side data"},
        ],
        "in:bug" => [
            "autodetect",
            #{value: "xvid_ilace", desc: "xvid interlacing bug (autodetected if FOURCC == XVIX)"},
            #{value: "ump4", desc: "(autodetected if FOURCC == UMP4)"},
            #{value: "no_padding", desc: "padding bug (autodetected)"},
            "amv",
            "qpel_chroma",
            #{value: "std_qpel", desc: "old standard qpel (autodetected per FOURCC/version)"},
            "qpel_chroma2",
            #{value: "direct_blocksize", desc: "direct-qpel-blocksize bug (autodetected per FOURCC/version)"},
            #{value: "edge", desc: "edge padding bug (autodetected per FOURCC/version)"},
            "hpel_chroma",
            "dc_clip",
            #{value: "ms", desc: "work around various bugs in Microsoft's broken decoders"},
            #{value: "trunc", desc: "truncated frames"},
            "iedge",
        ],
        "in:err_detect" => [
            #{value: "crccheck", desc: "verify embedded CRCs"},
            #{value: "bitstream", desc: "detect bitstream specification deviations"},
            #{value: "buffer", desc: "detect improper bitstream length"},
            #{value: "explode", desc: "abort decoding on minor error detection"},
            #{value: "ignore_err", desc: "ignore errors"},
            #{value: "careful", desc: "consider things that violate the spec, are fast to check and have not been seen in the"},
            #{value: "compliant", desc: "consider all spec non compliancies as errors"},
            #{value: "aggressive", desc: "consider things that a sane encoder should not do as an error"},
        ],
        "in:ec" => [
            #{value: "guess_mvs", desc: "iterative motion vector (MV) search (slow)"},
            #{value: "deblock", desc: "use strong deblock filter for damaged MBs"},
            #{value: "favor_inter", desc: "favor predicting from the previous frame"},
        ],
        "in:debug" => [
            #{value: "pict", desc: "picture info"},
            "bitstream",
            #{value: "mb_type", desc: "macroblock (MB) type"},
            #{value: "qp", desc: "per-block quantization parameter (QP)"},
            "dct_coeff",
            "green_metadata",
            "skip",
            "startcode",
            #{value: "er", desc: "error recognition"},
            #{value: "mmco", desc: "memory management control operations (H.264)"},
            "bugs",
            #{value: "buffers", desc: "picture buffer allocations"},
            #{value: "thread_ops", desc: "threading operations"},
            #{value: "nomc", desc: "skip motion compensation"},
        ],
        "in:thread_type" => ["slice", "frame"],
        "in:sub_charenc_mode" => ["do_nothing", "auto", "pre_decoder", "ignore"],
        "in:hwaccel_flags" => [
            #{value: "ignore_level", desc: "ignore level even if the codec level used is unknown or higher than the maximum supported"},
            #{value: "allow_high_depth", desc: "allow to output YUV pixel formats with a different chroma sampling than 4:2:0 and/or"},
            #{value: "allow_profile_mismatch", desc: "attempt to decode anyway if HW accelerated decoder's supported profiles do not exactly"},
            #{value: "unsafe_output", desc: "allow potentially unsafe hwaccel frame output that might require special care to process"},
        ],
        "in:avioflags" => [#{value: "direct", desc: "reduce buffering"}],
        "in:fflags" => [
            #{value: "ignidx", desc: "ignore index"},
            #{value: "genpts", desc: "generate pts"},
            #{value: "nofillin", desc: "do not fill in missing values that can be exactly calculated"},
            #{value: "noparse", desc: "disable AVParsers, this needs nofillin too"},
            #{value: "igndts", desc: "ignore dts"},
            #{value: "discardcorrupt", desc: "discard corrupted frames"},
            #{value: "sortdts", desc: "try to interleave outputted packets by dts"},
            #{value: "fastseek", desc: "fast but inaccurate seeks"},
            #{value: "nobuffer", desc: "reduce the latency introduced by optional buffering"},
        ],
        "in:fdebug" => ["ts", "id3v2"],
        "out:flags" => [
            #{value: "mv4", desc: "use four motion vectors per macroblock (MPEG-4)"},
            #{value: "qpel", desc: "use 1/4-pel motion compensation"},
            #{value: "loop", desc: "use loop filter"},
            #{value: "gray", desc: "only decode/encode grayscale"},
            #{value: "psnr", desc: "error[?] variables will be set during encoding"},
            #{value: "ildct", desc: "use interlaced DCT"},
            #{value: "low_delay", desc: "force low delay"},
            #{value: "global_header", desc: "place global headers in extradata instead of every keyframe"},
            #{value: "bitexact", desc: "use only bitexact functions (except (I)DCT)"},
            #{value: "aic", desc: "h.263 advanced intra coding / MPEG-4 AC prediction"},
            #{value: "ilme", desc: "interlaced motion estimation"},
            #{value: "cgop", desc: "closed GOP"},
        ],
        "out:flags2" => [
            #{value: "fast", desc: "allow non-spec-compliant speedup tricks"},
            #{value: "noout", desc: "skip bitstream encoding"},
            #{value: "local_header", desc: "place global headers at every keyframe instead of in extradata"},
            #{value: "fixed_frame_size", desc: "force a fixed frame size"},
        ],
        "out:export_side_data" => [#{value: "prft", desc: "export Producer Reference Time through packet side data"}],
        "out:err_detect" => [
            #{value: "crccheck", desc: "verify embedded CRCs"},
            #{value: "bitstream", desc: "detect bitstream specification deviations"},
            #{value: "buffer", desc: "detect improper bitstream length"},
            #{value: "explode", desc: "abort decoding on minor error detection"},
            #{value: "ignore_err", desc: "ignore errors"},
            #{value: "careful", desc: "consider things that violate the spec, are fast to check and have not been seen in the"},
            #{value: "compliant", desc: "consider all spec non compliancies as errors"},
            #{value: "aggressive", desc: "consider things that a sane encoder should not do as an error"},
        ],
        "out:debug" => [#{value: "rc", desc: "rate control"}],
        "out:thread_type" => ["slice", "frame"],
        "out:avioflags" => [#{value: "direct", desc: "reduce buffering"}],
        "out:fflags" => [
            #{value: "flush_packets", desc: "reduce the latency by flushing out packets immediately"},
            #{value: "bitexact", desc: "do not write random/volatile data"},
            #{value: "autobsf", desc: "add needed bsfs automatically"},
        ],
        "out:fdebug" => ["ts", "id3v2"],
        "out:sws_flags" => [
            #{value: "fast_bilinear", desc: "fast bilinear"},
            #{value: "bilinear", desc: "bilinear"},
            #{value: "bicubic", desc: "bicubic"},
            #{value: "experimental", desc: "experimental"},
            #{value: "neighbor", desc: "nearest neighbor"},
            #{value: "area", desc: "averaging area"},
            #{value: "bicublin", desc: "luma bicubic, chroma bilinear"},
            #{value: "gauss", desc: "gaussian approximation"},
            #{value: "sinc", desc: "sinc"},
            #{value: "lanczos", desc: "lanczos (sinc/sinc)"},
            #{value: "spline", desc: "natural bicubic spline"},
            #{value: "print_info", desc: "print info"},
            #{value: "accurate_rnd", desc: "accurate rounding"},
            #{value: "full_chroma_int", desc: "full chroma interpolation"},
            #{value: "full_chroma_inp", desc: "full chroma input"},
            #{value: "bitexact", desc: "bit-exact mode"},
            #{value: "error_diffusion", desc: "error diffusion dither"},
            #{value: "unstable", desc: "allow experimental new code"},
            #{value: "strict", desc: "require all metadata to be set"},
        ],
        "out:sws_backends" => [
            #{value: "auto", desc: "automatic selection"},
            #{value: "stable", desc: "all stable backends"},
            #{value: "unstable", desc: "all unstable backends"},
            #{value: "all", desc: "all available backends"},
            #{value: "legacy", desc: "legacy swscale code"},
            #{value: "c", desc: "template-based reference code"},
            #{value: "memcpy", desc: "fast path using libc memcpy"},
            #{value: "x86", desc: "x86 SIMD kernels"},
            #{value: "aarch64", desc: "AArch64 NEON kernels"},
