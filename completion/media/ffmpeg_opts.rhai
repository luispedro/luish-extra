                #{value: "sinc", desc: "unwindowed sinc"},
                #{value: "lanczos", desc: "3-tap sinc/sinc"},
                #{value: "spline", desc: "2-tap cubic BC spline"},
            ],
            "-param0": "none", "-param1": "none", "-srcw": "none", "-srch": "none", "-dstw": "none",
            "-dsth": "none", "-src_format": k("pix_fmts"), "-dst_format": k("pix_fmts"),
            "-src_range": ["true", "false"], "-dst_range": ["true", "false"], "-gamma": ["true", "false"],
            "-src_v_chr_pos": "none", "-src_h_chr_pos": "none", "-dst_v_chr_pos": "none", "-dst_h_chr_pos": "none",
            "-sws_dither": [
                #{value: "auto", desc: "automatic selection"},
                #{value: "none", desc: "no dithering"},
                #{value: "bayer", desc: "ordered matrix dither"},
                #{value: "ed", desc: "full error diffusion"},
                #{value: "a_dither", desc: "arithmetic addition dither"},
                #{value: "x_dither", desc: "arithmetic xor dither"},
            ],
            "-alphablend": [
                #{value: "none", desc: "ignore alpha"},
                #{value: "uniform_color", desc: "blend onto a uniform color"},
                #{value: "checkerboard", desc: "blend onto a checkerboard"},
            ],
            "-intent": [
