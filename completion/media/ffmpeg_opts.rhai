                #{value: "relative_colorimetric", desc: "relative colorimetric clipping"},
                #{value: "saturation", desc: "saturation mapping"},
                #{value: "absolute_colorimetric", desc: "absolute colorimetric clipping"},
            ],
            "-sws_backends": k("flags:gen:out:sws_backends"),
        }
    }
}

// The `-noNAME` of the flags (`-nostdin`), offered for a word that starts with `-no`.
fn negations(side) {
    if side == "in" {
        `
            -nohide_banner              not -hide_banner
            -noignore_unknown           not -ignore_unknown
            -nocopy_unknown             not -copy_unknown
            -norecast_media             not -recast_media
            -noaccurate_seek            not -accurate_seek
            -nobenchmark                not -benchmark
            -nobenchmark_all            not -benchmark_all
            -nostdin                    not -stdin
            -nodump                     not -dump
            -nohex                      not -hex
            -nocopyts                   not -copyts
            -nostart_at_zero            not -start_at_zero
            -nobitexact                 not -bitexact
            -noxerror                   not -xerror
            -noprint_graphs             not -print_graphs
            -noauto_conversion_filters  not -auto_conversion_filters
            -nostats                    not -stats
            -nodebug_ts                 not -debug_ts
            -nofind_stream_info         not -find_stream_info
            -nodisplay_hflip            not -display_hflip
            -nodisplay_vflip            not -display_vflip
            -noautorotate               not -autorotate
            -nofix_sub_duration         not -fix_sub_duration
        `
    } else {
        `
            -nohide_banner                 not -hide_banner
            -noignore_unknown              not -ignore_unknown
            -nocopy_unknown                not -copy_unknown
            -norecast_media                not -recast_media
            -nobenchmark                   not -benchmark
            -nobenchmark_all               not -benchmark_all
            -nostdin                       not -stdin
            -nodump                        not -dump
            -nohex                         not -hex
            -nocopyts                      not -copyts
            -nostart_at_zero               not -start_at_zero
            -noshortest                    not -shortest
            -nobitexact                    not -bitexact
            -noxerror                      not -xerror
            -nocopyinkf                    not -copyinkf
            -noprint_graphs                not -print_graphs
            -noauto_conversion_filters     not -auto_conversion_filters
            -nostats                       not -stats
            -nodebug_ts                    not -debug_ts
            -noforce_fps                   not -force_fps
            -noautoscale                   not -autoscale
            -nofix_sub_duration_heartbeat  not -fix_sub_duration_heartbeat
        `
    }
}

// The options that take a stream specifier (`-c:v`, "stream") or a metadata specifier (`-metadata:s:a`, "meta"), by
// name: those of ffmpeg marked so, and the generic options of libavcodec.
