        "threads": "stream", "dc": "stream", "nssew": "stream", "skip_top": "stream", "skip_bottom": "stream",
        "profile": "stream", "level": "stream", "lowres": "stream", "cmp": "stream", "subcmp": "stream",
        "mbcmp": "stream", "ildctcmp": "stream", "precmp": "stream", "mblmin": "stream", "mblmax": "stream",
