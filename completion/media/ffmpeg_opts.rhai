// ffmpeg 9.0.2 (conda-forge's), generated by scripts/gen/mk_ffmpeg.py from `ffmpeg -h long` and from the
// AVCodecContext, AVFormatContext and SWScaler sections of `ffmpeg -h full`, with which options take values and which
// are for inputs or outputs only from the OptionDef tables of fftools. The options of an input (`side`: "in") are
// ffmpeg's own for inputs and the generic options for decoding and demuxing, those of an output ("out"), ffmpeg's
// own for outputs and the generic options for encoding and muxing. The kinds are ffmpeg.rhai's.

// This plugin's `MODULE:NAME` (a kind or sub_spec) by the module's path, whatever the source is called.
fn own(name) { sh::plugin_dir() + "/" + name }

fn k(name) { own("ffmpeg:") + name }

// The options of an input or an output.
fn opts(side) {
    if side == "in" {
        `
            -L                                  show license
            -license                            show license
            -h TOPIC                            show help (long, full, or TYPE=NAME for a codec, format, filter, bsf or protocol)
            -version                            show version
            -muxers                             show available muxers
            -demuxers                           show available demuxers
            -devices                            show available devices
            -decoders                           show available decoders
            -encoders                           show available encoders
            -filters                            show available filters
            -pix_fmts                           show available pixel formats
            -layouts                            show standard channel layouts
            -sample_fmts                        show available audio sample formats
            -? TOPIC                            show help
            -help TOPIC                         show help
            --help TOPIC                        show help
            -buildconf                          show build configuration
            -formats                            show available formats
            -codecs                             show available codecs
            -bsfs                               show available bit stream filters
            -protocols                          show available protocols
            -dispositions                       show available stream dispositions
            -colors                             show available color names
            -sources DEVICE                     list sources of the input device
            -sinks DEVICE                       list sinks of the output device
            -hwaccels                           show available HW acceleration methods
            -v LOGLEVEL                         set logging level
            -y                                  overwrite output files
            -n                                  never overwrite output files
            -print_graphs                       print execution graph data to stderr
            -print_graphs_file FILENAME         write execution graph data to the specified file
            -print_graphs_format FORMAT         set the output printing format
            -stats                              print progress report during encoding
            -loglevel LOGLEVEL                  set logging level
            -report                             generate a report
            -max_alloc BYTES                    set maximum size of a single allocated block
            -cpuflags FLAGS                     force specific cpu flags
            -cpucount COUNT                     force specific cpu count
            -hide_banner                        do not show program banner
            -ignore_unknown                     ignore unknown stream types
            -copy_unknown                       copy unknown stream types
            -recast_media                       allow recasting stream type in order to force a decoder of different media type
            -benchmark                          add timings for benchmarking
            -benchmark_all                      add timings for each task
            -progress URL                       write program-readable progress information
            -stdin                              enable interaction on standard input (-nostdin: disable it)
            -timelimit LIMIT                    set max runtime in seconds in CPU user time
            -dump                               dump each input packet
            -hex                                when dumping packets, also dump the payload
            -frame_drop_threshold VALUE         frame drop threshold
            -copyts                             copy timestamps
            -start_at_zero                      shift input timestamps to start at 0 when using copyts
            -copytb MODE                        copy input stream time base when stream copying
            -dts_delta_threshold THRESHOLD      timestamp discontinuity delta threshold
            -dts_error_threshold THRESHOLD      timestamp error delta threshold
            -xerror                             exit on error
            -abort_on FLAGS                     abort on the specified condition flags
            -filter_threads VALUE               number of non-complex filter threads
            -filter_buffered_frames VALUE       maximum number of buffered frames in a filter graph
            -filter_complex GRAPH_DESCRIPTION   create a complex filtergraph
            -filter_complex_threads VALUE       number of threads for -filter_complex
            -lavfi GRAPH_DESCRIPTION            create a complex filtergraph
            -auto_conversion_filters            enable automatic conversion filters globally
            -stats_period TIME                  set the period at which ffmpeg updates stats and -progress output
            -debug_ts                           print timestamp debugging info
            -max_error_rate RATIO               ratio of decoding errors (0.0 to 1.0) above which ffmpeg exits with an error
            -vstats                             dump video coding statistics to file
            -vstats_file FILE                   dump video coding statistics to file
            -vstats_version VALUE               version of the vstats format to use
            -vaapi_device DEVICE                set VAAPI hardware device (DirectX adapter index, DRM path or X11 display name)
            -qsv_device DEVICE                  set QSV hardware device (DirectX adapter index, DRM path or X11 display name)
            -init_hw_device ARGS                initialise hardware device
            -filter_hw_device DEVICE            set hardware device used when filtering
            -f FMT                              force container format (auto-detected otherwise)
            -t DURATION                         stop transcoding after specified duration
            -to TIME_STOP                       stop transcoding after specified time is reached
            -ss TIME_OFF                        start transcoding at specified time
            -bitexact                           bitexact mode
            -thread_queue_size VALUE            set the maximum number of queued packets from the demuxer
            -sseof TIME_OFF                     set the start time offset relative to EOF
            -seek_timestamp VALUE               enable/disable seeking by timestamp with -ss
            -accurate_seek                      enable/disable accurate seeking with -ss
            -isync INDEX                        indicate the input index for sync reference
            -itsoffset TIME_OFF                 set the input ts offset
            -re                                 read input at native frame rate; equivalent to -readrate 1
            -readrate SPEED                     read input at specified rate
            -readrate_initial_burst SECONDS     the initial amount of input to burst read before imposing any readrate
            -readrate_catchup SPEED             temporary readrate used to catch up if an input lags behind the specified readrate
            -dump_attachment FILENAME           extract an attachment into a file
            -stream_loop LOOP_COUNT             set number of times input stream shall be looped
            -find_stream_info                   read and decode the streams to fill missing information with heuristics
            -c CODEC                            select encoder/decoder ('copy' to copy stream without reencoding)
            -codec CODEC                        alias for -c (select encoder/decoder)
            -itsscale SCALE                     set the input ts scale
            -tag TAG                            force codec tag/fourcc
            -reinit_filter VALUE                reinit filtergraph on input parameter changes
            -drop_changed VALUE                 drop frame instead of reiniting filtergraph on input parameter changes
            -discard VALUE                      discard
            -bsf BITSTREAM_FILTERS              a comma-separated list of bitstream filters
            -r RATE                             override input framerate/convert to given output framerate
            -vn                                 disable video
            -vcodec CODEC                       alias for -c:v (select encoder/decoder for video streams)
            -pix_fmt FORMAT                     set pixel format
            -display_rotation ANGLE             set pure counter-clockwise rotation in degrees for stream(s)
            -display_hflip                      set display horizontal flip for stream(s)
            -display_vflip                      set display vertical flip for stream(s) (overrides any display rotation if it is not set)
            -mastering_display VALUE            set SMPTE2084 mastering display color volume info
            -content_light VALUE                set SMPTE2084 Max CLL and Max FALL values
            -vtag TAG                           force video tag/fourcc
            -hwaccel NAME                       use HW accelerated decoding
            -hwaccel_device DEVICENAME          select a device for HW acceleration
            -hwaccel_output_format FORMAT       select output format used with HW accelerated decoding
            -autorotate                         automatically insert correct rotate filters
            -apply_cropping VALUE               select the cropping to apply
            -ar RATE                            set audio sampling rate (in Hz)
            -ac CHANNELS                        set number of audio channels
            -an                                 disable audio
            -acodec CODEC                       alias for -c:a (select encoder/decoder for audio streams)
            -sample_fmt FORMAT                  set sample format
            -channel_layout LAYOUT              set channel layout
            -ch_layout LAYOUT                   set channel layout
            -guess_layout_max VALUE             set the maximum number of channels to try to guess the channel layout
            -sn                                 disable subtitle
            -scodec CODEC                       alias for -c:s (select encoder/decoder for subtitle streams)
            -fix_sub_duration                   fix subtitles duration
            -canvas_size SIZE                   set canvas size (WxH or abbreviation)
            -dcodec CODEC                       alias for -c:d (select encoder/decoder for data streams)
            -dn                                 disable data
            -s SIZE                             set frame size (WxH or abbreviation)
            -i URL                              input file or URL
            -flags FLAGS                        flags
            -flags2 FLAGS                       flags
            -export_side_data FLAGS             export metadata as side data
            -bug FLAGS                          work around not autodetected encoder bugs
            -strict INT                         how strictly to follow the standards (from INT_MIN to INT_MAX)
            -err_detect FLAGS                   set error detection flags
            -idct INT                           select IDCT implementation (from 0 to INT_MAX)
            -ec FLAGS                           set error concealment strategy
            -debug FLAGS                        print specific debug info
            -threads INT                        set the number of threads (from 0 to INT_MAX)
            -skip_top INT                       number of macroblock rows at the top which are skipped (from INT_MIN to INT_MAX)
            -skip_bottom INT                    number of macroblock rows at the bottom which are skipped (from INT_MIN to INT_MAX)
            -lowres INT                         decode at 1= 1/2, 2=1/4, 3=1/8 resolutions (from 0 to INT_MAX)
            -skip_loop_filter INT               skip loop filtering process for the selected frames (from INT_MIN to INT_MAX)
            -skip_idct INT                      skip IDCT/dequantization for the selected frames (from INT_MIN to INT_MAX)
            -skip_frame INT                     skip decoding for the selected frames (from INT_MIN to INT_MAX)
            -color_primaries INT                color primaries (from 1 to INT_MAX)
            -color_trc INT                      color transfer characteristics (from 1 to INT_MAX)
            -colorspace INT                     color space (from 0 to INT_MAX)
            -color_range INT                    color range (from 0 to INT_MAX)
            -chroma_sample_location INT         chroma sample location (from 0 to INT_MAX)
            -alpha_mode INT                     alpha mode (from 0 to INT_MAX)
            -thread_type FLAGS                  select multithreading type
            -request_sample_fmt SAMPLE_FMT      sample format audio decoders should prefer
            -sub_charenc STRING                 set input text subtitles character encoding
            -sub_charenc_mode FLAGS             set input text subtitles character encoding mode
            -skip_alpha BOOLEAN                 skip processing alpha
            -field_order INT                    field order (from 0 to 5)
            -dump_separator STRING              set information dump field separator
            -codec_whitelist STRING             list of decoders that are allowed to be used
            -max_pixels INT64                   maximum number of pixels (from 0 to INT_MAX)
            -max_samples INT64                  maximum number of samples (from 0 to INT_MAX)
            -hwaccel_flags FLAGS                flags
            -extra_hw_frames INT                number of extra hardware frames to allocate for the user (from -1 to INT_MAX)
            -discard_damaged_percentage INT     percentage of damaged samples to discard a frame (from 0 to 100)
            -side_data_prefer_packet INT        comma-separated list of side data types for which user-supplied (container) data is
            -avioflags FLAGS                    flags
            -probesize INT64                    set probing size (from 32 to I64_MAX)
            -formatprobesize INT                number of bytes to probe file format (from 0 to 2.14748e+09)
            -fflags FLAGS                       flags
            -seek2any BOOLEAN                   allow seeking to non-keyframes on demuxer level when supported
            -analyzeduration INT64              specify how many microseconds are analyzed to probe the input (from 0 to I64_MAX)
            -cryptokey BINARY                   decryption key
            -indexmem INT                       max memory used for timestamp index (per stream) (from 0 to INT_MAX)
            -rtbufsize INT                      max memory used for buffering real-time frames (from 0 to INT_MAX)
            -fdebug FLAGS                       print specific debug info
            -max_delay INT                      maximum muxing or demuxing delay in microseconds (from -1 to INT_MAX)
            -fpsprobesize INT                   number of frames used to probe fps (from -1 to 2.14748e+09)
            -use_wallclock_as_timestamps BOOLEAN  use wallclock as timestamps
            -skip_initial_bytes INT64           set number of bytes to skip before reading header and frames (from 0 to I64_MAX)
            -correct_ts_overflow BOOLEAN        correct single timestamp overflows
            -max_ts_probe INT                   maximum number of packets to read while waiting for the first timestamp
            -format_whitelist STRING            list of demuxers that are allowed to be used
            -protocol_whitelist STRING          list of protocols that are allowed to be used
            -protocol_blacklist STRING          list of protocols that are not allowed to be used
            -max_streams INT                    maximum number of streams (from 0 to INT_MAX)
            -skip_estimate_duration_from_pts BOOLEAN  skip duration calculation in estimate_timings_from_pts
            -max_probe_packets INT              maximum number of packets to probe a codec (from 0 to INT_MAX)
            -duration_probesize INT64           maximum number of bytes to probe the durations of the streams in
        `
    } else {
        `
            -L                                  show license
            -license                            show license
            -h TOPIC                            show help (long, full, or TYPE=NAME for a codec, format, filter, bsf or protocol)
            -version                            show version
            -muxers                             show available muxers
