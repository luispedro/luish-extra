                "chroma",
                #{value: "msad", desc: "sum of absolute differences, median predicted"},
            ],
            "-ildctcmp": [
                #{value: "sad", desc: "sum of absolute differences, fast"},
                #{value: "sse", desc: "sum of squared errors"},
                #{value: "satd", desc: "sum of absolute Hadamard transformed differences"},
                #{value: "dct", desc: "sum of absolute DCT transformed differences"},
                #{value: "psnr", desc: "sum of squared quantization errors (avoid, low quality)"},
                #{value: "bit", desc: "number of bits needed for the block"},
                #{value: "rd", desc: "rate distortion optimal, slow"},
                #{value: "zero", desc: "0"},
                #{value: "vsad", desc: "sum of absolute vertical differences"},
                #{value: "vsse", desc: "sum of squared vertical differences"},
                #{value: "nsse", desc: "noise preserving sum of squared differences"},
                #{value: "w53", desc: "5/3 wavelet, only used in snow"},
                #{value: "w97", desc: "9/7 wavelet, only used in snow"},
                "dctmax",
                "chroma",
                #{value: "msad", desc: "sum of absolute differences, median predicted"},
            ],
            "-precmp": [
                #{value: "sad", desc: "sum of absolute differences, fast"},
                #{value: "sse", desc: "sum of squared errors"},
                #{value: "satd", desc: "sum of absolute Hadamard transformed differences"},
