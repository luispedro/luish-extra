            -thread_type FLAGS                  select multithreading type
            -audio_service_type INT             audio service type (from 0 to 8)
            -field_order INT                    field order (from 0 to 5)
            -dump_separator STRING              set information dump field separator
            -max_pixels INT64                   maximum number of pixels (from 0 to INT_MAX)
            -max_samples INT64                  maximum number of samples (from 0 to INT_MAX)
            -avioflags FLAGS                    flags
            -packetsize INT                     set packet size (from 0 to INT_MAX)
            -fflags FLAGS                       flags
            -fdebug FLAGS                       print specific debug info
            -max_delay INT                      maximum muxing or demuxing delay in microseconds (from -1 to INT_MAX)
            -start_time_realtime INT64          wall-clock time when stream begins (PTS==0) (from I64_MIN to I64_MAX)
            -audio_preload INT                  microseconds by which audio packets should be interleaved earlier (from 0 to 2.14748e+09)
            -chunk_duration INT                 microseconds for each chunk (from 0 to 2.14748e+09)
            -chunk_size INT                     size in bytes for each chunk (from 0 to 2.14748e+09)
            -flush_packets INT                  enable flushing of the I/O context after each packet (from -1 to 1)
            -metadata_header_padding INT        set number of bytes to be written as padding in a metadata header (from -1 to INT_MAX)
            -output_ts_offset DURATION          set output timestamp offset
            -max_interleave_delta INT64         maximum buffering duration for interleaving (from 0 to I64_MAX)
            -avoid_negative_ts INT              shift timestamps so they start at 0 (from -1 to 2)
            -sws_flags FLAGS                    swscale flags
            -scaler INT                         set scaling algorithm (from 0 to 8)
            -scaler_sub INT                     set subsampling algorithm (from 0 to 8)
            -param0 DOUBLE                      scaler param 0 (from INT_MIN to INT_MAX)
            -param1 DOUBLE                      scaler param 1 (from INT_MIN to INT_MAX)
            -srcw INT                           source width (from 1 to INT_MAX)
            -srch INT                           source height (from 1 to INT_MAX)
            -dstw INT                           destination width (from 1 to INT_MAX)
            -dsth INT                           destination height (from 1 to INT_MAX)
            -src_format PIX_FMT                 source format
            -dst_format PIX_FMT                 destination format
            -src_range BOOLEAN                  source is full range
            -dst_range BOOLEAN                  destination is full range
            -gamma BOOLEAN                      gamma correct scaling
            -src_v_chr_pos INT                  source vertical chroma position in luma grid/256 (from -513 to 1024)
            -src_h_chr_pos INT                  source horizontal chroma position in luma grid/256 (from -513 to 1024)
            -dst_v_chr_pos INT                  destination vertical chroma position in luma grid/256 (from -513 to 1024)
            -dst_h_chr_pos INT                  destination horizontal chroma position in luma grid/256 (from -513 to 1024)
            -sws_dither INT                     set dithering algorithm (from 0 to 5)
            -alphablend INT                     mode for alpha -> non alpha (from 0 to 2)
            -intent INT                         color mapping intent (from 0 to 3)
            -sws_backends FLAGS                 set allowed swscale backends
        `
    }
}

