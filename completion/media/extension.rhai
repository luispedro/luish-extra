// Completion for audio, video, image and PDF tools, by the command's name.
//
// The modules: `ffmpeg`, ffmpeg's completer and its kinds, `ffmpeg_opts`,
// the tables of its options, generated by scripts/gen/mk_ffmpeg.py, and
// `pdf`, the specs of Poppler's tools and their kinds, completed by std's
// engine (`@std/completion/lib`), as the commands of `module_of` are. luish
// calls a completer with the command's name as the first word.

// The module of each command (with `fn spec(cmd)`).
let module_of = #{};
for m in [
    ["pdf", ["pdftotext", "pdfinfo", "pdftoppm", "pdfimages", "pdfunite", "pdfseparate", "pdffonts", "pdftocairo",
             "pdftohtml", "pdftops", "pdfdetach", "pdfattach", "pdfsig"]],
] {
    for cmd in m[1] {
        module_of[cmd] = m[0];
    }
}

for cmd in module_of.keys() {
    sh::completer(cmd, |words, i| {
        import "@std/completion/lib" as lib;
        let m = module_of[words[0]];
        import m as specs;
        lib::complete(specs::spec(words[0]), words, i)
    });
}

// ffmpeg's options depend on where they are on the line (an input's or an output's, the codec and the format chosen
// before them) and many are read from the installed ffmpeg, so it has a completer of its own.
sh::completer("ffmpeg", |words, i| {
    import "ffmpeg" as m;
    m::complete(words, i)
});
