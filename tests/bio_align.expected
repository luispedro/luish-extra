data/sub/
data/tx.idx 
--- kallisto quant -g data/
data/genes.gtf 
data/sub/
--- kallisto quant -o data/
data/sub/
--- kallisto quant --f
--fr-stranded 	strand specific reads, first read forward
--fragment-length=	estimated average fragment length
--- kallisto bus -
--aa 	align to index generated from a FASTA-file containing amino acid sequences
--batch-barcodes 	records both batch and extracted barcode in BUS file
--fr-stranded 	strand specific reads for UMI-tagged reads, first read forward
--genomebam 	project pseudoalignments to genome sorted BAM file
--inleaved 	specifies that input is an interleaved FASTQ file
--long 	treat reads as long
--paired 	treat reads as paired
--rf-stranded 	strand specific reads for UMI-tagged reads, first read reverse
--threshold 	threshold for rate of unmapped kmers per read
--unstranded 	treat all read as non-strand-specific
--verbose 	print out progress information every 1M proccessed reads
-B 	process files listed in FILE
-N 	maximum number of reads to process from supplied input
-T 	5′ tag sequence to identify UMI reads for certain technologies
-b 	input file is a BAM file
-c 	tab separated file with chromosome names and lengths
-g 	for transcriptome information (required for --genomebam)
-i 	filename for the kallisto index to be used for pseudoalignment
-l 	list all single-cell technologies supported
-n 	output number of read in flag column (incompatible with --bam)
-o 	directory to write output to
-t 	number of threads to use
-x 	single-cell technology used
