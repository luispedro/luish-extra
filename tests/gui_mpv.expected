load 0
=== options
--- mpv --
--alang=	string list (default: )
--audio-device=	string (default: auto)
--display-fps-override=	double (0 to any) (default: 0)
--fs 	alias for --fullscreen
--fullscreen 	flag (default: no)
--help 	print the help (--help=FILTER: the options that match FILTER)
--hwdec=	string list (default: no)
--list-protocols 	print it and quit
--loop-file=	choices: no inf yes (or an integer) (0 to 10000) (default: no)
--loop=	alias for --loop-file
--profile=	string list (default: )
--screenshot-dir=	string (default: )
--screenshot-format=	choices: jpg jpeg png webp jxl avif (default: jpg)
--start=	relative time or percent position (default: none)
--sub-file-paths=	string list (default: )
--sub-file=	alias for --sub-files-append: append an item
--sub-files=	string list (default: )
--vf=	object settings list (default: )
--vo=	object settings list (default: )
--volume=	float (-1 to 1000) (default: 100)
--watch-later-dir=	string (default: )
--watch-later-directory=	alias for --watch-later-dir
--- mpv --f
--fs 	alias for --fullscreen
--fullscreen 	flag (default: no)
--- mpv --no-f
--no-fs 	alias for --fullscreen
--no-fullscreen 	flag (default: no)
--- mpv --alang-
--alang-add=	append an item (--alang)
--alang-append=	append an item (--alang)
--alang-clr 	clear the list (--alang)
--alang-del=	remove the items at these indexes (--alang)
--alang-pre=	prepend an item (--alang)
--alang-remove=	remove an item (--alang)
--alang-set=	set the whole list (--alang)
--alang-toggle=	append an item, or remove it if it is there (--alang)
--- mpv --sub-file
--sub-file-paths=	string list (default: )
--sub-file=	alias for --sub-files-append: append an item
--sub-files=	string list (default: )
--- mpv --sub-files-
--sub-files-add=	append an item (--sub-files)
--sub-files-append=	append an item (--sub-files)
--sub-files-clr 	clear the list (--sub-files)
--sub-files-del=	remove the items at these indexes (--sub-files)
--sub-files-pre=	prepend an item (--sub-files)
--sub-files-remove=	remove an item (--sub-files)
--sub-files-set=	set the whole list (--sub-files)
--sub-files-toggle=	append an item, or remove it if it is there (--sub-files)
--- mpv --gam
--- mpv --override
