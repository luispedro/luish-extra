#!/bin/sh
# Stand-in for Slurm's scontrol in the tests: a reservation and two licenses.
case "$*" in
"-o show reservation")
    printf 'ReservationName=maint StartTime=2026-11-01T08:00:00 EndTime=2026-11-01T12:00:00 Duration=04:00:00 Nodes=n[01-02] State=INACTIVE\n' ;;
"-o show licenses")
    printf 'LicenseName=matlab Total=10 Used=2 Free=8 Reserved=0 Remote=no\nLicenseName=ansys Total=4 Used=4 Free=0 Reserved=0 Remote=no\n' ;;
*) exit 1 ;;
esac
