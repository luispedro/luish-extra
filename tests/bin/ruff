    "prefix": "UP",
    "name": "pyupgrade",
    "url": "https://pypi.org/project/pyupgrade/"
  }
]
OUT
    ;;
"rule --all --output-format json")
    cat <<'OUT'
[
  {
    "name": "mutable-argument-default",
    "code": "B006",
    "linter": "flake8-bugbear",
    "summary": "Do not use mutable data structures for argument defaults",
    "message_formats": [
      "Do not use mutable data structures for argument defaults"
    ],
    "fix": "Fix is sometimes available.",
    "fix_availability": "Sometimes",
    "explanation": "## What it does\nChecks for uses of mutable objects as functi",
    "preview": false,
    "status": {
      "Stable": {
        "since": "v0.0.92"
      }
    },
    "category": "suspicious",
    "source_location": {
      "file": "crates/ruff_linter/src/rules/flake8_bugbear/rules/mutable_argument_default.rs",
      "line": 82
    }
  },
  {
    "name": "line-too-long",
    "code": "E501",
    "linter": "pycodestyle",
    "summary": "Line too long ({width} > {limit})",
