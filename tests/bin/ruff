    "url": "https://pypi.org/project/isort/"
  },
  {
    "prefix": "",
    "name": "pycodestyle",
    "url": "https://pypi.org/project/pycodestyle/",
    "categories": [
      {
        "prefix": "E",
        "name": "Error"
      },
      {
        "prefix": "W",
        "name": "Warning"
      }
    ]
  },
  {
    "prefix": "F",
