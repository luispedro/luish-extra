#!/bin/sh
# Stand-in for mmseqs in the tests: the help of the modules, in mmseqs's format.
case "$*" in
"-h")
    printf 'usage: mmseqs <command> [<args>]\n\nEasy workflows for plain text input/output\n  easy-search       \tSensitive homology search\n  easy-cluster      \tSlower, sensitive clustering\n\nInput database creation\n  createdb          \tConvert FASTA/Q file(s) to a sequence DB\n' ;;
"createdb -h")
    printf 'usage: mmseqs createdb <i:fastaFile1[.gz|.bz2]> ... <o:sequenceDB> [options]\noptions: prefilter:\n --mask INT              Mask sequences in prefilter stage with tantan: 0: w/o low complexity masking, 1: with low complexity masking [1]\nmisc:\n --dbtype INT            Database type 0: auto, 1: amino acid 2: nucleotides [0]\n --shuffle BOOL          Shuffle input database [1]\n --local-tmp STR         Path where some of the temporary files will be created []\ncommon:\n --threads INT           Number of CPU-cores used (all by default) [16]\n -v INT                  Verbosity level: 0: quiet, 1: +errors, 2: +warnings, 3: +info [3]\n' ;;
"easy-search -h")
    printf 'usage: mmseqs easy-search <i:queryFastaFile1> ... <o:alignmentFile> <tmpDir> [options]\noptions: prefilter:\n -s FLOAT                         Sensitivity: 1.0 faster; 4.0 fast; 7.5 sensitive [5.700]\n --max-seqs INT                   Maximum results per query sequence allowed to pass the prefilter [300]\n -e DOUBLE                        List matches below this E-value (range 0.0-inf) [1.000E-03]\n --format-output STR              Choose comma separated list of output columns [query,target,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits]\n --add-self-matches BOOL          Artificially add entries of queries with themselves [0]\n' ;;
*) exit 1 ;;
esac
