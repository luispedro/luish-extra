#!/bin/sh
# Stand-in for xrandr in the tests: `--query` (xrandr 1.5.2) with two outputs, one of them disconnected.
case "$*" in
"--query" | "--display :1 --query")
    cat <<'OUT'
Screen 0: minimum 320 x 200, current 1920 x 1080, maximum 16384 x 16384
eDP-1 connected primary 1920x1080+0+0 (normal left inverted right x axis y axis) 344mm x 193mm
   1920x1080     60.01*+  59.97    59.96  
   1680x1050     59.95  
   1280x720      60.00    59.99  
HDMI-1 disconnected (normal left inverted right x axis y axis)
DP-1 connected 2560x1440+1920+0 (normal left inverted right x axis y axis) 597mm x 336mm
   2560x1440     59.95*+
   1920x1080     60.00    50.00  
   1280x720      60.00  
OUT
    ;;
*)
    exit 1
    ;;
esac
