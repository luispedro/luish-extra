load 0
=== samtools
--- samtools sor
sort 	sort an alignment file
--- samtools sort -
--input-fmt-option=	an input format option
--no-PG 	do not add a PG line
--output-fmt-option=	an output format option
--reference=	the reference FASTA
--template-coordinate 	sort by template coordinate
--verbosity=	set the level of verbosity
--write-index 	automatically index the output files
-@ 	number of additional threads to use
-H 	squash homopolymers for the minimiser
-I 	order minimisers by their position in FILE
-K 	k-mer size for the minimiser
-M 	use minimisers for clustering unaligned reads
-N 	sort by read name (ASCII)
-O 	the output format
-R 	do not use the reverse strand (with -M)
-T 	write temporary files to PREFIX.nnnn.bam
-l 	compression level, from 0 to 9
-m 	maximum memory per thread (K, M or G)
-n 	sort by read name (natural)
-o 	write output to FILE
-t 	sort by the value of TAG
-u 	uncompressed output
-w 	window size for minimiser indexing
--- samtools sort -O 
BAM 
CRAM 
SAM 
--- samtools sort --output-fmt=
--output-fmt=BAM 
--output-fmt=CRAM 
--output-fmt=SAM 
--- samtools sort -o out.bam data/
data/a.bam 
data/b.sam 
data/c.cram 
data/sub/
--- samtools view -T data/
data/genome.fa 
data/genome.fa.gz 
data/sub/
--- samtools view --reference=data/
--reference=data/genome.fa 
--reference=data/genome.fa.gz 
--reference=data/sub/
--- samtools view -L data/
data/peaks.bed 
data/peaks.bed.gz 
data/sub/
--- samtools view -b data/
data/a.bam 
data/b.sam 
data/c.cram 
data/sub/
