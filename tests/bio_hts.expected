--- samtools coverage --
--ascii 	show only ASCII characters in the histogram
--bam-list=	file listing the input alignment files
--depth=	maximum coverage depth
--ff=	filter flags
--help 	show help
--histogram 	show a histogram instead of a table
--input-fmt-option=	an input format option
--min-BQ=	base quality threshold
--min-MQ=	mapping quality threshold
--min-read-len=	ignore reads shorter than N bp
--n-bins=	number of bins in the histogram
--no-header 	no header in tabular mode
--output=	write output to FILE
--plot-depth 	plot depth instead of a table
--reference=	the reference FASTA
--region=	show this region
--rf=	required flags
--verbosity=	set the level of verbosity
