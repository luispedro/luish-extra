--- datamash --
--collapse-delimiter=	use X to separate elements in collapse and unique lists
--field-separator=	use X instead of TAB as field delimiter
--filler=	fill missing values with X
--format=	print numeric values with printf style floating-point FORMAT
--full 	print the entire input line before the operation results
--group=	group by fields X,[Y,Z]; the same as the primary operation 'groupby'
--header-in 	the first input line is column headers
--header-out 	print column headers as the first line
--headers 	the same as '--header-in --header-out'
--help 	display the help and exit
--ignore-case 	ignore upper/lower case when comparing text
--narm 	skip NA/NaN values
--no-strict 	allow lines with varying number of fields
--output-delimiter=	use X instead as output field delimiter
--round=	round numeric output to N decimal places
--seed=	set a seed for operations that use randomization
--skip-comments 	skip comment lines (starting with '#' or ';' and optional whitespace)
--sort 	sort the input before grouping
--sort-cmd=	alternative sort(1) to use
--version 	output version information and exit
--vnlog 	read and write data in the vnlog format
--whitespace 	use whitespace (one or more spaces and/or tabs) for field delimiters
--zero-terminated 	end lines with a 0 byte, not newline
