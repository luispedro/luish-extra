load 0
=== duckdb
--- duckdb -
-ascii 	set output mode to 'ascii'
-bail 	stop after hitting an error
-batch 	force batch I/O
-box 	set output mode to 'box'
-c 	run COMMAND and exit
-cmd 	run COMMAND before reading stdin
-column 	set output mode to 'column'
-csv 	set output mode to 'csv'
-dark-mode 	use dark mode colors
-echo 	print commands before execution
-f 	read and process the named file and exit
-h 	show help message
-header 	turn headers on
-help 	show help message
-html 	set output mode to HTML
-init 	read and process the named file
-interactive 	force interactive I/O
-json 	set output mode to 'json'
-jsonlines 	set output mode to 'jsonlines'
-light-mode 	use light mode colors
-line 	set output mode to 'line'
-list 	set output mode to 'list'
-markdown 	set output mode to 'markdown'
-newline 	set output row separator
-no-init 	skip processing the init file
-no-stdin 	exit after processing options instead of reading stdin
-noheader 	turn headers off
-nullvalue 	set text string for NULL values
-quote 	set output mode to 'quote'
-readonly 	open the database read-only
-s 	run COMMAND and exit
-safe 	enable safe-mode
-separator 	set output column separator
-storage-version 	database storage compatibility version to use
-table 	set output mode to 'table'
-ui 	launch a web interface using the ui extension
-unredacted 	allow printing unredacted secrets
-unsigned 	allow loading of unsigned extensions
-version 	show DuckDB version
--- duckdb -cs
-csv 	set output mode to 'csv'
--- duckdb -f 
analysis.R 
archive.tar 
bin/
data.tsv 
list.meta4 
model.duckdb 
notes.txt 
plot.gp 
run.r 
science_tools.sh 
seeds.torrent 
--- duckdb mo
model.duckdb 
