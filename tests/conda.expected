--- the first shell runs conda
PATH=~/miniconda3/envs/py/bin:~/miniconda3/condabin:/usr/bin:/bin
PS1=(py) $  CONDA_SHLVL=1 CONDA_PREFIX=~/miniconda3/envs/py
CONDA_DEFAULT_ENV=py FROM_SCRIPT=1 FROM_NEW=
conda is a shell function
0
ran: conda shell.bash hook
ran: conda shell.posix activate py
