--- cython --directive=c_string_type=
--directive=c_string_type=bytearray 
--directive=c_string_type=bytes 
--directive=c_string_type=str 
--directive=c_string_type=unicode 
--- cython --emb
--embed	generate a main() function (or NAME()) that embeds the Python interpreter
--embed-modules=	the modules to embed with --embed (comma-separated)
--embed-positions 	embed the positions of the definitions in the Cython files in their docstrings
--- cython -I 
build/
pkg/
--- cython -W
-Werror 	make all warnings into errors
-Wextra 	enable extra warnings
=== cythonize
--- cythonize 
build/
main.py 
pkg/
--- cythonize -i pkg/
pkg/__init__.py 
pkg/fast.pyx 
--- cythonize -X wrap
wraparound=
--- cythonize --
--3str 	use Python 3 syntax mode by default (deprecated alias for -3)
--annotate 	produce a colorized HTML version of the source
--annotate-fullc 	produce a colorized HTML version of the source which includes entire generated C/C++-code
--build 	build extension modules using distutils/setuptools
--compile-time-env=	set compile-time constants, as DEF would (NAME=VALUE, comma-separated)
--cplus 	compile as C++ rather than C
--depfile 	produce depfiles for the sources
--directive=	override compiler directives (NAME=VALUE, comma-separated)
--exclude=	exclude certain file patterns from the compilation
--force 	force recompilation
--help 	show this help message and exit
--inplace 	build extension modules in place using distutils/setuptools (implies -b)
--keep-going 	compile as much as possible, ignore compilation failures
--lenient 	increase Python compatibility by ignoring some compile time errors
--no-docstrings 	strip docstrings
--option=	set an option of cythonize (NAME=VALUE)
--parallel=	run builds in N parallel jobs
--quiet 	be less verbose during compilation
--setup=	use CODESTRING as pre-benchmark setup code for --bench
--timeit=	build in place, then compile+run CODESTRING as benchmark in first module's namespace
