=== bracken
--- bracken -
-d 	location of Kraken database
-i 	Kraken report file to use for abundance estimation
-l 	level to estimate abundance at: D, P, C, O, F, G, S, S1, ...
-o 	file name for Bracken default output
-r 	read length to get all classifications for
-t 	number of reads required prior to abundance estimation to reestimate
-v 	echoes the current software version and exits
-w 	new Kraken report with Bracken's read estimates
--- bracken -l 
C 
C1 
D 
D1 
F 
F1 
G 
G1 
O 
O1 
P 
P1 
S 
S1 
--- bracken-build -y 
kraken 
kraken2 
krakenuniq 
--- combine_bracken_outputs.py --
--files=	bracken output files to combine
--help 	show this help message and exit
--names=	names of the input files, comma-separated, for the column headers
--output=	name of output file with combined Bracken results
=== krakenuniq
--- krakenuniq --report
--report-file=	write the report (with unique k-mer counts) to filename
--- krakenuniq-build --download-library 
refseq/archaea 
refseq/bacteria 
refseq/viral 
--- krakenuniq-build --lca
--lca-database 	build a LCA database
--lca-order=	set the LCAs from this directory of the library first (once per directory, in order)
--- krakenuniq-download 
contaminants 
genbank/archaea 
genbank/bacteria 
genbank/fungi 
genbank/invertebrate 
genbank/plant 
genbank/protozoa 
genbank/vertebrate_mammalian 
genbank/vertebrate_other 
genbank/viral 
microbial-nt 
nt 
nucleotide 
refseq/archaea 
refseq/bacteria 
refseq/fungi 
refseq/invertebrate 
refseq/plant 
refseq/protozoa 
refseq/vertebrate_mammalian 
refseq/vertebrate_other 
refseq/viral 
taxonomy 
viral-neighbors 
--- krakenuniq-download -
--ac=	accessions of the nucleotide database to download, comma-separated (instead of --search)
--db=	download to DIRECTORY/{library,taxonomy} (instead of -o)
--exclude-environmental-taxa 	exclude taxa that are named 'environmental samples'
--fna=	sequence types, comma-separated: genomic, rna, rna_from_genomic, cds_from_genomic
--mapping-file=	map accessions with these files: nucl_est, nucl_gb, nucl_gss, nucl_wgs
--min-seq-len=	filter all sequences from the FASTA files that have less than X bp
--overwrite 	redownload and overwrite files with the same name
--retmode=	return mode: text, asn.1, xml
--rettype=	return type: fasta, gb, gbc, native, ...
--search=	download all sequences returned from a NCBI nucleotide search
--taxa=	taxa to keep from nt, comma-separated: taxIDXXXX or a division (bacteria, viral, ...)
--threads=	number of processes when downloading
--verbose 	be verbose
-D 	mask low-complexity regions using dustmasker
-R 	download using rsync
-o 	folder to which the files are downloaded
-u 	filter unplaced sequences
--- krakenuniq-report --
--db=	Kraken DB directory
--show-zeros 	show full taxonomy table
--taxon-counts 	the input files are 'TAXID<tab>COUNT' instead of Kraken output
--taxon-list 	the input files are lists of taxon IDs instead of Kraken output
=== centrifuge
--- centrifuge -x data/cfdb/
data/cfdb/p_compressed 
--- centrifuge --out-fmt 
sam 
tab 
--- centrifuge --un-c
--un-conc-bz2=	like --un-conc, bzip2 compressed
--un-conc-gz=	like --un-conc, gzip compressed
--un-conc=	write pairs that didn't align concordantly to PATH
--- centrifuge-build -
--bmax=	maximum bucket size for the blockwise suffix-array builder
--bmaxdivn=	maximum bucket size as a divisor of the reference length
--conversion-table=	a table that converts any id to a taxonomy id
--dcv=	diff-cover period for blockwise
--kmer-count=	k size for counting the number of distinct k-mer
--name-table=	names corresponding to taxonomic IDs
--nodc 	disable diff-cover (algorithm becomes quadratic)
--seed=	seed for random number generator
--size-table=	table of contig (or genome) sizes
--taxonomy-tree=	taxonomy tree
--usage 	print this usage message
--version 	print version information and quit
-3 	just build the .3/.4 (packed reference) portion
-a 	disable automatic -p/--bmax/--dcv memory-fitting
-c 	the reference sequences are given on the command line, not files
-h 	print detailed description of tool and its options
-o 	sample the SA every 2^offrate BWT characters
-p 	number of alignment threads to launch
-q 	quiet output
-r 	don't build the .3/.4 (packed reference) portion
-t 	number of characters consumed in the initial lookup
--- centrifuge-build --taxonomy-tree data/
data/cfdb/
data/k2db/
data/names.dmp 
data/nodes.dmp 
--- centrifuge-build data/genomes.fna data/cfdb/
data/cfdb/p_compressed 
--- centrifuge-inspect data/cfdb/
data/cfdb/p_compressed 
--- centrifuge-kreport -x data/cfdb/
data/cfdb/p_compressed 
