--no-desc 	do not show description
--no-provision	don't provision tox, fail (and write the provision's metadata as JSON to REQ_JSON)
--no-recreate-provision 	if recreate is set do not recreate provision tox environment
--override=	override a setting of the configuration (testenv:NAME.KEY=VALUE)
--quiet 	decrease verbosity
--recreate 	recreate the tox environments
--root=	project root directory (if not specified will be the folder of the config file)
--runner=	the tox run engine to use when not explicitly stated in tox env configuration
--skip-env=	exclude all environments selected that match this regular expression
--stderr-color=	color for stderr output, use RESET for terminal defaults
--verbose 	increase verbosity
--version 	show program's and plugins version number and exit
--workdir=	tox working directory (if not specified will be the folder of the config file)
