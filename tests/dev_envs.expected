--- pipx upgrade --
--backend=	backend used for creating venvs and managing packages
--cooldown=	ignore files uploaded to the index less than DAYS days ago
--editable 	install a project in editable mode
--fetch-missing-python 	deprecated: alias for --fetch-python=missing
--fetch-python=	when to fetch a standalone Python build from python-build-standalone
--force 	modify an existing environment and the files in PIPX_BIN_DIR and PIPX_MAN_DIR
--global 	perform action globally for all users
--help 	show this help message and exit
--include-injected 	also upgrade packages injected into the main app's environment
--index-url=	the base URL of the Python package index
--install 	install package spec if missing
--output=	select the output format
--pip-args=	arguments to pass to pip (quoted, as one word)
--python=	the Python to install with (a version, such as 3.12, or a path)
--quiet 	give less output
--skip-maintenance 	do not upgrade shared libraries; use bundled pip when creating them
--system-site-packages 	give the virtual environment access to the system site-packages dir
--verbose 	give more output
