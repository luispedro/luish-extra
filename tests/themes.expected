--- the schemes
* default-dark (dark background, from $LUISH_BACKGROUND)
  default-light
  ansi-dark
  ansi-light
  catppuccin-latte
  catppuccin-mocha
  gruvbox-dark
  gruvbox-light
  solarized-dark
  solarized-light
  tokyonight-day
  tokyonight-night
--- ansi-dark
command              green
command.builtin      green
command.function     bold green
command.alias        italic green
command.external     green
command.precommand   italic magenta
command.directory    bold bright-blue
command.history      yellow
command.unknown      bold red
keyword              bold magenta
arg                  plain
arg.option           bright-blue
arg.subcommand       plain
string               yellow
string.single        yellow
string.double        yellow
string.dollar        yellow
string.heredoc       yellow
string.escape        bold bright-yellow
var                  cyan
var.special          bright-cyan
var.array            italic cyan
var.exported         bold cyan
var.readonly         bright-cyan
var.unset            italic red
subst                bright-magenta
subst.command        bright-magenta
subst.process        bright-magenta
subst.arith          bright-magenta
expand               bright-yellow
expand.tilde         bright-yellow
expand.brace         bright-yellow
expand.glob          bright-yellow
op                   bold
op.control           bold
op.pipe              bold
redir                bold
redir.fd             bold bright-yellow
assign               cyan
comment              italic bright-black
error                underline red
path                 underline
path.prefix          underline
match                bold bg:bright-black
menu                 plain
menu.selected        reverse
menu.description     bright-black
suggestion           bright-black
--- ansi-light
command              green
command.builtin      green
command.function     bold green
command.alias        italic green
command.external     green
command.precommand   italic magenta
command.directory    bold blue
command.history      136
command.unknown      bold red
keyword              bold magenta
arg                  plain
arg.option           blue
arg.subcommand       plain
string               136
string.single        136
string.double        136
string.dollar        136
string.heredoc       136
string.escape        bold 136
var                  cyan
var.special          blue
var.array            italic cyan
var.exported         bold cyan
var.readonly         blue
var.unset            italic red
subst                magenta
subst.command        magenta
subst.process        magenta
subst.arith          magenta
expand               bold magenta
expand.tilde         bold magenta
expand.brace         bold magenta
expand.glob          bold magenta
op                   bold
op.control           bold
op.pipe              bold
redir                bold
redir.fd             bold magenta
assign               cyan
comment              italic bright-black
error                underline red
path                 underline
path.prefix          underline
match                bold bg:white
menu                 plain
menu.selected        reverse
menu.description     bright-black
suggestion           bright-black
