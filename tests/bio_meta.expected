load 0
=== rgi
--- rgi 
auto_load 	automatically load the CARD database, annotations and k-mer database
baits_annotation 	create FASTA files with annotations from baits
bwt 	align reads to CARD and in silico predicted allelic variants
card_annotation 	create FASTA files with annotations from card.json
clean 	remove BLAST databases and temporary files
database 	information on the installed CARD database
galaxy 	Galaxy project wrapper
heatmap 	heatmap for multiple RGI results
kmer_build 	build the k-mer sets for CARD*kmers
kmer_query 	test sequences using CARD*kmers
load 	load the CARD database, annotations and k-mer database
main 	run RGI to predict a resistome from a FASTA or gzip file
parser 	create categorical JSON files for the RGI wheel visualization
remove_duplicates 	remove duplicate sequences from an annotated FASTA file
tab 	create a tab-delimited file from an RGI results JSON file
tm 	baits melting temperature
wildcard_annotation 	create FASTA files with annotations from variants
--- rgi ma
main 	run RGI to predict a resistome from a FASTA or gzip file
--- rgi main -
--clean 	remove temporary files
--debug 	debug mode
--include_loose 	include loose hits in addition to strict and perfect hits
--include_nudge 	include hits nudged from loose to strict hits
--keep 	keep Prodigal CDS when used with --clean
--local 	use local database
--low_quality 	use for short contigs to predict partial genes
-a 	specify alignment tool
-d 	specify a data-type
-g 	specify ORF finding tool
-h 	show this help message and exit
-i 	input FASTA (contig or protein), or gzip
-n 	number of threads (CPUs) to use in the BLAST search
-o 	output folder and base filename
-t 	specify data input type
-v 	print software version number
--- rgi main -i data/
data/contigs.fna 
data/sub/
--- rgi main -t 
contig 
protein 
--- rgi main -a 
BLAST 
DIAMOND 
--- rgi main -d 
NA 
chromosome 
plasmid 
wgs 
--- rgi main -g 
PRODIGAL 
PYRODIGAL 
--- rgi tab -i data/
data/card.json 
data/contigs.fna 
data/notes.txt 
data/reads_1.fq.gz 
data/reads_2.fq.gz 
data/sub/
--- rgi bwt -1 data/
data/reads_1.fq.gz 
data/reads_2.fq.gz 
data/sub/
--- rgi bwt -a 
bowtie2 
bwa 
kma 
--- rgi load --card_annotation data/
data/contigs.fna 
data/sub/
--- rgi load --wildcard_index data/
data/card.json 
data/contigs.fna 
data/notes.txt 
data/reads_1.fq.gz 
data/reads_2.fq.gz 
data/sub/
--- rgi wildcard_annotation -i data/
data/sub/
--- rgi heatmap -cat 
drug_class 
gene_family 
resistance_mechanism 
--- rgi heatmap -clus 
both 
genes 
samples 
--- rgi heatmap -d 
fill 
plain 
text 
--- rgi kmer_query --
--bwt 	the input file is a BAM file generated from RGI*BWT
--debug 	debug mode
--fasta 	the input file is a FASTA file of sequences
--help 	show this help message and exit
--input=	a BAM file from RGI*BWT, a JSON file of RGI results, or a FASTA file
--kmer_size=	length of k
--local 	use local database
--minimum=	minimum number of kmers in the called category for the classification
--output=	output file name
--rgi 	the input file is an RGI results JSON file
--threads=	number of threads (CPUs) to use
--- rgi kmer_build -c data/
data/contigs.fna 
data/sub/
--- rgi database -
--all 	data version number used for 'rgi bwt' and 'rgi main'
--local 	use local database
-h 	show this help message and exit
-v 	print data version number
--- rgi auto_load --
--canonical 	load only CARD canonical data
--clean 	remove temporary files
--debug 	debug mode
--help 	show this help message and exit
--local 	use local database
=== amrfinder
--- amrfinder -
--blast_bin=	directory for BLAST
--debug 	integrity checks
--gpipe_org 	NCBI internal GPipe organism names
--hmmer_bin=	directory for HMMer
--log=	error log file, appended
--mutation_all=	file to report all mutations
--name=	text added as the first column of the report
--nucleotide_flank5_output=	output FASTA of reported sequences with 5' flanking sequences
--nucleotide_flank5_size=	5' flanking sequence size
--nucleotide_output=	output nucleotide FASTA file of reported sequences
--parm=	amr_report parameters for testing
--pgap 	input files are created by the NCBI PGAP
--plus 	add the plus genes to the report
--print_node 	print the hierarchy node (family)
--protein_output=	output protein FASTA file of reported proteins
--report_all_equal 	report all equally-scoring BLAST and HMM matches
--report_common 	report proteins common to a taxonomy group
--threads=	max. number of threads
-O 	taxonomy group, for point mutations
-U 	force updating the AMRFinder database
-V 	print the database version and exit
-a 	type of GFF file
-c 	minimum coverage of the reference protein (0..1)
-d 	alternative directory with the AMRFinder database
-g 	GFF file for protein locations (can be gzipped)
-h 	show the help and exit
-i 	minimum proportion of identical amino acids for a hit (0..1)
-l 	print the possible taxonomy groups and exit
-n 	input nucleotide FASTA file (can be gzipped)
-o 	write the output to a file instead of standard output
-p 	input protein FASTA file (can be gzipped)
-q 	suppress messages to standard error
-t 	NCBI genetic code for translated BLAST
-u 	update the AMRFinder database
-v 	print the software version and exit
--- amrfinder -p amr/
amr/contigs.fna 
amr/proteins.faa.gz 
amr/sub/
--- amrfinder -n amr/
amr/contigs.fna 
amr/proteins.faa.gz 
amr/sub/
--- amrfinder -g amr/
amr/genes.gff 
amr/sub/
--- amrfinder -a 
bakta 
genbank 
microscope 
patric 
pgap 
prodigal 
prokka 
pseudomonasdb 
rast 
standard 
--- amrfinder -d amr/
amr/sub/
--- amrfinder -O 
Campylobacter 
Escherichia 
Salmonella 
--- amrfinder --organism E
Escherichia 
--- amrfinder -d other -O 
Klebsiella_pneumoniae 
Vibrio_cholerae 
--- amrfinder --database=other --organism 
Klebsiella_pneumoniae 
Vibrio_cholerae 
--- amrfinder_update -
--blast_bin=	directory for BLAST
--debug 	integrity checks
--force_update 	force updating the AMRFinder database
--hmmer_bin=	directory for HMMer
--log=	error log file, appended
-d 	directory for all versions of AMRFinder databases
-h 	show the help and exit
-q 	suppress messages to standard error
-v 	print the software version and exit
