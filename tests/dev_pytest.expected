=== options and values
--- pytest --tb=
--tb=auto 
--tb=line 
--tb=long 
--tb=native 
--tb=no 
--tb=short 
--- pytest --lf
--lf 	rerun only the tests that failed at the last run (or all if none failed)
--lfnf=	with --lf, what to run when there are no known failures
--- pytest -o log_c
log_cli=	enable log display during test run (also known as 'live logging')
log_cli_date_format=	default value for --log-cli-date-format
log_cli_format=	default value for --log-cli-format
log_cli_level=	default value for --log-cli-level
--- pytest --log-level 
CRITICAL 
DEBUG 
ERROR 
INFO 
WARNING 
