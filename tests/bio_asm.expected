data/genes.gff 
data/models.hmm 
data/notes.txt 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- hmm_mapper.py --hmm_
--hmm_evalue=	e-value threshold
--hmm_maxhits=	max number of hits to report (0 to report all)
--hmm_maxseqlen=	ignore query sequences longer than this
--hmm_qcov=	minimum query coverage (0-1)
--hmm_score=	bit score threshold
