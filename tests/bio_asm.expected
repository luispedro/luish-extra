load 0
=== spades.py, metaspades.py
--- spades.py --pe-
--pe-12=	file with interlaced reads for paired-end library number N
--pe-1=	file with forward reads for paired-end library number N
--pe-2=	file with reverse reads for paired-end library number N
--pe-m=	file with merged reads for paired-end library number N
--pe-or=	orientation of reads for paired-end library number N
--pe-s=	file with unpaired reads for paired-end library number N
--- spades.py -1 data/
data/a.bam 
data/contigs.fa 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- spades.py --pe-1 1 data/
data/a.bam 
data/contigs.fa 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- spades.py --trusted-contigs data/
data/contigs.fa 
data/sub/
--- spades.py --restart-from 
as 
ec 
last 
mc 
--- spades.py -o data/
data/sub/
--- metaspades.py --
--12=	file with interlaced forward and reverse paired-end reads
--checkpoints=	save intermediate check-points ('last', 'all')
--continue 	continue run from the last available check-point (only -o should be specified)
--custom-hmms=	directory with custom hmms that replace default ones
--dataset=	file with dataset description in YAML format
--disable-gzip-output 	forces error correction not to compress the corrected reads
--disable-rr 	disables repeat resolution stage of assembling
--frugal 	be memory frugal (at the expense of the possible assembly quality)
--gfa11 	use GFA v1.1 format for assembly graph
--grid-engine=	run under grid control ('slurm', 'local', 'mpi', save_yaml')
--grid-extra=	any extra commands
--grid-nnodes=	specifies the number of processors
--grid-queue=	submits the jobs to one of the specified queues
--grid-time=	time limit
--grid-wait 	wait for job finish
--help 	prints this usage message
--iontorrent 	this flag is required for IonTorrent data
--memory=	RAM limit for SPAdes in Gb (terminates if exceeded)
--merged=	file with merged forward and reverse paired-end reads
--nanopore=	file with Nanopore reads
--only-assembler 	runs only assembling (without read error correction)
--only-error-correction 	runs only read error correction (without assembling)
--pacbio=	file with PacBio reads
--pe-12=	file with interlaced reads for paired-end library number N
--pe-1=	file with forward reads for paired-end library number N
--pe-2=	file with reverse reads for paired-end library number N
--pe-m=	file with merged reads for paired-end library number N
--pe-or=	orientation of reads for paired-end library number N
--pe-s=	file with unpaired reads for paired-end library number N
--phred-offset=	PHRED quality offset in the input reads (33 or 64)
--restart-from=	restart run with updated options and from the specified check-point
--s=	file with unpaired reads for single reads library number N
--test 	runs SPAdes on toy dataset
--threads=	number of threads
--tmp-dir=	directory for temporary files
--version 	prints version
=== megahit
--- megahit --presets 
meta-large 
meta-sensitive 
--- megahit -r data/
data/a.bam 
data/contigs.fa 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- megahit --k-
--k-list=	comma-separated list of k-mer sizes (odd, 15-255, steps <= 28)
--k-max=	maximum kmer size (<= 255), must be odd number
--k-min=	minimum kmer size (<= 255), must be odd number
--k-step=	increment of kmer size of each iteration (<= 28), must be even number
=== flye
--- flye --nano
--nano-corr=	ONT reads that were corrected with other methods
--nano-hq=	ONT R10 reads, aka Q20
--nano-raw=	ONT reads with older chemistries, pre R9 Guppy5 (10-20% error)
--- flye --nano-hq data/
data/a.bam 
data/contigs.fa 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- flye --nano-hq data/ont.fastq data/
data/a.bam 
data/contigs.fa 
data/ont.fastq 
data/r1.fq.gz 
data/r2.fq.gz 
data/sub/
--- flye --stop-after 
assembly 
configure 
consensus 
contigger 
finalize 
polishing 
repeat 
--- flye --polish-target data/
data/contigs.fa 
data/sub/
