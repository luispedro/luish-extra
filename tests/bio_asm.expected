data/sub/
--- megahit --k-
--k-list=	comma-separated list of k-mer sizes (odd, 15-255, steps <= 28)
--k-max=	maximum kmer size (<= 255), must be odd number
--k-min=	minimum kmer size (<= 255), must be odd number
--k-step=	increment of kmer size of each iteration (<= 28), must be even number
