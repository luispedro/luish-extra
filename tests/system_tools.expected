=== borg
--- borg 
benchmark 	benchmark command
break-lock 	break repository and cache locks
check 	verify repository
compact 	compact segment files / free space in repo
config 	get and set configuration values
create 	create backup
debug 	debugging command
delete 	delete archive
diff 	find differences in archive contents
export-tar 	create tarball from archive
extract 	extract archive contents
help 	show help on a command or a topic
import-tar 	create a backup archive from a tarball
info 	show repository or archive information
init 	initialize empty repository
key 	manage repository key
list 	list archive or repository contents
mount 	mount repository
prune 	prune archives
recreate 	re-create archives
rename 	rename archive
serve 	start repository server process
umount 	umount repository
upgrade 	upgrade repository format
with-lock 	run user command with lock held
--- borg --lock
--lock-wait=	wait at most SECONDS for acquiring a repository/cache lock
--- borg init -e 
authenticated 
authenticated-blake2 
keyfile 
keyfile-blake2 
none 
repokey 
repokey-blake2 
--- borg init --encryption=repokey-
--encryption=repokey-blake2 
--- borg init back
backups/
--- borg init backups/
backups/repo/
--- borg create --comp
--compression=	the compression algorithm (see borg help compression)
--- borg create -C 
auto,	compress only data that lz4 finds compressible
lz4 	very high speed, very low compression (default)
lzma 	low speed, high compression (level 6)
lzma,	lzma with a level (0-9)
none 	no compression
obfuscate,	obfuscate the sizes of the compressed chunks
zlib 	medium speed, medium compression (level 6)
zlib,	zlib with a level (0-9)
zstd 	modern wide-range algorithm (level 3)
zstd,	zstd with a level (1-22)
--- borg create --compression=zs
--compression=zstd 	modern wide-range algorithm (level 3)
--compression=zstd,	zstd with a level (1-22)
--- borg create --chunker-params 
buzhash,	CHUNK_MIN_EXP,CHUNK_MAX_EXP,HASH_MASK_BITS,HASH_WINDOW_SIZE
default 	buzhash,19,23,21,4095
fixed,	BLOCK_SIZE[,HEADER_SIZE]
--- borg create --files-cache=
--files-cache=ctime,size 
--files-cache=ctime,size,inode 
--files-cache=disabled 
--files-cache=mtime,size 
--files-cache=mtime,size,inode 
--files-cache=rechunk,ctime 
--files-cache=rechunk,mtime 
--files-cache=size 
--- borg create --exclude-from 
backups/
bin/
excludes.txt 
mnt/
src/
system_tools.sh 
--- borg create backups/repo::today 
backups/
bin/
excludes.txt 
mnt/
src/
system_tools.sh 
