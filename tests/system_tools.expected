--- borg prune --keep-
--keep-daily=	number of daily archives to keep
--keep-hourly=	number of hourly archives to keep
--keep-last=	number of secondly archives to keep
--keep-minutely=	number of minutely archives to keep
--keep-monthly=	number of monthly archives to keep
--keep-secondly=	number of secondly archives to keep
--keep-weekly=	number of weekly archives to keep
--keep-within=	keep all archives within this time interval
--keep-yearly=	number of yearly archives to keep
--- borg recreate --recompress=
--recompress=always 
--recompress=if-different 
--recompress=never 
--- borg mount backups/repo mn
mnt/
--- borg umount /zz-no-such-mount
--- borg key 
change-passphrase 	change repository passphrase
export 	export repository key for backup
import 	import repository key from backup
migrate-to-repokey 	migrate passphrase-mode repository to repokey
--- borg key export --
--bypass-lock 	bypass locking mechanism
--consider-part-files 	treat part files like normal files (e.g to list/extract them)
--critical 	work on log level CRITICAL
--debug 	enable debug output, work on log level DEBUG
--debug-profile=	write an execution profile into FILE
--debug-topic=	enable TOPIC debugging (can be specified multiple times)
--error 	work on log level ERROR
--help 	show this help message and exit
--iec 	format using IEC units (1KiB = 1024B)
--info 	work on log level INFO
--lock-wait=	wait at most SECONDS for acquiring a repository/cache lock
--log-json 	output one JSON object per log line instead of formatted text
--paper 	create an export suitable for printing and later type-in
--progress 	show progress information
--qr-html 	create an html file suitable for printing and later type-in or qr scan
--remote-buffer=	deprecated, use --upload-buffer instead
--remote-path=	use PATH as borg executable on the remote
--remote-ratelimit=	deprecated, use --upload-ratelimit instead
--rsh=	use this command to connect to the 'borg serve' process
--show-rc 	show/log the return code (rc)
--show-version 	show/log the borg version
--umask=	set umask to M (local only, default: 0077)
--upload-buffer=	set network upload buffer size in MiB
--upload-ratelimit=	set network upload rate limit in kiByte/s
--verbose 	work on log level INFO
--warning 	work on log level WARNING
