=== filtergraphs
--- ffmpeg -i in.mp4 -vf 
crop	crop the input video
format	convert the input video to one of the specified pixel formats
fps	force constant framerate
hflip	horizontally flip the input video
overlay	overlay a video source on top of the input
scale	scale the input video size and/or convert the image format
split	pass on the input to N video outputs
--- ffmpeg -i in.mp4 -vf scale=w=1280:h=-1,f
scale=w=1280:h=-1,format	convert the input video to one of the specified pixel formats
scale=w=1280:h=-1,fps	force constant framerate
--- ffmpeg -i in.mp4 -af 
amix	audio mixing
aresample	resample audio data
volume	change input volume
--- ffmpeg -i in.mp4 -filter:a 
amix	audio mixing
aresample	resample audio data
volume	change input volume
--- ffmpeg -i in.mp4 -vf scale=
scale=flags=	flags to pass to libswscale
scale=h=	output video height
scale=in_range=	set input color range (from 0 to 2)
scale=interl=	set interlacing
scale=w=	output video width
--- ffmpeg -i in.mp4 -vf scale=w=1280:in_r
scale=w=1280:in_range=	set input color range (from 0 to 2)
--- ffmpeg -i in.mp4 -vf scale=in_range=
scale=in_range=auto
scale=in_range=full
scale=in_range=jpeg
scale=in_range=limited
scale=in_range=mpeg
scale=in_range=pc
scale=in_range=tv
scale=in_range=unknown
--- ffmpeg -i in.mp4 -vf format=pix_fmts=
format=pix_fmts=nv12 	3 components, 12 bits per pixel
format=pix_fmts=rgb24 	3 components, 24 bits per pixel
format=pix_fmts=yuv420p 	3 components, 12 bits per pixel
format=pix_fmts=yuv420p10le 	3 components, 15 bits per pixel
format=pix_fmts=yuv444p 	3 components, 24 bits per pixel
--- ffmpeg -i in.mp4 -i in.mp4 -filter_complex "[0:v][1:v]overlay[v];[
"[0:v][1:v]overlay[v];[0:a]	in.mp4
"[0:v][1:v]overlay[v];[0:v]	in.mp4
"[0:v][1:v]overlay[v];[1:a]	in.mp4
"[0:v][1:v]overlay[v];[1:v]	in.mp4
"[0:v][1:v]overlay[v];[v]
--- ffmpeg -i in.mp4 -filter_complex "hflip[a];[a]spl
"hflip[a];[a]split	pass on the input to N video outputs
=== map
--- ffmpeg -i in.mp4 -i missing.mkv -map 
0 	in.mp4
0:0 	video h264
0:1 	audio aac (eng)
0:2 	audio ac3 (por): Commentary
0:a 	audio streams
0:v 	video streams
1 	missing.mkv
1:a 	audio streams
1:d 	data streams
1:s 	subtitle streams
1:t 	attachments
1:v 	video streams
--- ffmpeg -i in.mp4 -map -0:
-0:0 	video h264
-0:1 	audio aac (eng)
-0:2 	audio ac3 (por): Commentary
-0:a 	audio streams
-0:v 	video streams
--- ffmpeg -i in.mp4 -filter_complex "[0:v]split[a][b];[a]hflip[c]" -map [
[b] 	an output of -filter_complex
[c] 	an output of -filter_complex
--- ffmpeg -i in.mp4 -map_metadata 
-1 	none
0 	in.mp4
