load 0
=== options
--- ffmpeg -ss
-ss 	start transcoding at specified time
-sseof 	set the start time offset relative to EOF
--- ffmpeg -hwacc
-hwaccel 	use HW accelerated decoding
-hwaccel_device 	select a device for HW acceleration
-hwaccel_flags 	flags
-hwaccel_output_format 	select output format used with HW accelerated decoding
-hwaccels 	show available HW acceleration methods
--- ffmpeg -i in.mp4 -hwacc
-hwaccels 	show available HW acceleration methods
--- ffmpeg -i in.mp4 -mov
--- ffmpeg -i in.mp4 -probes
--- ffmpeg -probes
-probesize 	set probing size (from 32 to I64_MAX)
--- ffmpeg -nost
-nostart_at_zero 	not -start_at_zero
-nostats 	not -stats
-nostdin 	not -stdin
--- ffmpeg -i in.mp4 -c:
-c:V 	video streams that aren't attached pictures
-c:a 	audio streams
-c:d 	data streams
-c:s 	subtitle streams
-c:t 	attachments
-c:v 	video streams
--- ffmpeg -i in.mp4 -b:
-b:V 	video streams that aren't attached pictures
-b:a 	audio streams
-b:d 	data streams
-b:s 	subtitle streams
-b:t 	attachments
-b:v 	video streams
--- ffmpeg -i in.mp4 -c:v:
--- ffmpeg -i in.mp4 -metadata:
-metadata:c 	the metadata of a chapter (c:0)
-metadata:g 	global metadata
-metadata:p 	the metadata of a program (p:0)
-metadata:s 	the metadata of streams (s:a, s:v:0...)
--- ffmpeg -i in.mp4 -metadata:s:
-metadata:s:V 	video streams that aren't attached pictures
-metadata:s:a 	audio streams
-metadata:s:d 	data streams
-metadata:s:s 	subtitle streams
-metadata:s:t 	attachments
-metadata:s:v 	video streams
--- ffmpeg -i in.mp4 -y:
=== private options
--- ffmpeg -i in.mp4 -c:v libx264 -pr
-pre 	preset name
-pre_dia_size 	diamond type & size for motion estimation pre-pass (from INT_MIN to INT_MAX)
-precmp 	pre motion estimation compare function (from INT_MIN to INT_MAX)
-preset 	set the encoding preset (cf. x264 --fullhelp) (libx264)
-print_graphs 	print execution graph data to stderr
-print_graphs_file 	write execution graph data to the specified file
-print_graphs_format 	set the output printing format
-profile 	set profile
-program 	add program with specified streams
-progress 	write program-readable progress information
-protocols 	show available protocols
--- ffmpeg -i in.mp4 -c:v libx264 -c:a aac -aac_
-aac_coder 	coding algorithm (from 0 to 1) (aac)
-aac_is 	intensity stereo coding (aac)
-aac_ms 	force M/S stereo coding (aac)
-aac_pce 	forces the use of PCEs (aac)
-aac_pns 	perceptual noise substitution (aac)
-aac_tns 	temporal noise shaping (aac)
--- ffmpeg -i in.mp4 -c:v libx264 -preset:
-preset:V 	video streams that aren't attached pictures
-preset:a 	audio streams
-preset:d 	data streams
-preset:s 	subtitle streams
-preset:t 	attachments
-preset:v 	video streams
--- ffmpeg -i in.mp4 -c:v libx264 out.mp4 -pr
-pre 	preset name
-pre_dia_size 	diamond type & size for motion estimation pre-pass (from INT_MIN to INT_MAX)
-precmp 	pre motion estimation compare function (from INT_MIN to INT_MAX)
-print_graphs 	print execution graph data to stderr
-print_graphs_file 	write execution graph data to the specified file
-print_graphs_format 	set the output printing format
-profile 	set profile
-program 	add program with specified streams
-progress 	write program-readable progress information
-protocols 	show available protocols
--- ffmpeg -i in.mp4 -c:v copy -pr
-pre 	preset name
-pre_dia_size 	diamond type & size for motion estimation pre-pass (from INT_MIN to INT_MAX)
-precmp 	pre motion estimation compare function (from INT_MIN to INT_MAX)
-print_graphs 	print execution graph data to stderr
-print_graphs_file 	write execution graph data to the specified file
-print_graphs_format 	set the output printing format
-profile 	set profile
-program 	add program with specified streams
-progress 	write program-readable progress information
-protocols 	show available protocols
--- ffmpeg -i in.mp4 -f mp4 -movfl
-movflags 	MOV muxer flags (mp4)
=== codecs and formats
--- ffmpeg -i in.mp4 -c:v 
copy 	copy the stream without reencoding
libsvtav1 	SVT-AV1(Scalable Video Technology for AV1) encoder (codec av1)
libx264 	libx264 H.264 / AVC / MPEG-4 AVC / MPEG-4 part 10 (codec h264)
libx265 	libx265 H.265 / HEVC (codec hevc)
mpeg4 	MPEG-4 part 2
--- ffmpeg -i in.mp4 -c:a 
aac 	AAC (Advanced Audio Coding)
copy 	copy the stream without reencoding
flac 	FLAC (Free Lossless Audio Codec)
libmp3lame 	libmp3lame MP3 (MPEG audio layer 3) (codec mp3)
libopus 	libopus Opus (codec opus)
--- ffmpeg -i in.mp4 -acodec 
aac 	AAC (Advanced Audio Coding)
copy 	copy the stream without reencoding
flac 	FLAC (Free Lossless Audio Codec)
libmp3lame 	libmp3lame MP3 (MPEG audio layer 3) (codec mp3)
libopus 	libopus Opus (codec opus)
--- ffmpeg -i in.mp4 -c:s:0 
copy 	copy the stream without reencoding
mov_text 	3GPP Timed Text subtitle
subrip 	SubRip subtitle
--- ffmpeg -i in.mp4 -codec 
aac 	AAC (Advanced Audio Coding)
copy 	copy the stream without reencoding
flac 	FLAC (Free Lossless Audio Codec)
libmp3lame 	libmp3lame MP3 (MPEG audio layer 3) (codec mp3)
libopus 	libopus Opus (codec opus)
