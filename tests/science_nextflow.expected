=== nf-test
--- nf-test 
clean 	remove the .nf-test directory
coverage 	print the status of the tests
generate 	generate tests for sources
init 	initialize a project
list 	list tests
test 	run tests
update-plugins 	update the plugins
version 	show the version
--- nf-test t
test 	run tests
--- nf-test test --
--changed-since=	run tests related to the changes since a branch or commit hash
--changed-until=	run tests related to the changes until a branch or commit hash
--changedSince=	run tests related to the changes since a branch or commit hash
--changedUntil=	run tests related to the changes until a branch or commit hash
--ci 	CI mode: fail instead of storing a new snapshot
--clean-snapshot 	remove all obsolete snapshots
--cleanSnapshot 	remove all obsolete snapshots
--config=	nf-test.config filename
--coverage 	print simple coverage calculation
--csv=	write test results in csv format
--debug 	show debugging infos and dump channels
--dry-run 	execute most of test discovery but stop before running any test case
--dryRun 	execute most of test discovery but stop before running any test case
--filter=	filter test cases by types (process, pipeline, workflow, function)
--follow-dependencies 	follow all dependencies when related-tests is set
--followDependencies 	follow all dependencies when related-tests is set
--graph=	export dependency graph as dot file
--junitxml=	write test results in Junit Xml format
--lib=	library extension path
--log=	filename for log file
--only-changed 	run tests only for the files modified in the current git repository
--onlyChanged 	run tests only for the files modified in the current git repository
--plugins=	library extension path
--profile=	profile to execute all tests
--related-tests 	find and execute all related tests for the provided files
--relatedTests 	find and execute all related tests for the provided files
--shard-strategy=	strategy to build shards
--shard=	split into chunks and execute the I-th of N
--silent 	hide header and program version
--smart-testing 	run in smart testing mode (--ci --changed-since HEAD^)
--smartTesting 	run in smart testing mode (--ci --changed-since HEAD^)
--stop-on-first-failure 	stop execution immediately after the first test failure
--stopOnFirstFailure 	stop execution immediately after the first test failure
--tag=	execute only tests with this tag
--tap=	write test results to tap file
--update-snapshot 	re-record every snapshot that fails during this test run
--updateSnapshot 	re-record every snapshot that fails during this test run
--verbose 	show Nextflow output
--wipe-snapshot 	remove all obsolete snapshots
--wipeSnapshot 	remove all obsolete snapshots
--without-trace 	run nextflow tests without the trace parameter
