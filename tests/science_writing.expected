=== TeX
--- pdflatex -
-8bit 	make all characters printable
-cnf-line=	parse STRING as a configuration file line
-draftmode 	switch on draft mode (generates no output PDF)
-enc 	enable encTeX extensions
-etex 	enable e-TeX extensions
-file-line-error 	enable file:line:error style messages
-fmt=	use FMTNAME instead of program name or a %& line
-halt-on-error 	stop processing at the first error
-help 	display the help and exit
-ini 	be an initex, for dumping formats
-interaction=	set interaction mode
-jobname=	set the job name to STRING
-kpathsea-debug=	set path searching debugging flags according to the bits of NUMBER
-mktex=	enable mktexFMT generation
-mltex 	enable MLTeX extensions
-no-file-line-error 	disable file:line:error style messages
-no-mktex=	disable mktexFMT generation
-no-parse-first-line 	disable parsing of the first line of the input file
-no-shell-escape 	disable the write18 shell escape
-output-comment=	use STRING for the file comment instead of the date
-output-directory=	use existing DIR as the directory to write files in
-output-format=	use FORMAT for job output (dvi or pdf)
-parse-first-line 	enable parsing of the first line of the input file
-progname=	set program (and fmt) name to STRING
-recorder 	enable filename recorder
-shell-escape 	enable the write18 shell escape
-shell-restricted 	enable restricted write18
-src-specials	insert source specials into the output file, in certain places
-synctex=	generate SyncTeX data for previewers according to bits of NUMBER
-translate-file=	use the TCX file TCXNAME
-version 	output version information and exit
--- pdflatex -interaction=
-interaction=batchmode 
-interaction=errorstopmode 
-interaction=nonstopmode 
-interaction=scrollmode 
