--- claude --perm
--permission-mode=	permission mode to use for the session
--permission-prompts=	who answers permission prompts with --print: "host" (the SDK host or --permission-prompt-tool) or "none" (nobody: anything that would prompt is denied automatically; the permission mode still decides everything else)
