=== sbatch
--- sbatch --part
--partition=	partition requested
--- sbatch -p 
debug 	up, 1:00:00, 2 nodes
gpu 	up, 2-00:00:00, 2 nodes
--- sbatch --partition=g
--partition=gpu 	up, 2-00:00:00, 2 nodes
--- sbatch -p debug,
debug,gpu 	up, 2-00:00:00, 2 nodes
--- sbatch -A 
lab 
teaching 
--- sbatch --qos=
--qos=long 	Up to 7 days
--qos=normal 	Normal QOS default
--- sbatch --mail-type=BEGIN,E
--mail-type=BEGIN,END 
--- sbatch -d 
after:
afterany:
afterburstbuffer:
aftercorr:
afternotok:
afterok:
singleton 
--- sbatch -d afterok:
afterok:4242 	assemble (RUNNING)
afterok:4243 	bin (PENDING)
afterok:4250_\[1-10] 	array (PENDING)
--- sbatch --dependency=afterok:4242:
--dependency=afterok:4242:4242 	assemble (RUNNING)
--dependency=afterok:4242:4243 	bin (PENDING)
--dependency=afterok:4242:4250_\[1-10] 	array (PENDING)
--- sbatch --dependency=afterok:4242,sing
--dependency=afterok:4242,singleton 
--- sbatch -C 'avx2&i
'avx2&ib' 
--- sbatch --constraint=a
--constraint=avx2 
--constraint=avx512 
--- sbatch --gres=
--gres=gpu 
--gres=gpu:a100 
--gres=gpu:v100 
--gres=mps 
--- sbatch -w n0
n01 	idle
n02 	mixed
--- sbatch --reservation 
maint 	INACTIVE
--- sbatch -L 
ansys 	0 of 4 free
matlab 	8 of 10 free
--- sbatch -M 
alpha 
beta 
--- sbatch --open-mode 
append 
truncate 
--- sbatch --test-o
--test-only 	estimate when the job would start, without submitting it
--- sbatch -o 
bin/
data.txt 
hpc_slurm.sh 
job.sh 
--- sbatch -p debug jo
job.sh 
--- sbatch job.sh --part
